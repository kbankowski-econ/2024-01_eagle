r*EAA_pex*EAKEAA_im+EAGEAB_rer*EAB_pex*EAKEAB_im+EAGEAC_rer*EAC_pex*EAKEAC_im+EAGEAD_rer*EAD_pex*EAKEAD_im+EAGEAE_rer*EAE_pex*EAKEAE_im+EAGEAF_rer*EAF_pex*EAKEAF_im+EAGEAH_rer*EAH_pex*EAKEAH_im+EAGEAI_rer*EAI_pex*EAKEAI_im+EAGEAJ_rer*EAJ_pex*EAKEAJ_im+EAGEAL_rer*EAL_pex*EAKEAL_im+EAGRW_rer*RW_pex*EAKRW_im+EAGUS_rer*US_pex*EAKUS_im)+EAL_size/EAG_size*EALEAG_im/EAG_ex*EAGEAA_rer*EAA_pex*EALEAA_im/(EAGEAL_rer*EAL_py*EAL_y+EAGEAA_rer*EAA_pex*EALEAA_im+EAGEAB_rer*EAB_pex*EALEAB_im+EAGEAC_rer*EAC_pex*EALEAC_im+EAGEAD_rer*EAD_pex*EALEAD_im+EAGEAE_rer*EAE_pex*EALEAE_im+EAGEAF_rer*EAF_pex*EALEAF_im+EAGEAH_rer*EAH_pex*EALEAH_im+EAGEAI_rer*EAI_pex*EALEAI_im+EAGEAJ_rer*EAJ_pex*EALEAJ_im+EAGEAK_rer*EAK_pex*EALEAK_im+EAGRW_rer*RW_pex*EALRW_im+EAGUS_rer*US_pex*EALUS_im)+RW_size/EAG_size*RWEAG_im/EAG_ex*EAGEAA_rer*EAA_pex*RWEAA_im/(EAGRW_rer*RW_py*RW_y+EAGEAA_rer*EAA_pex*RWEAA_im+EAGEAB_rer*EAB_pex*RWEAB_im+EAGEAC_rer*EAC_pex*RWEAC_im+EAGEAD_rer*EAD_pex*RWEAD_im+EAGEAE_rer*EAE_pex*RWEAE_im+EAGEAF_rer*EAF_pex*RWEAF_im+EAGEAH_rer*EAH_pex*RWEAH_im+EAGEAI_rer*EAI_pex*RWEAI_im+EAGEAJ_rer*EAJ_pex*RWEAJ_im+EAGEAK_rer*EAK_pex*RWEAK_im+EAGEAL_rer*EAL_pex*RWEAL_im+EAGUS_rer*US_pex*RWUS_im)+US_size/EAG_size*USEAG_im/EAG_ex*EAGEAA_rer*EAA_pex*USEAA_im/(EAGUS_rer*US_py*US_y+EAGEAA_rer*EAA_pex*USEAA_im+EAGEAB_rer*EAB_pex*USEAB_im+EAGEAC_rer*EAC_pex*USEAC_im+EAGEAD_rer*EAD_pex*USEAD_im+EAGEAE_rer*EAE_pex*USEAE_im+EAGEAF_rer*EAF_pex*USEAF_im+EAGEAH_rer*EAH_pex*USEAH_im+EAGEAI_rer*EAI_pex*USEAI_im+EAGEAJ_rer*EAJ_pex*USEAJ_im+EAGEAK_rer*EAK_pex*USEAK_im+EAGEAL_rer*EAL_pex*USEAL_im+EAGRW_rer*RW_pex*USRW_im);
