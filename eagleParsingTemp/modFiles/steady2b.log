for s = 1:length(suffixes)
    % Initialize matrix for current suffix
    matrix = zeros(length(countryCodes));
    
    % Fill the matrix
    for i = 1:length(countryCodes)
        for j = 1:length(countryCodes)
            fieldName = [countryCodes{i} countryCodes{j} suffixes{s}];
            if isfield(newStruct, fieldName)
                matrix(i, j) = newStruct.(fieldName);
            end
            % Note: Cells remain 0 if field doesn't exist
        end
    end
    
    % Create table
    tables{s} = array2table(matrix, 'RowNames', countryCodes, 'VariableNames', countryCodes);
end
