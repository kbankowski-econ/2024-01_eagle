% Get all field names from the original structure
allFields = fieldnames(aParam);

% Define the country codes and suffixes
countryCodes = {'EAA', 'EAB', 'EAC', 'EAD', 'EAE', 'EAF', 'EAG', 'EAH', 'EAI', 'EAJ', 'EAK', 'EAL', 'RW', 'US'};
suffixes = {'_imcy', '_imiy', '_imcgy', '_imigy'};

% Initialize the new structure
newStruct = struct();

% Loop through all fields in the original structure
for i = 1:length(allFields)
    fieldName = allFields{i};
    
    % Check if the field matches our criteria
    for j = 1:length(countryCodes)
        for k = 1:length(countryCodes)
            if startsWith(fieldName, [countryCodes{j} countryCodes{k}]) && endsWith(fieldName, '_imcy')
                newStruct.(fieldName) = aParam.(fieldName);
            end
        end
    end
    
    % Check for other suffixes
    for j = 1:length(countryCodes)
        for k = 2:length(suffixes)
            if strcmp(fieldName, [countryCodes{j} suffixes{k}])
                newStruct.(fieldName) = aParam.(fieldName);
            end
        end
    end
end


% Define country codes and suffixes
countries = {'EAA', 'EAB', 'EAC', 'EAD', 'EAE', 'EAF', 'EAG', 'EAH', 'EAI', 'EAJ', 'EAK', 'EAL', 'RW', 'US'};
suffixes = {'imcy', 'imiy', 'imcgy', 'imigy'};

% Initialize structure to store tables
origTable = struct();
% Create tables for each suffix
for s = 1:length(suffixes)
    aItem = suffixes{s};
    
    % Initialize table with NaN values
    origTable.(aItem) = array2table(nan(length(countries), length(countries)), 'RowNames', countries, 'VariableNames', countries);
    
    % Fill the table
    for i = 1:length(countries)
        aCtry1 = countries{i};
        for j = 1:length(countries)
            aCtry2 = countries{j};
            fieldName = [aCtry1 aCtry2 '_' aItem];
            
            if isfield(newStruct, fieldName)
                origTable.(aItem){aCtry1, aCtry2} = newStruct.(fieldName);
            else
                % If the field doesn't exist, leave it as NaN
            end
        end
        
        % Calculate residual (assuming last country is residual)
        aCtryResid = countries{end};
        residFieldName = [aCtry1 '_' aItem];
        if isfield(newStruct, residFieldName)
            totalValue = newStruct.(residFieldName);
            sumOfOthers = sum(origTable.(aItem){aCtry1, :}, 'omitnan');
            origTable.(aItem){aCtry1, aCtryResid} = totalValue - sumOfOthers;
        end
    end
end
