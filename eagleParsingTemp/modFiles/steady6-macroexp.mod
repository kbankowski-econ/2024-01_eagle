+BERU_rer*RU_pex*RARU_im
+BERW_rer*RW_pex*RARW_im
+BEUS_rer*US_pex*RAUS_im
)+
+AT_size/BE_size*ATBE_im/BE_ex*BERA_rer*RA_pex*ATRA_im/(BEAT_rer*AT_py*AT_y
+BERA_rer*RA_pex*ATRA_im
+BEES_rer*ES_pex*ATES_im
+BEFI_rer*FI_pex*ATFI_im
+BEFR_rer*FR_pex*ATFR_im
+BEGR_rer*GR_pex*ATGR_im
+BEIT_rer*IT_pex*ATIT_im
