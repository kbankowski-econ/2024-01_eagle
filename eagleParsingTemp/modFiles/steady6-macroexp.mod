+BEUS_rer*US_pex*RWUS_im
)
+US_size/BE_size*USBE_im/BE_ex*BERA_rer*RA_pex*USRA_im/(BEUS_rer*US_py*US_y
+BERA_rer*RA_pex*USRA_im
+BEAT_rer*AT_pex*USAT_im
+BEES_rer*ES_pex*USES_im
+BEFI_rer*FI_pex*USFI_im
+BEFR_rer*FR_pex*USFR_im
