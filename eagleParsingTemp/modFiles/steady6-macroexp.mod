// Private consumption good firm
// Private consumption good (tradable)
PT_ttc^((PT_mutc-1)/PT_mutc) = (PT_nutc)^(1/PT_mutc)*PT_htc^(1-1/PT_mutc)+(1-PT_nutc)^(1/PT_mutc)*PT_imc^(1-1/PT_mutc);
// Private consumption good  (total)
PT_qc^((PT_muc-1)/PT_muc) = (PT_nuc)^(1/PT_muc)*PT_ttc^(1-1/PT_muc)+(1-PT_nuc)^(1/PT_muc)*PT_ntc^(1-1/PT_muc);
// Demand for domestic intermediate goods - NONTRADABLE
PT_ntc = (1-PT_nuc)*(PT_pnt)^(-PT_muc)*PT_qc;
// Price of the consumption good (tradable)  
PT_pttc^(1-PT_mutc) = (PT_nutc)*PT_pht^(1-PT_mutc)+(1-PT_nutc)*PT_pimc^(1-PT_mutc);
// Price of the consumption good 
1^(1-PT_muc) = (PT_nuc)*PT_pttc^(1-PT_muc)+(1-PT_nuc)*PT_pnt^(1-PT_muc);
// Demand for domestic intermediate goods
PT_htc = PT_nutc*(PT_pht/PT_pttc)^(-PT_mutc)*PT_ttc;
PTRA_gammaimc = 0;
PTRA_gammaimcdag = 1;
