// PTFR_fx = FR_size/PT_size*FRPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(FRPT_piim(+1)/(FRPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTFR_fx(+1);
// Definition of gx   
