-FI_pex*ATFI_rer*ATFI_im
+AT_pex*FR_size/AT_size*FRAT_im
-FR_pex*ATFR_rer*ATFR_im
+AT_pex*GR_size/AT_size*GRAT_im
-GR_pex*ATGR_rer*ATGR_im
+AT_pex*IT_size/AT_size*ITAT_im
-IT_pex*ATIT_rer*ATIT_im
+AT_pex*NL_size/AT_size*NLAT_im
-NL_pex*ATNL_rer*ATNL_im
+AT_pex*PT_size/AT_size*PTAT_im
-PT_pex*ATPT_rer*ATPT_im
+AT_pex*DE_size/AT_size*DEAT_im
-DE_pex*ATDE_rer*ATDE_im
+AT_pex*RU_size/AT_size*RUAT_im
-RU_pex*ATRU_rer*ATRU_im
+AT_pex*RW_size/AT_size*RWAT_im
-RW_pex*ATRW_rer*ATRW_im
+AT_pex*US_size/AT_size*USAT_im
-US_pex*ATUS_rer*ATUS_im
;
// Aggregate exports (volume)
AT_ex =
+RA_size/AT_size*RAAT_im
+BE_size/AT_size*BEAT_im
+ES_size/AT_size*ESAT_im
+FI_size/AT_size*FIAT_im
+FR_size/AT_size*FRAT_im
+GR_size/AT_size*GRAT_im
+IT_size/AT_size*ITAT_im
+NL_size/AT_size*NLAT_im
+PT_size/AT_size*PTAT_im
+DE_size/AT_size*DEAT_im
+RU_size/AT_size*RUAT_im
+RW_size/AT_size*RWAT_im
+US_size/AT_size*USAT_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using AT_pg = AT_pht
// TODO: check the (1-AT_gammab(-1)) adjustment here, which is not in the fiscal extention
	AT_pcg(-1)*AT_cg(-1)+AT_pig(-1)*AT_ig(-1)+AT_tr(-1)
	+AT_b(-1)*AT_pic(-1)^(-1)+AT_m(-2)*AT_pic(-1)^(-1) = AT_tauc(-1)*AT_c(-1)+(AT_taun(-1)+AT_tauwh(-1))*(AT_wi(-1)*AT_ndi(-1)+AT_wj(-1)*AT_ndj(-1))+AT_tauwf(-1)*AT_w(-1)*AT_nd(-1)+AT_tauk(-1)*(AT_rk(-1)*AT_u(-1)-(AT_gammau(-1)+AT_delta)*AT_pi(-1))*AT_k(-1)+AT_taud(-1)*AT_d(-1)+AT_t(-1)+(AT_r(-1)*(1-AT_gammab(-1)))^(-1)*AT_b+AT_m(-1);
// Government spending, using AT_pg = AT_pht
AT_pcg*AT_cg = AT_cgy*AT_pybar*AT_ybar;
AT_pig*AT_ig = AT_igy*AT_pybar*AT_ybar;
AT_t = 0;
AT_b = AT_bytarget*AT_pybar*AT_ybar;
// Auxiliary equation for steady-state output
AT_ybar = AT_y;
// Auxiliary equation for steady-state output
AT_ytbar = AT_yst;
// Auxiliary equation for steady-state output
AT_ynbar = AT_ysn;
// Auxiliary equation for steady-state output deflator
AT_pybar = AT_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
AT_trybar = AT_tr/(AT_pybar*AT_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
AT_ti = AT_upsilont*AT_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
AT_tri = AT_upsilontr*AT_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	AT_r = DE_r;
AT_pic4 = AT_pi4target;
AT_rr-1 = AT_r/AT_pi4target^(1/4)-1;
// Equilibrium real interest rate
AT_rrstar-1 = 1/AT_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
AT_c = (1-AT_omega)*AT_ci+AT_omega*AT_cj;
// Aggregate money holdings
AT_m = (1-AT_omega)*AT_mi+AT_omega*AT_mj;
// Aggregate capital stock
AT_k = (1-AT_omega)*AT_ki;
// Aggregate investment
AT_i = (1-AT_omega)*AT_ii;
// Aggregate lump-sum transfers
AT_trj = 
1/AT_omega*AT_tr-(1-AT_omega)/AT_omega*AT_tri
;
// Aggregate lump-sum taxes
AT_tj = 
1/AT_omega*AT_t-(1-AT_omega)/AT_omega*AT_ti
;
// Aggregate transaction costs
AT_gammav = (1-AT_omega)*AT_ci*AT_gammavi+AT_omega*AT_cj*AT_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
AT_ni = AT_si*AT_ndi;
// Wage dispersion
AT_si = (1-AT_xii)*(AT_witilde/AT_wi)^(-AT_etai)+AT_xii*(AT_wi(-1)/AT_wi)^(-AT_etai)*(AT_pic/(AT_pic(-1)^AT_chii*AT_pi4target^(1/4*(1-AT_chii))))^(AT_etai)*AT_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
AT_nj = AT_sj*AT_ndj;
// Wage dispersion
AT_sj = (1-AT_xij)*(AT_wjtilde/AT_wj)^(-AT_etaj)+AT_xij*(AT_wj(-1)/AT_wj)^(-AT_etaj)*(AT_pic/(AT_pic(-1)^AT_chij*AT_pi4target^(1/4*(1-AT_chij))))^(AT_etaj)*AT_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
AT_u*AT_k = AT_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using AT_x = BE_size/AT_size*BE_im
AT_ysn = AT_snt*AT_nt;
//  nontradables aggregate demand
AT_nt = 
+AT_ntc
+AT_nti
+AT_ntcg
+AT_ntig
;
// Aggregate demand for domestic intermediate goods, using AT_hg = AT_cg
AT_ht =
+AT_htc
+AT_hti
+AT_htcg
+AT_htig
;
// Price dispersion in the domestic markets
AT_sh = (1-AT_xih)*(AT_phttilde/AT_pht)^(-AT_thetat)+AT_xih*(AT_piht/(AT_piht(-1)^AT_chih*AT_pi4target^(1/4*(1-AT_chih))))^AT_thetat*AT_sh(-1);
// Price dispersion in the foreign markets
AT_sx = (1-AT_xix)*(AT_pextilde/AT_pex)^(-AT_thetat)+AT_xix*(AT_piex/(AT_piex(-1)^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*AT_sx(-1);
// Price dispersion in the domestic markets
AT_snt = (1-AT_xin)*(AT_pnttilde/AT_pnt)^(-AT_thetan)+AT_xin*(AT_pint/(AT_pint(-1)^AT_chin*AT_pi4target^(1/4*(1-AT_chin))))^AT_thetan*AT_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
AT_qc = AT_c+AT_gammav;
// Aggregate investment and capital utilisation cost
AT_qi = AT_i+AT_k*AT_gammau;
// Aggregate gov demand components added to use the same structure like in private components
AT_qcg = AT_cg;
AT_qig = AT_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
AT_py*AT_y = 
+AT_qc
+AT_pi*AT_qi
+AT_pcg*AT_qcg
+AT_pig*AT_qig
+AT_pex*RA_size/AT_size*RAAT_im
-(RA_pex*ATRA_rer)*ATRA_imc
-(RA_pex*ATRA_rer)*ATRA_imi
-(RA_pex*ATRA_rer)*ATRA_imcg
-(RA_pex*ATRA_rer)*ATRA_imig
+AT_pex*BE_size/AT_size*BEAT_im
-(BE_pex*ATBE_rer)*ATBE_imc
-(BE_pex*ATBE_rer)*ATBE_imi
-(BE_pex*ATBE_rer)*ATBE_imcg
-(BE_pex*ATBE_rer)*ATBE_imig
+AT_pex*ES_size/AT_size*ESAT_im
-(ES_pex*ATES_rer)*ATES_imc
-(ES_pex*ATES_rer)*ATES_imi
-(ES_pex*ATES_rer)*ATES_imcg
-(ES_pex*ATES_rer)*ATES_imig
+AT_pex*FI_size/AT_size*FIAT_im
-(FI_pex*ATFI_rer)*ATFI_imc
-(FI_pex*ATFI_rer)*ATFI_imi
-(FI_pex*ATFI_rer)*ATFI_imcg
-(FI_pex*ATFI_rer)*ATFI_imig
+AT_pex*FR_size/AT_size*FRAT_im
-(FR_pex*ATFR_rer)*ATFR_imc
-(FR_pex*ATFR_rer)*ATFR_imi
-(FR_pex*ATFR_rer)*ATFR_imcg
-(FR_pex*ATFR_rer)*ATFR_imig
+AT_pex*GR_size/AT_size*GRAT_im
-(GR_pex*ATGR_rer)*ATGR_imc
-(GR_pex*ATGR_rer)*ATGR_imi
-(GR_pex*ATGR_rer)*ATGR_imcg
-(GR_pex*ATGR_rer)*ATGR_imig
+AT_pex*IT_size/AT_size*ITAT_im
-(IT_pex*ATIT_rer)*ATIT_imc
-(IT_pex*ATIT_rer)*ATIT_imi
-(IT_pex*ATIT_rer)*ATIT_imcg
-(IT_pex*ATIT_rer)*ATIT_imig
+AT_pex*NL_size/AT_size*NLAT_im
-(NL_pex*ATNL_rer)*ATNL_imc
-(NL_pex*ATNL_rer)*ATNL_imi
-(NL_pex*ATNL_rer)*ATNL_imcg
-(NL_pex*ATNL_rer)*ATNL_imig
+AT_pex*PT_size/AT_size*PTAT_im
-(PT_pex*ATPT_rer)*ATPT_imc
-(PT_pex*ATPT_rer)*ATPT_imi
-(PT_pex*ATPT_rer)*ATPT_imcg
-(PT_pex*ATPT_rer)*ATPT_imig
+AT_pex*DE_size/AT_size*DEAT_im
-(DE_pex*ATDE_rer)*ATDE_imc
-(DE_pex*ATDE_rer)*ATDE_imi
-(DE_pex*ATDE_rer)*ATDE_imcg
-(DE_pex*ATDE_rer)*ATDE_imig
+AT_pex*RU_size/AT_size*RUAT_im
-(RU_pex*ATRU_rer)*ATRU_imc
-(RU_pex*ATRU_rer)*ATRU_imi
-(RU_pex*ATRU_rer)*ATRU_imcg
-(RU_pex*ATRU_rer)*ATRU_imig
+AT_pex*RW_size/AT_size*RWAT_im
-(RW_pex*ATRW_rer)*ATRW_imc
-(RW_pex*ATRW_rer)*ATRW_imi
-(RW_pex*ATRW_rer)*ATRW_imcg
-(RW_pex*ATRW_rer)*ATRW_imig
+AT_pex*US_size/AT_size*USAT_im
-(US_pex*ATUS_rer)*ATUS_imc
-(US_pex*ATUS_rer)*ATUS_imi
-(US_pex*ATUS_rer)*ATUS_imcg
-(US_pex*ATUS_rer)*ATUS_imig
;
// Aggregate real demand
AT_y = AT_yst+AT_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(AT_zt) = (1-AT_rhozt)*log(AT_ztbar)+AT_rhozt*log(AT_zt(-1))+AT_epszt;
log(AT_zn) = (1-AT_rhozn)*log(AT_znbar)+AT_rhozn*log(AT_zn(-1))+AT_epszn;
// Government spending shock
AT_cgy = (1-AT_rhocg)*AT_cgybar+AT_rhocg*AT_cgy(-1)+AT_epsgc;
AT_igy = (1-AT_rhoig)*AT_igybar+AT_rhoig*AT_igy(-1)+AT_epsgi;
// Transfer shock
AT_try = (1-AT_rhotr)*AT_trybar+AT_rhotr*AT_try(-1)+AT_epstr;
// Consumption tax shock
AT_tauc = (1-AT_rhotauc)*AT_taucbar+AT_rhotauc*AT_tauc(-1)+AT_epstauc;
// Dividend income tax shock
AT_taud = (1-AT_rhotaud)*AT_taudbar+AT_rhotaud*AT_taud(-1)+AT_epstaud;
// Capital income tax shock
AT_tauk = (1-AT_rhotauk)*AT_taukbar+AT_rhotauk*AT_tauk(-1)+AT_epstauk;
// Labour income tax shock
AT_taun = (1-AT_rhotaun)*AT_taunbar+AT_rhotaun*AT_taun(-1)+AT_epstaun;
// Payroll tax shock: households
AT_tauwh = (1-AT_rhotauwh)*AT_tauwhbar+AT_rhotauwh*AT_tauwh(-1)+AT_epstauwh;
// Payroll tax shock: firms
AT_tauwf = (1-AT_rhotauwf)*AT_tauwfbar+AT_rhotauwf*AT_tauwf(-1)+AT_epstauwf;
// Wage cost push shock
AT_wcst = (1-AT_rhowcst)*AT_wcstbar+AT_rhowcst*AT_wcst(-1)+AT_epswcst;
// Preference shock
log(AT_zcon) = (1-AT_rhozcon)*log(AT_zconbar)+AT_rhozcon*log(AT_zcon(-1))+AT_epszcon;
// Investment specific shock
log(AT_zinv) = (1-AT_rhozinv)*log(AT_zinvbar)+AT_rhozinv*log(AT_zinv(-1))+AT_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
AT_cy = AT_c/(AT_py*AT_y);
// Aggregate nominal investment share
AT_iy = AT_pi*AT_i/(AT_py*AT_y);
// Aggregate nominal import share  
AT_imy = (
+AT_pimc*AT_imc
+AT_pimi*AT_imi
+AT_pimcg*AT_imcg
+AT_pimig*AT_imig
)/(AT_py*AT_y);
// Aggregate nominal import share
AT_imcy = AT_pimc*AT_imc/(AT_py*AT_y);
AT_imiy = AT_pimi*AT_imi/(AT_py*AT_y);
AT_imcgy = AT_pimcg*AT_imcg/(AT_py*AT_y);
AT_imigy = AT_pimig*AT_imig/(AT_py*AT_y);
// Aggregate debt-to-output ratio
AT_by = AT_b/(AT_pybar*AT_ybar);
// Aggregate lump-sum tax-to-output ratio
AT_ty = AT_t/(AT_pybar*AT_ybar);
// Aggregate labour cost share
AT_lcy = ((1+AT_tauwf)*AT_w*AT_nd)/(AT_py*AT_y);
// Aggregate nominal Wage share
AT_wy = (AT_w*AT_nd)/(AT_py*AT_y);
// NT sector nominal Wage share
AT_wnty = (AT_w*AT_ndn)/(AT_pnt*AT_ysn);
// T sector nominal Wage share
AT_whty = (AT_w*AT_ndt)/(AT_pht*AT_yst);
// T sector share
AT_yhty = AT_pht*AT_yst/(AT_py*AT_y);
// NT sector share
AT_ynty = AT_pnt*AT_ysn/(AT_py*AT_y);
// Output gap
AT_ygap = 0;
// Output growth (gross rate)
AT_ygrowth = AT_y/AT_y(-1);
// Output growth (gross rate yoy)
AT_ygrowth4 = AT_y/AT_y(-4);
// Domestic nominal output as a share of world nominal output
AT_yshare  = AT_size*AT_py*AT_y/AT_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
AT_epsilonm = -1/8*1/(AT_r*(AT_gammav2*AT_r+AT_r-1));
// Trade balance-to-GDP ratio
AT_tby = AT_tb/(AT_py*AT_y);
// Bilateral shares
ATRA_imcy = (RA_pex*ATRA_rer)*ATRA_imc/(AT_py*AT_y);
ATRA_imiy = (RA_pex*ATRA_rer)*ATRA_imi/(AT_py*AT_y);
ATRA_imcgy = (RA_pex*ATRA_rer)*ATRA_imcg/(AT_py*AT_y);
ATRA_imigy = (RA_pex*ATRA_rer)*ATRA_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATRA_excy  = RA_size/AT_size*AT_pex*RAAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATRA_exiy  = RA_size/AT_size*AT_pex*RAAT_imi/(AT_py*AT_y);
// Bilateral shares
ATBE_imcy = (BE_pex*ATBE_rer)*ATBE_imc/(AT_py*AT_y);
ATBE_imiy = (BE_pex*ATBE_rer)*ATBE_imi/(AT_py*AT_y);
ATBE_imcgy = (BE_pex*ATBE_rer)*ATBE_imcg/(AT_py*AT_y);
ATBE_imigy = (BE_pex*ATBE_rer)*ATBE_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATBE_excy  = BE_size/AT_size*AT_pex*BEAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATBE_exiy  = BE_size/AT_size*AT_pex*BEAT_imi/(AT_py*AT_y);
// Bilateral shares
ATES_imcy = (ES_pex*ATES_rer)*ATES_imc/(AT_py*AT_y);
ATES_imiy = (ES_pex*ATES_rer)*ATES_imi/(AT_py*AT_y);
ATES_imcgy = (ES_pex*ATES_rer)*ATES_imcg/(AT_py*AT_y);
ATES_imigy = (ES_pex*ATES_rer)*ATES_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATES_excy  = ES_size/AT_size*AT_pex*ESAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATES_exiy  = ES_size/AT_size*AT_pex*ESAT_imi/(AT_py*AT_y);
// Bilateral shares
ATFI_imcy = (FI_pex*ATFI_rer)*ATFI_imc/(AT_py*AT_y);
ATFI_imiy = (FI_pex*ATFI_rer)*ATFI_imi/(AT_py*AT_y);
ATFI_imcgy = (FI_pex*ATFI_rer)*ATFI_imcg/(AT_py*AT_y);
ATFI_imigy = (FI_pex*ATFI_rer)*ATFI_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATFI_excy  = FI_size/AT_size*AT_pex*FIAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATFI_exiy  = FI_size/AT_size*AT_pex*FIAT_imi/(AT_py*AT_y);
// Bilateral shares
ATFR_imcy = (FR_pex*ATFR_rer)*ATFR_imc/(AT_py*AT_y);
ATFR_imiy = (FR_pex*ATFR_rer)*ATFR_imi/(AT_py*AT_y);
ATFR_imcgy = (FR_pex*ATFR_rer)*ATFR_imcg/(AT_py*AT_y);
ATFR_imigy = (FR_pex*ATFR_rer)*ATFR_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATFR_excy  = FR_size/AT_size*AT_pex*FRAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATFR_exiy  = FR_size/AT_size*AT_pex*FRAT_imi/(AT_py*AT_y);
// Bilateral shares
ATGR_imcy = (GR_pex*ATGR_rer)*ATGR_imc/(AT_py*AT_y);
ATGR_imiy = (GR_pex*ATGR_rer)*ATGR_imi/(AT_py*AT_y);
ATGR_imcgy = (GR_pex*ATGR_rer)*ATGR_imcg/(AT_py*AT_y);
ATGR_imigy = (GR_pex*ATGR_rer)*ATGR_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATGR_excy  = GR_size/AT_size*AT_pex*GRAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATGR_exiy  = GR_size/AT_size*AT_pex*GRAT_imi/(AT_py*AT_y);
// Bilateral shares
ATIT_imcy = (IT_pex*ATIT_rer)*ATIT_imc/(AT_py*AT_y);
ATIT_imiy = (IT_pex*ATIT_rer)*ATIT_imi/(AT_py*AT_y);
ATIT_imcgy = (IT_pex*ATIT_rer)*ATIT_imcg/(AT_py*AT_y);
ATIT_imigy = (IT_pex*ATIT_rer)*ATIT_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATIT_excy  = IT_size/AT_size*AT_pex*ITAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATIT_exiy  = IT_size/AT_size*AT_pex*ITAT_imi/(AT_py*AT_y);
// Bilateral shares
ATNL_imcy = (NL_pex*ATNL_rer)*ATNL_imc/(AT_py*AT_y);
ATNL_imiy = (NL_pex*ATNL_rer)*ATNL_imi/(AT_py*AT_y);
ATNL_imcgy = (NL_pex*ATNL_rer)*ATNL_imcg/(AT_py*AT_y);
ATNL_imigy = (NL_pex*ATNL_rer)*ATNL_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATNL_excy  = NL_size/AT_size*AT_pex*NLAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATNL_exiy  = NL_size/AT_size*AT_pex*NLAT_imi/(AT_py*AT_y);
// Bilateral shares
ATPT_imcy = (PT_pex*ATPT_rer)*ATPT_imc/(AT_py*AT_y);
ATPT_imiy = (PT_pex*ATPT_rer)*ATPT_imi/(AT_py*AT_y);
ATPT_imcgy = (PT_pex*ATPT_rer)*ATPT_imcg/(AT_py*AT_y);
ATPT_imigy = (PT_pex*ATPT_rer)*ATPT_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATPT_excy  = PT_size/AT_size*AT_pex*PTAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATPT_exiy  = PT_size/AT_size*AT_pex*PTAT_imi/(AT_py*AT_y);
// Bilateral shares
ATDE_imcy = (DE_pex*ATDE_rer)*ATDE_imc/(AT_py*AT_y);
ATDE_imiy = (DE_pex*ATDE_rer)*ATDE_imi/(AT_py*AT_y);
ATDE_imcgy = (DE_pex*ATDE_rer)*ATDE_imcg/(AT_py*AT_y);
ATDE_imigy = (DE_pex*ATDE_rer)*ATDE_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATDE_excy  = DE_size/AT_size*AT_pex*DEAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATDE_exiy  = DE_size/AT_size*AT_pex*DEAT_imi/(AT_py*AT_y);
// Bilateral shares
ATRU_imcy = (RU_pex*ATRU_rer)*ATRU_imc/(AT_py*AT_y);
ATRU_imiy = (RU_pex*ATRU_rer)*ATRU_imi/(AT_py*AT_y);
ATRU_imcgy = (RU_pex*ATRU_rer)*ATRU_imcg/(AT_py*AT_y);
ATRU_imigy = (RU_pex*ATRU_rer)*ATRU_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATRU_excy  = RU_size/AT_size*AT_pex*RUAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATRU_exiy  = RU_size/AT_size*AT_pex*RUAT_imi/(AT_py*AT_y);
// Bilateral shares
ATRW_imcy = (RW_pex*ATRW_rer)*ATRW_imc/(AT_py*AT_y);
ATRW_imiy = (RW_pex*ATRW_rer)*ATRW_imi/(AT_py*AT_y);
ATRW_imcgy = (RW_pex*ATRW_rer)*ATRW_imcg/(AT_py*AT_y);
ATRW_imigy = (RW_pex*ATRW_rer)*ATRW_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATRW_excy  = RW_size/AT_size*AT_pex*RWAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATRW_exiy  = RW_size/AT_size*AT_pex*RWAT_imi/(AT_py*AT_y);
// Bilateral shares
ATUS_imcy = (US_pex*ATUS_rer)*ATUS_imc/(AT_py*AT_y);
ATUS_imiy = (US_pex*ATUS_rer)*ATUS_imi/(AT_py*AT_y);
ATUS_imcgy = (US_pex*ATUS_rer)*ATUS_imcg/(AT_py*AT_y);
ATUS_imigy = (US_pex*ATUS_rer)*ATUS_imig/(AT_py*AT_y);
// Exports of consumption goods to gdp
ATUS_excy  = US_size/AT_size*AT_pex*USAT_imc/(AT_py*AT_y);
// Exports of investment goods to gdp
ATUS_exiy  = US_size/AT_size*AT_pex*USAT_imi/(AT_py*AT_y);
// Internal real exchange rate
AT_internalrer = AT_pnt/AT_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
BE_ccesi^(1-1/BE_mucces) = (BE_nucces)^(1/BE_mucces)*BE_ci^(1-1/BE_mucces)+(1-BE_nucces)^(1/BE_mucces)*BE_cg^(1-1/BE_mucces);
// Utility
BE_utili = 
BE_zcon*log(BE_ccesi-BE_kappa*BE_ccesi(-1))-1/(1+BE_zeta)*(BE_ni)^(1+BE_zeta)+BE_beta*BE_utili(+1)
;
// Marginal utility of consumption
BE_dcci = ((BE_nucces)^(1/BE_mucces)*BE_ci^(1-1/BE_mucces)+(1-BE_nucces)^(1/BE_mucces)*BE_cg^(1-1/BE_mucces))^(1/(BE_mucces-1))*(BE_nucces^(1/BE_mucces))*(BE_ci^(-1/BE_mucces));
BE_lambdai*(1+BE_tauc+BE_gammavi+BE_vi*BE_gammavider) = BE_zcon*(BE_ccesi-BE_kappa*BE_ccesi(-1))^(-BE_sigma)*BE_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
BE_r                   = BE_beta^(-1)*BE_lambdai/BE_lambdai    *BE_pic;
// Germany
// US and the RoW
// Euler equation for money
BE_vi^(2)*BE_gammavider = 1-BE_beta*BE_lambdai(+1)/(BE_lambdai*BE_pic(+1));
// Consumption-based velocity
BE_vi = BE_ci/BE_mi;
// Transaction cost
BE_gammavi = BE_gammav1*BE_vi+BE_gammav2/BE_vi-2*(BE_gammav1*BE_gammav2)^(1/2);
// Derivative of transaction cost
BE_gammavider = BE_gammav1-BE_gammav2*BE_vi^(-2);
BE_delta = BE_ii/BE_ki;
BE_gammai = 0;
BE_gammaider = 0;
BE_gammau = 0;
BE_gammauder = ((BE_beta^(-1)-1+BE_delta)*BE_qbar-BE_delta*BE_taukbar*BE_pibar)/((1-BE_taukbar)*BE_pibar);
BE_u = 1;
BE_pi = BE_q;
// Auxiliary equation for Tobin's Q in steady state
BE_qbar = BE_q;
// Rate of return on capital
BE_q = BE_beta*((1-BE_tauk)*BE_rk+(BE_tauk*BE_delta)*BE_pi+(1-BE_delta)*BE_q);
// Optimal wage contract (FOC)
BE_witilde^(1+BE_etai*BE_zeta) = BE_etai/(BE_etai-1)*BE_fi/BE_gi+BE_wcst;
// Definition of fi
BE_fi = BE_wi^(BE_etai*(1+BE_zeta))*BE_ndi^(1+BE_zeta)+BE_xii*BE_beta*(BE_pic(+1)/(BE_pic^BE_chii*BE_pi4target^(1/4*(1-BE_chii))))^(BE_etai*(1+BE_zeta))*BE_fi(+1);
// Definition of gi
BE_gi = BE_lambdai*(1-BE_taun-BE_tauwh)*BE_wi^BE_etai*BE_ndi+BE_xii*BE_beta*(BE_pic(+1)/(BE_pic^BE_chii*BE_pi4target^(1/4*(1-BE_chii))))^(BE_etai-1)*BE_gi(+1);
// Aggregate wage rate
BE_wi^(1-BE_etai) = (1-BE_xii)*BE_witilde^(1-BE_etai)+BE_xii*BE_wi(-1)^(1-BE_etai)*(BE_pic(-1)^BE_chii*BE_pi4target^(1/4*(1-BE_chii))/BE_pic)^(1-BE_etai);
//-------------
// Household J
//-------------
BE_ccesj^(1-1/BE_mucces) = (BE_nucces)^(1/BE_mucces)*BE_cj^(1-1/BE_mucces)+(1-BE_nucces)^(1/BE_mucces)*BE_cg^(1-1/BE_mucces);
// Utility
BE_utilj = 
BE_zcon*log(BE_ccesj-BE_kappa*BE_ccesj(-1))-1/(1+BE_zeta)*(BE_nj)^(1+BE_zeta)+BE_beta*BE_utilj(+1)
;
// Marginal utility of consumption
BE_dccj = ((BE_nucces)^(1/BE_mucces)*BE_cj^(1-1/BE_mucces)+(1-BE_nucces)^(1/BE_mucces)*BE_cg^(1-1/BE_mucces))^(1/(BE_mucces-1))*(BE_nucces^(1/BE_mucces))*(BE_cj^(-1/BE_mucces));
BE_lambdaj*(1+BE_tauc+BE_gammavj+BE_vj*BE_gammavjder) = BE_zcon*(BE_ccesj-BE_kappa*BE_ccesj(-1))^(-BE_sigma)*BE_dccj;
// Budget constraint
(1+BE_tauc+BE_gammavj)*BE_cj+BE_mj = (1-BE_taun-BE_tauwh)*BE_wj*BE_nj+BE_trj-BE_tj+BE_mj(-1)*BE_pic^(-1);
// Euler equation for money
BE_vj^(2)*BE_gammavjder = 1-BE_beta*BE_lambdaj(+1)/(BE_lambdaj*BE_pic(+1));
// Consumption-based velocity
BE_vj = BE_cj/BE_mj;
// Transaction technology
BE_gammavj = BE_gammav1*BE_vj+BE_gammav2/BE_vj-2*(BE_gammav1*BE_gammav2)^(1/2);
// Derivative of transaction technology
BE_gammavjder = BE_gammav1-BE_gammav2*BE_vj^(-2);
// Optimal wage contract (FOC)
BE_wjtilde^(1+BE_etaj*BE_zeta) = BE_etaj/(BE_etaj-1)*BE_fj/BE_gj+BE_wcst;
// Definition of fj
BE_fj = BE_wj^(BE_etaj*(1+BE_zeta))*BE_ndj^(1+BE_zeta)+BE_xij*BE_beta*(BE_pic(+1)/(BE_pic^BE_chij*BE_pi4target^(1/4*(1-BE_chij))))^(BE_etaj*(1+BE_zeta))*BE_fj(+1);
// Definition of gj
BE_gj = BE_lambdaj*(1-BE_taun-BE_tauwh)*BE_wj^BE_etaj*BE_ndj+BE_xij*BE_beta*(BE_pic(+1)/(BE_pic^BE_chij*BE_pi4target^(1/4*(1-BE_chij))))^(BE_etaj-1)*BE_gj(+1);
// Aggregate wage rate
BE_wj^(1-BE_etaj) = (1-BE_xij)*BE_wjtilde^(1-BE_etaj)+BE_xij*BE_wj(-1)^(1-BE_etaj)*(BE_pic(-1)^BE_chij*BE_pi4target^(1/4*(1-BE_chij))/BE_pic)^(1-BE_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
BE_kg = (1-BE_deltag)*BE_kg(-1)+BE_ig(-1);
// Production function tradable
BE_yst = EA_z*BE_zt*BE_kg^BE_alphag*BE_kdt^BE_alphat*BE_ndt^(1-BE_alphat)-BE_psitbar;
// Production function nontradable
BE_ysn = EA_z*BE_zn*BE_kg^BE_alphag*BE_kdn^BE_alphan*BE_ndn^(1-BE_alphan)-BE_psinbar;
// Real marginal cost tradable
BE_mct = 1/(EA_z*BE_zt*BE_kg^BE_alphag*(BE_alphat)^(BE_alphat)*(1-BE_alphat)^(1-BE_alphat))*BE_rk^(BE_alphat)*((1+BE_tauwf)*BE_w)^(1-BE_alphat);
// Real marginal cost nontradable
BE_mcn = 1/(EA_z*BE_zn*BE_kg^BE_alphag*(BE_alphan)^(BE_alphan)*(1-BE_alphan)^(1-BE_alphan))*BE_rk^(BE_alphan)*((1+BE_tauwf)*BE_w)^(1-BE_alphan);
// Wage Inflation (qoq)
BE_piw = BE_w/BE_w(-1)*BE_pic;
// Wage Inflation (yoy)
BE_piw4 = BE_pic4;
// Auxiliary equation for steady-state fixed cost
BE_psitbar = BE_psit*BE_ytbar;
// Auxiliary equation for steady-state fixed cost
BE_psinbar = BE_psin*BE_ynbar;
// Capital input (FOC)
BE_rk = BE_alphat*(BE_yst+BE_psitbar)/BE_kdt*BE_mct;
// Capital input (FOC)
BE_rk = BE_alphan*(BE_ysn+BE_psinbar)/BE_kdn*BE_mcn;
// Total capital demand
BE_kd = BE_kdt+BE_kdn;
// Demand for labour services by household I
BE_ndi = 
(1-BE_omega)*(BE_wi/BE_w)^(-BE_eta)*BE_nd
;
// Demand for labour services by household J
BE_ndj = 
BE_omega*(BE_wj/BE_w)^(-BE_eta)*BE_nd
;
// Aggregate labour demand
BE_nd^(1-1/BE_eta) = 
(1-BE_omega)^(1/BE_eta)*BE_ndi^(1-1/BE_eta)+BE_omega^(1/BE_eta)*BE_ndj^(1-1/BE_eta)
;
// Total demand 
BE_nd = BE_ndt+BE_ndn;
// Aggregate dividends
BE_d = BE_py*BE_y-BE_rk*BE_kd-(1+BE_tauwf)*BE_w*BE_nd;
// Non-tradable sector dividends
BE_dn = BE_pnt*BE_ysn-BE_rk*BE_kdn-(1+BE_tauwf)*BE_w*BE_ndn;
// Tradable sector dividends
BE_dt = BE_pht*BE_ht
+BE_pex*BE_ex
-BE_rk*BE_kdt-(1+BE_tauwf)*BE_w*BE_ndt;
// Optimal price contract set in domestic markets (FOC)
BE_phttilde/BE_pht = BE_thetat/(BE_thetat-1)*BE_fh/BE_gh;
// Definition of fh
BE_fh = BE_mct*BE_ht+BE_xih*BE_beta*BE_lambdai(+1)/BE_lambdai*(BE_piht(+1)/(BE_piht^BE_chih*BE_pi4target^(1/4*(1-BE_chih))))^BE_thetat*BE_fh(+1);
// Definition of gh
BE_gh = BE_pht*BE_ht+BE_xih*BE_beta*BE_lambdai(+1)/BE_lambdai*(BE_piht(+1)/(BE_piht^BE_chih*BE_pi4target^(1/4*(1-BE_chih))))^(BE_thetat-1)*BE_gh(+1);
// Aggregate intermediate-good price dynamics
BE_pht^(1-BE_thetat) = (1-BE_xih)*BE_phttilde^(1-BE_thetat)+BE_xih*(BE_pht(-1)/BE_pic)^(1-BE_thetat)*(BE_piht(-1)^BE_chih*BE_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation
BE_piht = BE_pht/BE_pht(-1)*BE_pic;
// Optimal price contract set in domestic markets (FOC)
BE_pnttilde/BE_pnt = BE_thetan/(BE_thetan-1)*BE_fn/BE_gn;
// Definition of fn
BE_fn = BE_mcn*BE_nt+BE_xin*BE_beta*BE_lambdai(+1)/BE_lambdai*(BE_pint(+1)/(BE_pint^BE_chin*BE_pi4target^(1/4*(1-BE_chin))))^BE_thetan*BE_fn(+1);
// Definition of gn
BE_gn = BE_pnt*BE_nt+BE_xin*BE_beta*BE_lambdai(+1)/BE_lambdai*(BE_pint(+1)/(BE_pint^BE_chin*BE_pi4target^(1/4*(1-BE_chin))))^(BE_thetan-1)*BE_gn(+1);
// Aggregate intermediate-good price dynamics
BE_pnt^(1-BE_thetan) = (1-BE_xin)*BE_pnttilde^(1-BE_thetan)+BE_xin*(BE_pnt(-1)/BE_pic)^(1-BE_thetan)*(BE_pint(-1)^BE_chin*BE_pi4target^(1/4*(1-BE_chin)))^(1-BE_thetan);
// Intermediate-good price inflation
BE_pint = BE_pnt/BE_pnt(-1)*BE_pic;
// Optimal price contract set in domestic markets (FOC)
BE_pextilde/BE_pex = BE_thetat/(BE_thetat-1)*BE_fx/BE_gx;
// Definition of fh
BE_fx = BE_mct*BE_ex+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(BE_piex(+1)/(BE_piex^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BE_fx(+1);
// Definition of gh
BE_gx = BE_pex*BE_ex+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(BE_piex(+1)/(BE_piex^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BE_gx(+1);
// Aggregate intermediate-good price dynamics
BE_pex^(1-BE_thetat) = (1-BE_xix)*BE_pextilde^(1-BE_thetat)+BE_xix*(BE_pex(-1)/BE_pic)^(1-BE_thetat)*(BE_piex(-1)^BE_chix*BE_pi4target^(1/4*(1-BE_chix)))^(1-BE_thetat);
// Intermediate-good price inflation
BE_piex = BE_pex/BE_pex(-1)*BE_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = RA_pimtilde
// RABE_pimtilde/RABE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BERA_fx/BERA_gx;
// Definition of fx
// BERA_fx = RA_size/BE_size*RABE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(RABE_piim(+1)/(RABE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BERA_fx(+1);
// Definition of gx   
// BERA_gx = BERA_rer*RABE_pim*RA_size/BE_size*RABE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(RABE_piim(+1)/(RABE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BERA_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = RA_pim
// RABE_pim^(1-BE_thetat) = (1-BE_xix)*RABE_pimtilde^(1-BE_thetat)+BE_xix*(RABE_pim(-1)/RA_pic)^(1-BE_thetat)*(RABE_piim(-1)^BE_chix*RA_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = RA_piim
// RABE_piim = RABE_pim/RABE_pim(-1)*RA_pic;
// Bilateral real exchange rate
BERA_rer = BE_rer/RA_rer;
// Auxiliary equation for steady-state output
BERA_rerbar = BERA_rer;
//Terms of Trade
BERA_tot = RA_pex*BERA_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = AT_pimtilde
// ATBE_pimtilde/ATBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEAT_fx/BEAT_gx;
// Definition of fx
// BEAT_fx = AT_size/BE_size*ATBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(ATBE_piim(+1)/(ATBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEAT_fx(+1);
// Definition of gx   
// BEAT_gx = BEAT_rer*ATBE_pim*AT_size/BE_size*ATBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(ATBE_piim(+1)/(ATBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEAT_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = AT_pim
// ATBE_pim^(1-BE_thetat) = (1-BE_xix)*ATBE_pimtilde^(1-BE_thetat)+BE_xix*(ATBE_pim(-1)/AT_pic)^(1-BE_thetat)*(ATBE_piim(-1)^BE_chix*AT_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = AT_piim
// ATBE_piim = ATBE_pim/ATBE_pim(-1)*AT_pic;
// Bilateral real exchange rate
BEAT_rer = BE_rer/AT_rer;
// Auxiliary equation for steady-state output
BEAT_rerbar = BEAT_rer;
//Terms of Trade
BEAT_tot = AT_pex*BEAT_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = ES_pimtilde
// ESBE_pimtilde/ESBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEES_fx/BEES_gx;
// Definition of fx
// BEES_fx = ES_size/BE_size*ESBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(ESBE_piim(+1)/(ESBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEES_fx(+1);
// Definition of gx   
// BEES_gx = BEES_rer*ESBE_pim*ES_size/BE_size*ESBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(ESBE_piim(+1)/(ESBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEES_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = ES_pim
// ESBE_pim^(1-BE_thetat) = (1-BE_xix)*ESBE_pimtilde^(1-BE_thetat)+BE_xix*(ESBE_pim(-1)/ES_pic)^(1-BE_thetat)*(ESBE_piim(-1)^BE_chix*ES_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = ES_piim
// ESBE_piim = ESBE_pim/ESBE_pim(-1)*ES_pic;
// Bilateral real exchange rate
BEES_rer = BE_rer/ES_rer;
// Auxiliary equation for steady-state output
BEES_rerbar = BEES_rer;
//Terms of Trade
BEES_tot = ES_pex*BEES_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = FI_pimtilde
// FIBE_pimtilde/FIBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEFI_fx/BEFI_gx;
// Definition of fx
// BEFI_fx = FI_size/BE_size*FIBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(FIBE_piim(+1)/(FIBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEFI_fx(+1);
// Definition of gx   
// BEFI_gx = BEFI_rer*FIBE_pim*FI_size/BE_size*FIBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(FIBE_piim(+1)/(FIBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEFI_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = FI_pim
// FIBE_pim^(1-BE_thetat) = (1-BE_xix)*FIBE_pimtilde^(1-BE_thetat)+BE_xix*(FIBE_pim(-1)/FI_pic)^(1-BE_thetat)*(FIBE_piim(-1)^BE_chix*FI_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = FI_piim
// FIBE_piim = FIBE_pim/FIBE_pim(-1)*FI_pic;
// Bilateral real exchange rate
BEFI_rer = BE_rer/FI_rer;
// Auxiliary equation for steady-state output
BEFI_rerbar = BEFI_rer;
//Terms of Trade
BEFI_tot = FI_pex*BEFI_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = FR_pimtilde
// FRBE_pimtilde/FRBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEFR_fx/BEFR_gx;
// Definition of fx
// BEFR_fx = FR_size/BE_size*FRBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(FRBE_piim(+1)/(FRBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEFR_fx(+1);
// Definition of gx   
// BEFR_gx = BEFR_rer*FRBE_pim*FR_size/BE_size*FRBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(FRBE_piim(+1)/(FRBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEFR_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = FR_pim
// FRBE_pim^(1-BE_thetat) = (1-BE_xix)*FRBE_pimtilde^(1-BE_thetat)+BE_xix*(FRBE_pim(-1)/FR_pic)^(1-BE_thetat)*(FRBE_piim(-1)^BE_chix*FR_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = FR_piim
// FRBE_piim = FRBE_pim/FRBE_pim(-1)*FR_pic;
// Bilateral real exchange rate
BEFR_rer = BE_rer/FR_rer;
// Auxiliary equation for steady-state output
BEFR_rerbar = BEFR_rer;
//Terms of Trade
BEFR_tot = FR_pex*BEFR_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = GR_pimtilde
// GRBE_pimtilde/GRBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEGR_fx/BEGR_gx;
// Definition of fx
// BEGR_fx = GR_size/BE_size*GRBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(GRBE_piim(+1)/(GRBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEGR_fx(+1);
// Definition of gx   
// BEGR_gx = BEGR_rer*GRBE_pim*GR_size/BE_size*GRBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(GRBE_piim(+1)/(GRBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEGR_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = GR_pim
// GRBE_pim^(1-BE_thetat) = (1-BE_xix)*GRBE_pimtilde^(1-BE_thetat)+BE_xix*(GRBE_pim(-1)/GR_pic)^(1-BE_thetat)*(GRBE_piim(-1)^BE_chix*GR_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = GR_piim
// GRBE_piim = GRBE_pim/GRBE_pim(-1)*GR_pic;
// Bilateral real exchange rate
BEGR_rer = BE_rer/GR_rer;
// Auxiliary equation for steady-state output
BEGR_rerbar = BEGR_rer;
//Terms of Trade
BEGR_tot = GR_pex*BEGR_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = IT_pimtilde
// ITBE_pimtilde/ITBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEIT_fx/BEIT_gx;
// Definition of fx
// BEIT_fx = IT_size/BE_size*ITBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(ITBE_piim(+1)/(ITBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEIT_fx(+1);
// Definition of gx   
// BEIT_gx = BEIT_rer*ITBE_pim*IT_size/BE_size*ITBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(ITBE_piim(+1)/(ITBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEIT_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = IT_pim
// ITBE_pim^(1-BE_thetat) = (1-BE_xix)*ITBE_pimtilde^(1-BE_thetat)+BE_xix*(ITBE_pim(-1)/IT_pic)^(1-BE_thetat)*(ITBE_piim(-1)^BE_chix*IT_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = IT_piim
// ITBE_piim = ITBE_pim/ITBE_pim(-1)*IT_pic;
// Bilateral real exchange rate
BEIT_rer = BE_rer/IT_rer;
// Auxiliary equation for steady-state output
BEIT_rerbar = BEIT_rer;
//Terms of Trade
BEIT_tot = IT_pex*BEIT_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = NL_pimtilde
// NLBE_pimtilde/NLBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BENL_fx/BENL_gx;
// Definition of fx
// BENL_fx = NL_size/BE_size*NLBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(NLBE_piim(+1)/(NLBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BENL_fx(+1);
// Definition of gx   
// BENL_gx = BENL_rer*NLBE_pim*NL_size/BE_size*NLBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(NLBE_piim(+1)/(NLBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BENL_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = NL_pim
// NLBE_pim^(1-BE_thetat) = (1-BE_xix)*NLBE_pimtilde^(1-BE_thetat)+BE_xix*(NLBE_pim(-1)/NL_pic)^(1-BE_thetat)*(NLBE_piim(-1)^BE_chix*NL_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = NL_piim
// NLBE_piim = NLBE_pim/NLBE_pim(-1)*NL_pic;
// Bilateral real exchange rate
BENL_rer = BE_rer/NL_rer;
// Auxiliary equation for steady-state output
BENL_rerbar = BENL_rer;
//Terms of Trade
BENL_tot = NL_pex*BENL_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = PT_pimtilde
// PTBE_pimtilde/PTBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEPT_fx/BEPT_gx;
// Definition of fx
// BEPT_fx = PT_size/BE_size*PTBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(PTBE_piim(+1)/(PTBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEPT_fx(+1);
// Definition of gx   
// BEPT_gx = BEPT_rer*PTBE_pim*PT_size/BE_size*PTBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(PTBE_piim(+1)/(PTBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEPT_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = PT_pim
// PTBE_pim^(1-BE_thetat) = (1-BE_xix)*PTBE_pimtilde^(1-BE_thetat)+BE_xix*(PTBE_pim(-1)/PT_pic)^(1-BE_thetat)*(PTBE_piim(-1)^BE_chix*PT_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = PT_piim
// PTBE_piim = PTBE_pim/PTBE_pim(-1)*PT_pic;
// Bilateral real exchange rate
BEPT_rer = BE_rer/PT_rer;
// Auxiliary equation for steady-state output
BEPT_rerbar = BEPT_rer;
//Terms of Trade
BEPT_tot = PT_pex*BEPT_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = DE_pimtilde
// DEBE_pimtilde/DEBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEDE_fx/BEDE_gx;
// Definition of fx
// BEDE_fx = DE_size/BE_size*DEBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(DEBE_piim(+1)/(DEBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEDE_fx(+1);
// Definition of gx   
// BEDE_gx = BEDE_rer*DEBE_pim*DE_size/BE_size*DEBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(DEBE_piim(+1)/(DEBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEDE_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = DE_pim
// DEBE_pim^(1-BE_thetat) = (1-BE_xix)*DEBE_pimtilde^(1-BE_thetat)+BE_xix*(DEBE_pim(-1)/DE_pic)^(1-BE_thetat)*(DEBE_piim(-1)^BE_chix*DE_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = DE_piim
// DEBE_piim = DEBE_pim/DEBE_pim(-1)*DE_pic;
// Bilateral real exchange rate
BEDE_rer = BE_rer/DE_rer;
// Auxiliary equation for steady-state output
BEDE_rerbar = BEDE_rer;
//Terms of Trade
BEDE_tot = DE_pex*BEDE_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = RU_pimtilde
// RUBE_pimtilde/RUBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BERU_fx/BERU_gx;
// Definition of fx
// BERU_fx = RU_size/BE_size*RUBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(RUBE_piim(+1)/(RUBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BERU_fx(+1);
// Definition of gx   
// BERU_gx = BERU_rer*RUBE_pim*RU_size/BE_size*RUBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(RUBE_piim(+1)/(RUBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BERU_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = RU_pim
// RUBE_pim^(1-BE_thetat) = (1-BE_xix)*RUBE_pimtilde^(1-BE_thetat)+BE_xix*(RUBE_pim(-1)/RU_pic)^(1-BE_thetat)*(RUBE_piim(-1)^BE_chix*RU_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = RU_piim
// RUBE_piim = RUBE_pim/RUBE_pim(-1)*RU_pic;
// Bilateral real exchange rate
BERU_rer = BE_rer/RU_rer;
// Auxiliary equation for steady-state output
BERU_rerbar = BERU_rer;
//Terms of Trade
BERU_tot = RU_pex*BERU_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = RW_pimtilde
// RWBE_pimtilde/RWBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BERW_fx/BERW_gx;
// Definition of fx
// BERW_fx = RW_size/BE_size*RWBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(RWBE_piim(+1)/(RWBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BERW_fx(+1);
// Definition of gx   
// BERW_gx = BERW_rer*RWBE_pim*RW_size/BE_size*RWBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(RWBE_piim(+1)/(RWBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BERW_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = RW_pim
// RWBE_pim^(1-BE_thetat) = (1-BE_xix)*RWBE_pimtilde^(1-BE_thetat)+BE_xix*(RWBE_pim(-1)/RW_pic)^(1-BE_thetat)*(RWBE_piim(-1)^BE_chix*RW_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = RW_piim
// RWBE_piim = RWBE_pim/RWBE_pim(-1)*RW_pic;
// Bilateral real exchange rate
BERW_rer = BE_rer/RW_rer;
// Auxiliary equation for steady-state output
BERW_rerbar = BERW_rer;
//Terms of Trade
BERW_tot = RW_pex*BERW_rer/BE_pex;
// Optimal price contract set in foreign markets (FOC), using BE_pxtilde = US_pimtilde
// USBE_pimtilde/USBE_pim = BE_cpim*BE_thetat/(BE_thetat-1)*BEUS_fx/BEUS_gx;
// Definition of fx
// BEUS_fx = US_size/BE_size*USBE_im*BE_mct+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(USBE_piim(+1)/(USBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BEUS_fx(+1);
// Definition of gx   
// BEUS_gx = BEUS_rer*USBE_pim*US_size/BE_size*USBE_im+BE_xix*BE_beta*BE_lambdai(+1)/BE_lambdai*(USBE_piim(+1)/(USBE_piim^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^(BE_thetat-1)*BEUS_gx(+1);
// Aggregate intermediate-good price dynamics, using BE_px = US_pim
// USBE_pim^(1-BE_thetat) = (1-BE_xix)*USBE_pimtilde^(1-BE_thetat)+BE_xix*(USBE_pim(-1)/US_pic)^(1-BE_thetat)*(USBE_piim(-1)^BE_chix*US_pi4target^(1/4*(1-BE_chih)))^(1-BE_thetat);
// Intermediate-good price inflation, using BE_pix = US_piim
// USBE_piim = USBE_pim/USBE_pim(-1)*US_pic;
// Bilateral real exchange rate
BEUS_rer = BE_rer/US_rer;
// Auxiliary equation for steady-state output
BEUS_rerbar = BEUS_rer;
//Terms of Trade
BEUS_tot = US_pex*BEUS_rer/BE_pex;
// Total imports 
BE_im = 
+BE_imc
+BE_imi
+BE_imcg
+BE_imig
;
// Total import deflator
BE_im*BE_pim  = 
+BE_pimc*BE_imc
+BE_pimi*BE_imi
+BE_pimcg*BE_imcg
+BE_pimig*BE_imig
;
// Effective real exchange rate: double weighting (imports)
BERA_weightim = BERA_rer*RA_pex*BERA_im/(BE_pim*BE_im);
// Effective real exchange rate: double weighting (exports)
BERA_weightex = RA_size/BE_size*RABE_im/BE_ex*BERA_rer*RA_py*RA_y/(BERA_rer*RA_py*RA_y
+BEAT_rer*AT_pex*RAAT_im
+BEES_rer*ES_pex*RAES_im
+BEFI_rer*FI_pex*RAFI_im
+BEFR_rer*FR_pex*RAFR_im
+BEGR_rer*GR_pex*RAGR_im
+BEIT_rer*IT_pex*RAIT_im
+BENL_rer*NL_pex*RANL_im
