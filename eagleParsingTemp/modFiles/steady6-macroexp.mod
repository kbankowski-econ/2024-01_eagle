// Effective real exchange rate: double weighting (overall)
FIUS_weight = FI_pim*FI_im/(FI_pim*FI_im+FI_pex*FI_ex)*FIUS_weightim+FI_pex*FI_ex/(FI_pim*FI_im+FI_pex*FI_ex)*FIUS_weightex;
// Effective real exchange rate
FI_reer = 1
*FIRA_rer^FIRA_weight
*FIAT_rer^FIAT_weight
*FIBE_rer^FIBE_weight
*FIES_rer^FIES_weight
*FIFR_rer^FIFR_weight
*FIGR_rer^FIGR_weight
*FIIT_rer^FIIT_weight
*FINL_rer^FINL_weight
*FIPT_rer^FIPT_weight
*FIDE_rer^FIDE_weight
*FIRU_rer^FIRU_weight
*FIRW_rer^FIRW_weight
*FIUS_rer^FIUS_weight
;
// Effective terms of trade
FI_etot = 1
*FIRA_tot^FIRA_weight
*FIAT_tot^FIAT_weight
*FIBE_tot^FIBE_weight
*FIES_tot^FIES_weight
*FIFR_tot^FIFR_weight
*FIGR_tot^FIGR_weight
*FIIT_tot^FIIT_weight
*FINL_tot^FINL_weight
*FIPT_tot^FIPT_weight
*FIDE_tot^FIDE_weight
*FIRU_tot^FIRU_weight
*FIRW_tot^FIRW_weight
*FIUS_tot^FIUS_weight
;
//-----------------
// Final-good firms
//-----------------
// Private consumption good (import)
FI_imc^((FI_mumc-1)/FI_mumc) =
+FIRA_numc ^(1/FI_mumc)*FIRA_imc^(1-1/FI_mumc)
+FIAT_numc ^(1/FI_mumc)*FIAT_imc^(1-1/FI_mumc)
+FIES_numc ^(1/FI_mumc)*FIES_imc^(1-1/FI_mumc)
