PTRU_gammaimcgdag = 1;
PTRW_gammaimcg = 0;
PTRW_gammaimcgdag = 1;
PTUS_gammaimcg = 0;
PTUS_gammaimcgdag = 1;
// Private consumption good (tradable)
PT_ttig^((PT_mutig-1)/PT_mutig) = (PT_nutig)^(1/PT_mutig)*PT_htig^(1-1/PT_mutig)+(1-PT_nutig)^(1/PT_mutig)*PT_imig^(1-1/PT_mutig);
// Private consumption good  (total)
PT_qig^((PT_muig-1)/PT_muig) = (PT_nuig)^(1/PT_muig)*PT_ttig^(1-1/PT_muig)+(1-PT_nuig)^(1/PT_muig)*PT_ntig^(1-1/PT_muig);
// Demand for domestic intermediate goods - NONTRADABLE
PT_ntig = (1-PT_nuig)*(PT_pnt/PT_pig)^(-PT_muig)*PT_qig;
// Price of the consumption good (tradable)  
PT_pttig^(1-PT_mutig) = (PT_nutig)*PT_pht^(1-PT_mutig)+(1-PT_nutig)*PT_pimig^(1-PT_mutig);
// Price of the consumption good 
PT_pig^(1-PT_muig) = (PT_nuig)*PT_pttig^(1-PT_muig)+(1-PT_nuig)*PT_pnt^(1-PT_muig);
// Demand for domestic intermediate goods
PT_htig = PT_nutig*(PT_pht/PT_pttig)^(-PT_mutig)*PT_ttig;
PTRA_gammaimig = 0;
PTRA_gammaimigdag = 1;
PTAT_gammaimig = 0;
PTAT_gammaimigdag = 1;
PTBE_gammaimig = 0;
