;
// Effective real exchange rate: double weighting (overall)
DERA_weight = DE_pim*DE_im/(DE_pim*DE_im+DE_pex*DE_ex)*DERA_weightim+DE_pex*DE_ex/(DE_pim*DE_im+DE_pex*DE_ex)*DERA_weightex;
// Effective real exchange rate: double weighting (imports)
DEAT_weightim = DEAT_rer*AT_pex*DEAT_im/(DE_pim*DE_im);
