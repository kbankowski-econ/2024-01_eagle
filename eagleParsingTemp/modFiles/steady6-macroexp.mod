+FIRU_rer*RU_pex*USRU_im
+FIRW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
FIRW_weight = FI_pim*FI_im/(FI_pim*FI_im+FI_pex*FI_ex)*FIRW_weightim+FI_pex*FI_ex/(FI_pim*FI_im+FI_pex*FI_ex)*FIRW_weightex;
// Effective real exchange rate: double weighting (imports)
FIUS_weightim = FIUS_rer*US_pex*FIUS_im/(FI_pim*FI_im);
// Effective real exchange rate: double weighting (exports)
FIUS_weightex = US_size/FI_size*USFI_im/FI_ex*FIUS_rer*US_py*US_y/(FIUS_rer*US_py*US_y
+FIRA_rer*RA_pex*USRA_im
+FIAT_rer*AT_pex*USAT_im
