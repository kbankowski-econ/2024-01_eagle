;
GRFI_im = 
+GRFI_imc
+GRFI_imi
+GRFI_imcg
+GRFI_imig
;
GRFR_im = 
+GRFR_imc
+GRFR_imi
+GRFR_imcg
+GRFR_imig
;
GRIT_im = 
+GRIT_imc
+GRIT_imi
+GRIT_imcg
+GRIT_imig
;
GRNL_im = 
+GRNL_imc
+GRNL_imi
+GRNL_imcg
+GRNL_imig
;
GRPT_im = 
+GRPT_imc
+GRPT_imi
+GRPT_imcg
+GRPT_imig
;
GRDE_im = 
+GRDE_imc
+GRDE_imi
+GRDE_imcg
+GRDE_imig
;
GRRU_im = 
+GRRU_imc
+GRRU_imi
+GRRU_imcg
+GRRU_imig
;
GRRW_im = 
+GRRW_imc
+GRRW_imi
+GRRW_imcg
+GRRW_imig
;
GRUS_im = 
+GRUS_imc
+GRUS_imi
+GRUS_imcg
+GRUS_imig
;
// Private consumption good firm
// Private consumption good (tradable)
GR_ttc^((GR_mutc-1)/GR_mutc) = (GR_nutc)^(1/GR_mutc)*GR_htc^(1-1/GR_mutc)+(1-GR_nutc)^(1/GR_mutc)*GR_imc^(1-1/GR_mutc);
// Private consumption good  (total)
GR_qc^((GR_muc-1)/GR_muc) = (GR_nuc)^(1/GR_muc)*GR_ttc^(1-1/GR_muc)+(1-GR_nuc)^(1/GR_muc)*GR_ntc^(1-1/GR_muc);
// Demand for domestic intermediate goods - NONTRADABLE
GR_ntc = (1-GR_nuc)*(GR_pnt)^(-GR_muc)*GR_qc;
// Price of the consumption good (tradable)  
GR_pttc^(1-GR_mutc) = (GR_nutc)*GR_pht^(1-GR_mutc)+(1-GR_nutc)*GR_pimc^(1-GR_mutc);
// Price of the consumption good 
1^(1-GR_muc) = (GR_nuc)*GR_pttc^(1-GR_muc)+(1-GR_nuc)*GR_pnt^(1-GR_muc);
// Demand for domestic intermediate goods
GR_htc = GR_nutc*(GR_pht/GR_pttc)^(-GR_mutc)*GR_ttc;
GRRA_gammaimc = 0;
GRRA_gammaimcdag = 1;
GRAT_gammaimc = 0;
GRAT_gammaimcdag = 1;
GRBE_gammaimc = 0;
GRBE_gammaimcdag = 1;
GRES_gammaimc = 0;
GRES_gammaimcdag = 1;
GRFI_gammaimc = 0;
GRFI_gammaimcdag = 1;
GRFR_gammaimc = 0;
GRFR_gammaimcdag = 1;
GRIT_gammaimc = 0;
GRIT_gammaimcdag = 1;
GRNL_gammaimc = 0;
GRNL_gammaimcdag = 1;
GRPT_gammaimc = 0;
GRPT_gammaimcdag = 1;
GRDE_gammaimc = 0;
GRDE_gammaimcdag = 1;
GRRU_gammaimc = 0;
GRRU_gammaimcdag = 1;
GRRW_gammaimc = 0;
GRRW_gammaimcdag = 1;
GRUS_gammaimc = 0;
GRUS_gammaimcdag = 1;
// Private consumption good (tradable)
GR_tti^((GR_muti-1)/GR_muti) = (GR_nuti)^(1/GR_muti)*GR_hti^(1-1/GR_muti)+(1-GR_nuti)^(1/GR_muti)*GR_imi^(1-1/GR_muti);
// Private consumption good  (total)
GR_qi^((GR_mui-1)/GR_mui) = (GR_nui)^(1/GR_mui)*GR_tti^(1-1/GR_mui)+(1-GR_nui)^(1/GR_mui)*GR_nti^(1-1/GR_mui);
// Demand for domestic intermediate goods - NONTRADABLE
GR_nti = (1-GR_nui)*(GR_pnt/GR_pi)^(-GR_mui)*GR_qi;
// Price of the consumption good (tradable)  
GR_ptti^(1-GR_muti) = (GR_nuti)*GR_pht^(1-GR_muti)+(1-GR_nuti)*GR_pimi^(1-GR_muti);
// Price of the consumption good 
GR_pi^(1-GR_mui) = (GR_nui)*GR_ptti^(1-GR_mui)+(1-GR_nui)*GR_pnt^(1-GR_mui);
// Auxiliary equation for the price of the investment good in steady state
// this only appears in the capacity utilisation cost; not needed for consumption where it is one by assumption; neither for gov demand components where there is no adjustment cost
GR_pibar = GR_pi;
// Demand for domestic intermediate goods
GR_hti = GR_nuti*(GR_pht/GR_ptti)^(-GR_muti)*GR_tti;
GRRA_gammaimi = 0;
GRRA_gammaimidag = 1;
GRAT_gammaimi = 0;
GRAT_gammaimidag = 1;
GRBE_gammaimi = 0;
GRBE_gammaimidag = 1;
GRES_gammaimi = 0;
GRES_gammaimidag = 1;
GRFI_gammaimi = 0;
GRFI_gammaimidag = 1;
GRFR_gammaimi = 0;
GRFR_gammaimidag = 1;
GRIT_gammaimi = 0;
GRIT_gammaimidag = 1;
GRNL_gammaimi = 0;
GRNL_gammaimidag = 1;
GRPT_gammaimi = 0;
GRPT_gammaimidag = 1;
GRDE_gammaimi = 0;
GRDE_gammaimidag = 1;
GRRU_gammaimi = 0;
GRRU_gammaimidag = 1;
GRRW_gammaimi = 0;
GRRW_gammaimidag = 1;
GRUS_gammaimi = 0;
GRUS_gammaimidag = 1;
// Private consumption good (tradable)
GR_ttcg^((GR_mutcg-1)/GR_mutcg) = (GR_nutcg)^(1/GR_mutcg)*GR_htcg^(1-1/GR_mutcg)+(1-GR_nutcg)^(1/GR_mutcg)*GR_imcg^(1-1/GR_mutcg);
// Private consumption good  (total)
GR_qcg^((GR_mucg-1)/GR_mucg) = (GR_nucg)^(1/GR_mucg)*GR_ttcg^(1-1/GR_mucg)+(1-GR_nucg)^(1/GR_mucg)*GR_ntcg^(1-1/GR_mucg);
// Demand for domestic intermediate goods - NONTRADABLE
GR_ntcg = (1-GR_nucg)*(GR_pnt/GR_pcg)^(-GR_mucg)*GR_qcg;
// Price of the consumption good (tradable)  
GR_pttcg^(1-GR_mutcg) = (GR_nutcg)*GR_pht^(1-GR_mutcg)+(1-GR_nutcg)*GR_pimcg^(1-GR_mutcg);
// Price of the consumption good 
GR_pcg^(1-GR_mucg) = (GR_nucg)*GR_pttcg^(1-GR_mucg)+(1-GR_nucg)*GR_pnt^(1-GR_mucg);
// Demand for domestic intermediate goods
GR_htcg = GR_nutcg*(GR_pht/GR_pttcg)^(-GR_mutcg)*GR_ttcg;
GRRA_gammaimcg = 0;
GRRA_gammaimcgdag = 1;
GRAT_gammaimcg = 0;
GRAT_gammaimcgdag = 1;
GRBE_gammaimcg = 0;
GRBE_gammaimcgdag = 1;
GRES_gammaimcg = 0;
GRES_gammaimcgdag = 1;
GRFI_gammaimcg = 0;
GRFI_gammaimcgdag = 1;
GRFR_gammaimcg = 0;
GRFR_gammaimcgdag = 1;
GRIT_gammaimcg = 0;
GRIT_gammaimcgdag = 1;
GRNL_gammaimcg = 0;
GRNL_gammaimcgdag = 1;
GRPT_gammaimcg = 0;
GRPT_gammaimcgdag = 1;
GRDE_gammaimcg = 0;
GRDE_gammaimcgdag = 1;
GRRU_gammaimcg = 0;
GRRU_gammaimcgdag = 1;
GRRW_gammaimcg = 0;
GRRW_gammaimcgdag = 1;
GRUS_gammaimcg = 0;
GRUS_gammaimcgdag = 1;
// Private consumption good (tradable)
GR_ttig^((GR_mutig-1)/GR_mutig) = (GR_nutig)^(1/GR_mutig)*GR_htig^(1-1/GR_mutig)+(1-GR_nutig)^(1/GR_mutig)*GR_imig^(1-1/GR_mutig);
// Private consumption good  (total)
GR_qig^((GR_muig-1)/GR_muig) = (GR_nuig)^(1/GR_muig)*GR_ttig^(1-1/GR_muig)+(1-GR_nuig)^(1/GR_muig)*GR_ntig^(1-1/GR_muig);
// Demand for domestic intermediate goods - NONTRADABLE
GR_ntig = (1-GR_nuig)*(GR_pnt/GR_pig)^(-GR_muig)*GR_qig;
// Price of the consumption good (tradable)  
GR_pttig^(1-GR_mutig) = (GR_nutig)*GR_pht^(1-GR_mutig)+(1-GR_nutig)*GR_pimig^(1-GR_mutig);
// Price of the consumption good 
GR_pig^(1-GR_muig) = (GR_nuig)*GR_pttig^(1-GR_muig)+(1-GR_nuig)*GR_pnt^(1-GR_muig);
// Demand for domestic intermediate goods
GR_htig = GR_nutig*(GR_pht/GR_pttig)^(-GR_mutig)*GR_ttig;
GRRA_gammaimig = 0;
GRRA_gammaimigdag = 1;
GRAT_gammaimig = 0;
GRAT_gammaimigdag = 1;
GRBE_gammaimig = 0;
GRBE_gammaimigdag = 1;
GRES_gammaimig = 0;
GRES_gammaimigdag = 1;
GRFI_gammaimig = 0;
GRFI_gammaimigdag = 1;
GRFR_gammaimig = 0;
GRFR_gammaimigdag = 1;
GRIT_gammaimig = 0;
GRIT_gammaimigdag = 1;
GRNL_gammaimig = 0;
GRNL_gammaimigdag = 1;
GRPT_gammaimig = 0;
GRPT_gammaimigdag = 1;
GRDE_gammaimig = 0;
GRDE_gammaimigdag = 1;
GRRU_gammaimig = 0;
GRRU_gammaimigdag = 1;
GRRW_gammaimig = 0;
GRRW_gammaimigdag = 1;
GRUS_gammaimig = 0;
GRUS_gammaimigdag = 1;
// Trade balance
GR_tb =
+GR_pex*RA_size/GR_size*RAGR_im
-RA_pex*GRRA_rer*GRRA_im
+GR_pex*AT_size/GR_size*ATGR_im
-AT_pex*GRAT_rer*GRAT_im
+GR_pex*BE_size/GR_size*BEGR_im
-BE_pex*GRBE_rer*GRBE_im
+GR_pex*ES_size/GR_size*ESGR_im
-ES_pex*GRES_rer*GRES_im
+GR_pex*FI_size/GR_size*FIGR_im
-FI_pex*GRFI_rer*GRFI_im
+GR_pex*FR_size/GR_size*FRGR_im
-FR_pex*GRFR_rer*GRFR_im
+GR_pex*IT_size/GR_size*ITGR_im
-IT_pex*GRIT_rer*GRIT_im
+GR_pex*NL_size/GR_size*NLGR_im
-NL_pex*GRNL_rer*GRNL_im
+GR_pex*PT_size/GR_size*PTGR_im
-PT_pex*GRPT_rer*GRPT_im
+GR_pex*DE_size/GR_size*DEGR_im
-DE_pex*GRDE_rer*GRDE_im
+GR_pex*RU_size/GR_size*RUGR_im
-RU_pex*GRRU_rer*GRRU_im
+GR_pex*RW_size/GR_size*RWGR_im
-RW_pex*GRRW_rer*GRRW_im
+GR_pex*US_size/GR_size*USGR_im
-US_pex*GRUS_rer*GRUS_im
;
// Aggregate exports (volume)
GR_ex =
+RA_size/GR_size*RAGR_im
+AT_size/GR_size*ATGR_im
+BE_size/GR_size*BEGR_im
+ES_size/GR_size*ESGR_im
+FI_size/GR_size*FIGR_im
+FR_size/GR_size*FRGR_im
+IT_size/GR_size*ITGR_im
+NL_size/GR_size*NLGR_im
+PT_size/GR_size*PTGR_im
+DE_size/GR_size*DEGR_im
+RU_size/GR_size*RUGR_im
+RW_size/GR_size*RWGR_im
+US_size/GR_size*USGR_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using GR_pg = GR_pht
// TODO: check the (1-GR_gammab(-1)) adjustment here, which is not in the fiscal extention
	GR_pcg(-1)*GR_cg(-1)+GR_pig(-1)*GR_ig(-1)+GR_tr(-1)
	+GR_b(-1)*GR_pic(-1)^(-1)+GR_m(-2)*GR_pic(-1)^(-1) = GR_tauc(-1)*GR_c(-1)+(GR_taun(-1)+GR_tauwh(-1))*(GR_wi(-1)*GR_ndi(-1)+GR_wj(-1)*GR_ndj(-1))+GR_tauwf(-1)*GR_w(-1)*GR_nd(-1)+GR_tauk(-1)*(GR_rk(-1)*GR_u(-1)-(GR_gammau(-1)+GR_delta)*GR_pi(-1))*GR_k(-1)+GR_taud(-1)*GR_d(-1)+GR_t(-1)+(GR_r(-1)*(1-GR_gammab(-1)))^(-1)*GR_b+GR_m(-1);
// Government spending, using GR_pg = GR_pht
GR_pcg*GR_cg = GR_cgy*GR_pybar*GR_ybar;
GR_pig*GR_ig = GR_igy*GR_pybar*GR_ybar;
GR_t = 0;
GR_b = GR_bytarget*GR_pybar*GR_ybar;
// Auxiliary equation for steady-state output
GR_ybar = GR_y;
// Auxiliary equation for steady-state output
GR_ytbar = GR_yst;
// Auxiliary equation for steady-state output
GR_ynbar = GR_ysn;
// Auxiliary equation for steady-state output deflator
GR_pybar = GR_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
GR_trybar = GR_tr/(GR_pybar*GR_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
GR_ti = GR_upsilont*GR_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
GR_tri = GR_upsilontr*GR_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	GR_r = DE_r;
GR_pic4 = GR_pi4target;
GR_rr-1 = GR_r/GR_pi4target^(1/4)-1;
// Equilibrium real interest rate
GR_rrstar-1 = 1/GR_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
GR_c = (1-GR_omega)*GR_ci+GR_omega*GR_cj;
// Aggregate money holdings
GR_m = (1-GR_omega)*GR_mi+GR_omega*GR_mj;
// Aggregate capital stock
GR_k = (1-GR_omega)*GR_ki;
// Aggregate investment
GR_i = (1-GR_omega)*GR_ii;
// Aggregate lump-sum transfers
GR_trj = 
1/GR_omega*GR_tr-(1-GR_omega)/GR_omega*GR_tri
;
// Aggregate lump-sum taxes
GR_tj = 
1/GR_omega*GR_t-(1-GR_omega)/GR_omega*GR_ti
;
// Aggregate transaction costs
GR_gammav = (1-GR_omega)*GR_ci*GR_gammavi+GR_omega*GR_cj*GR_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
GR_ni = GR_si*GR_ndi;
// Wage dispersion
GR_si = (1-GR_xii)*(GR_witilde/GR_wi)^(-GR_etai)+GR_xii*(GR_wi(-1)/GR_wi)^(-GR_etai)*(GR_pic/(GR_pic(-1)^GR_chii*GR_pi4target^(1/4*(1-GR_chii))))^(GR_etai)*GR_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
GR_nj = GR_sj*GR_ndj;
// Wage dispersion
GR_sj = (1-GR_xij)*(GR_wjtilde/GR_wj)^(-GR_etaj)+GR_xij*(GR_wj(-1)/GR_wj)^(-GR_etaj)*(GR_pic/(GR_pic(-1)^GR_chij*GR_pi4target^(1/4*(1-GR_chij))))^(GR_etaj)*GR_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
GR_u*GR_k = GR_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using GR_x = IT_size/GR_size*IT_im
GR_ysn = GR_snt*GR_nt;
//  nontradables aggregate demand
GR_nt = 
+GR_ntc
+GR_nti
+GR_ntcg
+GR_ntig
;
// Aggregate demand for domestic intermediate goods, using GR_hg = GR_cg
GR_ht =
+GR_htc
+GR_hti
+GR_htcg
+GR_htig
;
// Price dispersion in the domestic markets
GR_sh = (1-GR_xih)*(GR_phttilde/GR_pht)^(-GR_thetat)+GR_xih*(GR_piht/(GR_piht(-1)^GR_chih*GR_pi4target^(1/4*(1-GR_chih))))^GR_thetat*GR_sh(-1);
// Price dispersion in the foreign markets
GR_sx = (1-GR_xix)*(GR_pextilde/GR_pex)^(-GR_thetat)+GR_xix*(GR_piex/(GR_piex(-1)^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GR_sx(-1);
// Price dispersion in the domestic markets
GR_snt = (1-GR_xin)*(GR_pnttilde/GR_pnt)^(-GR_thetan)+GR_xin*(GR_pint/(GR_pint(-1)^GR_chin*GR_pi4target^(1/4*(1-GR_chin))))^GR_thetan*GR_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
GR_qc = GR_c+GR_gammav;
// Aggregate investment and capital utilisation cost
GR_qi = GR_i+GR_k*GR_gammau;
// Aggregate gov demand components added to use the same structure like in private components
GR_qcg = GR_cg;
GR_qig = GR_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
GR_py*GR_y = 
+GR_qc
+GR_pi*GR_qi
+GR_pcg*GR_qcg
+GR_pig*GR_qig
+GR_pex*RA_size/GR_size*RAGR_im
-(RA_pex*GRRA_rer)*GRRA_imc
-(RA_pex*GRRA_rer)*GRRA_imi
-(RA_pex*GRRA_rer)*GRRA_imcg
-(RA_pex*GRRA_rer)*GRRA_imig
+GR_pex*AT_size/GR_size*ATGR_im
-(AT_pex*GRAT_rer)*GRAT_imc
-(AT_pex*GRAT_rer)*GRAT_imi
-(AT_pex*GRAT_rer)*GRAT_imcg
-(AT_pex*GRAT_rer)*GRAT_imig
+GR_pex*BE_size/GR_size*BEGR_im
-(BE_pex*GRBE_rer)*GRBE_imc
-(BE_pex*GRBE_rer)*GRBE_imi
-(BE_pex*GRBE_rer)*GRBE_imcg
-(BE_pex*GRBE_rer)*GRBE_imig
+GR_pex*ES_size/GR_size*ESGR_im
-(ES_pex*GRES_rer)*GRES_imc
-(ES_pex*GRES_rer)*GRES_imi
-(ES_pex*GRES_rer)*GRES_imcg
-(ES_pex*GRES_rer)*GRES_imig
+GR_pex*FI_size/GR_size*FIGR_im
-(FI_pex*GRFI_rer)*GRFI_imc
-(FI_pex*GRFI_rer)*GRFI_imi
-(FI_pex*GRFI_rer)*GRFI_imcg
-(FI_pex*GRFI_rer)*GRFI_imig
+GR_pex*FR_size/GR_size*FRGR_im
-(FR_pex*GRFR_rer)*GRFR_imc
-(FR_pex*GRFR_rer)*GRFR_imi
-(FR_pex*GRFR_rer)*GRFR_imcg
-(FR_pex*GRFR_rer)*GRFR_imig
+GR_pex*IT_size/GR_size*ITGR_im
-(IT_pex*GRIT_rer)*GRIT_imc
-(IT_pex*GRIT_rer)*GRIT_imi
-(IT_pex*GRIT_rer)*GRIT_imcg
-(IT_pex*GRIT_rer)*GRIT_imig
+GR_pex*NL_size/GR_size*NLGR_im
-(NL_pex*GRNL_rer)*GRNL_imc
-(NL_pex*GRNL_rer)*GRNL_imi
-(NL_pex*GRNL_rer)*GRNL_imcg
-(NL_pex*GRNL_rer)*GRNL_imig
+GR_pex*PT_size/GR_size*PTGR_im
-(PT_pex*GRPT_rer)*GRPT_imc
-(PT_pex*GRPT_rer)*GRPT_imi
-(PT_pex*GRPT_rer)*GRPT_imcg
-(PT_pex*GRPT_rer)*GRPT_imig
+GR_pex*DE_size/GR_size*DEGR_im
-(DE_pex*GRDE_rer)*GRDE_imc
-(DE_pex*GRDE_rer)*GRDE_imi
-(DE_pex*GRDE_rer)*GRDE_imcg
-(DE_pex*GRDE_rer)*GRDE_imig
+GR_pex*RU_size/GR_size*RUGR_im
-(RU_pex*GRRU_rer)*GRRU_imc
-(RU_pex*GRRU_rer)*GRRU_imi
-(RU_pex*GRRU_rer)*GRRU_imcg
-(RU_pex*GRRU_rer)*GRRU_imig
+GR_pex*RW_size/GR_size*RWGR_im
-(RW_pex*GRRW_rer)*GRRW_imc
-(RW_pex*GRRW_rer)*GRRW_imi
-(RW_pex*GRRW_rer)*GRRW_imcg
-(RW_pex*GRRW_rer)*GRRW_imig
+GR_pex*US_size/GR_size*USGR_im
-(US_pex*GRUS_rer)*GRUS_imc
-(US_pex*GRUS_rer)*GRUS_imi
-(US_pex*GRUS_rer)*GRUS_imcg
-(US_pex*GRUS_rer)*GRUS_imig
;
// Aggregate real demand
GR_y = GR_yst+GR_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(GR_zt) = (1-GR_rhozt)*log(GR_ztbar)+GR_rhozt*log(GR_zt(-1))+GR_epszt;
log(GR_zn) = (1-GR_rhozn)*log(GR_znbar)+GR_rhozn*log(GR_zn(-1))+GR_epszn;
// Government spending shock
GR_cgy = (1-GR_rhocg)*GR_cgybar+GR_rhocg*GR_cgy(-1)+GR_epsgc;
GR_igy = (1-GR_rhoig)*GR_igybar+GR_rhoig*GR_igy(-1)+GR_epsgi;
// Transfer shock
GR_try = (1-GR_rhotr)*GR_trybar+GR_rhotr*GR_try(-1)+GR_epstr;
// Consumption tax shock
GR_tauc = (1-GR_rhotauc)*GR_taucbar+GR_rhotauc*GR_tauc(-1)+GR_epstauc;
// Dividend income tax shock
GR_taud = (1-GR_rhotaud)*GR_taudbar+GR_rhotaud*GR_taud(-1)+GR_epstaud;
// Capital income tax shock
GR_tauk = (1-GR_rhotauk)*GR_taukbar+GR_rhotauk*GR_tauk(-1)+GR_epstauk;
// Labour income tax shock
GR_taun = (1-GR_rhotaun)*GR_taunbar+GR_rhotaun*GR_taun(-1)+GR_epstaun;
// Payroll tax shock: households
GR_tauwh = (1-GR_rhotauwh)*GR_tauwhbar+GR_rhotauwh*GR_tauwh(-1)+GR_epstauwh;
// Payroll tax shock: firms
GR_tauwf = (1-GR_rhotauwf)*GR_tauwfbar+GR_rhotauwf*GR_tauwf(-1)+GR_epstauwf;
// Wage cost push shock
GR_wcst = (1-GR_rhowcst)*GR_wcstbar+GR_rhowcst*GR_wcst(-1)+GR_epswcst;
// Preference shock
log(GR_zcon) = (1-GR_rhozcon)*log(GR_zconbar)+GR_rhozcon*log(GR_zcon(-1))+GR_epszcon;
// Investment specific shock
log(GR_zinv) = (1-GR_rhozinv)*log(GR_zinvbar)+GR_rhozinv*log(GR_zinv(-1))+GR_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
GR_cy = GR_c/(GR_py*GR_y);
// Aggregate nominal investment share
GR_iy = GR_pi*GR_i/(GR_py*GR_y);
// Aggregate nominal import share  
GR_imy = (
+GR_pimc*GR_imc
+GR_pimi*GR_imi
+GR_pimcg*GR_imcg
+GR_pimig*GR_imig
)/(GR_py*GR_y);
// Aggregate nominal import share
GR_imcy = GR_pimc*GR_imc/(GR_py*GR_y);
GR_imiy = GR_pimi*GR_imi/(GR_py*GR_y);
GR_imcgy = GR_pimcg*GR_imcg/(GR_py*GR_y);
GR_imigy = GR_pimig*GR_imig/(GR_py*GR_y);
// Aggregate debt-to-output ratio
GR_by = GR_b/(GR_pybar*GR_ybar);
// Aggregate lump-sum tax-to-output ratio
GR_ty = GR_t/(GR_pybar*GR_ybar);
// Aggregate labour cost share
GR_lcy = ((1+GR_tauwf)*GR_w*GR_nd)/(GR_py*GR_y);
// Aggregate nominal Wage share
GR_wy = (GR_w*GR_nd)/(GR_py*GR_y);
// NT sector nominal Wage share
GR_wnty = (GR_w*GR_ndn)/(GR_pnt*GR_ysn);
// T sector nominal Wage share
GR_whty = (GR_w*GR_ndt)/(GR_pht*GR_yst);
// T sector share
GR_yhty = GR_pht*GR_yst/(GR_py*GR_y);
// NT sector share
GR_ynty = GR_pnt*GR_ysn/(GR_py*GR_y);
// Output gap
GR_ygap = 0;
// Output growth (gross rate)
GR_ygrowth = GR_y/GR_y(-1);
// Output growth (gross rate yoy)
GR_ygrowth4 = GR_y/GR_y(-4);
// Domestic nominal output as a share of world nominal output
GR_yshare  = GR_size*GR_py*GR_y/GR_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
GR_epsilonm = -1/8*1/(GR_r*(GR_gammav2*GR_r+GR_r-1));
// Trade balance-to-GDP ratio
GR_tby = GR_tb/(GR_py*GR_y);
// Bilateral shares
GRRA_imcy = (RA_pex*GRRA_rer)*GRRA_imc/(GR_py*GR_y);
GRRA_imiy = (RA_pex*GRRA_rer)*GRRA_imi/(GR_py*GR_y);
GRRA_imcgy = (RA_pex*GRRA_rer)*GRRA_imcg/(GR_py*GR_y);
GRRA_imigy = (RA_pex*GRRA_rer)*GRRA_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRRA_excy  = RA_size/GR_size*GR_pex*RAGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRRA_exiy  = RA_size/GR_size*GR_pex*RAGR_imi/(GR_py*GR_y);
// Bilateral shares
GRAT_imcy = (AT_pex*GRAT_rer)*GRAT_imc/(GR_py*GR_y);
GRAT_imiy = (AT_pex*GRAT_rer)*GRAT_imi/(GR_py*GR_y);
GRAT_imcgy = (AT_pex*GRAT_rer)*GRAT_imcg/(GR_py*GR_y);
GRAT_imigy = (AT_pex*GRAT_rer)*GRAT_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRAT_excy  = AT_size/GR_size*GR_pex*ATGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRAT_exiy  = AT_size/GR_size*GR_pex*ATGR_imi/(GR_py*GR_y);
// Bilateral shares
GRBE_imcy = (BE_pex*GRBE_rer)*GRBE_imc/(GR_py*GR_y);
GRBE_imiy = (BE_pex*GRBE_rer)*GRBE_imi/(GR_py*GR_y);
GRBE_imcgy = (BE_pex*GRBE_rer)*GRBE_imcg/(GR_py*GR_y);
GRBE_imigy = (BE_pex*GRBE_rer)*GRBE_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRBE_excy  = BE_size/GR_size*GR_pex*BEGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRBE_exiy  = BE_size/GR_size*GR_pex*BEGR_imi/(GR_py*GR_y);
// Bilateral shares
GRES_imcy = (ES_pex*GRES_rer)*GRES_imc/(GR_py*GR_y);
GRES_imiy = (ES_pex*GRES_rer)*GRES_imi/(GR_py*GR_y);
GRES_imcgy = (ES_pex*GRES_rer)*GRES_imcg/(GR_py*GR_y);
GRES_imigy = (ES_pex*GRES_rer)*GRES_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRES_excy  = ES_size/GR_size*GR_pex*ESGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRES_exiy  = ES_size/GR_size*GR_pex*ESGR_imi/(GR_py*GR_y);
// Bilateral shares
GRFI_imcy = (FI_pex*GRFI_rer)*GRFI_imc/(GR_py*GR_y);
GRFI_imiy = (FI_pex*GRFI_rer)*GRFI_imi/(GR_py*GR_y);
GRFI_imcgy = (FI_pex*GRFI_rer)*GRFI_imcg/(GR_py*GR_y);
GRFI_imigy = (FI_pex*GRFI_rer)*GRFI_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRFI_excy  = FI_size/GR_size*GR_pex*FIGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRFI_exiy  = FI_size/GR_size*GR_pex*FIGR_imi/(GR_py*GR_y);
// Bilateral shares
GRFR_imcy = (FR_pex*GRFR_rer)*GRFR_imc/(GR_py*GR_y);
GRFR_imiy = (FR_pex*GRFR_rer)*GRFR_imi/(GR_py*GR_y);
GRFR_imcgy = (FR_pex*GRFR_rer)*GRFR_imcg/(GR_py*GR_y);
GRFR_imigy = (FR_pex*GRFR_rer)*GRFR_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRFR_excy  = FR_size/GR_size*GR_pex*FRGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRFR_exiy  = FR_size/GR_size*GR_pex*FRGR_imi/(GR_py*GR_y);
// Bilateral shares
GRIT_imcy = (IT_pex*GRIT_rer)*GRIT_imc/(GR_py*GR_y);
GRIT_imiy = (IT_pex*GRIT_rer)*GRIT_imi/(GR_py*GR_y);
GRIT_imcgy = (IT_pex*GRIT_rer)*GRIT_imcg/(GR_py*GR_y);
GRIT_imigy = (IT_pex*GRIT_rer)*GRIT_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRIT_excy  = IT_size/GR_size*GR_pex*ITGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRIT_exiy  = IT_size/GR_size*GR_pex*ITGR_imi/(GR_py*GR_y);
// Bilateral shares
GRNL_imcy = (NL_pex*GRNL_rer)*GRNL_imc/(GR_py*GR_y);
GRNL_imiy = (NL_pex*GRNL_rer)*GRNL_imi/(GR_py*GR_y);
GRNL_imcgy = (NL_pex*GRNL_rer)*GRNL_imcg/(GR_py*GR_y);
GRNL_imigy = (NL_pex*GRNL_rer)*GRNL_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRNL_excy  = NL_size/GR_size*GR_pex*NLGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRNL_exiy  = NL_size/GR_size*GR_pex*NLGR_imi/(GR_py*GR_y);
// Bilateral shares
GRPT_imcy = (PT_pex*GRPT_rer)*GRPT_imc/(GR_py*GR_y);
GRPT_imiy = (PT_pex*GRPT_rer)*GRPT_imi/(GR_py*GR_y);
GRPT_imcgy = (PT_pex*GRPT_rer)*GRPT_imcg/(GR_py*GR_y);
GRPT_imigy = (PT_pex*GRPT_rer)*GRPT_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRPT_excy  = PT_size/GR_size*GR_pex*PTGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRPT_exiy  = PT_size/GR_size*GR_pex*PTGR_imi/(GR_py*GR_y);
// Bilateral shares
GRDE_imcy = (DE_pex*GRDE_rer)*GRDE_imc/(GR_py*GR_y);
GRDE_imiy = (DE_pex*GRDE_rer)*GRDE_imi/(GR_py*GR_y);
GRDE_imcgy = (DE_pex*GRDE_rer)*GRDE_imcg/(GR_py*GR_y);
GRDE_imigy = (DE_pex*GRDE_rer)*GRDE_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRDE_excy  = DE_size/GR_size*GR_pex*DEGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRDE_exiy  = DE_size/GR_size*GR_pex*DEGR_imi/(GR_py*GR_y);
// Bilateral shares
GRRU_imcy = (RU_pex*GRRU_rer)*GRRU_imc/(GR_py*GR_y);
GRRU_imiy = (RU_pex*GRRU_rer)*GRRU_imi/(GR_py*GR_y);
GRRU_imcgy = (RU_pex*GRRU_rer)*GRRU_imcg/(GR_py*GR_y);
GRRU_imigy = (RU_pex*GRRU_rer)*GRRU_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRRU_excy  = RU_size/GR_size*GR_pex*RUGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRRU_exiy  = RU_size/GR_size*GR_pex*RUGR_imi/(GR_py*GR_y);
// Bilateral shares
GRRW_imcy = (RW_pex*GRRW_rer)*GRRW_imc/(GR_py*GR_y);
GRRW_imiy = (RW_pex*GRRW_rer)*GRRW_imi/(GR_py*GR_y);
GRRW_imcgy = (RW_pex*GRRW_rer)*GRRW_imcg/(GR_py*GR_y);
GRRW_imigy = (RW_pex*GRRW_rer)*GRRW_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRRW_excy  = RW_size/GR_size*GR_pex*RWGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRRW_exiy  = RW_size/GR_size*GR_pex*RWGR_imi/(GR_py*GR_y);
// Bilateral shares
GRUS_imcy = (US_pex*GRUS_rer)*GRUS_imc/(GR_py*GR_y);
GRUS_imiy = (US_pex*GRUS_rer)*GRUS_imi/(GR_py*GR_y);
GRUS_imcgy = (US_pex*GRUS_rer)*GRUS_imcg/(GR_py*GR_y);
GRUS_imigy = (US_pex*GRUS_rer)*GRUS_imig/(GR_py*GR_y);
// Exports of consumption goods to gdp
GRUS_excy  = US_size/GR_size*GR_pex*USGR_imc/(GR_py*GR_y);
// Exports of investment goods to gdp
GRUS_exiy  = US_size/GR_size*GR_pex*USGR_imi/(GR_py*GR_y);
// Internal real exchange rate
GR_internalrer = GR_pnt/GR_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
IT_ccesi^(1-1/IT_mucces) = (IT_nucces)^(1/IT_mucces)*IT_ci^(1-1/IT_mucces)+(1-IT_nucces)^(1/IT_mucces)*IT_cg^(1-1/IT_mucces);
// Utility
IT_utili = 
IT_zcon*log(IT_ccesi-IT_kappa*IT_ccesi(-1))-1/(1+IT_zeta)*(IT_ni)^(1+IT_zeta)+IT_beta*IT_utili(+1)
;
// Marginal utility of consumption
IT_dcci = ((IT_nucces)^(1/IT_mucces)*IT_ci^(1-1/IT_mucces)+(1-IT_nucces)^(1/IT_mucces)*IT_cg^(1-1/IT_mucces))^(1/(IT_mucces-1))*(IT_nucces^(1/IT_mucces))*(IT_ci^(-1/IT_mucces));
IT_lambdai*(1+IT_tauc+IT_gammavi+IT_vi*IT_gammavider) = IT_zcon*(IT_ccesi-IT_kappa*IT_ccesi(-1))^(-IT_sigma)*IT_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
IT_r                   = IT_beta^(-1)*IT_lambdai/IT_lambdai    *IT_pic;
// Germany
// US and the RoW
// Euler equation for money
IT_vi^(2)*IT_gammavider = 1-IT_beta*IT_lambdai(+1)/(IT_lambdai*IT_pic(+1));
// Consumption-based velocity
IT_vi = IT_ci/IT_mi;
// Transaction cost
IT_gammavi = IT_gammav1*IT_vi+IT_gammav2/IT_vi-2*(IT_gammav1*IT_gammav2)^(1/2);
// Derivative of transaction cost
IT_gammavider = IT_gammav1-IT_gammav2*IT_vi^(-2);
IT_delta = IT_ii/IT_ki;
IT_gammai = 0;
IT_gammaider = 0;
IT_gammau = 0;
IT_gammauder = ((IT_beta^(-1)-1+IT_delta)*IT_qbar-IT_delta*IT_taukbar*IT_pibar)/((1-IT_taukbar)*IT_pibar);
IT_u = 1;
IT_pi = IT_q;
// Auxiliary equation for Tobin's Q in steady state
IT_qbar = IT_q;
// Rate of return on capital
IT_q = IT_beta*((1-IT_tauk)*IT_rk+(IT_tauk*IT_delta)*IT_pi+(1-IT_delta)*IT_q);
// Optimal wage contract (FOC)
IT_witilde^(1+IT_etai*IT_zeta) = IT_etai/(IT_etai-1)*IT_fi/IT_gi+IT_wcst;
// Definition of fi
IT_fi = IT_wi^(IT_etai*(1+IT_zeta))*IT_ndi^(1+IT_zeta)+IT_xii*IT_beta*(IT_pic(+1)/(IT_pic^IT_chii*IT_pi4target^(1/4*(1-IT_chii))))^(IT_etai*(1+IT_zeta))*IT_fi(+1);
// Definition of gi
IT_gi = IT_lambdai*(1-IT_taun-IT_tauwh)*IT_wi^IT_etai*IT_ndi+IT_xii*IT_beta*(IT_pic(+1)/(IT_pic^IT_chii*IT_pi4target^(1/4*(1-IT_chii))))^(IT_etai-1)*IT_gi(+1);
// Aggregate wage rate
IT_wi^(1-IT_etai) = (1-IT_xii)*IT_witilde^(1-IT_etai)+IT_xii*IT_wi(-1)^(1-IT_etai)*(IT_pic(-1)^IT_chii*IT_pi4target^(1/4*(1-IT_chii))/IT_pic)^(1-IT_etai);
//-------------
// Household J
//-------------
IT_ccesj^(1-1/IT_mucces) = (IT_nucces)^(1/IT_mucces)*IT_cj^(1-1/IT_mucces)+(1-IT_nucces)^(1/IT_mucces)*IT_cg^(1-1/IT_mucces);
// Utility
IT_utilj = 
IT_zcon*log(IT_ccesj-IT_kappa*IT_ccesj(-1))-1/(1+IT_zeta)*(IT_nj)^(1+IT_zeta)+IT_beta*IT_utilj(+1)
;
// Marginal utility of consumption
IT_dccj = ((IT_nucces)^(1/IT_mucces)*IT_cj^(1-1/IT_mucces)+(1-IT_nucces)^(1/IT_mucces)*IT_cg^(1-1/IT_mucces))^(1/(IT_mucces-1))*(IT_nucces^(1/IT_mucces))*(IT_cj^(-1/IT_mucces));
IT_lambdaj*(1+IT_tauc+IT_gammavj+IT_vj*IT_gammavjder) = IT_zcon*(IT_ccesj-IT_kappa*IT_ccesj(-1))^(-IT_sigma)*IT_dccj;
// Budget constraint
(1+IT_tauc+IT_gammavj)*IT_cj+IT_mj = (1-IT_taun-IT_tauwh)*IT_wj*IT_nj+IT_trj-IT_tj+IT_mj(-1)*IT_pic^(-1);
// Euler equation for money
IT_vj^(2)*IT_gammavjder = 1-IT_beta*IT_lambdaj(+1)/(IT_lambdaj*IT_pic(+1));
// Consumption-based velocity
IT_vj = IT_cj/IT_mj;
// Transaction technology
IT_gammavj = IT_gammav1*IT_vj+IT_gammav2/IT_vj-2*(IT_gammav1*IT_gammav2)^(1/2);
// Derivative of transaction technology
IT_gammavjder = IT_gammav1-IT_gammav2*IT_vj^(-2);
// Optimal wage contract (FOC)
IT_wjtilde^(1+IT_etaj*IT_zeta) = IT_etaj/(IT_etaj-1)*IT_fj/IT_gj+IT_wcst;
// Definition of fj
IT_fj = IT_wj^(IT_etaj*(1+IT_zeta))*IT_ndj^(1+IT_zeta)+IT_xij*IT_beta*(IT_pic(+1)/(IT_pic^IT_chij*IT_pi4target^(1/4*(1-IT_chij))))^(IT_etaj*(1+IT_zeta))*IT_fj(+1);
// Definition of gj
IT_gj = IT_lambdaj*(1-IT_taun-IT_tauwh)*IT_wj^IT_etaj*IT_ndj+IT_xij*IT_beta*(IT_pic(+1)/(IT_pic^IT_chij*IT_pi4target^(1/4*(1-IT_chij))))^(IT_etaj-1)*IT_gj(+1);
// Aggregate wage rate
IT_wj^(1-IT_etaj) = (1-IT_xij)*IT_wjtilde^(1-IT_etaj)+IT_xij*IT_wj(-1)^(1-IT_etaj)*(IT_pic(-1)^IT_chij*IT_pi4target^(1/4*(1-IT_chij))/IT_pic)^(1-IT_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
IT_kg = (1-IT_deltag)*IT_kg(-1)+IT_ig(-1);
// Production function tradable
IT_yst = IT_zt*IT_kg^IT_alphag*IT_kdt^IT_alphat*IT_ndt^(1-IT_alphat)-IT_psitbar;
// Production function nontradable
IT_ysn = IT_zn*IT_kg^IT_alphag*IT_kdn^IT_alphan*IT_ndn^(1-IT_alphan)-IT_psinbar;
// Real marginal cost tradable
IT_mct = 1/(IT_zt*IT_kg^IT_alphag*(IT_alphat)^(IT_alphat)*(1-IT_alphat)^(1-IT_alphat))*IT_rk^(IT_alphat)*((1+IT_tauwf)*IT_w)^(1-IT_alphat);
// Real marginal cost nontradable
IT_mcn = 1/(IT_zn*IT_kg^IT_alphag*(IT_alphan)^(IT_alphan)*(1-IT_alphan)^(1-IT_alphan))*IT_rk^(IT_alphan)*((1+IT_tauwf)*IT_w)^(1-IT_alphan);
// Wage Inflation (qoq)
IT_piw = IT_w/IT_w(-1)*IT_pic;
// Wage Inflation (yoy)
IT_piw4 = IT_pic4;
// Auxiliary equation for steady-state fixed cost
IT_psitbar = IT_psit*IT_ytbar;
// Auxiliary equation for steady-state fixed cost
IT_psinbar = IT_psin*IT_ynbar;
// Capital input (FOC)
IT_rk = IT_alphat*(IT_yst+IT_psitbar)/IT_kdt*IT_mct;
// Capital input (FOC)
IT_rk = IT_alphan*(IT_ysn+IT_psinbar)/IT_kdn*IT_mcn;
// Total capital demand
IT_kd = IT_kdt+IT_kdn;
// Demand for labour services by household I
IT_ndi = 
(1-IT_omega)*(IT_wi/IT_w)^(-IT_eta)*IT_nd
;
// Demand for labour services by household J
IT_ndj = 
IT_omega*(IT_wj/IT_w)^(-IT_eta)*IT_nd
;
// Aggregate labour demand
IT_nd^(1-1/IT_eta) = 
(1-IT_omega)^(1/IT_eta)*IT_ndi^(1-1/IT_eta)+IT_omega^(1/IT_eta)*IT_ndj^(1-1/IT_eta)
;
// Total demand 
IT_nd = IT_ndt+IT_ndn;
// Aggregate dividends
IT_d = IT_py*IT_y-IT_rk*IT_kd-(1+IT_tauwf)*IT_w*IT_nd;
// Non-tradable sector dividends
IT_dn = IT_pnt*IT_ysn-IT_rk*IT_kdn-(1+IT_tauwf)*IT_w*IT_ndn;
// Tradable sector dividends
IT_dt = IT_pht*IT_ht
+IT_pex*IT_ex
-IT_rk*IT_kdt-(1+IT_tauwf)*IT_w*IT_ndt;
// Optimal price contract set in domestic markets (FOC)
IT_phttilde/IT_pht = IT_thetat/(IT_thetat-1)*IT_fh/IT_gh;
// Definition of fh
IT_fh = IT_mct*IT_ht+IT_xih*IT_beta*IT_lambdai(+1)/IT_lambdai*(IT_piht(+1)/(IT_piht^IT_chih*IT_pi4target^(1/4*(1-IT_chih))))^IT_thetat*IT_fh(+1);
// Definition of gh
IT_gh = IT_pht*IT_ht+IT_xih*IT_beta*IT_lambdai(+1)/IT_lambdai*(IT_piht(+1)/(IT_piht^IT_chih*IT_pi4target^(1/4*(1-IT_chih))))^(IT_thetat-1)*IT_gh(+1);
// Aggregate intermediate-good price dynamics
IT_pht^(1-IT_thetat) = (1-IT_xih)*IT_phttilde^(1-IT_thetat)+IT_xih*(IT_pht(-1)/IT_pic)^(1-IT_thetat)*(IT_piht(-1)^IT_chih*IT_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation
IT_piht = IT_pht/IT_pht(-1)*IT_pic;
// Optimal price contract set in domestic markets (FOC)
IT_pnttilde/IT_pnt = IT_thetan/(IT_thetan-1)*IT_fn/IT_gn;
// Definition of fn
IT_fn = IT_mcn*IT_nt+IT_xin*IT_beta*IT_lambdai(+1)/IT_lambdai*(IT_pint(+1)/(IT_pint^IT_chin*IT_pi4target^(1/4*(1-IT_chin))))^IT_thetan*IT_fn(+1);
// Definition of gn
IT_gn = IT_pnt*IT_nt+IT_xin*IT_beta*IT_lambdai(+1)/IT_lambdai*(IT_pint(+1)/(IT_pint^IT_chin*IT_pi4target^(1/4*(1-IT_chin))))^(IT_thetan-1)*IT_gn(+1);
// Aggregate intermediate-good price dynamics
IT_pnt^(1-IT_thetan) = (1-IT_xin)*IT_pnttilde^(1-IT_thetan)+IT_xin*(IT_pnt(-1)/IT_pic)^(1-IT_thetan)*(IT_pint(-1)^IT_chin*IT_pi4target^(1/4*(1-IT_chin)))^(1-IT_thetan);
// Intermediate-good price inflation
IT_pint = IT_pnt/IT_pnt(-1)*IT_pic;
// Optimal price contract set in domestic markets (FOC)
IT_pextilde/IT_pex = IT_thetat/(IT_thetat-1)*IT_fx/IT_gx;
// Definition of fh
IT_fx = IT_mct*IT_ex+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(IT_piex(+1)/(IT_piex^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*IT_fx(+1);
// Definition of gh
IT_gx = IT_pex*IT_ex+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(IT_piex(+1)/(IT_piex^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*IT_gx(+1);
// Aggregate intermediate-good price dynamics
IT_pex^(1-IT_thetat) = (1-IT_xix)*IT_pextilde^(1-IT_thetat)+IT_xix*(IT_pex(-1)/IT_pic)^(1-IT_thetat)*(IT_piex(-1)^IT_chix*IT_pi4target^(1/4*(1-IT_chix)))^(1-IT_thetat);
// Intermediate-good price inflation
IT_piex = IT_pex/IT_pex(-1)*IT_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = RA_pimtilde
// RAIT_pimtilde/RAIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITRA_fx/ITRA_gx;
// Definition of fx
// ITRA_fx = RA_size/IT_size*RAIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(RAIT_piim(+1)/(RAIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITRA_fx(+1);
// Definition of gx   
// ITRA_gx = ITRA_rer*RAIT_pim*RA_size/IT_size*RAIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(RAIT_piim(+1)/(RAIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITRA_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = RA_pim
// RAIT_pim^(1-IT_thetat) = (1-IT_xix)*RAIT_pimtilde^(1-IT_thetat)+IT_xix*(RAIT_pim(-1)/RA_pic)^(1-IT_thetat)*(RAIT_piim(-1)^IT_chix*RA_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = RA_piim
// RAIT_piim = RAIT_pim/RAIT_pim(-1)*RA_pic;
// Bilateral real exchange rate
ITRA_rer = IT_rer/RA_rer;
// Auxiliary equation for steady-state output
ITRA_rerbar = ITRA_rer;
//Terms of Trade
ITRA_tot = RA_pex*ITRA_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = AT_pimtilde
// ATIT_pimtilde/ATIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITAT_fx/ITAT_gx;
// Definition of fx
// ITAT_fx = AT_size/IT_size*ATIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(ATIT_piim(+1)/(ATIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITAT_fx(+1);
// Definition of gx   
// ITAT_gx = ITAT_rer*ATIT_pim*AT_size/IT_size*ATIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(ATIT_piim(+1)/(ATIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITAT_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = AT_pim
// ATIT_pim^(1-IT_thetat) = (1-IT_xix)*ATIT_pimtilde^(1-IT_thetat)+IT_xix*(ATIT_pim(-1)/AT_pic)^(1-IT_thetat)*(ATIT_piim(-1)^IT_chix*AT_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = AT_piim
// ATIT_piim = ATIT_pim/ATIT_pim(-1)*AT_pic;
// Bilateral real exchange rate
ITAT_rer = IT_rer/AT_rer;
// Auxiliary equation for steady-state output
ITAT_rerbar = ITAT_rer;
//Terms of Trade
ITAT_tot = AT_pex*ITAT_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = BE_pimtilde
// BEIT_pimtilde/BEIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITBE_fx/ITBE_gx;
// Definition of fx
// ITBE_fx = BE_size/IT_size*BEIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(BEIT_piim(+1)/(BEIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITBE_fx(+1);
// Definition of gx   
// ITBE_gx = ITBE_rer*BEIT_pim*BE_size/IT_size*BEIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(BEIT_piim(+1)/(BEIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITBE_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = BE_pim
// BEIT_pim^(1-IT_thetat) = (1-IT_xix)*BEIT_pimtilde^(1-IT_thetat)+IT_xix*(BEIT_pim(-1)/BE_pic)^(1-IT_thetat)*(BEIT_piim(-1)^IT_chix*BE_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = BE_piim
// BEIT_piim = BEIT_pim/BEIT_pim(-1)*BE_pic;
// Bilateral real exchange rate
ITBE_rer = IT_rer/BE_rer;
// Auxiliary equation for steady-state output
ITBE_rerbar = ITBE_rer;
//Terms of Trade
ITBE_tot = BE_pex*ITBE_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = ES_pimtilde
// ESIT_pimtilde/ESIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITES_fx/ITES_gx;
// Definition of fx
// ITES_fx = ES_size/IT_size*ESIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(ESIT_piim(+1)/(ESIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITES_fx(+1);
// Definition of gx   
// ITES_gx = ITES_rer*ESIT_pim*ES_size/IT_size*ESIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(ESIT_piim(+1)/(ESIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITES_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = ES_pim
// ESIT_pim^(1-IT_thetat) = (1-IT_xix)*ESIT_pimtilde^(1-IT_thetat)+IT_xix*(ESIT_pim(-1)/ES_pic)^(1-IT_thetat)*(ESIT_piim(-1)^IT_chix*ES_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = ES_piim
// ESIT_piim = ESIT_pim/ESIT_pim(-1)*ES_pic;
// Bilateral real exchange rate
ITES_rer = IT_rer/ES_rer;
// Auxiliary equation for steady-state output
ITES_rerbar = ITES_rer;
//Terms of Trade
ITES_tot = ES_pex*ITES_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = FI_pimtilde
// FIIT_pimtilde/FIIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITFI_fx/ITFI_gx;
// Definition of fx
// ITFI_fx = FI_size/IT_size*FIIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(FIIT_piim(+1)/(FIIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITFI_fx(+1);
// Definition of gx   
// ITFI_gx = ITFI_rer*FIIT_pim*FI_size/IT_size*FIIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(FIIT_piim(+1)/(FIIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITFI_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = FI_pim
// FIIT_pim^(1-IT_thetat) = (1-IT_xix)*FIIT_pimtilde^(1-IT_thetat)+IT_xix*(FIIT_pim(-1)/FI_pic)^(1-IT_thetat)*(FIIT_piim(-1)^IT_chix*FI_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = FI_piim
// FIIT_piim = FIIT_pim/FIIT_pim(-1)*FI_pic;
// Bilateral real exchange rate
ITFI_rer = IT_rer/FI_rer;
// Auxiliary equation for steady-state output
ITFI_rerbar = ITFI_rer;
//Terms of Trade
ITFI_tot = FI_pex*ITFI_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = FR_pimtilde
// FRIT_pimtilde/FRIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITFR_fx/ITFR_gx;
// Definition of fx
// ITFR_fx = FR_size/IT_size*FRIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(FRIT_piim(+1)/(FRIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITFR_fx(+1);
// Definition of gx   
// ITFR_gx = ITFR_rer*FRIT_pim*FR_size/IT_size*FRIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(FRIT_piim(+1)/(FRIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITFR_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = FR_pim
// FRIT_pim^(1-IT_thetat) = (1-IT_xix)*FRIT_pimtilde^(1-IT_thetat)+IT_xix*(FRIT_pim(-1)/FR_pic)^(1-IT_thetat)*(FRIT_piim(-1)^IT_chix*FR_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = FR_piim
// FRIT_piim = FRIT_pim/FRIT_pim(-1)*FR_pic;
// Bilateral real exchange rate
ITFR_rer = IT_rer/FR_rer;
// Auxiliary equation for steady-state output
ITFR_rerbar = ITFR_rer;
//Terms of Trade
ITFR_tot = FR_pex*ITFR_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = GR_pimtilde
// GRIT_pimtilde/GRIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITGR_fx/ITGR_gx;
// Definition of fx
// ITGR_fx = GR_size/IT_size*GRIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(GRIT_piim(+1)/(GRIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITGR_fx(+1);
// Definition of gx   
// ITGR_gx = ITGR_rer*GRIT_pim*GR_size/IT_size*GRIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(GRIT_piim(+1)/(GRIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITGR_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = GR_pim
// GRIT_pim^(1-IT_thetat) = (1-IT_xix)*GRIT_pimtilde^(1-IT_thetat)+IT_xix*(GRIT_pim(-1)/GR_pic)^(1-IT_thetat)*(GRIT_piim(-1)^IT_chix*GR_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = GR_piim
// GRIT_piim = GRIT_pim/GRIT_pim(-1)*GR_pic;
// Bilateral real exchange rate
ITGR_rer = IT_rer/GR_rer;
// Auxiliary equation for steady-state output
ITGR_rerbar = ITGR_rer;
//Terms of Trade
ITGR_tot = GR_pex*ITGR_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = NL_pimtilde
// NLIT_pimtilde/NLIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITNL_fx/ITNL_gx;
// Definition of fx
// ITNL_fx = NL_size/IT_size*NLIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(NLIT_piim(+1)/(NLIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITNL_fx(+1);
// Definition of gx   
// ITNL_gx = ITNL_rer*NLIT_pim*NL_size/IT_size*NLIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(NLIT_piim(+1)/(NLIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITNL_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = NL_pim
// NLIT_pim^(1-IT_thetat) = (1-IT_xix)*NLIT_pimtilde^(1-IT_thetat)+IT_xix*(NLIT_pim(-1)/NL_pic)^(1-IT_thetat)*(NLIT_piim(-1)^IT_chix*NL_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = NL_piim
// NLIT_piim = NLIT_pim/NLIT_pim(-1)*NL_pic;
// Bilateral real exchange rate
ITNL_rer = IT_rer/NL_rer;
// Auxiliary equation for steady-state output
ITNL_rerbar = ITNL_rer;
//Terms of Trade
ITNL_tot = NL_pex*ITNL_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = PT_pimtilde
// PTIT_pimtilde/PTIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITPT_fx/ITPT_gx;
// Definition of fx
// ITPT_fx = PT_size/IT_size*PTIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(PTIT_piim(+1)/(PTIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITPT_fx(+1);
// Definition of gx   
// ITPT_gx = ITPT_rer*PTIT_pim*PT_size/IT_size*PTIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(PTIT_piim(+1)/(PTIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITPT_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = PT_pim
// PTIT_pim^(1-IT_thetat) = (1-IT_xix)*PTIT_pimtilde^(1-IT_thetat)+IT_xix*(PTIT_pim(-1)/PT_pic)^(1-IT_thetat)*(PTIT_piim(-1)^IT_chix*PT_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = PT_piim
// PTIT_piim = PTIT_pim/PTIT_pim(-1)*PT_pic;
// Bilateral real exchange rate
ITPT_rer = IT_rer/PT_rer;
// Auxiliary equation for steady-state output
ITPT_rerbar = ITPT_rer;
//Terms of Trade
ITPT_tot = PT_pex*ITPT_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = DE_pimtilde
// DEIT_pimtilde/DEIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITDE_fx/ITDE_gx;
// Definition of fx
// ITDE_fx = DE_size/IT_size*DEIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(DEIT_piim(+1)/(DEIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITDE_fx(+1);
// Definition of gx   
// ITDE_gx = ITDE_rer*DEIT_pim*DE_size/IT_size*DEIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(DEIT_piim(+1)/(DEIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITDE_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = DE_pim
// DEIT_pim^(1-IT_thetat) = (1-IT_xix)*DEIT_pimtilde^(1-IT_thetat)+IT_xix*(DEIT_pim(-1)/DE_pic)^(1-IT_thetat)*(DEIT_piim(-1)^IT_chix*DE_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = DE_piim
// DEIT_piim = DEIT_pim/DEIT_pim(-1)*DE_pic;
// Bilateral real exchange rate
ITDE_rer = IT_rer/DE_rer;
// Auxiliary equation for steady-state output
ITDE_rerbar = ITDE_rer;
//Terms of Trade
ITDE_tot = DE_pex*ITDE_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = RU_pimtilde
// RUIT_pimtilde/RUIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITRU_fx/ITRU_gx;
// Definition of fx
// ITRU_fx = RU_size/IT_size*RUIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(RUIT_piim(+1)/(RUIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITRU_fx(+1);
// Definition of gx   
// ITRU_gx = ITRU_rer*RUIT_pim*RU_size/IT_size*RUIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(RUIT_piim(+1)/(RUIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITRU_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = RU_pim
// RUIT_pim^(1-IT_thetat) = (1-IT_xix)*RUIT_pimtilde^(1-IT_thetat)+IT_xix*(RUIT_pim(-1)/RU_pic)^(1-IT_thetat)*(RUIT_piim(-1)^IT_chix*RU_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = RU_piim
// RUIT_piim = RUIT_pim/RUIT_pim(-1)*RU_pic;
// Bilateral real exchange rate
ITRU_rer = IT_rer/RU_rer;
// Auxiliary equation for steady-state output
ITRU_rerbar = ITRU_rer;
//Terms of Trade
ITRU_tot = RU_pex*ITRU_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = RW_pimtilde
// RWIT_pimtilde/RWIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITRW_fx/ITRW_gx;
// Definition of fx
// ITRW_fx = RW_size/IT_size*RWIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(RWIT_piim(+1)/(RWIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITRW_fx(+1);
// Definition of gx   
// ITRW_gx = ITRW_rer*RWIT_pim*RW_size/IT_size*RWIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(RWIT_piim(+1)/(RWIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITRW_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = RW_pim
// RWIT_pim^(1-IT_thetat) = (1-IT_xix)*RWIT_pimtilde^(1-IT_thetat)+IT_xix*(RWIT_pim(-1)/RW_pic)^(1-IT_thetat)*(RWIT_piim(-1)^IT_chix*RW_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = RW_piim
// RWIT_piim = RWIT_pim/RWIT_pim(-1)*RW_pic;
// Bilateral real exchange rate
ITRW_rer = IT_rer/RW_rer;
// Auxiliary equation for steady-state output
ITRW_rerbar = ITRW_rer;
//Terms of Trade
ITRW_tot = RW_pex*ITRW_rer/IT_pex;
// Optimal price contract set in foreign markets (FOC), using IT_pxtilde = US_pimtilde
// USIT_pimtilde/USIT_pim = IT_cpim*IT_thetat/(IT_thetat-1)*ITUS_fx/ITUS_gx;
// Definition of fx
// ITUS_fx = US_size/IT_size*USIT_im*IT_mct+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(USIT_piim(+1)/(USIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*ITUS_fx(+1);
// Definition of gx   
// ITUS_gx = ITUS_rer*USIT_pim*US_size/IT_size*USIT_im+IT_xix*IT_beta*IT_lambdai(+1)/IT_lambdai*(USIT_piim(+1)/(USIT_piim^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^(IT_thetat-1)*ITUS_gx(+1);
// Aggregate intermediate-good price dynamics, using IT_px = US_pim
// USIT_pim^(1-IT_thetat) = (1-IT_xix)*USIT_pimtilde^(1-IT_thetat)+IT_xix*(USIT_pim(-1)/US_pic)^(1-IT_thetat)*(USIT_piim(-1)^IT_chix*US_pi4target^(1/4*(1-IT_chih)))^(1-IT_thetat);
// Intermediate-good price inflation, using IT_pix = US_piim
// USIT_piim = USIT_pim/USIT_pim(-1)*US_pic;
// Bilateral real exchange rate
ITUS_rer = IT_rer/US_rer;
// Auxiliary equation for steady-state output
ITUS_rerbar = ITUS_rer;
//Terms of Trade
ITUS_tot = US_pex*ITUS_rer/IT_pex;
// Total imports 
IT_im = 
+IT_imc
+IT_imi
+IT_imcg
+IT_imig
;
// Total import deflator
IT_im*IT_pim  = 
+IT_pimc*IT_imc
+IT_pimi*IT_imi
+IT_pimcg*IT_imcg
+IT_pimig*IT_imig
;
// Effective real exchange rate: double weighting (imports)
ITRA_weightim = ITRA_rer*RA_pex*ITRA_im/(IT_pim*IT_im);
// Effective real exchange rate: double weighting (exports)
ITRA_weightex = RA_size/IT_size*RAIT_im/IT_ex*ITRA_rer*RA_py*RA_y/(ITRA_rer*RA_py*RA_y
+ITAT_rer*AT_pex*RAAT_im
+ITBE_rer*BE_pex*RABE_im
+ITES_rer*ES_pex*RAES_im
+ITFI_rer*FI_pex*RAFI_im
+ITFR_rer*FR_pex*RAFR_im
+ITGR_rer*GR_pex*RAGR_im
+ITNL_rer*NL_pex*RANL_im
+ITPT_rer*PT_pex*RAPT_im
+ITDE_rer*DE_pex*RADE_im
+ITRU_rer*RU_pex*RARU_im
+ITRW_rer*RW_pex*RARW_im
+ITUS_rer*US_pex*RAUS_im
)+
+AT_size/IT_size*ATIT_im/IT_ex*ITRA_rer*RA_pex*ATRA_im/(ITAT_rer*AT_py*AT_y
+ITRA_rer*RA_pex*ATRA_im
+ITBE_rer*BE_pex*ATBE_im
+ITES_rer*ES_pex*ATES_im
+ITFI_rer*FI_pex*ATFI_im
+ITFR_rer*FR_pex*ATFR_im
+ITGR_rer*GR_pex*ATGR_im
+ITNL_rer*NL_pex*ATNL_im
+ITPT_rer*PT_pex*ATPT_im
+ITDE_rer*DE_pex*ATDE_im
+ITRU_rer*RU_pex*ATRU_im
+ITRW_rer*RW_pex*ATRW_im
+ITUS_rer*US_pex*ATUS_im
)
+BE_size/IT_size*BEIT_im/IT_ex*ITRA_rer*RA_pex*BERA_im/(ITBE_rer*BE_py*BE_y
+ITRA_rer*RA_pex*BERA_im
+ITAT_rer*AT_pex*BEAT_im
+ITES_rer*ES_pex*BEES_im
+ITFI_rer*FI_pex*BEFI_im
+ITFR_rer*FR_pex*BEFR_im
+ITGR_rer*GR_pex*BEGR_im
+ITNL_rer*NL_pex*BENL_im
+ITPT_rer*PT_pex*BEPT_im
+ITDE_rer*DE_pex*BEDE_im
+ITRU_rer*RU_pex*BERU_im
+ITRW_rer*RW_pex*BERW_im
+ITUS_rer*US_pex*BEUS_im
)
+ES_size/IT_size*ESIT_im/IT_ex*ITRA_rer*RA_pex*ESRA_im/(ITES_rer*ES_py*ES_y
+ITRA_rer*RA_pex*ESRA_im
+ITAT_rer*AT_pex*ESAT_im
+ITBE_rer*BE_pex*ESBE_im
+ITFI_rer*FI_pex*ESFI_im
+ITFR_rer*FR_pex*ESFR_im
+ITGR_rer*GR_pex*ESGR_im
+ITNL_rer*NL_pex*ESNL_im
+ITPT_rer*PT_pex*ESPT_im
+ITDE_rer*DE_pex*ESDE_im
+ITRU_rer*RU_pex*ESRU_im
+ITRW_rer*RW_pex*ESRW_im
+ITUS_rer*US_pex*ESUS_im
)
+FI_size/IT_size*FIIT_im/IT_ex*ITRA_rer*RA_pex*FIRA_im/(ITFI_rer*FI_py*FI_y
+ITRA_rer*RA_pex*FIRA_im
+ITAT_rer*AT_pex*FIAT_im
+ITBE_rer*BE_pex*FIBE_im
+ITES_rer*ES_pex*FIES_im
+ITFR_rer*FR_pex*FIFR_im
+ITGR_rer*GR_pex*FIGR_im
+ITNL_rer*NL_pex*FINL_im
+ITPT_rer*PT_pex*FIPT_im
+ITDE_rer*DE_pex*FIDE_im
+ITRU_rer*RU_pex*FIRU_im
+ITRW_rer*RW_pex*FIRW_im
