				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
		* IT_pic4^(IT_size/(
				+ RA_size
				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
		* NL_pic4^(NL_size/(
				+ RA_size
				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
		* PT_pic4^(PT_size/(
				+ RA_size
				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
		* DE_pic4^(DE_size/(
				+ RA_size
				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
;
// Productivity
log(EA_z) = (1-EA_rhoz)*log(EA_zbar)+EA_rhoz*log(EA_z(-1))+EA_epsz;
// Auxiliary equation for steady-state output
EA_ybar = EA_y;
end;
