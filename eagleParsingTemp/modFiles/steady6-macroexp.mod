+RABE_rer*BE_pex*USBE_im
+RAES_rer*ES_pex*USES_im
+RAFI_rer*FI_pex*USFI_im
+RAFR_rer*FR_pex*USFR_im
+RAGR_rer*GR_pex*USGR_im
+RAIT_rer*IT_pex*USIT_im
+RANL_rer*NL_pex*USNL_im
+RAPT_rer*PT_pex*USPT_im
+RADE_rer*DE_pex*USDE_im
+RARU_rer*RU_pex*USRU_im
+RARW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
RARW_weight = RA_pim*RA_im/(RA_pim*RA_im+RA_pex*RA_ex)*RARW_weightim+RA_pex*RA_ex/(RA_pim*RA_im+RA_pex*RA_ex)*RARW_weightex;
// Effective real exchange rate: double weighting (imports)
RAUS_weightim = RAUS_rer*US_pex*RAUS_im/(RA_pim*RA_im);
// Effective real exchange rate: double weighting (exports)
RAUS_weightex = US_size/RA_size*USRA_im/RA_ex*RAUS_rer*US_py*US_y/(RAUS_rer*US_py*US_y
+RAAT_rer*AT_pex*USAT_im
