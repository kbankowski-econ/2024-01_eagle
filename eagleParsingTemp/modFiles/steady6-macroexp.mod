FIRU_weight = FI_pim*FI_im/(FI_pim*FI_im+FI_pex*FI_ex)*FIRU_weightim+FI_pex*FI_ex/(FI_pim*FI_im+FI_pex*FI_ex)*FIRU_weightex;
// Effective real exchange rate: double weighting (imports)
FIRW_weightim = FIRW_rer*RW_pex*FIRW_im/(FI_pim*FI_im);
// Effective real exchange rate: double weighting (exports)
