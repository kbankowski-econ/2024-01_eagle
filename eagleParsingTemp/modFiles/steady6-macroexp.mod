// Bilateral real exchange rate
PTGR_rer = PT_rer/GR_rer;
// Auxiliary equation for steady-state output
PTGR_rerbar = PTGR_rer;
//Terms of Trade
PTGR_tot = GR_pex*PTGR_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = IT_pimtilde
// ITPT_pimtilde/ITPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTIT_fx/PTIT_gx;
// Definition of fx
// PTIT_fx = IT_size/PT_size*ITPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(ITPT_piim(+1)/(ITPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTIT_fx(+1);
// Definition of gx   
// PTIT_gx = PTIT_rer*ITPT_pim*IT_size/PT_size*ITPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(ITPT_piim(+1)/(ITPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTIT_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = IT_pim
// ITPT_pim^(1-PT_thetat) = (1-PT_xix)*ITPT_pimtilde^(1-PT_thetat)+PT_xix*(ITPT_pim(-1)/IT_pic)^(1-PT_thetat)*(ITPT_piim(-1)^PT_chix*IT_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = IT_piim
// ITPT_piim = ITPT_pim/ITPT_pim(-1)*IT_pic;
// Bilateral real exchange rate
PTIT_rer = PT_rer/IT_rer;
// Auxiliary equation for steady-state output
PTIT_rerbar = PTIT_rer;
//Terms of Trade
PTIT_tot = IT_pex*PTIT_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = NL_pimtilde
// NLPT_pimtilde/NLPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTNL_fx/PTNL_gx;
// Definition of fx
// PTNL_fx = NL_size/PT_size*NLPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(NLPT_piim(+1)/(NLPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTNL_fx(+1);
// Definition of gx   
// PTNL_gx = PTNL_rer*NLPT_pim*NL_size/PT_size*NLPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(NLPT_piim(+1)/(NLPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTNL_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = NL_pim
// NLPT_pim^(1-PT_thetat) = (1-PT_xix)*NLPT_pimtilde^(1-PT_thetat)+PT_xix*(NLPT_pim(-1)/NL_pic)^(1-PT_thetat)*(NLPT_piim(-1)^PT_chix*NL_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = NL_piim
// NLPT_piim = NLPT_pim/NLPT_pim(-1)*NL_pic;
// Bilateral real exchange rate
PTNL_rer = PT_rer/NL_rer;
// Auxiliary equation for steady-state output
PTNL_rerbar = PTNL_rer;
//Terms of Trade
PTNL_tot = NL_pex*PTNL_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = DE_pimtilde
// DEPT_pimtilde/DEPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTDE_fx/PTDE_gx;
// Definition of fx
// PTDE_fx = DE_size/PT_size*DEPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(DEPT_piim(+1)/(DEPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTDE_fx(+1);
// Definition of gx   
// PTDE_gx = PTDE_rer*DEPT_pim*DE_size/PT_size*DEPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(DEPT_piim(+1)/(DEPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTDE_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = DE_pim
// DEPT_pim^(1-PT_thetat) = (1-PT_xix)*DEPT_pimtilde^(1-PT_thetat)+PT_xix*(DEPT_pim(-1)/DE_pic)^(1-PT_thetat)*(DEPT_piim(-1)^PT_chix*DE_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = DE_piim
// DEPT_piim = DEPT_pim/DEPT_pim(-1)*DE_pic;
// Bilateral real exchange rate
PTDE_rer = PT_rer/DE_rer;
// Auxiliary equation for steady-state output
PTDE_rerbar = PTDE_rer;
//Terms of Trade
PTDE_tot = DE_pex*PTDE_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = RU_pimtilde
// RUPT_pimtilde/RUPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTRU_fx/PTRU_gx;
// Definition of fx
// PTRU_fx = RU_size/PT_size*RUPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(RUPT_piim(+1)/(RUPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTRU_fx(+1);
// Definition of gx   
// PTRU_gx = PTRU_rer*RUPT_pim*RU_size/PT_size*RUPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(RUPT_piim(+1)/(RUPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTRU_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = RU_pim
// RUPT_pim^(1-PT_thetat) = (1-PT_xix)*RUPT_pimtilde^(1-PT_thetat)+PT_xix*(RUPT_pim(-1)/RU_pic)^(1-PT_thetat)*(RUPT_piim(-1)^PT_chix*RU_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = RU_piim
// RUPT_piim = RUPT_pim/RUPT_pim(-1)*RU_pic;
// Bilateral real exchange rate
PTRU_rer = PT_rer/RU_rer;
// Auxiliary equation for steady-state output
PTRU_rerbar = PTRU_rer;
//Terms of Trade
PTRU_tot = RU_pex*PTRU_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = RW_pimtilde
// RWPT_pimtilde/RWPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTRW_fx/PTRW_gx;
// Definition of fx
// PTRW_fx = RW_size/PT_size*RWPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(RWPT_piim(+1)/(RWPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTRW_fx(+1);
// Definition of gx   
// PTRW_gx = PTRW_rer*RWPT_pim*RW_size/PT_size*RWPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(RWPT_piim(+1)/(RWPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTRW_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = RW_pim
// RWPT_pim^(1-PT_thetat) = (1-PT_xix)*RWPT_pimtilde^(1-PT_thetat)+PT_xix*(RWPT_pim(-1)/RW_pic)^(1-PT_thetat)*(RWPT_piim(-1)^PT_chix*RW_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = RW_piim
