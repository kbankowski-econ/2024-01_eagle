)
+DE_size/AT_size*DEAT_im/AT_ex*ATRA_rer*RA_pex*DERA_im/(ATDE_rer*DE_py*DE_y
+ATRA_rer*RA_pex*DERA_im
+ATBE_rer*BE_pex*DEBE_im
+ATES_rer*ES_pex*DEES_im
