+RU_size/DE_size*RUDE_im
+RW_size/DE_size*RWDE_im
+US_size/DE_size*USDE_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using DE_pg = DE_pht
// TODO: check the (1-DE_gammab(-1)) adjustment here, which is not in the fiscal extention
	DE_pcg(-1)*DE_cg(-1)+DE_pig(-1)*DE_ig(-1)+DE_tr(-1)
	+DE_b(-1)*DE_pic(-1)^(-1)+DE_m(-2)*DE_pic(-1)^(-1) = DE_tauc(-1)*DE_c(-1)+(DE_taun(-1)+DE_tauwh(-1))*(DE_wi(-1)*DE_ndi(-1)+DE_wj(-1)*DE_ndj(-1))+DE_tauwf(-1)*DE_w(-1)*DE_nd(-1)+DE_tauk(-1)*(DE_rk(-1)*DE_u(-1)-(DE_gammau(-1)+DE_delta)*DE_pi(-1))*DE_k(-1)+DE_taud(-1)*DE_d(-1)+DE_t(-1)+(DE_r(-1)*(1-DE_gammab(-1)))^(-1)*DE_b+DE_m(-1);
// Government spending, using DE_pg = DE_pht
DE_pcg*DE_cg = DE_cgy*DE_pybar*DE_ybar;
DE_pig*DE_ig = DE_igy*DE_pybar*DE_ybar;
DE_t = 0;
DE_b = DE_bytarget*DE_pybar*DE_ybar;
// Auxiliary equation for steady-state output
DE_ybar = DE_y;
// Auxiliary equation for steady-state output
DE_ytbar = DE_yst;
// Auxiliary equation for steady-state output
DE_ynbar = DE_ysn;
// Auxiliary equation for steady-state output deflator
DE_pybar = DE_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
DE_trybar = DE_tr/(DE_pybar*DE_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
DE_ti = DE_upsilont*DE_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
DE_tri = DE_upsilontr*DE_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	DE_r^4-1 = DE_rrstar^4*DE_pi4target-1;
DE_pic4 = DE_pi4target;
DE_rr-1 = DE_r/DE_pi4target^(1/4)-1;
// Equilibrium real interest rate
DE_rrstar-1 = 1/DE_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
DE_c = (1-DE_omega)*DE_ci+DE_omega*DE_cj;
// Aggregate money holdings
DE_m = (1-DE_omega)*DE_mi+DE_omega*DE_mj;
// Aggregate capital stock
DE_k = (1-DE_omega)*DE_ki;
// Aggregate investment
DE_i = (1-DE_omega)*DE_ii;
// Aggregate lump-sum transfers
DE_trj = 
1/DE_omega*DE_tr-(1-DE_omega)/DE_omega*DE_tri
;
// Aggregate lump-sum taxes
DE_tj = 
1/DE_omega*DE_t-(1-DE_omega)/DE_omega*DE_ti
;
// Aggregate transaction costs
DE_gammav = (1-DE_omega)*DE_ci*DE_gammavi+DE_omega*DE_cj*DE_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
DE_ni = DE_si*DE_ndi;
// Wage dispersion
DE_si = (1-DE_xii)*(DE_witilde/DE_wi)^(-DE_etai)+DE_xii*(DE_wi(-1)/DE_wi)^(-DE_etai)*(DE_pic/(DE_pic(-1)^DE_chii*DE_pi4target^(1/4*(1-DE_chii))))^(DE_etai)*DE_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
DE_nj = DE_sj*DE_ndj;
// Wage dispersion
DE_sj = (1-DE_xij)*(DE_wjtilde/DE_wj)^(-DE_etaj)+DE_xij*(DE_wj(-1)/DE_wj)^(-DE_etaj)*(DE_pic/(DE_pic(-1)^DE_chij*DE_pi4target^(1/4*(1-DE_chij))))^(DE_etaj)*DE_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
DE_u*DE_k = DE_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using DE_x = RU_size/DE_size*RU_im
DE_ysn = DE_snt*DE_nt;
//  nontradables aggregate demand
DE_nt = 
+DE_ntc
+DE_nti
+DE_ntcg
+DE_ntig
;
// Aggregate demand for domestic intermediate goods, using DE_hg = DE_cg
DE_ht =
+DE_htc
+DE_hti
+DE_htcg
+DE_htig
;
// Price dispersion in the domestic markets
DE_sh = (1-DE_xih)*(DE_phttilde/DE_pht)^(-DE_thetat)+DE_xih*(DE_piht/(DE_piht(-1)^DE_chih*DE_pi4target^(1/4*(1-DE_chih))))^DE_thetat*DE_sh(-1);
// Price dispersion in the foreign markets
DE_sx = (1-DE_xix)*(DE_pextilde/DE_pex)^(-DE_thetat)+DE_xix*(DE_piex/(DE_piex(-1)^DE_chix*DE_pi4target^(1/4*(1-DE_chix))))^DE_thetat*DE_sx(-1);
// Price dispersion in the domestic markets
DE_snt = (1-DE_xin)*(DE_pnttilde/DE_pnt)^(-DE_thetan)+DE_xin*(DE_pint/(DE_pint(-1)^DE_chin*DE_pi4target^(1/4*(1-DE_chin))))^DE_thetan*DE_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
DE_qc = DE_c+DE_gammav;
// Aggregate investment and capital utilisation cost
DE_qi = DE_i+DE_k*DE_gammau;
// Aggregate gov demand components added to use the same structure like in private components
DE_qcg = DE_cg;
DE_qig = DE_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
DE_py*DE_y = 
+DE_qc
+DE_pi*DE_qi
+DE_pcg*DE_qcg
+DE_pig*DE_qig
+DE_pex*RA_size/DE_size*RADE_im
-(RA_pex*DERA_rer)*DERA_imc
-(RA_pex*DERA_rer)*DERA_imi
-(RA_pex*DERA_rer)*DERA_imcg
-(RA_pex*DERA_rer)*DERA_imig
+DE_pex*AT_size/DE_size*ATDE_im
-(AT_pex*DEAT_rer)*DEAT_imc
-(AT_pex*DEAT_rer)*DEAT_imi
-(AT_pex*DEAT_rer)*DEAT_imcg
-(AT_pex*DEAT_rer)*DEAT_imig
+DE_pex*BE_size/DE_size*BEDE_im
-(BE_pex*DEBE_rer)*DEBE_imc
-(BE_pex*DEBE_rer)*DEBE_imi
-(BE_pex*DEBE_rer)*DEBE_imcg
-(BE_pex*DEBE_rer)*DEBE_imig
+DE_pex*ES_size/DE_size*ESDE_im
-(ES_pex*DEES_rer)*DEES_imc
-(ES_pex*DEES_rer)*DEES_imi
-(ES_pex*DEES_rer)*DEES_imcg
-(ES_pex*DEES_rer)*DEES_imig
+DE_pex*FI_size/DE_size*FIDE_im
-(FI_pex*DEFI_rer)*DEFI_imc
-(FI_pex*DEFI_rer)*DEFI_imi
-(FI_pex*DEFI_rer)*DEFI_imcg
-(FI_pex*DEFI_rer)*DEFI_imig
+DE_pex*FR_size/DE_size*FRDE_im
-(FR_pex*DEFR_rer)*DEFR_imc
-(FR_pex*DEFR_rer)*DEFR_imi
-(FR_pex*DEFR_rer)*DEFR_imcg
-(FR_pex*DEFR_rer)*DEFR_imig
+DE_pex*GR_size/DE_size*GRDE_im
-(GR_pex*DEGR_rer)*DEGR_imc
-(GR_pex*DEGR_rer)*DEGR_imi
-(GR_pex*DEGR_rer)*DEGR_imcg
-(GR_pex*DEGR_rer)*DEGR_imig
+DE_pex*IT_size/DE_size*ITDE_im
-(IT_pex*DEIT_rer)*DEIT_imc
-(IT_pex*DEIT_rer)*DEIT_imi
-(IT_pex*DEIT_rer)*DEIT_imcg
-(IT_pex*DEIT_rer)*DEIT_imig
+DE_pex*NL_size/DE_size*NLDE_im
-(NL_pex*DENL_rer)*DENL_imc
-(NL_pex*DENL_rer)*DENL_imi
-(NL_pex*DENL_rer)*DENL_imcg
-(NL_pex*DENL_rer)*DENL_imig
+DE_pex*PT_size/DE_size*PTDE_im
-(PT_pex*DEPT_rer)*DEPT_imc
-(PT_pex*DEPT_rer)*DEPT_imi
-(PT_pex*DEPT_rer)*DEPT_imcg
-(PT_pex*DEPT_rer)*DEPT_imig
+DE_pex*RU_size/DE_size*RUDE_im
-(RU_pex*DERU_rer)*DERU_imc
-(RU_pex*DERU_rer)*DERU_imi
-(RU_pex*DERU_rer)*DERU_imcg
-(RU_pex*DERU_rer)*DERU_imig
+DE_pex*RW_size/DE_size*RWDE_im
-(RW_pex*DERW_rer)*DERW_imc
-(RW_pex*DERW_rer)*DERW_imi
-(RW_pex*DERW_rer)*DERW_imcg
-(RW_pex*DERW_rer)*DERW_imig
+DE_pex*US_size/DE_size*USDE_im
-(US_pex*DEUS_rer)*DEUS_imc
-(US_pex*DEUS_rer)*DEUS_imi
-(US_pex*DEUS_rer)*DEUS_imcg
-(US_pex*DEUS_rer)*DEUS_imig
;
// Aggregate real demand
DE_y = DE_yst+DE_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(DE_zt) = (1-DE_rhozt)*log(DE_ztbar)+DE_rhozt*log(DE_zt(-1))+DE_epszt;
log(DE_zn) = (1-DE_rhozn)*log(DE_znbar)+DE_rhozn*log(DE_zn(-1))+DE_epszn;
// Government spending shock
DE_cgy = (1-DE_rhocg)*DE_cgybar+DE_rhocg*DE_cgy(-1)+DE_epsgc;
DE_igy = (1-DE_rhoig)*DE_igybar+DE_rhoig*DE_igy(-1)+DE_epsgi;
// Transfer shock
DE_try = (1-DE_rhotr)*DE_trybar+DE_rhotr*DE_try(-1)+DE_epstr;
// Consumption tax shock
DE_tauc = (1-DE_rhotauc)*DE_taucbar+DE_rhotauc*DE_tauc(-1)+DE_epstauc;
// Dividend income tax shock
DE_taud = (1-DE_rhotaud)*DE_taudbar+DE_rhotaud*DE_taud(-1)+DE_epstaud;
// Capital income tax shock
DE_tauk = (1-DE_rhotauk)*DE_taukbar+DE_rhotauk*DE_tauk(-1)+DE_epstauk;
// Labour income tax shock
DE_taun = (1-DE_rhotaun)*DE_taunbar+DE_rhotaun*DE_taun(-1)+DE_epstaun;
// Payroll tax shock: households
DE_tauwh = (1-DE_rhotauwh)*DE_tauwhbar+DE_rhotauwh*DE_tauwh(-1)+DE_epstauwh;
// Payroll tax shock: firms
DE_tauwf = (1-DE_rhotauwf)*DE_tauwfbar+DE_rhotauwf*DE_tauwf(-1)+DE_epstauwf;
// Wage cost push shock
DE_wcst = (1-DE_rhowcst)*DE_wcstbar+DE_rhowcst*DE_wcst(-1)+DE_epswcst;
// Preference shock
log(DE_zcon) = (1-DE_rhozcon)*log(DE_zconbar)+DE_rhozcon*log(DE_zcon(-1))+DE_epszcon;
// Investment specific shock
log(DE_zinv) = (1-DE_rhozinv)*log(DE_zinvbar)+DE_rhozinv*log(DE_zinv(-1))+DE_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
DE_cy = DE_c/(DE_py*DE_y);
// Aggregate nominal investment share
DE_iy = DE_pi*DE_i/(DE_py*DE_y);
// Aggregate nominal import share  
DE_imy = (
+DE_pimc*DE_imc
+DE_pimi*DE_imi
+DE_pimcg*DE_imcg
+DE_pimig*DE_imig
)/(DE_py*DE_y);
// Aggregate nominal import share
DE_imcy = DE_pimc*DE_imc/(DE_py*DE_y);
DE_imiy = DE_pimi*DE_imi/(DE_py*DE_y);
DE_imcgy = DE_pimcg*DE_imcg/(DE_py*DE_y);
DE_imigy = DE_pimig*DE_imig/(DE_py*DE_y);
// Aggregate debt-to-output ratio
DE_by = DE_b/(DE_pybar*DE_ybar);
// Aggregate lump-sum tax-to-output ratio
DE_ty = DE_t/(DE_pybar*DE_ybar);
// Aggregate labour cost share
DE_lcy = ((1+DE_tauwf)*DE_w*DE_nd)/(DE_py*DE_y);
// Aggregate nominal Wage share
DE_wy = (DE_w*DE_nd)/(DE_py*DE_y);
// NT sector nominal Wage share
DE_wnty = (DE_w*DE_ndn)/(DE_pnt*DE_ysn);
// T sector nominal Wage share
DE_whty = (DE_w*DE_ndt)/(DE_pht*DE_yst);
// T sector share
DE_yhty = DE_pht*DE_yst/(DE_py*DE_y);
// NT sector share
DE_ynty = DE_pnt*DE_ysn/(DE_py*DE_y);
// Output gap
DE_ygap = 0;
// Output growth (gross rate)
DE_ygrowth = DE_y/DE_y(-1);
// Output growth (gross rate yoy)
DE_ygrowth4 = DE_y/DE_y(-4);
// Domestic nominal output as a share of world nominal output
DE_yshare  = DE_size*DE_py*DE_y/DE_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
DE_epsilonm = -1/8*1/(DE_r*(DE_gammav2*DE_r+DE_r-1));
// Trade balance-to-GDP ratio
DE_tby = DE_tb/(DE_py*DE_y);
// Bilateral shares
DERA_imcy = (RA_pex*DERA_rer)*DERA_imc/(DE_py*DE_y);
DERA_imiy = (RA_pex*DERA_rer)*DERA_imi/(DE_py*DE_y);
DERA_imcgy = (RA_pex*DERA_rer)*DERA_imcg/(DE_py*DE_y);
DERA_imigy = (RA_pex*DERA_rer)*DERA_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DERA_excy  = RA_size/DE_size*DE_pex*RADE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DERA_exiy  = RA_size/DE_size*DE_pex*RADE_imi/(DE_py*DE_y);
// Bilateral shares
DEAT_imcy = (AT_pex*DEAT_rer)*DEAT_imc/(DE_py*DE_y);
DEAT_imiy = (AT_pex*DEAT_rer)*DEAT_imi/(DE_py*DE_y);
DEAT_imcgy = (AT_pex*DEAT_rer)*DEAT_imcg/(DE_py*DE_y);
DEAT_imigy = (AT_pex*DEAT_rer)*DEAT_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEAT_excy  = AT_size/DE_size*DE_pex*ATDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEAT_exiy  = AT_size/DE_size*DE_pex*ATDE_imi/(DE_py*DE_y);
// Bilateral shares
DEBE_imcy = (BE_pex*DEBE_rer)*DEBE_imc/(DE_py*DE_y);
DEBE_imiy = (BE_pex*DEBE_rer)*DEBE_imi/(DE_py*DE_y);
DEBE_imcgy = (BE_pex*DEBE_rer)*DEBE_imcg/(DE_py*DE_y);
DEBE_imigy = (BE_pex*DEBE_rer)*DEBE_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEBE_excy  = BE_size/DE_size*DE_pex*BEDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEBE_exiy  = BE_size/DE_size*DE_pex*BEDE_imi/(DE_py*DE_y);
// Bilateral shares
DEES_imcy = (ES_pex*DEES_rer)*DEES_imc/(DE_py*DE_y);
DEES_imiy = (ES_pex*DEES_rer)*DEES_imi/(DE_py*DE_y);
DEES_imcgy = (ES_pex*DEES_rer)*DEES_imcg/(DE_py*DE_y);
DEES_imigy = (ES_pex*DEES_rer)*DEES_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEES_excy  = ES_size/DE_size*DE_pex*ESDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEES_exiy  = ES_size/DE_size*DE_pex*ESDE_imi/(DE_py*DE_y);
// Bilateral shares
DEFI_imcy = (FI_pex*DEFI_rer)*DEFI_imc/(DE_py*DE_y);
DEFI_imiy = (FI_pex*DEFI_rer)*DEFI_imi/(DE_py*DE_y);
DEFI_imcgy = (FI_pex*DEFI_rer)*DEFI_imcg/(DE_py*DE_y);
DEFI_imigy = (FI_pex*DEFI_rer)*DEFI_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEFI_excy  = FI_size/DE_size*DE_pex*FIDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEFI_exiy  = FI_size/DE_size*DE_pex*FIDE_imi/(DE_py*DE_y);
// Bilateral shares
DEFR_imcy = (FR_pex*DEFR_rer)*DEFR_imc/(DE_py*DE_y);
DEFR_imiy = (FR_pex*DEFR_rer)*DEFR_imi/(DE_py*DE_y);
DEFR_imcgy = (FR_pex*DEFR_rer)*DEFR_imcg/(DE_py*DE_y);
DEFR_imigy = (FR_pex*DEFR_rer)*DEFR_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEFR_excy  = FR_size/DE_size*DE_pex*FRDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEFR_exiy  = FR_size/DE_size*DE_pex*FRDE_imi/(DE_py*DE_y);
// Bilateral shares
DEGR_imcy = (GR_pex*DEGR_rer)*DEGR_imc/(DE_py*DE_y);
DEGR_imiy = (GR_pex*DEGR_rer)*DEGR_imi/(DE_py*DE_y);
DEGR_imcgy = (GR_pex*DEGR_rer)*DEGR_imcg/(DE_py*DE_y);
DEGR_imigy = (GR_pex*DEGR_rer)*DEGR_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEGR_excy  = GR_size/DE_size*DE_pex*GRDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEGR_exiy  = GR_size/DE_size*DE_pex*GRDE_imi/(DE_py*DE_y);
// Bilateral shares
DEIT_imcy = (IT_pex*DEIT_rer)*DEIT_imc/(DE_py*DE_y);
DEIT_imiy = (IT_pex*DEIT_rer)*DEIT_imi/(DE_py*DE_y);
DEIT_imcgy = (IT_pex*DEIT_rer)*DEIT_imcg/(DE_py*DE_y);
DEIT_imigy = (IT_pex*DEIT_rer)*DEIT_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEIT_excy  = IT_size/DE_size*DE_pex*ITDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEIT_exiy  = IT_size/DE_size*DE_pex*ITDE_imi/(DE_py*DE_y);
// Bilateral shares
DENL_imcy = (NL_pex*DENL_rer)*DENL_imc/(DE_py*DE_y);
DENL_imiy = (NL_pex*DENL_rer)*DENL_imi/(DE_py*DE_y);
DENL_imcgy = (NL_pex*DENL_rer)*DENL_imcg/(DE_py*DE_y);
DENL_imigy = (NL_pex*DENL_rer)*DENL_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DENL_excy  = NL_size/DE_size*DE_pex*NLDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DENL_exiy  = NL_size/DE_size*DE_pex*NLDE_imi/(DE_py*DE_y);
// Bilateral shares
DEPT_imcy = (PT_pex*DEPT_rer)*DEPT_imc/(DE_py*DE_y);
DEPT_imiy = (PT_pex*DEPT_rer)*DEPT_imi/(DE_py*DE_y);
DEPT_imcgy = (PT_pex*DEPT_rer)*DEPT_imcg/(DE_py*DE_y);
DEPT_imigy = (PT_pex*DEPT_rer)*DEPT_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEPT_excy  = PT_size/DE_size*DE_pex*PTDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEPT_exiy  = PT_size/DE_size*DE_pex*PTDE_imi/(DE_py*DE_y);
// Bilateral shares
DERU_imcy = (RU_pex*DERU_rer)*DERU_imc/(DE_py*DE_y);
DERU_imiy = (RU_pex*DERU_rer)*DERU_imi/(DE_py*DE_y);
DERU_imcgy = (RU_pex*DERU_rer)*DERU_imcg/(DE_py*DE_y);
DERU_imigy = (RU_pex*DERU_rer)*DERU_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DERU_excy  = RU_size/DE_size*DE_pex*RUDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DERU_exiy  = RU_size/DE_size*DE_pex*RUDE_imi/(DE_py*DE_y);
// Bilateral shares
DERW_imcy = (RW_pex*DERW_rer)*DERW_imc/(DE_py*DE_y);
DERW_imiy = (RW_pex*DERW_rer)*DERW_imi/(DE_py*DE_y);
DERW_imcgy = (RW_pex*DERW_rer)*DERW_imcg/(DE_py*DE_y);
DERW_imigy = (RW_pex*DERW_rer)*DERW_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DERW_excy  = RW_size/DE_size*DE_pex*RWDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DERW_exiy  = RW_size/DE_size*DE_pex*RWDE_imi/(DE_py*DE_y);
// Bilateral shares
DEUS_imcy = (US_pex*DEUS_rer)*DEUS_imc/(DE_py*DE_y);
DEUS_imiy = (US_pex*DEUS_rer)*DEUS_imi/(DE_py*DE_y);
DEUS_imcgy = (US_pex*DEUS_rer)*DEUS_imcg/(DE_py*DE_y);
DEUS_imigy = (US_pex*DEUS_rer)*DEUS_imig/(DE_py*DE_y);
// Exports of consumption goods to gdp
DEUS_excy  = US_size/DE_size*DE_pex*USDE_imc/(DE_py*DE_y);
// Exports of investment goods to gdp
DEUS_exiy  = US_size/DE_size*DE_pex*USDE_imi/(DE_py*DE_y);
// Internal real exchange rate
DE_internalrer = DE_pnt/DE_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
RU_ccesi^(1-1/RU_mucces) = (RU_nucces)^(1/RU_mucces)*RU_ci^(1-1/RU_mucces)+(1-RU_nucces)^(1/RU_mucces)*RU_cg^(1-1/RU_mucces);
// Utility
RU_utili = 
RU_zcon*log(RU_ccesi-RU_kappa*RU_ccesi(-1))-1/(1+RU_zeta)*(RU_ni)^(1+RU_zeta)+RU_beta*RU_utili(+1)
;
// Marginal utility of consumption
RU_dcci = ((RU_nucces)^(1/RU_mucces)*RU_ci^(1-1/RU_mucces)+(1-RU_nucces)^(1/RU_mucces)*RU_cg^(1-1/RU_mucces))^(1/(RU_mucces-1))*(RU_nucces^(1/RU_mucces))*(RU_ci^(-1/RU_mucces));
RU_lambdai*(1+RU_tauc+RU_gammavi+RU_vi*RU_gammavider) = RU_zcon*(RU_ccesi-RU_kappa*RU_ccesi(-1))^(-RU_sigma)*RU_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
// Germany
// US and the RoW
RU_r = RU_beta^(-1)*RU_lambdai/RU_lambdai(+1)*RU_pic(+1);
// Euler equation for money
RU_vi^(2)*RU_gammavider = 1-RU_beta*RU_lambdai(+1)/(RU_lambdai*RU_pic(+1));
// Consumption-based velocity
RU_vi = RU_ci/RU_mi;
// Transaction cost
RU_gammavi = RU_gammav1*RU_vi+RU_gammav2/RU_vi-2*(RU_gammav1*RU_gammav2)^(1/2);
// Derivative of transaction cost
RU_gammavider = RU_gammav1-RU_gammav2*RU_vi^(-2);
RU_delta = RU_ii/RU_ki;
RU_gammai = 0;
RU_gammaider = 0;
RU_gammau = 0;
RU_gammauder = ((RU_beta^(-1)-1+RU_delta)*RU_qbar-RU_delta*RU_taukbar*RU_pibar)/((1-RU_taukbar)*RU_pibar);
RU_u = 1;
RU_pi = RU_q;
// Auxiliary equation for Tobin's Q in steady state
RU_qbar = RU_q;
// Rate of return on capital
RU_q = RU_beta*((1-RU_tauk)*RU_rk+(RU_tauk*RU_delta)*RU_pi+(1-RU_delta)*RU_q);
// Optimal wage contract (FOC)
RU_witilde^(1+RU_etai*RU_zeta) = RU_etai/(RU_etai-1)*RU_fi/RU_gi+RU_wcst;
// Definition of fi
RU_fi = RU_wi^(RU_etai*(1+RU_zeta))*RU_ndi^(1+RU_zeta)+RU_xii*RU_beta*(RU_pic(+1)/(RU_pic^RU_chii*RU_pi4target^(1/4*(1-RU_chii))))^(RU_etai*(1+RU_zeta))*RU_fi(+1);
// Definition of gi
RU_gi = RU_lambdai*(1-RU_taun-RU_tauwh)*RU_wi^RU_etai*RU_ndi+RU_xii*RU_beta*(RU_pic(+1)/(RU_pic^RU_chii*RU_pi4target^(1/4*(1-RU_chii))))^(RU_etai-1)*RU_gi(+1);
// Aggregate wage rate
RU_wi^(1-RU_etai) = (1-RU_xii)*RU_witilde^(1-RU_etai)+RU_xii*RU_wi(-1)^(1-RU_etai)*(RU_pic(-1)^RU_chii*RU_pi4target^(1/4*(1-RU_chii))/RU_pic)^(1-RU_etai);
//-------------
// Household J
//-------------
RU_ccesj^(1-1/RU_mucces) = (RU_nucces)^(1/RU_mucces)*RU_cj^(1-1/RU_mucces)+(1-RU_nucces)^(1/RU_mucces)*RU_cg^(1-1/RU_mucces);
// Utility
RU_utilj = 
RU_zcon*log(RU_ccesj-RU_kappa*RU_ccesj(-1))-1/(1+RU_zeta)*(RU_nj)^(1+RU_zeta)+RU_beta*RU_utilj(+1)
;
// Marginal utility of consumption
RU_dccj = ((RU_nucces)^(1/RU_mucces)*RU_cj^(1-1/RU_mucces)+(1-RU_nucces)^(1/RU_mucces)*RU_cg^(1-1/RU_mucces))^(1/(RU_mucces-1))*(RU_nucces^(1/RU_mucces))*(RU_cj^(-1/RU_mucces));
RU_lambdaj*(1+RU_tauc+RU_gammavj+RU_vj*RU_gammavjder) = RU_zcon*(RU_ccesj-RU_kappa*RU_ccesj(-1))^(-RU_sigma)*RU_dccj;
// Budget constraint
(1+RU_tauc+RU_gammavj)*RU_cj+RU_mj = (1-RU_taun-RU_tauwh)*RU_wj*RU_nj+RU_trj-RU_tj+RU_mj(-1)*RU_pic^(-1);
// Euler equation for money
RU_vj^(2)*RU_gammavjder = 1-RU_beta*RU_lambdaj(+1)/(RU_lambdaj*RU_pic(+1));
// Consumption-based velocity
RU_vj = RU_cj/RU_mj;
// Transaction technology
RU_gammavj = RU_gammav1*RU_vj+RU_gammav2/RU_vj-2*(RU_gammav1*RU_gammav2)^(1/2);
// Derivative of transaction technology
RU_gammavjder = RU_gammav1-RU_gammav2*RU_vj^(-2);
// Optimal wage contract (FOC)
RU_wjtilde^(1+RU_etaj*RU_zeta) = RU_etaj/(RU_etaj-1)*RU_fj/RU_gj+RU_wcst;
// Definition of fj
RU_fj = RU_wj^(RU_etaj*(1+RU_zeta))*RU_ndj^(1+RU_zeta)+RU_xij*RU_beta*(RU_pic(+1)/(RU_pic^RU_chij*RU_pi4target^(1/4*(1-RU_chij))))^(RU_etaj*(1+RU_zeta))*RU_fj(+1);
// Definition of gj
RU_gj = RU_lambdaj*(1-RU_taun-RU_tauwh)*RU_wj^RU_etaj*RU_ndj+RU_xij*RU_beta*(RU_pic(+1)/(RU_pic^RU_chij*RU_pi4target^(1/4*(1-RU_chij))))^(RU_etaj-1)*RU_gj(+1);
// Aggregate wage rate
RU_wj^(1-RU_etaj) = (1-RU_xij)*RU_wjtilde^(1-RU_etaj)+RU_xij*RU_wj(-1)^(1-RU_etaj)*(RU_pic(-1)^RU_chij*RU_pi4target^(1/4*(1-RU_chij))/RU_pic)^(1-RU_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
RU_kg = (1-RU_deltag)*RU_kg(-1)+RU_ig(-1);
// Production function tradable
RU_yst = RU_zt*RU_kg^RU_alphag*RU_kdt^RU_alphat*RU_ndt^(1-RU_alphat)-RU_psitbar;
// Production function nontradable
RU_ysn = RU_zn*RU_kg^RU_alphag*RU_kdn^RU_alphan*RU_ndn^(1-RU_alphan)-RU_psinbar;
// Real marginal cost tradable
RU_mct = 1/(RU_zt*RU_kg^RU_alphag*(RU_alphat)^(RU_alphat)*(1-RU_alphat)^(1-RU_alphat))*RU_rk^(RU_alphat)*((1+RU_tauwf)*RU_w)^(1-RU_alphat);
// Real marginal cost nontradable
RU_mcn = 1/(RU_zn*RU_kg^RU_alphag*(RU_alphan)^(RU_alphan)*(1-RU_alphan)^(1-RU_alphan))*RU_rk^(RU_alphan)*((1+RU_tauwf)*RU_w)^(1-RU_alphan);
// Wage Inflation (qoq)
RU_piw = RU_w/RU_w(-1)*RU_pic;
// Wage Inflation (yoy)
RU_piw4 = RU_pic4;
// Auxiliary equation for steady-state fixed cost
RU_psitbar = RU_psit*RU_ytbar;
// Auxiliary equation for steady-state fixed cost
RU_psinbar = RU_psin*RU_ynbar;
// Capital input (FOC)
RU_rk = RU_alphat*(RU_yst+RU_psitbar)/RU_kdt*RU_mct;
// Capital input (FOC)
RU_rk = RU_alphan*(RU_ysn+RU_psinbar)/RU_kdn*RU_mcn;
// Total capital demand
RU_kd = RU_kdt+RU_kdn;
// Demand for labour services by household I
RU_ndi = 
(1-RU_omega)*(RU_wi/RU_w)^(-RU_eta)*RU_nd
;
// Demand for labour services by household J
RU_ndj = 
RU_omega*(RU_wj/RU_w)^(-RU_eta)*RU_nd
;
// Aggregate labour demand
RU_nd^(1-1/RU_eta) = 
(1-RU_omega)^(1/RU_eta)*RU_ndi^(1-1/RU_eta)+RU_omega^(1/RU_eta)*RU_ndj^(1-1/RU_eta)
;
// Total demand 
RU_nd = RU_ndt+RU_ndn;
// Aggregate dividends
RU_d = RU_py*RU_y-RU_rk*RU_kd-(1+RU_tauwf)*RU_w*RU_nd;
// Non-tradable sector dividends
RU_dn = RU_pnt*RU_ysn-RU_rk*RU_kdn-(1+RU_tauwf)*RU_w*RU_ndn;
// Tradable sector dividends
RU_dt = RU_pht*RU_ht
+RU_pex*RU_ex
-RU_rk*RU_kdt-(1+RU_tauwf)*RU_w*RU_ndt;
// Optimal price contract set in domestic markets (FOC)
RU_phttilde/RU_pht = RU_thetat/(RU_thetat-1)*RU_fh/RU_gh;
// Definition of fh
RU_fh = RU_mct*RU_ht+RU_xih*RU_beta*RU_lambdai(+1)/RU_lambdai*(RU_piht(+1)/(RU_piht^RU_chih*RU_pi4target^(1/4*(1-RU_chih))))^RU_thetat*RU_fh(+1);
// Definition of gh
RU_gh = RU_pht*RU_ht+RU_xih*RU_beta*RU_lambdai(+1)/RU_lambdai*(RU_piht(+1)/(RU_piht^RU_chih*RU_pi4target^(1/4*(1-RU_chih))))^(RU_thetat-1)*RU_gh(+1);
// Aggregate intermediate-good price dynamics
RU_pht^(1-RU_thetat) = (1-RU_xih)*RU_phttilde^(1-RU_thetat)+RU_xih*(RU_pht(-1)/RU_pic)^(1-RU_thetat)*(RU_piht(-1)^RU_chih*RU_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation
RU_piht = RU_pht/RU_pht(-1)*RU_pic;
// Optimal price contract set in domestic markets (FOC)
RU_pnttilde/RU_pnt = RU_thetan/(RU_thetan-1)*RU_fn/RU_gn;
// Definition of fn
RU_fn = RU_mcn*RU_nt+RU_xin*RU_beta*RU_lambdai(+1)/RU_lambdai*(RU_pint(+1)/(RU_pint^RU_chin*RU_pi4target^(1/4*(1-RU_chin))))^RU_thetan*RU_fn(+1);
// Definition of gn
RU_gn = RU_pnt*RU_nt+RU_xin*RU_beta*RU_lambdai(+1)/RU_lambdai*(RU_pint(+1)/(RU_pint^RU_chin*RU_pi4target^(1/4*(1-RU_chin))))^(RU_thetan-1)*RU_gn(+1);
// Aggregate intermediate-good price dynamics
RU_pnt^(1-RU_thetan) = (1-RU_xin)*RU_pnttilde^(1-RU_thetan)+RU_xin*(RU_pnt(-1)/RU_pic)^(1-RU_thetan)*(RU_pint(-1)^RU_chin*RU_pi4target^(1/4*(1-RU_chin)))^(1-RU_thetan);
// Intermediate-good price inflation
RU_pint = RU_pnt/RU_pnt(-1)*RU_pic;
// Optimal price contract set in domestic markets (FOC)
RU_pextilde/RU_pex = RU_thetat/(RU_thetat-1)*RU_fx/RU_gx;
// Definition of fh
RU_fx = RU_mct*RU_ex+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(RU_piex(+1)/(RU_piex^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RU_fx(+1);
// Definition of gh
RU_gx = RU_pex*RU_ex+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(RU_piex(+1)/(RU_piex^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RU_gx(+1);
// Aggregate intermediate-good price dynamics
RU_pex^(1-RU_thetat) = (1-RU_xix)*RU_pextilde^(1-RU_thetat)+RU_xix*(RU_pex(-1)/RU_pic)^(1-RU_thetat)*(RU_piex(-1)^RU_chix*RU_pi4target^(1/4*(1-RU_chix)))^(1-RU_thetat);
// Intermediate-good price inflation
RU_piex = RU_pex/RU_pex(-1)*RU_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = RA_pimtilde
// RARU_pimtilde/RARU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RURA_fx/RURA_gx;
// Definition of fx
// RURA_fx = RA_size/RU_size*RARU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(RARU_piim(+1)/(RARU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RURA_fx(+1);
// Definition of gx   
// RURA_gx = RURA_rer*RARU_pim*RA_size/RU_size*RARU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(RARU_piim(+1)/(RARU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RURA_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = RA_pim
// RARU_pim^(1-RU_thetat) = (1-RU_xix)*RARU_pimtilde^(1-RU_thetat)+RU_xix*(RARU_pim(-1)/RA_pic)^(1-RU_thetat)*(RARU_piim(-1)^RU_chix*RA_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = RA_piim
// RARU_piim = RARU_pim/RARU_pim(-1)*RA_pic;
// Bilateral real exchange rate
RURA_rer = RU_rer/RA_rer;
// Auxiliary equation for steady-state output
RURA_rerbar = RURA_rer;
//Terms of Trade
RURA_tot = RA_pex*RURA_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = AT_pimtilde
// ATRU_pimtilde/ATRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUAT_fx/RUAT_gx;
// Definition of fx
// RUAT_fx = AT_size/RU_size*ATRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(ATRU_piim(+1)/(ATRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUAT_fx(+1);
// Definition of gx   
// RUAT_gx = RUAT_rer*ATRU_pim*AT_size/RU_size*ATRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(ATRU_piim(+1)/(ATRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUAT_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = AT_pim
// ATRU_pim^(1-RU_thetat) = (1-RU_xix)*ATRU_pimtilde^(1-RU_thetat)+RU_xix*(ATRU_pim(-1)/AT_pic)^(1-RU_thetat)*(ATRU_piim(-1)^RU_chix*AT_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = AT_piim
// ATRU_piim = ATRU_pim/ATRU_pim(-1)*AT_pic;
// Bilateral real exchange rate
RUAT_rer = RU_rer/AT_rer;
// Auxiliary equation for steady-state output
RUAT_rerbar = RUAT_rer;
//Terms of Trade
RUAT_tot = AT_pex*RUAT_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = BE_pimtilde
// BERU_pimtilde/BERU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUBE_fx/RUBE_gx;
// Definition of fx
// RUBE_fx = BE_size/RU_size*BERU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(BERU_piim(+1)/(BERU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUBE_fx(+1);
// Definition of gx   
// RUBE_gx = RUBE_rer*BERU_pim*BE_size/RU_size*BERU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(BERU_piim(+1)/(BERU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUBE_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = BE_pim
// BERU_pim^(1-RU_thetat) = (1-RU_xix)*BERU_pimtilde^(1-RU_thetat)+RU_xix*(BERU_pim(-1)/BE_pic)^(1-RU_thetat)*(BERU_piim(-1)^RU_chix*BE_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = BE_piim
// BERU_piim = BERU_pim/BERU_pim(-1)*BE_pic;
// Bilateral real exchange rate
RUBE_rer = RU_rer/BE_rer;
// Auxiliary equation for steady-state output
RUBE_rerbar = RUBE_rer;
//Terms of Trade
RUBE_tot = BE_pex*RUBE_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = ES_pimtilde
// ESRU_pimtilde/ESRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUES_fx/RUES_gx;
// Definition of fx
// RUES_fx = ES_size/RU_size*ESRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(ESRU_piim(+1)/(ESRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUES_fx(+1);
// Definition of gx   
// RUES_gx = RUES_rer*ESRU_pim*ES_size/RU_size*ESRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(ESRU_piim(+1)/(ESRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUES_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = ES_pim
// ESRU_pim^(1-RU_thetat) = (1-RU_xix)*ESRU_pimtilde^(1-RU_thetat)+RU_xix*(ESRU_pim(-1)/ES_pic)^(1-RU_thetat)*(ESRU_piim(-1)^RU_chix*ES_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = ES_piim
// ESRU_piim = ESRU_pim/ESRU_pim(-1)*ES_pic;
// Bilateral real exchange rate
RUES_rer = RU_rer/ES_rer;
// Auxiliary equation for steady-state output
RUES_rerbar = RUES_rer;
//Terms of Trade
RUES_tot = ES_pex*RUES_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = FI_pimtilde
// FIRU_pimtilde/FIRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUFI_fx/RUFI_gx;
// Definition of fx
// RUFI_fx = FI_size/RU_size*FIRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(FIRU_piim(+1)/(FIRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUFI_fx(+1);
// Definition of gx   
// RUFI_gx = RUFI_rer*FIRU_pim*FI_size/RU_size*FIRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(FIRU_piim(+1)/(FIRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUFI_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = FI_pim
// FIRU_pim^(1-RU_thetat) = (1-RU_xix)*FIRU_pimtilde^(1-RU_thetat)+RU_xix*(FIRU_pim(-1)/FI_pic)^(1-RU_thetat)*(FIRU_piim(-1)^RU_chix*FI_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = FI_piim
// FIRU_piim = FIRU_pim/FIRU_pim(-1)*FI_pic;
// Bilateral real exchange rate
RUFI_rer = RU_rer/FI_rer;
// Auxiliary equation for steady-state output
RUFI_rerbar = RUFI_rer;
//Terms of Trade
RUFI_tot = FI_pex*RUFI_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = FR_pimtilde
// FRRU_pimtilde/FRRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUFR_fx/RUFR_gx;
// Definition of fx
// RUFR_fx = FR_size/RU_size*FRRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(FRRU_piim(+1)/(FRRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUFR_fx(+1);
// Definition of gx   
// RUFR_gx = RUFR_rer*FRRU_pim*FR_size/RU_size*FRRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(FRRU_piim(+1)/(FRRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUFR_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = FR_pim
// FRRU_pim^(1-RU_thetat) = (1-RU_xix)*FRRU_pimtilde^(1-RU_thetat)+RU_xix*(FRRU_pim(-1)/FR_pic)^(1-RU_thetat)*(FRRU_piim(-1)^RU_chix*FR_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = FR_piim
// FRRU_piim = FRRU_pim/FRRU_pim(-1)*FR_pic;
// Bilateral real exchange rate
RUFR_rer = RU_rer/FR_rer;
// Auxiliary equation for steady-state output
RUFR_rerbar = RUFR_rer;
//Terms of Trade
RUFR_tot = FR_pex*RUFR_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = GR_pimtilde
// GRRU_pimtilde/GRRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUGR_fx/RUGR_gx;
// Definition of fx
// RUGR_fx = GR_size/RU_size*GRRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(GRRU_piim(+1)/(GRRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUGR_fx(+1);
// Definition of gx   
// RUGR_gx = RUGR_rer*GRRU_pim*GR_size/RU_size*GRRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(GRRU_piim(+1)/(GRRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUGR_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = GR_pim
// GRRU_pim^(1-RU_thetat) = (1-RU_xix)*GRRU_pimtilde^(1-RU_thetat)+RU_xix*(GRRU_pim(-1)/GR_pic)^(1-RU_thetat)*(GRRU_piim(-1)^RU_chix*GR_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = GR_piim
// GRRU_piim = GRRU_pim/GRRU_pim(-1)*GR_pic;
// Bilateral real exchange rate
RUGR_rer = RU_rer/GR_rer;
// Auxiliary equation for steady-state output
RUGR_rerbar = RUGR_rer;
//Terms of Trade
RUGR_tot = GR_pex*RUGR_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = IT_pimtilde
// ITRU_pimtilde/ITRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUIT_fx/RUIT_gx;
// Definition of fx
// RUIT_fx = IT_size/RU_size*ITRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(ITRU_piim(+1)/(ITRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUIT_fx(+1);
// Definition of gx   
// RUIT_gx = RUIT_rer*ITRU_pim*IT_size/RU_size*ITRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(ITRU_piim(+1)/(ITRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUIT_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = IT_pim
// ITRU_pim^(1-RU_thetat) = (1-RU_xix)*ITRU_pimtilde^(1-RU_thetat)+RU_xix*(ITRU_pim(-1)/IT_pic)^(1-RU_thetat)*(ITRU_piim(-1)^RU_chix*IT_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = IT_piim
// ITRU_piim = ITRU_pim/ITRU_pim(-1)*IT_pic;
// Bilateral real exchange rate
RUIT_rer = RU_rer/IT_rer;
// Auxiliary equation for steady-state output
RUIT_rerbar = RUIT_rer;
//Terms of Trade
RUIT_tot = IT_pex*RUIT_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = NL_pimtilde
// NLRU_pimtilde/NLRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUNL_fx/RUNL_gx;
// Definition of fx
// RUNL_fx = NL_size/RU_size*NLRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(NLRU_piim(+1)/(NLRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUNL_fx(+1);
// Definition of gx   
// RUNL_gx = RUNL_rer*NLRU_pim*NL_size/RU_size*NLRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(NLRU_piim(+1)/(NLRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUNL_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = NL_pim
// NLRU_pim^(1-RU_thetat) = (1-RU_xix)*NLRU_pimtilde^(1-RU_thetat)+RU_xix*(NLRU_pim(-1)/NL_pic)^(1-RU_thetat)*(NLRU_piim(-1)^RU_chix*NL_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = NL_piim
// NLRU_piim = NLRU_pim/NLRU_pim(-1)*NL_pic;
// Bilateral real exchange rate
RUNL_rer = RU_rer/NL_rer;
// Auxiliary equation for steady-state output
RUNL_rerbar = RUNL_rer;
//Terms of Trade
RUNL_tot = NL_pex*RUNL_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = PT_pimtilde
// PTRU_pimtilde/PTRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUPT_fx/RUPT_gx;
// Definition of fx
// RUPT_fx = PT_size/RU_size*PTRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(PTRU_piim(+1)/(PTRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUPT_fx(+1);
// Definition of gx   
