// Total imports 
DE_im = 
+DE_imc
+DE_imi
+DE_imcg
+DE_imig
;
// Total import deflator
DE_im*DE_pim  = 
+DE_pimc*DE_imc
+DE_pimi*DE_imi
+DE_pimcg*DE_imcg
+DE_pimig*DE_imig
;
// Effective real exchange rate: double weighting (imports)
DERA_weightim = DERA_rer*RA_pex*DERA_im/(DE_pim*DE_im);
// Effective real exchange rate: double weighting (exports)
DERA_weightex = RA_size/DE_size*RADE_im/DE_ex*DERA_rer*RA_py*RA_y/(DERA_rer*RA_py*RA_y
+DEAT_rer*AT_pex*RAAT_im
+DEBE_rer*BE_pex*RABE_im
+DEES_rer*ES_pex*RAES_im
+DEFI_rer*FI_pex*RAFI_im
+DEFR_rer*FR_pex*RAFR_im
+DEGR_rer*GR_pex*RAGR_im
+DEIT_rer*IT_pex*RAIT_im
+DENL_rer*NL_pex*RANL_im
+DEPT_rer*PT_pex*RAPT_im
+DERU_rer*RU_pex*RARU_im
+DERW_rer*RW_pex*RARW_im
+DEUS_rer*US_pex*RAUS_im
)+
+AT_size/DE_size*ATDE_im/DE_ex*DERA_rer*RA_pex*ATRA_im/(DEAT_rer*AT_py*AT_y
+DERA_rer*RA_pex*ATRA_im
+DEBE_rer*BE_pex*ATBE_im
+DEES_rer*ES_pex*ATES_im
+DEFI_rer*FI_pex*ATFI_im
+DEFR_rer*FR_pex*ATFR_im
+DEGR_rer*GR_pex*ATGR_im
+DEIT_rer*IT_pex*ATIT_im
+DENL_rer*NL_pex*ATNL_im
+DEPT_rer*PT_pex*ATPT_im
+DERU_rer*RU_pex*ATRU_im
+DERW_rer*RW_pex*ATRW_im
+DEUS_rer*US_pex*ATUS_im
)
+BE_size/DE_size*BEDE_im/DE_ex*DERA_rer*RA_pex*BERA_im/(DEBE_rer*BE_py*BE_y
+DERA_rer*RA_pex*BERA_im
+DEAT_rer*AT_pex*BEAT_im
+DEES_rer*ES_pex*BEES_im
+DEFI_rer*FI_pex*BEFI_im
