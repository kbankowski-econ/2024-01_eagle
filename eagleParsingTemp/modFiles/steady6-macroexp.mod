// Aggregate intermediate-good price dynamics, using GR_px = IT_pim
// ITGR_pim^(1-GR_thetat) = (1-GR_xix)*ITGR_pimtilde^(1-GR_thetat)+GR_xix*(ITGR_pim(-1)/IT_pic)^(1-GR_thetat)*(ITGR_piim(-1)^GR_chix*IT_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = IT_piim
// ITGR_piim = ITGR_pim/ITGR_pim(-1)*IT_pic;
// Bilateral real exchange rate
GRIT_rer = GR_rer/IT_rer;
// Auxiliary equation for steady-state output
GRIT_rerbar = GRIT_rer;
//Terms of Trade
GRIT_tot = IT_pex*GRIT_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = NL_pimtilde
// NLGR_pimtilde/NLGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRNL_fx/GRNL_gx;
// Definition of fx
// GRNL_fx = NL_size/GR_size*NLGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(NLGR_piim(+1)/(NLGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRNL_fx(+1);
// Definition of gx   
// GRNL_gx = GRNL_rer*NLGR_pim*NL_size/GR_size*NLGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(NLGR_piim(+1)/(NLGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRNL_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = NL_pim
// NLGR_pim^(1-GR_thetat) = (1-GR_xix)*NLGR_pimtilde^(1-GR_thetat)+GR_xix*(NLGR_pim(-1)/NL_pic)^(1-GR_thetat)*(NLGR_piim(-1)^GR_chix*NL_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = NL_piim
// NLGR_piim = NLGR_pim/NLGR_pim(-1)*NL_pic;
// Bilateral real exchange rate
GRNL_rer = GR_rer/NL_rer;
// Auxiliary equation for steady-state output
GRNL_rerbar = GRNL_rer;
//Terms of Trade
GRNL_tot = NL_pex*GRNL_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = PT_pimtilde
// PTGR_pimtilde/PTGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRPT_fx/GRPT_gx;
// Definition of fx
// GRPT_fx = PT_size/GR_size*PTGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(PTGR_piim(+1)/(PTGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRPT_fx(+1);
// Definition of gx   
// GRPT_gx = GRPT_rer*PTGR_pim*PT_size/GR_size*PTGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(PTGR_piim(+1)/(PTGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRPT_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = PT_pim
// PTGR_pim^(1-GR_thetat) = (1-GR_xix)*PTGR_pimtilde^(1-GR_thetat)+GR_xix*(PTGR_pim(-1)/PT_pic)^(1-GR_thetat)*(PTGR_piim(-1)^GR_chix*PT_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = PT_piim
// PTGR_piim = PTGR_pim/PTGR_pim(-1)*PT_pic;
// Bilateral real exchange rate
GRPT_rer = GR_rer/PT_rer;
// Auxiliary equation for steady-state output
GRPT_rerbar = GRPT_rer;
//Terms of Trade
GRPT_tot = PT_pex*GRPT_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = DE_pimtilde
// DEGR_pimtilde/DEGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRDE_fx/GRDE_gx;
// Definition of fx
// GRDE_fx = DE_size/GR_size*DEGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(DEGR_piim(+1)/(DEGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRDE_fx(+1);
// Definition of gx   
// GRDE_gx = GRDE_rer*DEGR_pim*DE_size/GR_size*DEGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(DEGR_piim(+1)/(DEGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRDE_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = DE_pim
// DEGR_pim^(1-GR_thetat) = (1-GR_xix)*DEGR_pimtilde^(1-GR_thetat)+GR_xix*(DEGR_pim(-1)/DE_pic)^(1-GR_thetat)*(DEGR_piim(-1)^GR_chix*DE_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = DE_piim
// DEGR_piim = DEGR_pim/DEGR_pim(-1)*DE_pic;
// Bilateral real exchange rate
GRDE_rer = GR_rer/DE_rer;
// Auxiliary equation for steady-state output
GRDE_rerbar = GRDE_rer;
//Terms of Trade
GRDE_tot = DE_pex*GRDE_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = RU_pimtilde
// RUGR_pimtilde/RUGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRRU_fx/GRRU_gx;
// Definition of fx
// GRRU_fx = RU_size/GR_size*RUGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(RUGR_piim(+1)/(RUGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRRU_fx(+1);
// Definition of gx   
// GRRU_gx = GRRU_rer*RUGR_pim*RU_size/GR_size*RUGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(RUGR_piim(+1)/(RUGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRRU_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = RU_pim
// RUGR_pim^(1-GR_thetat) = (1-GR_xix)*RUGR_pimtilde^(1-GR_thetat)+GR_xix*(RUGR_pim(-1)/RU_pic)^(1-GR_thetat)*(RUGR_piim(-1)^GR_chix*RU_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = RU_piim
