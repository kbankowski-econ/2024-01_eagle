// Private consumption good (tradable)
DE_ttc^((DE_mutc-1)/DE_mutc) = (DE_nutc)^(1/DE_mutc)*DE_htc^(1-1/DE_mutc)+(1-DE_nutc)^(1/DE_mutc)*DE_imc^(1-1/DE_mutc);
// Private consumption good  (total)
DE_qc^((DE_muc-1)/DE_muc) = (DE_nuc)^(1/DE_muc)*DE_ttc^(1-1/DE_muc)+(1-DE_nuc)^(1/DE_muc)*DE_ntc^(1-1/DE_muc);
// Demand for domestic intermediate goods - NONTRADABLE
DE_ntc = (1-DE_nuc)*(DE_pnt)^(-DE_muc)*DE_qc;
// Price of the consumption good (tradable)  
DE_pttc^(1-DE_mutc) = (DE_nutc)*DE_pht^(1-DE_mutc)+(1-DE_nutc)*DE_pimc^(1-DE_mutc);
// Price of the consumption good 
1^(1-DE_muc) = (DE_nuc)*DE_pttc^(1-DE_muc)+(1-DE_nuc)*DE_pnt^(1-DE_muc);
// Demand for domestic intermediate goods
DE_htc = DE_nutc*(DE_pht/DE_pttc)^(-DE_mutc)*DE_ttc;
