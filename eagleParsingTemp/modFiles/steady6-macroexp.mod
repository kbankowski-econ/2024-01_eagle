)
+NL_size/AT_size*NLAT_im/AT_ex*ATRA_rer*RA_pex*NLRA_im/(ATNL_rer*NL_py*NL_y
+ATRA_rer*RA_pex*NLRA_im
+ATBE_rer*BE_pex*NLBE_im
+ATES_rer*ES_pex*NLES_im
+ATFI_rer*FI_pex*NLFI_im
+ATFR_rer*FR_pex*NLFR_im
