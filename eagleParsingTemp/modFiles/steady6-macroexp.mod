				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
		* BE_pic4^(BE_size/(
				+ RA_size
				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
