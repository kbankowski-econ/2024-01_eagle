//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using RU_pg = RU_pht
// TODO: check the (1-RU_gammab(-1)) adjustment here, which is not in the fiscal extention
	RU_pcg(-1)*RU_cg(-1)+RU_pig(-1)*RU_ig(-1)+RU_tr(-1)
	+RU_b(-1)*RU_pic(-1)^(-1)+RU_m(-2)*RU_pic(-1)^(-1) = RU_tauc(-1)*RU_c(-1)+(RU_taun(-1)+RU_tauwh(-1))*(RU_wi(-1)*RU_ndi(-1)+RU_wj(-1)*RU_ndj(-1))+RU_tauwf(-1)*RU_w(-1)*RU_nd(-1)+RU_tauk(-1)*(RU_rk(-1)*RU_u(-1)-(RU_gammau(-1)+RU_delta)*RU_pi(-1))*RU_k(-1)+RU_taud(-1)*RU_d(-1)+RU_t(-1)+(RU_r(-1))^(-1)*RU_b+RU_m(-1);
// Government spending, using RU_pg = RU_pht
RU_pcg*RU_cg = RU_cgy*RU_pybar*RU_ybar;
RU_pig*RU_ig = RU_igy*RU_pybar*RU_ybar;
RU_t = 0;
RU_b = RU_bytarget*RU_pybar*RU_ybar;
// Auxiliary equation for steady-state output
RU_ybar = RU_y;
// Auxiliary equation for steady-state output
RU_ytbar = RU_yst;
// Auxiliary equation for steady-state output
RU_ynbar = RU_ysn;
// Auxiliary equation for steady-state output deflator
RU_pybar = RU_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
RU_trybar = RU_tr/(RU_pybar*RU_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
RU_ti = RU_upsilont*RU_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
RU_tri = RU_upsilontr*RU_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	RU_r^4-1 = RU_rrstar^4*RU_pi4target-1;
RU_pic4 = RU_pi4target;
RU_rr-1 = RU_r/RU_pi4target^(1/4)-1;
// Equilibrium real interest rate
RU_rrstar-1 = 1/RU_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
RU_c = (1-RU_omega)*RU_ci+RU_omega*RU_cj;
// Aggregate money holdings
RU_m = (1-RU_omega)*RU_mi+RU_omega*RU_mj;
// Aggregate capital stock
RU_k = (1-RU_omega)*RU_ki;
// Aggregate investment
RU_i = (1-RU_omega)*RU_ii;
// Aggregate lump-sum transfers
RU_trj = 
1/RU_omega*RU_tr-(1-RU_omega)/RU_omega*RU_tri
;
// Aggregate lump-sum taxes
RU_tj = 
1/RU_omega*RU_t-(1-RU_omega)/RU_omega*RU_ti
;
// Aggregate transaction costs
RU_gammav = (1-RU_omega)*RU_ci*RU_gammavi+RU_omega*RU_cj*RU_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
RU_ni = RU_si*RU_ndi;
// Wage dispersion
RU_si = (1-RU_xii)*(RU_witilde/RU_wi)^(-RU_etai)+RU_xii*(RU_wi(-1)/RU_wi)^(-RU_etai)*(RU_pic/(RU_pic(-1)^RU_chii*RU_pi4target^(1/4*(1-RU_chii))))^(RU_etai)*RU_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
RU_nj = RU_sj*RU_ndj;
// Wage dispersion
RU_sj = (1-RU_xij)*(RU_wjtilde/RU_wj)^(-RU_etaj)+RU_xij*(RU_wj(-1)/RU_wj)^(-RU_etaj)*(RU_pic/(RU_pic(-1)^RU_chij*RU_pi4target^(1/4*(1-RU_chij))))^(RU_etaj)*RU_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
RU_u*RU_k = RU_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using RU_x = RW_size/RU_size*RW_im
RU_ysn = RU_snt*RU_nt;
//  nontradables aggregate demand
RU_nt = 
+RU_ntc
+RU_nti
+RU_ntcg
+RU_ntig
;
// Aggregate demand for domestic intermediate goods, using RU_hg = RU_cg
RU_ht =
+RU_htc
+RU_hti
+RU_htcg
+RU_htig
;
// Price dispersion in the domestic markets
RU_sh = (1-RU_xih)*(RU_phttilde/RU_pht)^(-RU_thetat)+RU_xih*(RU_piht/(RU_piht(-1)^RU_chih*RU_pi4target^(1/4*(1-RU_chih))))^RU_thetat*RU_sh(-1);
// Price dispersion in the foreign markets
RU_sx = (1-RU_xix)*(RU_pextilde/RU_pex)^(-RU_thetat)+RU_xix*(RU_piex/(RU_piex(-1)^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RU_sx(-1);
// Price dispersion in the domestic markets
RU_snt = (1-RU_xin)*(RU_pnttilde/RU_pnt)^(-RU_thetan)+RU_xin*(RU_pint/(RU_pint(-1)^RU_chin*RU_pi4target^(1/4*(1-RU_chin))))^RU_thetan*RU_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
RU_qc = RU_c+RU_gammav;
// Aggregate investment and capital utilisation cost
RU_qi = RU_i+RU_k*RU_gammau;
// Aggregate gov demand components added to use the same structure like in private components
RU_qcg = RU_cg;
RU_qig = RU_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
RU_py*RU_y = 
+RU_qc
+RU_pi*RU_qi
+RU_pcg*RU_qcg
+RU_pig*RU_qig
+RU_pex*RA_size/RU_size*RARU_im
-(RA_pex*RURA_rer)*RURA_imc
-(RA_pex*RURA_rer)*RURA_imi
-(RA_pex*RURA_rer)*RURA_imcg
-(RA_pex*RURA_rer)*RURA_imig
+RU_pex*AT_size/RU_size*ATRU_im
-(AT_pex*RUAT_rer)*RUAT_imc
-(AT_pex*RUAT_rer)*RUAT_imi
-(AT_pex*RUAT_rer)*RUAT_imcg
-(AT_pex*RUAT_rer)*RUAT_imig
+RU_pex*BE_size/RU_size*BERU_im
-(BE_pex*RUBE_rer)*RUBE_imc
-(BE_pex*RUBE_rer)*RUBE_imi
-(BE_pex*RUBE_rer)*RUBE_imcg
-(BE_pex*RUBE_rer)*RUBE_imig
+RU_pex*ES_size/RU_size*ESRU_im
-(ES_pex*RUES_rer)*RUES_imc
-(ES_pex*RUES_rer)*RUES_imi
-(ES_pex*RUES_rer)*RUES_imcg
-(ES_pex*RUES_rer)*RUES_imig
+RU_pex*FI_size/RU_size*FIRU_im
-(FI_pex*RUFI_rer)*RUFI_imc
-(FI_pex*RUFI_rer)*RUFI_imi
-(FI_pex*RUFI_rer)*RUFI_imcg
-(FI_pex*RUFI_rer)*RUFI_imig
+RU_pex*FR_size/RU_size*FRRU_im
-(FR_pex*RUFR_rer)*RUFR_imc
-(FR_pex*RUFR_rer)*RUFR_imi
-(FR_pex*RUFR_rer)*RUFR_imcg
-(FR_pex*RUFR_rer)*RUFR_imig
+RU_pex*GR_size/RU_size*GRRU_im
-(GR_pex*RUGR_rer)*RUGR_imc
-(GR_pex*RUGR_rer)*RUGR_imi
-(GR_pex*RUGR_rer)*RUGR_imcg
-(GR_pex*RUGR_rer)*RUGR_imig
+RU_pex*IT_size/RU_size*ITRU_im
-(IT_pex*RUIT_rer)*RUIT_imc
-(IT_pex*RUIT_rer)*RUIT_imi
-(IT_pex*RUIT_rer)*RUIT_imcg
-(IT_pex*RUIT_rer)*RUIT_imig
+RU_pex*NL_size/RU_size*NLRU_im
-(NL_pex*RUNL_rer)*RUNL_imc
-(NL_pex*RUNL_rer)*RUNL_imi
-(NL_pex*RUNL_rer)*RUNL_imcg
-(NL_pex*RUNL_rer)*RUNL_imig
+RU_pex*PT_size/RU_size*PTRU_im
-(PT_pex*RUPT_rer)*RUPT_imc
-(PT_pex*RUPT_rer)*RUPT_imi
-(PT_pex*RUPT_rer)*RUPT_imcg
-(PT_pex*RUPT_rer)*RUPT_imig
+RU_pex*DE_size/RU_size*DERU_im
-(DE_pex*RUDE_rer)*RUDE_imc
-(DE_pex*RUDE_rer)*RUDE_imi
-(DE_pex*RUDE_rer)*RUDE_imcg
-(DE_pex*RUDE_rer)*RUDE_imig
+RU_pex*RW_size/RU_size*RWRU_im
-(RW_pex*RURW_rer)*RURW_imc
-(RW_pex*RURW_rer)*RURW_imi
-(RW_pex*RURW_rer)*RURW_imcg
-(RW_pex*RURW_rer)*RURW_imig
+RU_pex*US_size/RU_size*USRU_im
-(US_pex*RUUS_rer)*RUUS_imc
-(US_pex*RUUS_rer)*RUUS_imi
-(US_pex*RUUS_rer)*RUUS_imcg
-(US_pex*RUUS_rer)*RUUS_imig
;
// Aggregate real demand
RU_y = RU_yst+RU_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(RU_zt) = (1-RU_rhozt)*log(RU_ztbar)+RU_rhozt*log(RU_zt(-1))+RU_epszt;
log(RU_zn) = (1-RU_rhozn)*log(RU_znbar)+RU_rhozn*log(RU_zn(-1))+RU_epszn;
// Government spending shock
RU_cgy = (1-RU_rhocg)*RU_cgybar+RU_rhocg*RU_cgy(-1)+RU_epsgc;
RU_igy = (1-RU_rhoig)*RU_igybar+RU_rhoig*RU_igy(-1)+RU_epsgi;
// Transfer shock
RU_try = (1-RU_rhotr)*RU_trybar+RU_rhotr*RU_try(-1)+RU_epstr;
// Consumption tax shock
RU_tauc = (1-RU_rhotauc)*RU_taucbar+RU_rhotauc*RU_tauc(-1)+RU_epstauc;
// Dividend income tax shock
RU_taud = (1-RU_rhotaud)*RU_taudbar+RU_rhotaud*RU_taud(-1)+RU_epstaud;
// Capital income tax shock
RU_tauk = (1-RU_rhotauk)*RU_taukbar+RU_rhotauk*RU_tauk(-1)+RU_epstauk;
// Labour income tax shock
RU_taun = (1-RU_rhotaun)*RU_taunbar+RU_rhotaun*RU_taun(-1)+RU_epstaun;
// Payroll tax shock: households
RU_tauwh = (1-RU_rhotauwh)*RU_tauwhbar+RU_rhotauwh*RU_tauwh(-1)+RU_epstauwh;
// Payroll tax shock: firms
RU_tauwf = (1-RU_rhotauwf)*RU_tauwfbar+RU_rhotauwf*RU_tauwf(-1)+RU_epstauwf;
// Wage cost push shock
RU_wcst = (1-RU_rhowcst)*RU_wcstbar+RU_rhowcst*RU_wcst(-1)+RU_epswcst;
// Preference shock
log(RU_zcon) = (1-RU_rhozcon)*log(RU_zconbar)+RU_rhozcon*log(RU_zcon(-1))+RU_epszcon;
// Investment specific shock
log(RU_zinv) = (1-RU_rhozinv)*log(RU_zinvbar)+RU_rhozinv*log(RU_zinv(-1))+RU_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
RU_cy = RU_c/(RU_py*RU_y);
// Aggregate nominal investment share
RU_iy = RU_pi*RU_i/(RU_py*RU_y);
// Aggregate nominal import share  
RU_imy = (
+RU_pimc*RU_imc
+RU_pimi*RU_imi
+RU_pimcg*RU_imcg
+RU_pimig*RU_imig
)/(RU_py*RU_y);
// Aggregate nominal import share
RU_imcy = RU_pimc*RU_imc/(RU_py*RU_y);
RU_imiy = RU_pimi*RU_imi/(RU_py*RU_y);
RU_imcgy = RU_pimcg*RU_imcg/(RU_py*RU_y);
RU_imigy = RU_pimig*RU_imig/(RU_py*RU_y);
// Aggregate debt-to-output ratio
RU_by = RU_b/(RU_pybar*RU_ybar);
// Aggregate lump-sum tax-to-output ratio
RU_ty = RU_t/(RU_pybar*RU_ybar);
// Aggregate labour cost share
RU_lcy = ((1+RU_tauwf)*RU_w*RU_nd)/(RU_py*RU_y);
// Aggregate nominal Wage share
RU_wy = (RU_w*RU_nd)/(RU_py*RU_y);
// NT sector nominal Wage share
RU_wnty = (RU_w*RU_ndn)/(RU_pnt*RU_ysn);
// T sector nominal Wage share
RU_whty = (RU_w*RU_ndt)/(RU_pht*RU_yst);
// T sector share
RU_yhty = RU_pht*RU_yst/(RU_py*RU_y);
// NT sector share
RU_ynty = RU_pnt*RU_ysn/(RU_py*RU_y);
// Output gap
RU_ygap = 0;
// Output growth (gross rate)
RU_ygrowth = RU_y/RU_y(-1);
// Output growth (gross rate yoy)
RU_ygrowth4 = RU_y/RU_y(-4);
// Domestic nominal output as a share of world nominal output
RU_yshare  = RU_size*RU_py*RU_y/RU_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
RU_epsilonm = -1/8*1/(RU_r*(RU_gammav2*RU_r+RU_r-1));
// Trade balance-to-GDP ratio
RU_tby = RU_tb/(RU_py*RU_y);
// Bilateral shares
RURA_imcy = (RA_pex*RURA_rer)*RURA_imc/(RU_py*RU_y);
RURA_imiy = (RA_pex*RURA_rer)*RURA_imi/(RU_py*RU_y);
RURA_imcgy = (RA_pex*RURA_rer)*RURA_imcg/(RU_py*RU_y);
RURA_imigy = (RA_pex*RURA_rer)*RURA_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RURA_excy  = RA_size/RU_size*RU_pex*RARU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RURA_exiy  = RA_size/RU_size*RU_pex*RARU_imi/(RU_py*RU_y);
// Bilateral shares
RUAT_imcy = (AT_pex*RUAT_rer)*RUAT_imc/(RU_py*RU_y);
RUAT_imiy = (AT_pex*RUAT_rer)*RUAT_imi/(RU_py*RU_y);
RUAT_imcgy = (AT_pex*RUAT_rer)*RUAT_imcg/(RU_py*RU_y);
RUAT_imigy = (AT_pex*RUAT_rer)*RUAT_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUAT_excy  = AT_size/RU_size*RU_pex*ATRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUAT_exiy  = AT_size/RU_size*RU_pex*ATRU_imi/(RU_py*RU_y);
// Bilateral shares
RUBE_imcy = (BE_pex*RUBE_rer)*RUBE_imc/(RU_py*RU_y);
RUBE_imiy = (BE_pex*RUBE_rer)*RUBE_imi/(RU_py*RU_y);
RUBE_imcgy = (BE_pex*RUBE_rer)*RUBE_imcg/(RU_py*RU_y);
RUBE_imigy = (BE_pex*RUBE_rer)*RUBE_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUBE_excy  = BE_size/RU_size*RU_pex*BERU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUBE_exiy  = BE_size/RU_size*RU_pex*BERU_imi/(RU_py*RU_y);
// Bilateral shares
RUES_imcy = (ES_pex*RUES_rer)*RUES_imc/(RU_py*RU_y);
RUES_imiy = (ES_pex*RUES_rer)*RUES_imi/(RU_py*RU_y);
RUES_imcgy = (ES_pex*RUES_rer)*RUES_imcg/(RU_py*RU_y);
RUES_imigy = (ES_pex*RUES_rer)*RUES_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUES_excy  = ES_size/RU_size*RU_pex*ESRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUES_exiy  = ES_size/RU_size*RU_pex*ESRU_imi/(RU_py*RU_y);
// Bilateral shares
RUFI_imcy = (FI_pex*RUFI_rer)*RUFI_imc/(RU_py*RU_y);
RUFI_imiy = (FI_pex*RUFI_rer)*RUFI_imi/(RU_py*RU_y);
RUFI_imcgy = (FI_pex*RUFI_rer)*RUFI_imcg/(RU_py*RU_y);
RUFI_imigy = (FI_pex*RUFI_rer)*RUFI_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUFI_excy  = FI_size/RU_size*RU_pex*FIRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUFI_exiy  = FI_size/RU_size*RU_pex*FIRU_imi/(RU_py*RU_y);
// Bilateral shares
RUFR_imcy = (FR_pex*RUFR_rer)*RUFR_imc/(RU_py*RU_y);
RUFR_imiy = (FR_pex*RUFR_rer)*RUFR_imi/(RU_py*RU_y);
RUFR_imcgy = (FR_pex*RUFR_rer)*RUFR_imcg/(RU_py*RU_y);
RUFR_imigy = (FR_pex*RUFR_rer)*RUFR_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUFR_excy  = FR_size/RU_size*RU_pex*FRRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUFR_exiy  = FR_size/RU_size*RU_pex*FRRU_imi/(RU_py*RU_y);
// Bilateral shares
RUGR_imcy = (GR_pex*RUGR_rer)*RUGR_imc/(RU_py*RU_y);
RUGR_imiy = (GR_pex*RUGR_rer)*RUGR_imi/(RU_py*RU_y);
RUGR_imcgy = (GR_pex*RUGR_rer)*RUGR_imcg/(RU_py*RU_y);
RUGR_imigy = (GR_pex*RUGR_rer)*RUGR_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUGR_excy  = GR_size/RU_size*RU_pex*GRRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUGR_exiy  = GR_size/RU_size*RU_pex*GRRU_imi/(RU_py*RU_y);
// Bilateral shares
RUIT_imcy = (IT_pex*RUIT_rer)*RUIT_imc/(RU_py*RU_y);
RUIT_imiy = (IT_pex*RUIT_rer)*RUIT_imi/(RU_py*RU_y);
RUIT_imcgy = (IT_pex*RUIT_rer)*RUIT_imcg/(RU_py*RU_y);
RUIT_imigy = (IT_pex*RUIT_rer)*RUIT_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUIT_excy  = IT_size/RU_size*RU_pex*ITRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUIT_exiy  = IT_size/RU_size*RU_pex*ITRU_imi/(RU_py*RU_y);
// Bilateral shares
RUNL_imcy = (NL_pex*RUNL_rer)*RUNL_imc/(RU_py*RU_y);
RUNL_imiy = (NL_pex*RUNL_rer)*RUNL_imi/(RU_py*RU_y);
RUNL_imcgy = (NL_pex*RUNL_rer)*RUNL_imcg/(RU_py*RU_y);
RUNL_imigy = (NL_pex*RUNL_rer)*RUNL_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUNL_excy  = NL_size/RU_size*RU_pex*NLRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUNL_exiy  = NL_size/RU_size*RU_pex*NLRU_imi/(RU_py*RU_y);
// Bilateral shares
RUPT_imcy = (PT_pex*RUPT_rer)*RUPT_imc/(RU_py*RU_y);
RUPT_imiy = (PT_pex*RUPT_rer)*RUPT_imi/(RU_py*RU_y);
RUPT_imcgy = (PT_pex*RUPT_rer)*RUPT_imcg/(RU_py*RU_y);
RUPT_imigy = (PT_pex*RUPT_rer)*RUPT_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUPT_excy  = PT_size/RU_size*RU_pex*PTRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUPT_exiy  = PT_size/RU_size*RU_pex*PTRU_imi/(RU_py*RU_y);
// Bilateral shares
RUDE_imcy = (DE_pex*RUDE_rer)*RUDE_imc/(RU_py*RU_y);
RUDE_imiy = (DE_pex*RUDE_rer)*RUDE_imi/(RU_py*RU_y);
RUDE_imcgy = (DE_pex*RUDE_rer)*RUDE_imcg/(RU_py*RU_y);
RUDE_imigy = (DE_pex*RUDE_rer)*RUDE_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUDE_excy  = DE_size/RU_size*RU_pex*DERU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUDE_exiy  = DE_size/RU_size*RU_pex*DERU_imi/(RU_py*RU_y);
// Bilateral shares
RURW_imcy = (RW_pex*RURW_rer)*RURW_imc/(RU_py*RU_y);
RURW_imiy = (RW_pex*RURW_rer)*RURW_imi/(RU_py*RU_y);
RURW_imcgy = (RW_pex*RURW_rer)*RURW_imcg/(RU_py*RU_y);
RURW_imigy = (RW_pex*RURW_rer)*RURW_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RURW_excy  = RW_size/RU_size*RU_pex*RWRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RURW_exiy  = RW_size/RU_size*RU_pex*RWRU_imi/(RU_py*RU_y);
// Bilateral shares
RUUS_imcy = (US_pex*RUUS_rer)*RUUS_imc/(RU_py*RU_y);
RUUS_imiy = (US_pex*RUUS_rer)*RUUS_imi/(RU_py*RU_y);
RUUS_imcgy = (US_pex*RUUS_rer)*RUUS_imcg/(RU_py*RU_y);
RUUS_imigy = (US_pex*RUUS_rer)*RUUS_imig/(RU_py*RU_y);
// Exports of consumption goods to gdp
RUUS_excy  = US_size/RU_size*RU_pex*USRU_imc/(RU_py*RU_y);
// Exports of investment goods to gdp
RUUS_exiy  = US_size/RU_size*RU_pex*USRU_imi/(RU_py*RU_y);
// Internal real exchange rate
RU_internalrer = RU_pnt/RU_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
RW_ccesi^(1-1/RW_mucces) = (RW_nucces)^(1/RW_mucces)*RW_ci^(1-1/RW_mucces)+(1-RW_nucces)^(1/RW_mucces)*RW_cg^(1-1/RW_mucces);
// Utility
RW_utili = 
RW_zcon*log(RW_ccesi-RW_kappa*RW_ccesi(-1))-1/(1+RW_zeta)*(RW_ni)^(1+RW_zeta)+RW_beta*RW_utili(+1)
;
// Marginal utility of consumption
RW_dcci = ((RW_nucces)^(1/RW_mucces)*RW_ci^(1-1/RW_mucces)+(1-RW_nucces)^(1/RW_mucces)*RW_cg^(1-1/RW_mucces))^(1/(RW_mucces-1))*(RW_nucces^(1/RW_mucces))*(RW_ci^(-1/RW_mucces));
RW_lambdai*(1+RW_tauc+RW_gammavi+RW_vi*RW_gammavider) = RW_zcon*(RW_ccesi-RW_kappa*RW_ccesi(-1))^(-RW_sigma)*RW_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
// Germany
// US and the RoW
RW_r = RW_beta^(-1)*RW_lambdai/RW_lambdai(+1)*RW_pic(+1);
// Euler equation for money
RW_vi^(2)*RW_gammavider = 1-RW_beta*RW_lambdai(+1)/(RW_lambdai*RW_pic(+1));
// Consumption-based velocity
RW_vi = RW_ci/RW_mi;
// Transaction cost
RW_gammavi = RW_gammav1*RW_vi+RW_gammav2/RW_vi-2*(RW_gammav1*RW_gammav2)^(1/2);
// Derivative of transaction cost
RW_gammavider = RW_gammav1-RW_gammav2*RW_vi^(-2);
RW_delta = RW_ii/RW_ki;
RW_gammai = 0;
RW_gammaider = 0;
RW_gammau = 0;
RW_gammauder = ((RW_beta^(-1)-1+RW_delta)*RW_qbar-RW_delta*RW_taukbar*RW_pibar)/((1-RW_taukbar)*RW_pibar);
RW_u = 1;
RW_pi = RW_q;
// Auxiliary equation for Tobin's Q in steady state
RW_qbar = RW_q;
// Rate of return on capital
RW_q = RW_beta*((1-RW_tauk)*RW_rk+(RW_tauk*RW_delta)*RW_pi+(1-RW_delta)*RW_q);
// Optimal wage contract (FOC)
RW_witilde^(1+RW_etai*RW_zeta) = RW_etai/(RW_etai-1)*RW_fi/RW_gi+RW_wcst;
// Definition of fi
RW_fi = RW_wi^(RW_etai*(1+RW_zeta))*RW_ndi^(1+RW_zeta)+RW_xii*RW_beta*(RW_pic(+1)/(RW_pic^RW_chii*RW_pi4target^(1/4*(1-RW_chii))))^(RW_etai*(1+RW_zeta))*RW_fi(+1);
// Definition of gi
RW_gi = RW_lambdai*(1-RW_taun-RW_tauwh)*RW_wi^RW_etai*RW_ndi+RW_xii*RW_beta*(RW_pic(+1)/(RW_pic^RW_chii*RW_pi4target^(1/4*(1-RW_chii))))^(RW_etai-1)*RW_gi(+1);
// Aggregate wage rate
RW_wi^(1-RW_etai) = (1-RW_xii)*RW_witilde^(1-RW_etai)+RW_xii*RW_wi(-1)^(1-RW_etai)*(RW_pic(-1)^RW_chii*RW_pi4target^(1/4*(1-RW_chii))/RW_pic)^(1-RW_etai);
//-------------
// Household J
//-------------
RW_ccesj^(1-1/RW_mucces) = (RW_nucces)^(1/RW_mucces)*RW_cj^(1-1/RW_mucces)+(1-RW_nucces)^(1/RW_mucces)*RW_cg^(1-1/RW_mucces);
// Utility
RW_utilj = 
RW_zcon*log(RW_ccesj-RW_kappa*RW_ccesj(-1))-1/(1+RW_zeta)*(RW_nj)^(1+RW_zeta)+RW_beta*RW_utilj(+1)
;
// Marginal utility of consumption
RW_dccj = ((RW_nucces)^(1/RW_mucces)*RW_cj^(1-1/RW_mucces)+(1-RW_nucces)^(1/RW_mucces)*RW_cg^(1-1/RW_mucces))^(1/(RW_mucces-1))*(RW_nucces^(1/RW_mucces))*(RW_cj^(-1/RW_mucces));
RW_lambdaj*(1+RW_tauc+RW_gammavj+RW_vj*RW_gammavjder) = RW_zcon*(RW_ccesj-RW_kappa*RW_ccesj(-1))^(-RW_sigma)*RW_dccj;
// Budget constraint
(1+RW_tauc+RW_gammavj)*RW_cj+RW_mj = (1-RW_taun-RW_tauwh)*RW_wj*RW_nj+RW_trj-RW_tj+RW_mj(-1)*RW_pic^(-1);
// Euler equation for money
RW_vj^(2)*RW_gammavjder = 1-RW_beta*RW_lambdaj(+1)/(RW_lambdaj*RW_pic(+1));
// Consumption-based velocity
RW_vj = RW_cj/RW_mj;
// Transaction technology
RW_gammavj = RW_gammav1*RW_vj+RW_gammav2/RW_vj-2*(RW_gammav1*RW_gammav2)^(1/2);
// Derivative of transaction technology
RW_gammavjder = RW_gammav1-RW_gammav2*RW_vj^(-2);
// Optimal wage contract (FOC)
RW_wjtilde^(1+RW_etaj*RW_zeta) = RW_etaj/(RW_etaj-1)*RW_fj/RW_gj+RW_wcst;
// Definition of fj
RW_fj = RW_wj^(RW_etaj*(1+RW_zeta))*RW_ndj^(1+RW_zeta)+RW_xij*RW_beta*(RW_pic(+1)/(RW_pic^RW_chij*RW_pi4target^(1/4*(1-RW_chij))))^(RW_etaj*(1+RW_zeta))*RW_fj(+1);
// Definition of gj
RW_gj = RW_lambdaj*(1-RW_taun-RW_tauwh)*RW_wj^RW_etaj*RW_ndj+RW_xij*RW_beta*(RW_pic(+1)/(RW_pic^RW_chij*RW_pi4target^(1/4*(1-RW_chij))))^(RW_etaj-1)*RW_gj(+1);
// Aggregate wage rate
RW_wj^(1-RW_etaj) = (1-RW_xij)*RW_wjtilde^(1-RW_etaj)+RW_xij*RW_wj(-1)^(1-RW_etaj)*(RW_pic(-1)^RW_chij*RW_pi4target^(1/4*(1-RW_chij))/RW_pic)^(1-RW_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
RW_kg = (1-RW_deltag)*RW_kg(-1)+RW_ig(-1);
// Production function tradable
RW_yst = RW_zt*RW_kg^RW_alphag*RW_kdt^RW_alphat*RW_ndt^(1-RW_alphat)-RW_psitbar;
// Production function nontradable
RW_ysn = RW_zn*RW_kg^RW_alphag*RW_kdn^RW_alphan*RW_ndn^(1-RW_alphan)-RW_psinbar;
// Real marginal cost tradable
RW_mct = 1/(RW_zt*RW_kg^RW_alphag*(RW_alphat)^(RW_alphat)*(1-RW_alphat)^(1-RW_alphat))*RW_rk^(RW_alphat)*((1+RW_tauwf)*RW_w)^(1-RW_alphat);
// Real marginal cost nontradable
RW_mcn = 1/(RW_zn*RW_kg^RW_alphag*(RW_alphan)^(RW_alphan)*(1-RW_alphan)^(1-RW_alphan))*RW_rk^(RW_alphan)*((1+RW_tauwf)*RW_w)^(1-RW_alphan);
// Wage Inflation (qoq)
RW_piw = RW_w/RW_w(-1)*RW_pic;
// Wage Inflation (yoy)
RW_piw4 = RW_pic4;
// Auxiliary equation for steady-state fixed cost
RW_psitbar = RW_psit*RW_ytbar;
// Auxiliary equation for steady-state fixed cost
RW_psinbar = RW_psin*RW_ynbar;
// Capital input (FOC)
RW_rk = RW_alphat*(RW_yst+RW_psitbar)/RW_kdt*RW_mct;
// Capital input (FOC)
RW_rk = RW_alphan*(RW_ysn+RW_psinbar)/RW_kdn*RW_mcn;
// Total capital demand
RW_kd = RW_kdt+RW_kdn;
// Demand for labour services by household I
RW_ndi = 
(1-RW_omega)*(RW_wi/RW_w)^(-RW_eta)*RW_nd
;
// Demand for labour services by household J
RW_ndj = 
RW_omega*(RW_wj/RW_w)^(-RW_eta)*RW_nd
;
// Aggregate labour demand
RW_nd^(1-1/RW_eta) = 
(1-RW_omega)^(1/RW_eta)*RW_ndi^(1-1/RW_eta)+RW_omega^(1/RW_eta)*RW_ndj^(1-1/RW_eta)
;
// Total demand 
RW_nd = RW_ndt+RW_ndn;
// Aggregate dividends
RW_d = RW_py*RW_y-RW_rk*RW_kd-(1+RW_tauwf)*RW_w*RW_nd;
// Non-tradable sector dividends
RW_dn = RW_pnt*RW_ysn-RW_rk*RW_kdn-(1+RW_tauwf)*RW_w*RW_ndn;
// Tradable sector dividends
RW_dt = RW_pht*RW_ht
+RW_pex*RW_ex
-RW_rk*RW_kdt-(1+RW_tauwf)*RW_w*RW_ndt;
// Optimal price contract set in domestic markets (FOC)
RW_phttilde/RW_pht = RW_thetat/(RW_thetat-1)*RW_fh/RW_gh;
// Definition of fh
RW_fh = RW_mct*RW_ht+RW_xih*RW_beta*RW_lambdai(+1)/RW_lambdai*(RW_piht(+1)/(RW_piht^RW_chih*RW_pi4target^(1/4*(1-RW_chih))))^RW_thetat*RW_fh(+1);
// Definition of gh
RW_gh = RW_pht*RW_ht+RW_xih*RW_beta*RW_lambdai(+1)/RW_lambdai*(RW_piht(+1)/(RW_piht^RW_chih*RW_pi4target^(1/4*(1-RW_chih))))^(RW_thetat-1)*RW_gh(+1);
// Aggregate intermediate-good price dynamics
RW_pht^(1-RW_thetat) = (1-RW_xih)*RW_phttilde^(1-RW_thetat)+RW_xih*(RW_pht(-1)/RW_pic)^(1-RW_thetat)*(RW_piht(-1)^RW_chih*RW_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation
RW_piht = RW_pht/RW_pht(-1)*RW_pic;
// Optimal price contract set in domestic markets (FOC)
RW_pnttilde/RW_pnt = RW_thetan/(RW_thetan-1)*RW_fn/RW_gn;
// Definition of fn
RW_fn = RW_mcn*RW_nt+RW_xin*RW_beta*RW_lambdai(+1)/RW_lambdai*(RW_pint(+1)/(RW_pint^RW_chin*RW_pi4target^(1/4*(1-RW_chin))))^RW_thetan*RW_fn(+1);
// Definition of gn
RW_gn = RW_pnt*RW_nt+RW_xin*RW_beta*RW_lambdai(+1)/RW_lambdai*(RW_pint(+1)/(RW_pint^RW_chin*RW_pi4target^(1/4*(1-RW_chin))))^(RW_thetan-1)*RW_gn(+1);
// Aggregate intermediate-good price dynamics
RW_pnt^(1-RW_thetan) = (1-RW_xin)*RW_pnttilde^(1-RW_thetan)+RW_xin*(RW_pnt(-1)/RW_pic)^(1-RW_thetan)*(RW_pint(-1)^RW_chin*RW_pi4target^(1/4*(1-RW_chin)))^(1-RW_thetan);
// Intermediate-good price inflation
RW_pint = RW_pnt/RW_pnt(-1)*RW_pic;
// Optimal price contract set in domestic markets (FOC)
RW_pextilde/RW_pex = RW_thetat/(RW_thetat-1)*RW_fx/RW_gx;
// Definition of fh
RW_fx = RW_mct*RW_ex+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(RW_piex(+1)/(RW_piex^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RW_fx(+1);
// Definition of gh
RW_gx = RW_pex*RW_ex+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(RW_piex(+1)/(RW_piex^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RW_gx(+1);
// Aggregate intermediate-good price dynamics
RW_pex^(1-RW_thetat) = (1-RW_xix)*RW_pextilde^(1-RW_thetat)+RW_xix*(RW_pex(-1)/RW_pic)^(1-RW_thetat)*(RW_piex(-1)^RW_chix*RW_pi4target^(1/4*(1-RW_chix)))^(1-RW_thetat);
// Intermediate-good price inflation
RW_piex = RW_pex/RW_pex(-1)*RW_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = RA_pimtilde
// RARW_pimtilde/RARW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWRA_fx/RWRA_gx;
// Definition of fx
// RWRA_fx = RA_size/RW_size*RARW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(RARW_piim(+1)/(RARW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWRA_fx(+1);
// Definition of gx   
// RWRA_gx = RWRA_rer*RARW_pim*RA_size/RW_size*RARW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(RARW_piim(+1)/(RARW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWRA_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = RA_pim
// RARW_pim^(1-RW_thetat) = (1-RW_xix)*RARW_pimtilde^(1-RW_thetat)+RW_xix*(RARW_pim(-1)/RA_pic)^(1-RW_thetat)*(RARW_piim(-1)^RW_chix*RA_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = RA_piim
// RARW_piim = RARW_pim/RARW_pim(-1)*RA_pic;
// Bilateral real exchange rate
RWRA_rer = RW_rer/RA_rer;
// Auxiliary equation for steady-state output
RWRA_rerbar = RWRA_rer;
//Terms of Trade
RWRA_tot = RA_pex*RWRA_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = AT_pimtilde
// ATRW_pimtilde/ATRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWAT_fx/RWAT_gx;
// Definition of fx
// RWAT_fx = AT_size/RW_size*ATRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(ATRW_piim(+1)/(ATRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWAT_fx(+1);
// Definition of gx   
// RWAT_gx = RWAT_rer*ATRW_pim*AT_size/RW_size*ATRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(ATRW_piim(+1)/(ATRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWAT_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = AT_pim
// ATRW_pim^(1-RW_thetat) = (1-RW_xix)*ATRW_pimtilde^(1-RW_thetat)+RW_xix*(ATRW_pim(-1)/AT_pic)^(1-RW_thetat)*(ATRW_piim(-1)^RW_chix*AT_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = AT_piim
// ATRW_piim = ATRW_pim/ATRW_pim(-1)*AT_pic;
// Bilateral real exchange rate
RWAT_rer = RW_rer/AT_rer;
// Auxiliary equation for steady-state output
RWAT_rerbar = RWAT_rer;
//Terms of Trade
RWAT_tot = AT_pex*RWAT_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = BE_pimtilde
// BERW_pimtilde/BERW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWBE_fx/RWBE_gx;
// Definition of fx
// RWBE_fx = BE_size/RW_size*BERW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(BERW_piim(+1)/(BERW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWBE_fx(+1);
// Definition of gx   
// RWBE_gx = RWBE_rer*BERW_pim*BE_size/RW_size*BERW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(BERW_piim(+1)/(BERW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWBE_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = BE_pim
// BERW_pim^(1-RW_thetat) = (1-RW_xix)*BERW_pimtilde^(1-RW_thetat)+RW_xix*(BERW_pim(-1)/BE_pic)^(1-RW_thetat)*(BERW_piim(-1)^RW_chix*BE_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = BE_piim
// BERW_piim = BERW_pim/BERW_pim(-1)*BE_pic;
// Bilateral real exchange rate
RWBE_rer = RW_rer/BE_rer;
// Auxiliary equation for steady-state output
RWBE_rerbar = RWBE_rer;
//Terms of Trade
RWBE_tot = BE_pex*RWBE_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = ES_pimtilde
// ESRW_pimtilde/ESRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWES_fx/RWES_gx;
// Definition of fx
// RWES_fx = ES_size/RW_size*ESRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(ESRW_piim(+1)/(ESRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWES_fx(+1);
// Definition of gx   
// RWES_gx = RWES_rer*ESRW_pim*ES_size/RW_size*ESRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(ESRW_piim(+1)/(ESRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWES_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = ES_pim
// ESRW_pim^(1-RW_thetat) = (1-RW_xix)*ESRW_pimtilde^(1-RW_thetat)+RW_xix*(ESRW_pim(-1)/ES_pic)^(1-RW_thetat)*(ESRW_piim(-1)^RW_chix*ES_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = ES_piim
// ESRW_piim = ESRW_pim/ESRW_pim(-1)*ES_pic;
// Bilateral real exchange rate
RWES_rer = RW_rer/ES_rer;
// Auxiliary equation for steady-state output
RWES_rerbar = RWES_rer;
//Terms of Trade
RWES_tot = ES_pex*RWES_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = FI_pimtilde
// FIRW_pimtilde/FIRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWFI_fx/RWFI_gx;
// Definition of fx
// RWFI_fx = FI_size/RW_size*FIRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(FIRW_piim(+1)/(FIRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWFI_fx(+1);
// Definition of gx   
// RWFI_gx = RWFI_rer*FIRW_pim*FI_size/RW_size*FIRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(FIRW_piim(+1)/(FIRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWFI_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = FI_pim
// FIRW_pim^(1-RW_thetat) = (1-RW_xix)*FIRW_pimtilde^(1-RW_thetat)+RW_xix*(FIRW_pim(-1)/FI_pic)^(1-RW_thetat)*(FIRW_piim(-1)^RW_chix*FI_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = FI_piim
// FIRW_piim = FIRW_pim/FIRW_pim(-1)*FI_pic;
// Bilateral real exchange rate
RWFI_rer = RW_rer/FI_rer;
// Auxiliary equation for steady-state output
RWFI_rerbar = RWFI_rer;
//Terms of Trade
RWFI_tot = FI_pex*RWFI_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = FR_pimtilde
// FRRW_pimtilde/FRRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWFR_fx/RWFR_gx;
// Definition of fx
// RWFR_fx = FR_size/RW_size*FRRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(FRRW_piim(+1)/(FRRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWFR_fx(+1);
// Definition of gx   
// RWFR_gx = RWFR_rer*FRRW_pim*FR_size/RW_size*FRRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(FRRW_piim(+1)/(FRRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWFR_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = FR_pim
// FRRW_pim^(1-RW_thetat) = (1-RW_xix)*FRRW_pimtilde^(1-RW_thetat)+RW_xix*(FRRW_pim(-1)/FR_pic)^(1-RW_thetat)*(FRRW_piim(-1)^RW_chix*FR_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = FR_piim
// FRRW_piim = FRRW_pim/FRRW_pim(-1)*FR_pic;
// Bilateral real exchange rate
RWFR_rer = RW_rer/FR_rer;
// Auxiliary equation for steady-state output
RWFR_rerbar = RWFR_rer;
//Terms of Trade
RWFR_tot = FR_pex*RWFR_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = GR_pimtilde
// GRRW_pimtilde/GRRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWGR_fx/RWGR_gx;
// Definition of fx
// RWGR_fx = GR_size/RW_size*GRRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(GRRW_piim(+1)/(GRRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWGR_fx(+1);
// Definition of gx   
// RWGR_gx = RWGR_rer*GRRW_pim*GR_size/RW_size*GRRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(GRRW_piim(+1)/(GRRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWGR_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = GR_pim
// GRRW_pim^(1-RW_thetat) = (1-RW_xix)*GRRW_pimtilde^(1-RW_thetat)+RW_xix*(GRRW_pim(-1)/GR_pic)^(1-RW_thetat)*(GRRW_piim(-1)^RW_chix*GR_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = GR_piim
// GRRW_piim = GRRW_pim/GRRW_pim(-1)*GR_pic;
// Bilateral real exchange rate
RWGR_rer = RW_rer/GR_rer;
// Auxiliary equation for steady-state output
RWGR_rerbar = RWGR_rer;
//Terms of Trade
RWGR_tot = GR_pex*RWGR_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = IT_pimtilde
// ITRW_pimtilde/ITRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWIT_fx/RWIT_gx;
// Definition of fx
// RWIT_fx = IT_size/RW_size*ITRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(ITRW_piim(+1)/(ITRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWIT_fx(+1);
// Definition of gx   
// RWIT_gx = RWIT_rer*ITRW_pim*IT_size/RW_size*ITRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(ITRW_piim(+1)/(ITRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWIT_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = IT_pim
// ITRW_pim^(1-RW_thetat) = (1-RW_xix)*ITRW_pimtilde^(1-RW_thetat)+RW_xix*(ITRW_pim(-1)/IT_pic)^(1-RW_thetat)*(ITRW_piim(-1)^RW_chix*IT_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = IT_piim
// ITRW_piim = ITRW_pim/ITRW_pim(-1)*IT_pic;
// Bilateral real exchange rate
RWIT_rer = RW_rer/IT_rer;
// Auxiliary equation for steady-state output
RWIT_rerbar = RWIT_rer;
//Terms of Trade
RWIT_tot = IT_pex*RWIT_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = NL_pimtilde
// NLRW_pimtilde/NLRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWNL_fx/RWNL_gx;
// Definition of fx
// RWNL_fx = NL_size/RW_size*NLRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(NLRW_piim(+1)/(NLRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWNL_fx(+1);
// Definition of gx   
// RWNL_gx = RWNL_rer*NLRW_pim*NL_size/RW_size*NLRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(NLRW_piim(+1)/(NLRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWNL_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = NL_pim
// NLRW_pim^(1-RW_thetat) = (1-RW_xix)*NLRW_pimtilde^(1-RW_thetat)+RW_xix*(NLRW_pim(-1)/NL_pic)^(1-RW_thetat)*(NLRW_piim(-1)^RW_chix*NL_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = NL_piim
// NLRW_piim = NLRW_pim/NLRW_pim(-1)*NL_pic;
// Bilateral real exchange rate
RWNL_rer = RW_rer/NL_rer;
// Auxiliary equation for steady-state output
RWNL_rerbar = RWNL_rer;
//Terms of Trade
RWNL_tot = NL_pex*RWNL_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = PT_pimtilde
// PTRW_pimtilde/PTRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWPT_fx/RWPT_gx;
// Definition of fx
// RWPT_fx = PT_size/RW_size*PTRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(PTRW_piim(+1)/(PTRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWPT_fx(+1);
// Definition of gx   
// RWPT_gx = RWPT_rer*PTRW_pim*PT_size/RW_size*PTRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(PTRW_piim(+1)/(PTRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWPT_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = PT_pim
// PTRW_pim^(1-RW_thetat) = (1-RW_xix)*PTRW_pimtilde^(1-RW_thetat)+RW_xix*(PTRW_pim(-1)/PT_pic)^(1-RW_thetat)*(PTRW_piim(-1)^RW_chix*PT_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = PT_piim
// PTRW_piim = PTRW_pim/PTRW_pim(-1)*PT_pic;
// Bilateral real exchange rate
RWPT_rer = RW_rer/PT_rer;
// Auxiliary equation for steady-state output
RWPT_rerbar = RWPT_rer;
//Terms of Trade
RWPT_tot = PT_pex*RWPT_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = DE_pimtilde
// DERW_pimtilde/DERW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWDE_fx/RWDE_gx;
// Definition of fx
// RWDE_fx = DE_size/RW_size*DERW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(DERW_piim(+1)/(DERW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWDE_fx(+1);
// Definition of gx   
// RWDE_gx = RWDE_rer*DERW_pim*DE_size/RW_size*DERW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(DERW_piim(+1)/(DERW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWDE_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = DE_pim
// DERW_pim^(1-RW_thetat) = (1-RW_xix)*DERW_pimtilde^(1-RW_thetat)+RW_xix*(DERW_pim(-1)/DE_pic)^(1-RW_thetat)*(DERW_piim(-1)^RW_chix*DE_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = DE_piim
// DERW_piim = DERW_pim/DERW_pim(-1)*DE_pic;
// Bilateral real exchange rate
RWDE_rer = RW_rer/DE_rer;
// Auxiliary equation for steady-state output
RWDE_rerbar = RWDE_rer;
//Terms of Trade
RWDE_tot = DE_pex*RWDE_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = RU_pimtilde
// RURW_pimtilde/RURW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWRU_fx/RWRU_gx;
// Definition of fx
// RWRU_fx = RU_size/RW_size*RURW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(RURW_piim(+1)/(RURW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWRU_fx(+1);
// Definition of gx   
// RWRU_gx = RWRU_rer*RURW_pim*RU_size/RW_size*RURW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(RURW_piim(+1)/(RURW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWRU_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = RU_pim
// RURW_pim^(1-RW_thetat) = (1-RW_xix)*RURW_pimtilde^(1-RW_thetat)+RW_xix*(RURW_pim(-1)/RU_pic)^(1-RW_thetat)*(RURW_piim(-1)^RW_chix*RU_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = RU_piim
// RURW_piim = RURW_pim/RURW_pim(-1)*RU_pic;
// Bilateral real exchange rate
RWRU_rer = RW_rer/RU_rer;
// Auxiliary equation for steady-state output
RWRU_rerbar = RWRU_rer;
//Terms of Trade
RWRU_tot = RU_pex*RWRU_rer/RW_pex;
// Optimal price contract set in foreign markets (FOC), using RW_pxtilde = US_pimtilde
// USRW_pimtilde/USRW_pim = RW_cpim*RW_thetat/(RW_thetat-1)*RWUS_fx/RWUS_gx;
// Definition of fx
// RWUS_fx = US_size/RW_size*USRW_im*RW_mct+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(USRW_piim(+1)/(USRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^RW_thetat*RWUS_fx(+1);
// Definition of gx   
// RWUS_gx = RWUS_rer*USRW_pim*US_size/RW_size*USRW_im+RW_xix*RW_beta*RW_lambdai(+1)/RW_lambdai*(USRW_piim(+1)/(USRW_piim^RW_chix*RW_pi4target^(1/4*(1-RW_chix))))^(RW_thetat-1)*RWUS_gx(+1);
// Aggregate intermediate-good price dynamics, using RW_px = US_pim
// USRW_pim^(1-RW_thetat) = (1-RW_xix)*USRW_pimtilde^(1-RW_thetat)+RW_xix*(USRW_pim(-1)/US_pic)^(1-RW_thetat)*(USRW_piim(-1)^RW_chix*US_pi4target^(1/4*(1-RW_chih)))^(1-RW_thetat);
// Intermediate-good price inflation, using RW_pix = US_piim
// USRW_piim = USRW_pim/USRW_pim(-1)*US_pic;
// Bilateral real exchange rate
RWUS_rer = RW_rer/US_rer;
// Auxiliary equation for steady-state output
RWUS_rerbar = RWUS_rer;
//Terms of Trade
RWUS_tot = US_pex*RWUS_rer/RW_pex;
// Total imports 
RW_im = 
+RW_imc
+RW_imi
+RW_imcg
+RW_imig
;
// Total import deflator
RW_im*RW_pim  = 
+RW_pimc*RW_imc
+RW_pimi*RW_imi
+RW_pimcg*RW_imcg
+RW_pimig*RW_imig
;
// Effective real exchange rate: double weighting (imports)
RWRA_weightim = RWRA_rer*RA_pex*RWRA_im/(RW_pim*RW_im);
// Effective real exchange rate: double weighting (exports)
RWRA_weightex = RA_size/RW_size*RARW_im/RW_ex*RWRA_rer*RA_py*RA_y/(RWRA_rer*RA_py*RA_y
+RWAT_rer*AT_pex*RAAT_im
+RWBE_rer*BE_pex*RABE_im
+RWES_rer*ES_pex*RAES_im
+RWFI_rer*FI_pex*RAFI_im
