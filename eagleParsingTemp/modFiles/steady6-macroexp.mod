+RWUS_rer*US_pex*PTUS_im
)
+DE_size/RW_size*DERW_im/RW_ex*RWRU_rer*RU_pex*DERU_im/(RWDE_rer*DE_py*DE_y
+RWRA_rer*RA_pex*DERA_im
+RWAT_rer*AT_pex*DEAT_im
+RWBE_rer*BE_pex*DEBE_im
+RWES_rer*ES_pex*DEES_im
