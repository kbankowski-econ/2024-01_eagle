// Bilateral real exchange rate
NLFI_rer = NL_rer/FI_rer;
// Auxiliary equation for steady-state output
NLFI_rerbar = NLFI_rer;
//Terms of Trade
NLFI_tot = FI_pex*NLFI_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = FR_pimtilde
// FRNL_pimtilde/FRNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLFR_fx/NLFR_gx;
// Definition of fx
// NLFR_fx = FR_size/NL_size*FRNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(FRNL_piim(+1)/(FRNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLFR_fx(+1);
// Definition of gx   
// NLFR_gx = NLFR_rer*FRNL_pim*FR_size/NL_size*FRNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(FRNL_piim(+1)/(FRNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLFR_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = FR_pim
// FRNL_pim^(1-NL_thetat) = (1-NL_xix)*FRNL_pimtilde^(1-NL_thetat)+NL_xix*(FRNL_pim(-1)/FR_pic)^(1-NL_thetat)*(FRNL_piim(-1)^NL_chix*FR_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = FR_piim
// FRNL_piim = FRNL_pim/FRNL_pim(-1)*FR_pic;
// Bilateral real exchange rate
NLFR_rer = NL_rer/FR_rer;
// Auxiliary equation for steady-state output
NLFR_rerbar = NLFR_rer;
//Terms of Trade
NLFR_tot = FR_pex*NLFR_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = GR_pimtilde
// GRNL_pimtilde/GRNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLGR_fx/NLGR_gx;
// Definition of fx
// NLGR_fx = GR_size/NL_size*GRNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(GRNL_piim(+1)/(GRNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLGR_fx(+1);
// Definition of gx   
