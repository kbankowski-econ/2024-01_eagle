// Effective real exchange rate: double weighting (overall)
RAUS_weight = RA_pim*RA_im/(RA_pim*RA_im+RA_pex*RA_ex)*RAUS_weightim+RA_pex*RA_ex/(RA_pim*RA_im+RA_pex*RA_ex)*RAUS_weightex;
// Effective real exchange rate
RA_reer = 1
*RAAT_rer^RAAT_weight
*RABE_rer^RABE_weight
*RAES_rer^RAES_weight
*RAFI_rer^RAFI_weight
*RAFR_rer^RAFR_weight
*RAGR_rer^RAGR_weight
*RAIT_rer^RAIT_weight
*RANL_rer^RANL_weight
*RAPT_rer^RAPT_weight
*RADE_rer^RADE_weight
*RARU_rer^RARU_weight
*RARW_rer^RARW_weight
*RAUS_rer^RAUS_weight
;
// Effective terms of trade
RA_etot = 1
*RAAT_tot^RAAT_weight
*RABE_tot^RABE_weight
*RAES_tot^RAES_weight
*RAFI_tot^RAFI_weight
*RAFR_tot^RAFR_weight
*RAGR_tot^RAGR_weight
*RAIT_tot^RAIT_weight
*RANL_tot^RANL_weight
*RAPT_tot^RAPT_weight
*RADE_tot^RADE_weight
*RARU_tot^RARU_weight
*RARW_tot^RARW_weight
*RAUS_tot^RAUS_weight
;
