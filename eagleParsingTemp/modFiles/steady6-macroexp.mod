// Aggregate intermediate-good price dynamics, using PT_px = FR_pim
// FRPT_pim^(1-PT_thetat) = (1-PT_xix)*FRPT_pimtilde^(1-PT_thetat)+PT_xix*(FRPT_pim(-1)/FR_pic)^(1-PT_thetat)*(FRPT_piim(-1)^PT_chix*FR_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = FR_piim
// FRPT_piim = FRPT_pim/FRPT_pim(-1)*FR_pic;
// Bilateral real exchange rate
PTFR_rer = PT_rer/FR_rer;
// Auxiliary equation for steady-state output
PTFR_rerbar = PTFR_rer;
//Terms of Trade
PTFR_tot = FR_pex*PTFR_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = GR_pimtilde
// GRPT_pimtilde/GRPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTGR_fx/PTGR_gx;
// Definition of fx
// PTGR_fx = GR_size/PT_size*GRPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(GRPT_piim(+1)/(GRPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTGR_fx(+1);
// Definition of gx   
// PTGR_gx = PTGR_rer*GRPT_pim*GR_size/PT_size*GRPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(GRPT_piim(+1)/(GRPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTGR_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = GR_pim
// GRPT_pim^(1-PT_thetat) = (1-PT_xix)*GRPT_pimtilde^(1-PT_thetat)+PT_xix*(GRPT_pim(-1)/GR_pic)^(1-PT_thetat)*(GRPT_piim(-1)^PT_chix*GR_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = GR_piim
