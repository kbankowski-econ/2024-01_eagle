FR_ttc^((FR_mutc-1)/FR_mutc) = (FR_nutc)^(1/FR_mutc)*FR_htc^(1-1/FR_mutc)+(1-FR_nutc)^(1/FR_mutc)*FR_imc^(1-1/FR_mutc);
// Private consumption good  (total)
FR_qc^((FR_muc-1)/FR_muc) = (FR_nuc)^(1/FR_muc)*FR_ttc^(1-1/FR_muc)+(1-FR_nuc)^(1/FR_muc)*FR_ntc^(1-1/FR_muc);
// Demand for domestic intermediate goods - NONTRADABLE
FR_ntc = (1-FR_nuc)*(FR_pnt)^(-FR_muc)*FR_qc;
// Price of the consumption good (tradable)  
FR_pttc^(1-FR_mutc) = (FR_nutc)*FR_pht^(1-FR_mutc)+(1-FR_nutc)*FR_pimc^(1-FR_mutc);
// Price of the consumption good 
1^(1-FR_muc) = (FR_nuc)*FR_pttc^(1-FR_muc)+(1-FR_nuc)*FR_pnt^(1-FR_muc);
// Demand for domestic intermediate goods
FR_htc = FR_nutc*(FR_pht/FR_pttc)^(-FR_mutc)*FR_ttc;
FRRA_gammaimc = 0;
FRRA_gammaimcdag = 1;
FRAT_gammaimc = 0;
FRAT_gammaimcdag = 1;
FRBE_gammaimc = 0;
FRBE_gammaimcdag = 1;
FRES_gammaimc = 0;
FRES_gammaimcdag = 1;
FRFI_gammaimc = 0;
FRFI_gammaimcdag = 1;
FRGR_gammaimc = 0;
FRGR_gammaimcdag = 1;
FRIT_gammaimc = 0;
FRIT_gammaimcdag = 1;
FRNL_gammaimc = 0;
FRNL_gammaimcdag = 1;
FRPT_gammaimc = 0;
FRPT_gammaimcdag = 1;
FRDE_gammaimc = 0;
FRDE_gammaimcdag = 1;
FRRU_gammaimc = 0;
FRRU_gammaimcdag = 1;
FRRW_gammaimc = 0;
FRRW_gammaimcdag = 1;
FRUS_gammaimc = 0;
FRUS_gammaimcdag = 1;
// Private consumption good (tradable)
FR_tti^((FR_muti-1)/FR_muti) = (FR_nuti)^(1/FR_muti)*FR_hti^(1-1/FR_muti)+(1-FR_nuti)^(1/FR_muti)*FR_imi^(1-1/FR_muti);
// Private consumption good  (total)
FR_qi^((FR_mui-1)/FR_mui) = (FR_nui)^(1/FR_mui)*FR_tti^(1-1/FR_mui)+(1-FR_nui)^(1/FR_mui)*FR_nti^(1-1/FR_mui);
// Demand for domestic intermediate goods - NONTRADABLE
FR_nti = (1-FR_nui)*(FR_pnt/FR_pi)^(-FR_mui)*FR_qi;
// Price of the consumption good (tradable)  
FR_ptti^(1-FR_muti) = (FR_nuti)*FR_pht^(1-FR_muti)+(1-FR_nuti)*FR_pimi^(1-FR_muti);
// Price of the consumption good 
FR_pi^(1-FR_mui) = (FR_nui)*FR_ptti^(1-FR_mui)+(1-FR_nui)*FR_pnt^(1-FR_mui);
// Auxiliary equation for the price of the investment good in steady state
// this only appears in the capacity utilisation cost; not needed for consumption where it is one by assumption; neither for gov demand components where there is no adjustment cost
FR_pibar = FR_pi;
// Demand for domestic intermediate goods
FR_hti = FR_nuti*(FR_pht/FR_ptti)^(-FR_muti)*FR_tti;
FRRA_gammaimi = 0;
FRRA_gammaimidag = 1;
FRAT_gammaimi = 0;
FRAT_gammaimidag = 1;
FRBE_gammaimi = 0;
FRBE_gammaimidag = 1;
FRES_gammaimi = 0;
FRES_gammaimidag = 1;
FRFI_gammaimi = 0;
FRFI_gammaimidag = 1;
FRGR_gammaimi = 0;
FRGR_gammaimidag = 1;
FRIT_gammaimi = 0;
FRIT_gammaimidag = 1;
FRNL_gammaimi = 0;
FRNL_gammaimidag = 1;
FRPT_gammaimi = 0;
FRPT_gammaimidag = 1;
FRDE_gammaimi = 0;
FRDE_gammaimidag = 1;
FRRU_gammaimi = 0;
FRRU_gammaimidag = 1;
FRRW_gammaimi = 0;
FRRW_gammaimidag = 1;
FRUS_gammaimi = 0;
FRUS_gammaimidag = 1;
// Private consumption good (tradable)
FR_ttcg^((FR_mutcg-1)/FR_mutcg) = (FR_nutcg)^(1/FR_mutcg)*FR_htcg^(1-1/FR_mutcg)+(1-FR_nutcg)^(1/FR_mutcg)*FR_imcg^(1-1/FR_mutcg);
// Private consumption good  (total)
FR_qcg^((FR_mucg-1)/FR_mucg) = (FR_nucg)^(1/FR_mucg)*FR_ttcg^(1-1/FR_mucg)+(1-FR_nucg)^(1/FR_mucg)*FR_ntcg^(1-1/FR_mucg);
// Demand for domestic intermediate goods - NONTRADABLE
FR_ntcg = (1-FR_nucg)*(FR_pnt/FR_pcg)^(-FR_mucg)*FR_qcg;
// Price of the consumption good (tradable)  
FR_pttcg^(1-FR_mutcg) = (FR_nutcg)*FR_pht^(1-FR_mutcg)+(1-FR_nutcg)*FR_pimcg^(1-FR_mutcg);
// Price of the consumption good 
FR_pcg^(1-FR_mucg) = (FR_nucg)*FR_pttcg^(1-FR_mucg)+(1-FR_nucg)*FR_pnt^(1-FR_mucg);
// Demand for domestic intermediate goods
FR_htcg = FR_nutcg*(FR_pht/FR_pttcg)^(-FR_mutcg)*FR_ttcg;
FRRA_gammaimcg = 0;
FRRA_gammaimcgdag = 1;
FRAT_gammaimcg = 0;
FRAT_gammaimcgdag = 1;
FRBE_gammaimcg = 0;
FRBE_gammaimcgdag = 1;
FRES_gammaimcg = 0;
FRES_gammaimcgdag = 1;
FRFI_gammaimcg = 0;
FRFI_gammaimcgdag = 1;
FRGR_gammaimcg = 0;
FRGR_gammaimcgdag = 1;
FRIT_gammaimcg = 0;
FRIT_gammaimcgdag = 1;
FRNL_gammaimcg = 0;
FRNL_gammaimcgdag = 1;
FRPT_gammaimcg = 0;
FRPT_gammaimcgdag = 1;
FRDE_gammaimcg = 0;
FRDE_gammaimcgdag = 1;
FRRU_gammaimcg = 0;
FRRU_gammaimcgdag = 1;
FRRW_gammaimcg = 0;
FRRW_gammaimcgdag = 1;
FRUS_gammaimcg = 0;
FRUS_gammaimcgdag = 1;
// Private consumption good (tradable)
FR_ttig^((FR_mutig-1)/FR_mutig) = (FR_nutig)^(1/FR_mutig)*FR_htig^(1-1/FR_mutig)+(1-FR_nutig)^(1/FR_mutig)*FR_imig^(1-1/FR_mutig);
// Private consumption good  (total)
FR_qig^((FR_muig-1)/FR_muig) = (FR_nuig)^(1/FR_muig)*FR_ttig^(1-1/FR_muig)+(1-FR_nuig)^(1/FR_muig)*FR_ntig^(1-1/FR_muig);
// Demand for domestic intermediate goods - NONTRADABLE
FR_ntig = (1-FR_nuig)*(FR_pnt/FR_pig)^(-FR_muig)*FR_qig;
// Price of the consumption good (tradable)  
FR_pttig^(1-FR_mutig) = (FR_nutig)*FR_pht^(1-FR_mutig)+(1-FR_nutig)*FR_pimig^(1-FR_mutig);
// Price of the consumption good 
FR_pig^(1-FR_muig) = (FR_nuig)*FR_pttig^(1-FR_muig)+(1-FR_nuig)*FR_pnt^(1-FR_muig);
// Demand for domestic intermediate goods
FR_htig = FR_nutig*(FR_pht/FR_pttig)^(-FR_mutig)*FR_ttig;
FRRA_gammaimig = 0;
FRRA_gammaimigdag = 1;
FRAT_gammaimig = 0;
FRAT_gammaimigdag = 1;
FRBE_gammaimig = 0;
FRBE_gammaimigdag = 1;
FRES_gammaimig = 0;
FRES_gammaimigdag = 1;
FRFI_gammaimig = 0;
FRFI_gammaimigdag = 1;
FRGR_gammaimig = 0;
FRGR_gammaimigdag = 1;
FRIT_gammaimig = 0;
FRIT_gammaimigdag = 1;
FRNL_gammaimig = 0;
FRNL_gammaimigdag = 1;
FRPT_gammaimig = 0;
FRPT_gammaimigdag = 1;
FRDE_gammaimig = 0;
FRDE_gammaimigdag = 1;
FRRU_gammaimig = 0;
FRRU_gammaimigdag = 1;
FRRW_gammaimig = 0;
FRRW_gammaimigdag = 1;
FRUS_gammaimig = 0;
FRUS_gammaimigdag = 1;
// Trade balance
FR_tb =
+FR_pex*RA_size/FR_size*RAFR_im
-RA_pex*FRRA_rer*FRRA_im
+FR_pex*AT_size/FR_size*ATFR_im
-AT_pex*FRAT_rer*FRAT_im
+FR_pex*BE_size/FR_size*BEFR_im
-BE_pex*FRBE_rer*FRBE_im
+FR_pex*ES_size/FR_size*ESFR_im
-ES_pex*FRES_rer*FRES_im
+FR_pex*FI_size/FR_size*FIFR_im
-FI_pex*FRFI_rer*FRFI_im
+FR_pex*GR_size/FR_size*GRFR_im
-GR_pex*FRGR_rer*FRGR_im
+FR_pex*IT_size/FR_size*ITFR_im
-IT_pex*FRIT_rer*FRIT_im
+FR_pex*NL_size/FR_size*NLFR_im
-NL_pex*FRNL_rer*FRNL_im
+FR_pex*PT_size/FR_size*PTFR_im
-PT_pex*FRPT_rer*FRPT_im
+FR_pex*DE_size/FR_size*DEFR_im
-DE_pex*FRDE_rer*FRDE_im
+FR_pex*RU_size/FR_size*RUFR_im
-RU_pex*FRRU_rer*FRRU_im
+FR_pex*RW_size/FR_size*RWFR_im
-RW_pex*FRRW_rer*FRRW_im
+FR_pex*US_size/FR_size*USFR_im
-US_pex*FRUS_rer*FRUS_im
;
// Aggregate exports (volume)
FR_ex =
+RA_size/FR_size*RAFR_im
+AT_size/FR_size*ATFR_im
+BE_size/FR_size*BEFR_im
+ES_size/FR_size*ESFR_im
+FI_size/FR_size*FIFR_im
+GR_size/FR_size*GRFR_im
+IT_size/FR_size*ITFR_im
+NL_size/FR_size*NLFR_im
+PT_size/FR_size*PTFR_im
+DE_size/FR_size*DEFR_im
+RU_size/FR_size*RUFR_im
+RW_size/FR_size*RWFR_im
+US_size/FR_size*USFR_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using FR_pg = FR_pht
// TODO: check the (1-FR_gammab(-1)) adjustment here, which is not in the fiscal extention
	FR_pcg(-1)*FR_cg(-1)+FR_pig(-1)*FR_ig(-1)+FR_tr(-1)
	+FR_b(-1)*FR_pic(-1)^(-1)+FR_m(-2)*FR_pic(-1)^(-1) = FR_tauc(-1)*FR_c(-1)+(FR_taun(-1)+FR_tauwh(-1))*(FR_wi(-1)*FR_ndi(-1)+FR_wj(-1)*FR_ndj(-1))+FR_tauwf(-1)*FR_w(-1)*FR_nd(-1)+FR_tauk(-1)*(FR_rk(-1)*FR_u(-1)-(FR_gammau(-1)+FR_delta)*FR_pi(-1))*FR_k(-1)+FR_taud(-1)*FR_d(-1)+FR_t(-1)+(FR_r(-1)*(1-FR_gammab(-1)))^(-1)*FR_b+FR_m(-1);
// Government spending, using FR_pg = FR_pht
FR_pcg*FR_cg = FR_cgy*FR_pybar*FR_ybar;
FR_pig*FR_ig = FR_igy*FR_pybar*FR_ybar;
FR_t = 0;
FR_b = FR_bytarget*FR_pybar*FR_ybar;
// Auxiliary equation for steady-state output
FR_ybar = FR_y;
// Auxiliary equation for steady-state output
FR_ytbar = FR_yst;
// Auxiliary equation for steady-state output
FR_ynbar = FR_ysn;
// Auxiliary equation for steady-state output deflator
FR_pybar = FR_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
FR_trybar = FR_tr/(FR_pybar*FR_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
FR_ti = FR_upsilont*FR_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
FR_tri = FR_upsilontr*FR_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	FR_r = DE_r;
FR_pic4 = FR_pi4target;
FR_rr-1 = FR_r/FR_pi4target^(1/4)-1;
// Equilibrium real interest rate
FR_rrstar-1 = 1/FR_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
FR_c = (1-FR_omega)*FR_ci+FR_omega*FR_cj;
// Aggregate money holdings
FR_m = (1-FR_omega)*FR_mi+FR_omega*FR_mj;
// Aggregate capital stock
FR_k = (1-FR_omega)*FR_ki;
// Aggregate investment
FR_i = (1-FR_omega)*FR_ii;
// Aggregate lump-sum transfers
FR_trj = 
1/FR_omega*FR_tr-(1-FR_omega)/FR_omega*FR_tri
;
// Aggregate lump-sum taxes
FR_tj = 
1/FR_omega*FR_t-(1-FR_omega)/FR_omega*FR_ti
;
// Aggregate transaction costs
FR_gammav = (1-FR_omega)*FR_ci*FR_gammavi+FR_omega*FR_cj*FR_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
FR_ni = FR_si*FR_ndi;
// Wage dispersion
FR_si = (1-FR_xii)*(FR_witilde/FR_wi)^(-FR_etai)+FR_xii*(FR_wi(-1)/FR_wi)^(-FR_etai)*(FR_pic/(FR_pic(-1)^FR_chii*FR_pi4target^(1/4*(1-FR_chii))))^(FR_etai)*FR_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
FR_nj = FR_sj*FR_ndj;
// Wage dispersion
FR_sj = (1-FR_xij)*(FR_wjtilde/FR_wj)^(-FR_etaj)+FR_xij*(FR_wj(-1)/FR_wj)^(-FR_etaj)*(FR_pic/(FR_pic(-1)^FR_chij*FR_pi4target^(1/4*(1-FR_chij))))^(FR_etaj)*FR_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
FR_u*FR_k = FR_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using FR_x = GR_size/FR_size*GR_im
FR_ysn = FR_snt*FR_nt;
//  nontradables aggregate demand
FR_nt = 
+FR_ntc
+FR_nti
+FR_ntcg
+FR_ntig
;
// Aggregate demand for domestic intermediate goods, using FR_hg = FR_cg
FR_ht =
+FR_htc
+FR_hti
+FR_htcg
+FR_htig
;
// Price dispersion in the domestic markets
FR_sh = (1-FR_xih)*(FR_phttilde/FR_pht)^(-FR_thetat)+FR_xih*(FR_piht/(FR_piht(-1)^FR_chih*FR_pi4target^(1/4*(1-FR_chih))))^FR_thetat*FR_sh(-1);
// Price dispersion in the foreign markets
FR_sx = (1-FR_xix)*(FR_pextilde/FR_pex)^(-FR_thetat)+FR_xix*(FR_piex/(FR_piex(-1)^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^FR_thetat*FR_sx(-1);
// Price dispersion in the domestic markets
FR_snt = (1-FR_xin)*(FR_pnttilde/FR_pnt)^(-FR_thetan)+FR_xin*(FR_pint/(FR_pint(-1)^FR_chin*FR_pi4target^(1/4*(1-FR_chin))))^FR_thetan*FR_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
FR_qc = FR_c+FR_gammav;
// Aggregate investment and capital utilisation cost
FR_qi = FR_i+FR_k*FR_gammau;
// Aggregate gov demand components added to use the same structure like in private components
FR_qcg = FR_cg;
FR_qig = FR_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
FR_py*FR_y = 
+FR_qc
+FR_pi*FR_qi
+FR_pcg*FR_qcg
+FR_pig*FR_qig
+FR_pex*RA_size/FR_size*RAFR_im
-(RA_pex*FRRA_rer)*FRRA_imc
-(RA_pex*FRRA_rer)*FRRA_imi
-(RA_pex*FRRA_rer)*FRRA_imcg
-(RA_pex*FRRA_rer)*FRRA_imig
+FR_pex*AT_size/FR_size*ATFR_im
-(AT_pex*FRAT_rer)*FRAT_imc
-(AT_pex*FRAT_rer)*FRAT_imi
-(AT_pex*FRAT_rer)*FRAT_imcg
-(AT_pex*FRAT_rer)*FRAT_imig
+FR_pex*BE_size/FR_size*BEFR_im
-(BE_pex*FRBE_rer)*FRBE_imc
-(BE_pex*FRBE_rer)*FRBE_imi
-(BE_pex*FRBE_rer)*FRBE_imcg
-(BE_pex*FRBE_rer)*FRBE_imig
+FR_pex*ES_size/FR_size*ESFR_im
-(ES_pex*FRES_rer)*FRES_imc
-(ES_pex*FRES_rer)*FRES_imi
-(ES_pex*FRES_rer)*FRES_imcg
-(ES_pex*FRES_rer)*FRES_imig
+FR_pex*FI_size/FR_size*FIFR_im
-(FI_pex*FRFI_rer)*FRFI_imc
-(FI_pex*FRFI_rer)*FRFI_imi
-(FI_pex*FRFI_rer)*FRFI_imcg
-(FI_pex*FRFI_rer)*FRFI_imig
+FR_pex*GR_size/FR_size*GRFR_im
-(GR_pex*FRGR_rer)*FRGR_imc
-(GR_pex*FRGR_rer)*FRGR_imi
-(GR_pex*FRGR_rer)*FRGR_imcg
-(GR_pex*FRGR_rer)*FRGR_imig
+FR_pex*IT_size/FR_size*ITFR_im
-(IT_pex*FRIT_rer)*FRIT_imc
-(IT_pex*FRIT_rer)*FRIT_imi
-(IT_pex*FRIT_rer)*FRIT_imcg
-(IT_pex*FRIT_rer)*FRIT_imig
+FR_pex*NL_size/FR_size*NLFR_im
-(NL_pex*FRNL_rer)*FRNL_imc
-(NL_pex*FRNL_rer)*FRNL_imi
-(NL_pex*FRNL_rer)*FRNL_imcg
-(NL_pex*FRNL_rer)*FRNL_imig
+FR_pex*PT_size/FR_size*PTFR_im
-(PT_pex*FRPT_rer)*FRPT_imc
-(PT_pex*FRPT_rer)*FRPT_imi
-(PT_pex*FRPT_rer)*FRPT_imcg
-(PT_pex*FRPT_rer)*FRPT_imig
+FR_pex*DE_size/FR_size*DEFR_im
-(DE_pex*FRDE_rer)*FRDE_imc
-(DE_pex*FRDE_rer)*FRDE_imi
-(DE_pex*FRDE_rer)*FRDE_imcg
-(DE_pex*FRDE_rer)*FRDE_imig
+FR_pex*RU_size/FR_size*RUFR_im
-(RU_pex*FRRU_rer)*FRRU_imc
-(RU_pex*FRRU_rer)*FRRU_imi
-(RU_pex*FRRU_rer)*FRRU_imcg
-(RU_pex*FRRU_rer)*FRRU_imig
+FR_pex*RW_size/FR_size*RWFR_im
-(RW_pex*FRRW_rer)*FRRW_imc
-(RW_pex*FRRW_rer)*FRRW_imi
-(RW_pex*FRRW_rer)*FRRW_imcg
-(RW_pex*FRRW_rer)*FRRW_imig
+FR_pex*US_size/FR_size*USFR_im
-(US_pex*FRUS_rer)*FRUS_imc
-(US_pex*FRUS_rer)*FRUS_imi
-(US_pex*FRUS_rer)*FRUS_imcg
-(US_pex*FRUS_rer)*FRUS_imig
;
// Aggregate real demand
FR_y = FR_yst+FR_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(FR_zt) = (1-FR_rhozt)*log(FR_ztbar)+FR_rhozt*log(FR_zt(-1))+FR_epszt;
log(FR_zn) = (1-FR_rhozn)*log(FR_znbar)+FR_rhozn*log(FR_zn(-1))+FR_epszn;
// Government spending shock
FR_cgy = (1-FR_rhocg)*FR_cgybar+FR_rhocg*FR_cgy(-1)+FR_epsgc;
FR_igy = (1-FR_rhoig)*FR_igybar+FR_rhoig*FR_igy(-1)+FR_epsgi;
// Transfer shock
FR_try = (1-FR_rhotr)*FR_trybar+FR_rhotr*FR_try(-1)+FR_epstr;
// Consumption tax shock
FR_tauc = (1-FR_rhotauc)*FR_taucbar+FR_rhotauc*FR_tauc(-1)+FR_epstauc;
// Dividend income tax shock
FR_taud = (1-FR_rhotaud)*FR_taudbar+FR_rhotaud*FR_taud(-1)+FR_epstaud;
// Capital income tax shock
FR_tauk = (1-FR_rhotauk)*FR_taukbar+FR_rhotauk*FR_tauk(-1)+FR_epstauk;
// Labour income tax shock
FR_taun = (1-FR_rhotaun)*FR_taunbar+FR_rhotaun*FR_taun(-1)+FR_epstaun;
// Payroll tax shock: households
FR_tauwh = (1-FR_rhotauwh)*FR_tauwhbar+FR_rhotauwh*FR_tauwh(-1)+FR_epstauwh;
// Payroll tax shock: firms
FR_tauwf = (1-FR_rhotauwf)*FR_tauwfbar+FR_rhotauwf*FR_tauwf(-1)+FR_epstauwf;
// Wage cost push shock
FR_wcst = (1-FR_rhowcst)*FR_wcstbar+FR_rhowcst*FR_wcst(-1)+FR_epswcst;
// Preference shock
log(FR_zcon) = (1-FR_rhozcon)*log(FR_zconbar)+FR_rhozcon*log(FR_zcon(-1))+FR_epszcon;
// Investment specific shock
log(FR_zinv) = (1-FR_rhozinv)*log(FR_zinvbar)+FR_rhozinv*log(FR_zinv(-1))+FR_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
FR_cy = FR_c/(FR_py*FR_y);
// Aggregate nominal investment share
FR_iy = FR_pi*FR_i/(FR_py*FR_y);
// Aggregate nominal import share  
FR_imy = (
+FR_pimc*FR_imc
+FR_pimi*FR_imi
+FR_pimcg*FR_imcg
+FR_pimig*FR_imig
)/(FR_py*FR_y);
// Aggregate nominal import share
FR_imcy = FR_pimc*FR_imc/(FR_py*FR_y);
FR_imiy = FR_pimi*FR_imi/(FR_py*FR_y);
FR_imcgy = FR_pimcg*FR_imcg/(FR_py*FR_y);
FR_imigy = FR_pimig*FR_imig/(FR_py*FR_y);
// Aggregate debt-to-output ratio
FR_by = FR_b/(FR_pybar*FR_ybar);
// Aggregate lump-sum tax-to-output ratio
FR_ty = FR_t/(FR_pybar*FR_ybar);
// Aggregate labour cost share
FR_lcy = ((1+FR_tauwf)*FR_w*FR_nd)/(FR_py*FR_y);
// Aggregate nominal Wage share
FR_wy = (FR_w*FR_nd)/(FR_py*FR_y);
// NT sector nominal Wage share
FR_wnty = (FR_w*FR_ndn)/(FR_pnt*FR_ysn);
// T sector nominal Wage share
FR_whty = (FR_w*FR_ndt)/(FR_pht*FR_yst);
// T sector share
FR_yhty = FR_pht*FR_yst/(FR_py*FR_y);
// NT sector share
FR_ynty = FR_pnt*FR_ysn/(FR_py*FR_y);
// Output gap
FR_ygap = 0;
// Output growth (gross rate)
FR_ygrowth = FR_y/FR_y(-1);
// Output growth (gross rate yoy)
FR_ygrowth4 = FR_y/FR_y(-4);
// Domestic nominal output as a share of world nominal output
FR_yshare  = FR_size*FR_py*FR_y/FR_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
FR_epsilonm = -1/8*1/(FR_r*(FR_gammav2*FR_r+FR_r-1));
// Trade balance-to-GDP ratio
FR_tby = FR_tb/(FR_py*FR_y);
// Bilateral shares
FRRA_imcy = (RA_pex*FRRA_rer)*FRRA_imc/(FR_py*FR_y);
FRRA_imiy = (RA_pex*FRRA_rer)*FRRA_imi/(FR_py*FR_y);
FRRA_imcgy = (RA_pex*FRRA_rer)*FRRA_imcg/(FR_py*FR_y);
FRRA_imigy = (RA_pex*FRRA_rer)*FRRA_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRRA_excy  = RA_size/FR_size*FR_pex*RAFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRRA_exiy  = RA_size/FR_size*FR_pex*RAFR_imi/(FR_py*FR_y);
// Bilateral shares
FRAT_imcy = (AT_pex*FRAT_rer)*FRAT_imc/(FR_py*FR_y);
FRAT_imiy = (AT_pex*FRAT_rer)*FRAT_imi/(FR_py*FR_y);
FRAT_imcgy = (AT_pex*FRAT_rer)*FRAT_imcg/(FR_py*FR_y);
FRAT_imigy = (AT_pex*FRAT_rer)*FRAT_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRAT_excy  = AT_size/FR_size*FR_pex*ATFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRAT_exiy  = AT_size/FR_size*FR_pex*ATFR_imi/(FR_py*FR_y);
// Bilateral shares
FRBE_imcy = (BE_pex*FRBE_rer)*FRBE_imc/(FR_py*FR_y);
FRBE_imiy = (BE_pex*FRBE_rer)*FRBE_imi/(FR_py*FR_y);
FRBE_imcgy = (BE_pex*FRBE_rer)*FRBE_imcg/(FR_py*FR_y);
FRBE_imigy = (BE_pex*FRBE_rer)*FRBE_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRBE_excy  = BE_size/FR_size*FR_pex*BEFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRBE_exiy  = BE_size/FR_size*FR_pex*BEFR_imi/(FR_py*FR_y);
// Bilateral shares
FRES_imcy = (ES_pex*FRES_rer)*FRES_imc/(FR_py*FR_y);
FRES_imiy = (ES_pex*FRES_rer)*FRES_imi/(FR_py*FR_y);
FRES_imcgy = (ES_pex*FRES_rer)*FRES_imcg/(FR_py*FR_y);
FRES_imigy = (ES_pex*FRES_rer)*FRES_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRES_excy  = ES_size/FR_size*FR_pex*ESFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRES_exiy  = ES_size/FR_size*FR_pex*ESFR_imi/(FR_py*FR_y);
// Bilateral shares
FRFI_imcy = (FI_pex*FRFI_rer)*FRFI_imc/(FR_py*FR_y);
FRFI_imiy = (FI_pex*FRFI_rer)*FRFI_imi/(FR_py*FR_y);
FRFI_imcgy = (FI_pex*FRFI_rer)*FRFI_imcg/(FR_py*FR_y);
FRFI_imigy = (FI_pex*FRFI_rer)*FRFI_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRFI_excy  = FI_size/FR_size*FR_pex*FIFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRFI_exiy  = FI_size/FR_size*FR_pex*FIFR_imi/(FR_py*FR_y);
// Bilateral shares
FRGR_imcy = (GR_pex*FRGR_rer)*FRGR_imc/(FR_py*FR_y);
FRGR_imiy = (GR_pex*FRGR_rer)*FRGR_imi/(FR_py*FR_y);
FRGR_imcgy = (GR_pex*FRGR_rer)*FRGR_imcg/(FR_py*FR_y);
FRGR_imigy = (GR_pex*FRGR_rer)*FRGR_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRGR_excy  = GR_size/FR_size*FR_pex*GRFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRGR_exiy  = GR_size/FR_size*FR_pex*GRFR_imi/(FR_py*FR_y);
// Bilateral shares
FRIT_imcy = (IT_pex*FRIT_rer)*FRIT_imc/(FR_py*FR_y);
FRIT_imiy = (IT_pex*FRIT_rer)*FRIT_imi/(FR_py*FR_y);
FRIT_imcgy = (IT_pex*FRIT_rer)*FRIT_imcg/(FR_py*FR_y);
FRIT_imigy = (IT_pex*FRIT_rer)*FRIT_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRIT_excy  = IT_size/FR_size*FR_pex*ITFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRIT_exiy  = IT_size/FR_size*FR_pex*ITFR_imi/(FR_py*FR_y);
// Bilateral shares
FRNL_imcy = (NL_pex*FRNL_rer)*FRNL_imc/(FR_py*FR_y);
FRNL_imiy = (NL_pex*FRNL_rer)*FRNL_imi/(FR_py*FR_y);
FRNL_imcgy = (NL_pex*FRNL_rer)*FRNL_imcg/(FR_py*FR_y);
FRNL_imigy = (NL_pex*FRNL_rer)*FRNL_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRNL_excy  = NL_size/FR_size*FR_pex*NLFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRNL_exiy  = NL_size/FR_size*FR_pex*NLFR_imi/(FR_py*FR_y);
// Bilateral shares
FRPT_imcy = (PT_pex*FRPT_rer)*FRPT_imc/(FR_py*FR_y);
FRPT_imiy = (PT_pex*FRPT_rer)*FRPT_imi/(FR_py*FR_y);
FRPT_imcgy = (PT_pex*FRPT_rer)*FRPT_imcg/(FR_py*FR_y);
FRPT_imigy = (PT_pex*FRPT_rer)*FRPT_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRPT_excy  = PT_size/FR_size*FR_pex*PTFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRPT_exiy  = PT_size/FR_size*FR_pex*PTFR_imi/(FR_py*FR_y);
// Bilateral shares
FRDE_imcy = (DE_pex*FRDE_rer)*FRDE_imc/(FR_py*FR_y);
FRDE_imiy = (DE_pex*FRDE_rer)*FRDE_imi/(FR_py*FR_y);
FRDE_imcgy = (DE_pex*FRDE_rer)*FRDE_imcg/(FR_py*FR_y);
FRDE_imigy = (DE_pex*FRDE_rer)*FRDE_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRDE_excy  = DE_size/FR_size*FR_pex*DEFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRDE_exiy  = DE_size/FR_size*FR_pex*DEFR_imi/(FR_py*FR_y);
// Bilateral shares
FRRU_imcy = (RU_pex*FRRU_rer)*FRRU_imc/(FR_py*FR_y);
FRRU_imiy = (RU_pex*FRRU_rer)*FRRU_imi/(FR_py*FR_y);
FRRU_imcgy = (RU_pex*FRRU_rer)*FRRU_imcg/(FR_py*FR_y);
FRRU_imigy = (RU_pex*FRRU_rer)*FRRU_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRRU_excy  = RU_size/FR_size*FR_pex*RUFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRRU_exiy  = RU_size/FR_size*FR_pex*RUFR_imi/(FR_py*FR_y);
// Bilateral shares
FRRW_imcy = (RW_pex*FRRW_rer)*FRRW_imc/(FR_py*FR_y);
FRRW_imiy = (RW_pex*FRRW_rer)*FRRW_imi/(FR_py*FR_y);
FRRW_imcgy = (RW_pex*FRRW_rer)*FRRW_imcg/(FR_py*FR_y);
FRRW_imigy = (RW_pex*FRRW_rer)*FRRW_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRRW_excy  = RW_size/FR_size*FR_pex*RWFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRRW_exiy  = RW_size/FR_size*FR_pex*RWFR_imi/(FR_py*FR_y);
// Bilateral shares
FRUS_imcy = (US_pex*FRUS_rer)*FRUS_imc/(FR_py*FR_y);
FRUS_imiy = (US_pex*FRUS_rer)*FRUS_imi/(FR_py*FR_y);
FRUS_imcgy = (US_pex*FRUS_rer)*FRUS_imcg/(FR_py*FR_y);
FRUS_imigy = (US_pex*FRUS_rer)*FRUS_imig/(FR_py*FR_y);
// Exports of consumption goods to gdp
FRUS_excy  = US_size/FR_size*FR_pex*USFR_imc/(FR_py*FR_y);
// Exports of investment goods to gdp
FRUS_exiy  = US_size/FR_size*FR_pex*USFR_imi/(FR_py*FR_y);
// Internal real exchange rate
FR_internalrer = FR_pnt/FR_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
GR_ccesi^(1-1/GR_mucces) = (GR_nucces)^(1/GR_mucces)*GR_ci^(1-1/GR_mucces)+(1-GR_nucces)^(1/GR_mucces)*GR_cg^(1-1/GR_mucces);
// Utility
GR_utili = 
GR_zcon*log(GR_ccesi-GR_kappa*GR_ccesi(-1))-1/(1+GR_zeta)*(GR_ni)^(1+GR_zeta)+GR_beta*GR_utili(+1)
;
// Marginal utility of consumption
GR_dcci = ((GR_nucces)^(1/GR_mucces)*GR_ci^(1-1/GR_mucces)+(1-GR_nucces)^(1/GR_mucces)*GR_cg^(1-1/GR_mucces))^(1/(GR_mucces-1))*(GR_nucces^(1/GR_mucces))*(GR_ci^(-1/GR_mucces));
GR_lambdai*(1+GR_tauc+GR_gammavi+GR_vi*GR_gammavider) = GR_zcon*(GR_ccesi-GR_kappa*GR_ccesi(-1))^(-GR_sigma)*GR_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
GR_r                   = GR_beta^(-1)*GR_lambdai/GR_lambdai    *GR_pic;
// Germany
// US and the RoW
// Euler equation for money
GR_vi^(2)*GR_gammavider = 1-GR_beta*GR_lambdai(+1)/(GR_lambdai*GR_pic(+1));
// Consumption-based velocity
GR_vi = GR_ci/GR_mi;
// Transaction cost
GR_gammavi = GR_gammav1*GR_vi+GR_gammav2/GR_vi-2*(GR_gammav1*GR_gammav2)^(1/2);
// Derivative of transaction cost
GR_gammavider = GR_gammav1-GR_gammav2*GR_vi^(-2);
GR_delta = GR_ii/GR_ki;
GR_gammai = 0;
GR_gammaider = 0;
GR_gammau = 0;
GR_gammauder = ((GR_beta^(-1)-1+GR_delta)*GR_qbar-GR_delta*GR_taukbar*GR_pibar)/((1-GR_taukbar)*GR_pibar);
GR_u = 1;
GR_pi = GR_q;
// Auxiliary equation for Tobin's Q in steady state
GR_qbar = GR_q;
// Rate of return on capital
GR_q = GR_beta*((1-GR_tauk)*GR_rk+(GR_tauk*GR_delta)*GR_pi+(1-GR_delta)*GR_q);
// Optimal wage contract (FOC)
GR_witilde^(1+GR_etai*GR_zeta) = GR_etai/(GR_etai-1)*GR_fi/GR_gi+GR_wcst;
// Definition of fi
GR_fi = GR_wi^(GR_etai*(1+GR_zeta))*GR_ndi^(1+GR_zeta)+GR_xii*GR_beta*(GR_pic(+1)/(GR_pic^GR_chii*GR_pi4target^(1/4*(1-GR_chii))))^(GR_etai*(1+GR_zeta))*GR_fi(+1);
// Definition of gi
GR_gi = GR_lambdai*(1-GR_taun-GR_tauwh)*GR_wi^GR_etai*GR_ndi+GR_xii*GR_beta*(GR_pic(+1)/(GR_pic^GR_chii*GR_pi4target^(1/4*(1-GR_chii))))^(GR_etai-1)*GR_gi(+1);
// Aggregate wage rate
GR_wi^(1-GR_etai) = (1-GR_xii)*GR_witilde^(1-GR_etai)+GR_xii*GR_wi(-1)^(1-GR_etai)*(GR_pic(-1)^GR_chii*GR_pi4target^(1/4*(1-GR_chii))/GR_pic)^(1-GR_etai);
//-------------
// Household J
//-------------
GR_ccesj^(1-1/GR_mucces) = (GR_nucces)^(1/GR_mucces)*GR_cj^(1-1/GR_mucces)+(1-GR_nucces)^(1/GR_mucces)*GR_cg^(1-1/GR_mucces);
// Utility
GR_utilj = 
GR_zcon*log(GR_ccesj-GR_kappa*GR_ccesj(-1))-1/(1+GR_zeta)*(GR_nj)^(1+GR_zeta)+GR_beta*GR_utilj(+1)
;
// Marginal utility of consumption
GR_dccj = ((GR_nucces)^(1/GR_mucces)*GR_cj^(1-1/GR_mucces)+(1-GR_nucces)^(1/GR_mucces)*GR_cg^(1-1/GR_mucces))^(1/(GR_mucces-1))*(GR_nucces^(1/GR_mucces))*(GR_cj^(-1/GR_mucces));
GR_lambdaj*(1+GR_tauc+GR_gammavj+GR_vj*GR_gammavjder) = GR_zcon*(GR_ccesj-GR_kappa*GR_ccesj(-1))^(-GR_sigma)*GR_dccj;
// Budget constraint
(1+GR_tauc+GR_gammavj)*GR_cj+GR_mj = (1-GR_taun-GR_tauwh)*GR_wj*GR_nj+GR_trj-GR_tj+GR_mj(-1)*GR_pic^(-1);
// Euler equation for money
GR_vj^(2)*GR_gammavjder = 1-GR_beta*GR_lambdaj(+1)/(GR_lambdaj*GR_pic(+1));
// Consumption-based velocity
GR_vj = GR_cj/GR_mj;
// Transaction technology
GR_gammavj = GR_gammav1*GR_vj+GR_gammav2/GR_vj-2*(GR_gammav1*GR_gammav2)^(1/2);
// Derivative of transaction technology
GR_gammavjder = GR_gammav1-GR_gammav2*GR_vj^(-2);
// Optimal wage contract (FOC)
GR_wjtilde^(1+GR_etaj*GR_zeta) = GR_etaj/(GR_etaj-1)*GR_fj/GR_gj+GR_wcst;
// Definition of fj
GR_fj = GR_wj^(GR_etaj*(1+GR_zeta))*GR_ndj^(1+GR_zeta)+GR_xij*GR_beta*(GR_pic(+1)/(GR_pic^GR_chij*GR_pi4target^(1/4*(1-GR_chij))))^(GR_etaj*(1+GR_zeta))*GR_fj(+1);
// Definition of gj
GR_gj = GR_lambdaj*(1-GR_taun-GR_tauwh)*GR_wj^GR_etaj*GR_ndj+GR_xij*GR_beta*(GR_pic(+1)/(GR_pic^GR_chij*GR_pi4target^(1/4*(1-GR_chij))))^(GR_etaj-1)*GR_gj(+1);
// Aggregate wage rate
GR_wj^(1-GR_etaj) = (1-GR_xij)*GR_wjtilde^(1-GR_etaj)+GR_xij*GR_wj(-1)^(1-GR_etaj)*(GR_pic(-1)^GR_chij*GR_pi4target^(1/4*(1-GR_chij))/GR_pic)^(1-GR_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
GR_kg = (1-GR_deltag)*GR_kg(-1)+GR_ig(-1);
// Production function tradable
GR_yst = GR_zt*GR_kg^GR_alphag*GR_kdt^GR_alphat*GR_ndt^(1-GR_alphat)-GR_psitbar;
// Production function nontradable
GR_ysn = GR_zn*GR_kg^GR_alphag*GR_kdn^GR_alphan*GR_ndn^(1-GR_alphan)-GR_psinbar;
// Real marginal cost tradable
GR_mct = 1/(GR_zt*GR_kg^GR_alphag*(GR_alphat)^(GR_alphat)*(1-GR_alphat)^(1-GR_alphat))*GR_rk^(GR_alphat)*((1+GR_tauwf)*GR_w)^(1-GR_alphat);
// Real marginal cost nontradable
GR_mcn = 1/(GR_zn*GR_kg^GR_alphag*(GR_alphan)^(GR_alphan)*(1-GR_alphan)^(1-GR_alphan))*GR_rk^(GR_alphan)*((1+GR_tauwf)*GR_w)^(1-GR_alphan);
// Wage Inflation (qoq)
GR_piw = GR_w/GR_w(-1)*GR_pic;
// Wage Inflation (yoy)
GR_piw4 = GR_pic4;
// Auxiliary equation for steady-state fixed cost
GR_psitbar = GR_psit*GR_ytbar;
// Auxiliary equation for steady-state fixed cost
GR_psinbar = GR_psin*GR_ynbar;
// Capital input (FOC)
GR_rk = GR_alphat*(GR_yst+GR_psitbar)/GR_kdt*GR_mct;
// Capital input (FOC)
GR_rk = GR_alphan*(GR_ysn+GR_psinbar)/GR_kdn*GR_mcn;
// Total capital demand
GR_kd = GR_kdt+GR_kdn;
// Demand for labour services by household I
GR_ndi = 
(1-GR_omega)*(GR_wi/GR_w)^(-GR_eta)*GR_nd
;
// Demand for labour services by household J
GR_ndj = 
GR_omega*(GR_wj/GR_w)^(-GR_eta)*GR_nd
;
// Aggregate labour demand
GR_nd^(1-1/GR_eta) = 
(1-GR_omega)^(1/GR_eta)*GR_ndi^(1-1/GR_eta)+GR_omega^(1/GR_eta)*GR_ndj^(1-1/GR_eta)
;
// Total demand 
GR_nd = GR_ndt+GR_ndn;
// Aggregate dividends
GR_d = GR_py*GR_y-GR_rk*GR_kd-(1+GR_tauwf)*GR_w*GR_nd;
// Non-tradable sector dividends
GR_dn = GR_pnt*GR_ysn-GR_rk*GR_kdn-(1+GR_tauwf)*GR_w*GR_ndn;
// Tradable sector dividends
GR_dt = GR_pht*GR_ht
+GR_pex*GR_ex
-GR_rk*GR_kdt-(1+GR_tauwf)*GR_w*GR_ndt;
// Optimal price contract set in domestic markets (FOC)
GR_phttilde/GR_pht = GR_thetat/(GR_thetat-1)*GR_fh/GR_gh;
// Definition of fh
GR_fh = GR_mct*GR_ht+GR_xih*GR_beta*GR_lambdai(+1)/GR_lambdai*(GR_piht(+1)/(GR_piht^GR_chih*GR_pi4target^(1/4*(1-GR_chih))))^GR_thetat*GR_fh(+1);
// Definition of gh
GR_gh = GR_pht*GR_ht+GR_xih*GR_beta*GR_lambdai(+1)/GR_lambdai*(GR_piht(+1)/(GR_piht^GR_chih*GR_pi4target^(1/4*(1-GR_chih))))^(GR_thetat-1)*GR_gh(+1);
// Aggregate intermediate-good price dynamics
GR_pht^(1-GR_thetat) = (1-GR_xih)*GR_phttilde^(1-GR_thetat)+GR_xih*(GR_pht(-1)/GR_pic)^(1-GR_thetat)*(GR_piht(-1)^GR_chih*GR_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation
GR_piht = GR_pht/GR_pht(-1)*GR_pic;
// Optimal price contract set in domestic markets (FOC)
GR_pnttilde/GR_pnt = GR_thetan/(GR_thetan-1)*GR_fn/GR_gn;
// Definition of fn
GR_fn = GR_mcn*GR_nt+GR_xin*GR_beta*GR_lambdai(+1)/GR_lambdai*(GR_pint(+1)/(GR_pint^GR_chin*GR_pi4target^(1/4*(1-GR_chin))))^GR_thetan*GR_fn(+1);
// Definition of gn
GR_gn = GR_pnt*GR_nt+GR_xin*GR_beta*GR_lambdai(+1)/GR_lambdai*(GR_pint(+1)/(GR_pint^GR_chin*GR_pi4target^(1/4*(1-GR_chin))))^(GR_thetan-1)*GR_gn(+1);
// Aggregate intermediate-good price dynamics
GR_pnt^(1-GR_thetan) = (1-GR_xin)*GR_pnttilde^(1-GR_thetan)+GR_xin*(GR_pnt(-1)/GR_pic)^(1-GR_thetan)*(GR_pint(-1)^GR_chin*GR_pi4target^(1/4*(1-GR_chin)))^(1-GR_thetan);
// Intermediate-good price inflation
GR_pint = GR_pnt/GR_pnt(-1)*GR_pic;
// Optimal price contract set in domestic markets (FOC)
GR_pextilde/GR_pex = GR_thetat/(GR_thetat-1)*GR_fx/GR_gx;
// Definition of fh
GR_fx = GR_mct*GR_ex+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(GR_piex(+1)/(GR_piex^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GR_fx(+1);
// Definition of gh
GR_gx = GR_pex*GR_ex+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(GR_piex(+1)/(GR_piex^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GR_gx(+1);
// Aggregate intermediate-good price dynamics
GR_pex^(1-GR_thetat) = (1-GR_xix)*GR_pextilde^(1-GR_thetat)+GR_xix*(GR_pex(-1)/GR_pic)^(1-GR_thetat)*(GR_piex(-1)^GR_chix*GR_pi4target^(1/4*(1-GR_chix)))^(1-GR_thetat);
// Intermediate-good price inflation
GR_piex = GR_pex/GR_pex(-1)*GR_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = RA_pimtilde
// RAGR_pimtilde/RAGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRRA_fx/GRRA_gx;
// Definition of fx
// GRRA_fx = RA_size/GR_size*RAGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(RAGR_piim(+1)/(RAGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRRA_fx(+1);
// Definition of gx   
// GRRA_gx = GRRA_rer*RAGR_pim*RA_size/GR_size*RAGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(RAGR_piim(+1)/(RAGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRRA_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = RA_pim
// RAGR_pim^(1-GR_thetat) = (1-GR_xix)*RAGR_pimtilde^(1-GR_thetat)+GR_xix*(RAGR_pim(-1)/RA_pic)^(1-GR_thetat)*(RAGR_piim(-1)^GR_chix*RA_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = RA_piim
// RAGR_piim = RAGR_pim/RAGR_pim(-1)*RA_pic;
// Bilateral real exchange rate
GRRA_rer = GR_rer/RA_rer;
// Auxiliary equation for steady-state output
GRRA_rerbar = GRRA_rer;
//Terms of Trade
GRRA_tot = RA_pex*GRRA_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = AT_pimtilde
// ATGR_pimtilde/ATGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRAT_fx/GRAT_gx;
// Definition of fx
// GRAT_fx = AT_size/GR_size*ATGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(ATGR_piim(+1)/(ATGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRAT_fx(+1);
// Definition of gx   
// GRAT_gx = GRAT_rer*ATGR_pim*AT_size/GR_size*ATGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(ATGR_piim(+1)/(ATGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRAT_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = AT_pim
// ATGR_pim^(1-GR_thetat) = (1-GR_xix)*ATGR_pimtilde^(1-GR_thetat)+GR_xix*(ATGR_pim(-1)/AT_pic)^(1-GR_thetat)*(ATGR_piim(-1)^GR_chix*AT_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = AT_piim
// ATGR_piim = ATGR_pim/ATGR_pim(-1)*AT_pic;
// Bilateral real exchange rate
GRAT_rer = GR_rer/AT_rer;
// Auxiliary equation for steady-state output
GRAT_rerbar = GRAT_rer;
//Terms of Trade
GRAT_tot = AT_pex*GRAT_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = BE_pimtilde
// BEGR_pimtilde/BEGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRBE_fx/GRBE_gx;
// Definition of fx
// GRBE_fx = BE_size/GR_size*BEGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(BEGR_piim(+1)/(BEGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRBE_fx(+1);
// Definition of gx   
// GRBE_gx = GRBE_rer*BEGR_pim*BE_size/GR_size*BEGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(BEGR_piim(+1)/(BEGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRBE_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = BE_pim
