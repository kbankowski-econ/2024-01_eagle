// Government spending, using US_pg = US_pht
US_pcg*US_cg = US_cgy*US_pybar*US_ybar;
US_pig*US_ig = US_igy*US_pybar*US_ybar;
US_t = 0;
US_b = US_bytarget*US_pybar*US_ybar;
// Auxiliary equation for steady-state output
US_ybar = US_y;
// Auxiliary equation for steady-state output
US_ytbar = US_yst;
// Auxiliary equation for steady-state output
US_ynbar = US_ysn;
// Auxiliary equation for steady-state output deflator
US_pybar = US_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
US_trybar = US_tr/(US_pybar*US_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
US_ti = US_upsilont*US_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
US_tri = US_upsilontr*US_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	US_r^4-1 = US_rrstar^4*US_pi4target-1;
US_pic4 = US_pi4target;
US_rr-1 = US_r/US_pi4target^(1/4)-1;
// Equilibrium real interest rate
US_rrstar-1 = 1/US_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
US_c = (1-US_omega)*US_ci+US_omega*US_cj;
// Aggregate money holdings
US_m = (1-US_omega)*US_mi+US_omega*US_mj;
// Aggregate capital stock
US_k = (1-US_omega)*US_ki;
// Aggregate investment
US_i = (1-US_omega)*US_ii;
// Aggregate lump-sum transfers
US_trj = 
1/US_omega*US_tr-(1-US_omega)/US_omega*US_tri
;
// Aggregate lump-sum taxes
US_tj = 
1/US_omega*US_t-(1-US_omega)/US_omega*US_ti
;
// Aggregate transaction costs
US_gammav = (1-US_omega)*US_ci*US_gammavi+US_omega*US_cj*US_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
US_ni = US_si*US_ndi;
// Wage dispersion
US_si = (1-US_xii)*(US_witilde/US_wi)^(-US_etai)+US_xii*(US_wi(-1)/US_wi)^(-US_etai)*(US_pic/(US_pic(-1)^US_chii*US_pi4target^(1/4*(1-US_chii))))^(US_etai)*US_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
US_nj = US_sj*US_ndj;
// Wage dispersion
US_sj = (1-US_xij)*(US_wjtilde/US_wj)^(-US_etaj)+US_xij*(US_wj(-1)/US_wj)^(-US_etaj)*(US_pic/(US_pic(-1)^US_chij*US_pi4target^(1/4*(1-US_chij))))^(US_etaj)*US_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
US_u*US_k = US_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using US_x = RA_size/US_size*RA_im
US_ysn = US_snt*US_nt;
//  nontradables aggregate demand
US_nt = 
+US_ntc
+US_nti
+US_ntcg
+US_ntig
;
// Aggregate demand for domestic intermediate goods, using US_hg = US_cg
US_ht =
+US_htc
+US_hti
+US_htcg
+US_htig
;
// Price dispersion in the domestic markets
US_sh = (1-US_xih)*(US_phttilde/US_pht)^(-US_thetat)+US_xih*(US_piht/(US_piht(-1)^US_chih*US_pi4target^(1/4*(1-US_chih))))^US_thetat*US_sh(-1);
// Price dispersion in the foreign markets
US_sx = (1-US_xix)*(US_pextilde/US_pex)^(-US_thetat)+US_xix*(US_piex/(US_piex(-1)^US_chix*US_pi4target^(1/4*(1-US_chix))))^US_thetat*US_sx(-1);
// Price dispersion in the domestic markets
US_snt = (1-US_xin)*(US_pnttilde/US_pnt)^(-US_thetan)+US_xin*(US_pint/(US_pint(-1)^US_chin*US_pi4target^(1/4*(1-US_chin))))^US_thetan*US_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
US_qc = US_c+US_gammav;
// Aggregate investment and capital utilisation cost
US_qi = US_i+US_k*US_gammau;
// Aggregate gov demand components added to use the same structure like in private components
US_qcg = US_cg;
US_qig = US_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
US_py*US_y = 
+US_qc
+US_pi*US_qi
+US_pcg*US_qcg
+US_pig*US_qig
+US_pex*RA_size/US_size*RAUS_im
-(RA_pex*USRA_rer)*USRA_imc
-(RA_pex*USRA_rer)*USRA_imi
-(RA_pex*USRA_rer)*USRA_imcg
-(RA_pex*USRA_rer)*USRA_imig
+US_pex*AT_size/US_size*ATUS_im
-(AT_pex*USAT_rer)*USAT_imc
-(AT_pex*USAT_rer)*USAT_imi
-(AT_pex*USAT_rer)*USAT_imcg
-(AT_pex*USAT_rer)*USAT_imig
+US_pex*BE_size/US_size*BEUS_im
-(BE_pex*USBE_rer)*USBE_imc
-(BE_pex*USBE_rer)*USBE_imi
-(BE_pex*USBE_rer)*USBE_imcg
-(BE_pex*USBE_rer)*USBE_imig
+US_pex*ES_size/US_size*ESUS_im
-(ES_pex*USES_rer)*USES_imc
-(ES_pex*USES_rer)*USES_imi
-(ES_pex*USES_rer)*USES_imcg
-(ES_pex*USES_rer)*USES_imig
+US_pex*FI_size/US_size*FIUS_im
-(FI_pex*USFI_rer)*USFI_imc
-(FI_pex*USFI_rer)*USFI_imi
-(FI_pex*USFI_rer)*USFI_imcg
-(FI_pex*USFI_rer)*USFI_imig
+US_pex*FR_size/US_size*FRUS_im
-(FR_pex*USFR_rer)*USFR_imc
-(FR_pex*USFR_rer)*USFR_imi
-(FR_pex*USFR_rer)*USFR_imcg
-(FR_pex*USFR_rer)*USFR_imig
+US_pex*GR_size/US_size*GRUS_im
-(GR_pex*USGR_rer)*USGR_imc
-(GR_pex*USGR_rer)*USGR_imi
-(GR_pex*USGR_rer)*USGR_imcg
-(GR_pex*USGR_rer)*USGR_imig
+US_pex*IT_size/US_size*ITUS_im
-(IT_pex*USIT_rer)*USIT_imc
-(IT_pex*USIT_rer)*USIT_imi
-(IT_pex*USIT_rer)*USIT_imcg
-(IT_pex*USIT_rer)*USIT_imig
+US_pex*NL_size/US_size*NLUS_im
-(NL_pex*USNL_rer)*USNL_imc
-(NL_pex*USNL_rer)*USNL_imi
-(NL_pex*USNL_rer)*USNL_imcg
-(NL_pex*USNL_rer)*USNL_imig
+US_pex*PT_size/US_size*PTUS_im
-(PT_pex*USPT_rer)*USPT_imc
-(PT_pex*USPT_rer)*USPT_imi
-(PT_pex*USPT_rer)*USPT_imcg
-(PT_pex*USPT_rer)*USPT_imig
+US_pex*DE_size/US_size*DEUS_im
-(DE_pex*USDE_rer)*USDE_imc
-(DE_pex*USDE_rer)*USDE_imi
-(DE_pex*USDE_rer)*USDE_imcg
-(DE_pex*USDE_rer)*USDE_imig
+US_pex*RU_size/US_size*RUUS_im
-(RU_pex*USRU_rer)*USRU_imc
-(RU_pex*USRU_rer)*USRU_imi
-(RU_pex*USRU_rer)*USRU_imcg
-(RU_pex*USRU_rer)*USRU_imig
+US_pex*RW_size/US_size*RWUS_im
-(RW_pex*USRW_rer)*USRW_imc
-(RW_pex*USRW_rer)*USRW_imi
-(RW_pex*USRW_rer)*USRW_imcg
-(RW_pex*USRW_rer)*USRW_imig
;
// Aggregate real demand
US_y = US_yst+US_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(US_zt) = (1-US_rhozt)*log(US_ztbar)+US_rhozt*log(US_zt(-1))+US_epszt;
log(US_zn) = (1-US_rhozn)*log(US_znbar)+US_rhozn*log(US_zn(-1))+US_epszn;
// Government spending shock
US_cgy = (1-US_rhocg)*US_cgybar+US_rhocg*US_cgy(-1)+US_epsgc;
US_igy = (1-US_rhoig)*US_igybar+US_rhoig*US_igy(-1)+US_epsgi;
// Transfer shock
US_try = (1-US_rhotr)*US_trybar+US_rhotr*US_try(-1)+US_epstr;
// Consumption tax shock
US_tauc = (1-US_rhotauc)*US_taucbar+US_rhotauc*US_tauc(-1)+US_epstauc;
// Dividend income tax shock
US_taud = (1-US_rhotaud)*US_taudbar+US_rhotaud*US_taud(-1)+US_epstaud;
// Capital income tax shock
US_tauk = (1-US_rhotauk)*US_taukbar+US_rhotauk*US_tauk(-1)+US_epstauk;
// Labour income tax shock
US_taun = (1-US_rhotaun)*US_taunbar+US_rhotaun*US_taun(-1)+US_epstaun;
// Payroll tax shock: households
US_tauwh = (1-US_rhotauwh)*US_tauwhbar+US_rhotauwh*US_tauwh(-1)+US_epstauwh;
// Payroll tax shock: firms
US_tauwf = (1-US_rhotauwf)*US_tauwfbar+US_rhotauwf*US_tauwf(-1)+US_epstauwf;
// Wage cost push shock
US_wcst = (1-US_rhowcst)*US_wcstbar+US_rhowcst*US_wcst(-1)+US_epswcst;
// Preference shock
log(US_zcon) = (1-US_rhozcon)*log(US_zconbar)+US_rhozcon*log(US_zcon(-1))+US_epszcon;
// Investment specific shock
log(US_zinv) = (1-US_rhozinv)*log(US_zinvbar)+US_rhozinv*log(US_zinv(-1))+US_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
US_cy = US_c/(US_py*US_y);
// Aggregate nominal investment share
US_iy = US_pi*US_i/(US_py*US_y);
// Aggregate nominal import share  
US_imy = (
+US_pimc*US_imc
+US_pimi*US_imi
+US_pimcg*US_imcg
+US_pimig*US_imig
)/(US_py*US_y);
// Aggregate nominal import share
US_imcy = US_pimc*US_imc/(US_py*US_y);
US_imiy = US_pimi*US_imi/(US_py*US_y);
US_imcgy = US_pimcg*US_imcg/(US_py*US_y);
US_imigy = US_pimig*US_imig/(US_py*US_y);
// Aggregate debt-to-output ratio
US_by = US_b/(US_pybar*US_ybar);
// Aggregate lump-sum tax-to-output ratio
US_ty = US_t/(US_pybar*US_ybar);
// Aggregate labour cost share
US_lcy = ((1+US_tauwf)*US_w*US_nd)/(US_py*US_y);
// Aggregate nominal Wage share
US_wy = (US_w*US_nd)/(US_py*US_y);
// NT sector nominal Wage share
US_wnty = (US_w*US_ndn)/(US_pnt*US_ysn);
// T sector nominal Wage share
US_whty = (US_w*US_ndt)/(US_pht*US_yst);
// T sector share
US_yhty = US_pht*US_yst/(US_py*US_y);
// NT sector share
US_ynty = US_pnt*US_ysn/(US_py*US_y);
// Output gap
US_ygap = 0;
// Output growth (gross rate)
US_ygrowth = US_y/US_y(-1);
// Output growth (gross rate yoy)
US_ygrowth4 = US_y/US_y(-4);
// Domestic nominal output as a share of world nominal output
US_yshare  = US_size*US_py*US_y/US_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
US_epsilonm = -1/8*1/(US_r*(US_gammav2*US_r+US_r-1));
// Trade balance-to-GDP ratio
US_tby = US_tb/(US_py*US_y);
// Bilateral shares
USRA_imcy = (RA_pex*USRA_rer)*USRA_imc/(US_py*US_y);
USRA_imiy = (RA_pex*USRA_rer)*USRA_imi/(US_py*US_y);
USRA_imcgy = (RA_pex*USRA_rer)*USRA_imcg/(US_py*US_y);
USRA_imigy = (RA_pex*USRA_rer)*USRA_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USRA_excy  = RA_size/US_size*US_pex*RAUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USRA_exiy  = RA_size/US_size*US_pex*RAUS_imi/(US_py*US_y);
// Bilateral shares
USAT_imcy = (AT_pex*USAT_rer)*USAT_imc/(US_py*US_y);
USAT_imiy = (AT_pex*USAT_rer)*USAT_imi/(US_py*US_y);
USAT_imcgy = (AT_pex*USAT_rer)*USAT_imcg/(US_py*US_y);
USAT_imigy = (AT_pex*USAT_rer)*USAT_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USAT_excy  = AT_size/US_size*US_pex*ATUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USAT_exiy  = AT_size/US_size*US_pex*ATUS_imi/(US_py*US_y);
// Bilateral shares
USBE_imcy = (BE_pex*USBE_rer)*USBE_imc/(US_py*US_y);
USBE_imiy = (BE_pex*USBE_rer)*USBE_imi/(US_py*US_y);
USBE_imcgy = (BE_pex*USBE_rer)*USBE_imcg/(US_py*US_y);
USBE_imigy = (BE_pex*USBE_rer)*USBE_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USBE_excy  = BE_size/US_size*US_pex*BEUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USBE_exiy  = BE_size/US_size*US_pex*BEUS_imi/(US_py*US_y);
// Bilateral shares
USES_imcy = (ES_pex*USES_rer)*USES_imc/(US_py*US_y);
USES_imiy = (ES_pex*USES_rer)*USES_imi/(US_py*US_y);
USES_imcgy = (ES_pex*USES_rer)*USES_imcg/(US_py*US_y);
USES_imigy = (ES_pex*USES_rer)*USES_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USES_excy  = ES_size/US_size*US_pex*ESUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USES_exiy  = ES_size/US_size*US_pex*ESUS_imi/(US_py*US_y);
// Bilateral shares
USFI_imcy = (FI_pex*USFI_rer)*USFI_imc/(US_py*US_y);
USFI_imiy = (FI_pex*USFI_rer)*USFI_imi/(US_py*US_y);
USFI_imcgy = (FI_pex*USFI_rer)*USFI_imcg/(US_py*US_y);
USFI_imigy = (FI_pex*USFI_rer)*USFI_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USFI_excy  = FI_size/US_size*US_pex*FIUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USFI_exiy  = FI_size/US_size*US_pex*FIUS_imi/(US_py*US_y);
// Bilateral shares
USFR_imcy = (FR_pex*USFR_rer)*USFR_imc/(US_py*US_y);
USFR_imiy = (FR_pex*USFR_rer)*USFR_imi/(US_py*US_y);
USFR_imcgy = (FR_pex*USFR_rer)*USFR_imcg/(US_py*US_y);
USFR_imigy = (FR_pex*USFR_rer)*USFR_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USFR_excy  = FR_size/US_size*US_pex*FRUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USFR_exiy  = FR_size/US_size*US_pex*FRUS_imi/(US_py*US_y);
// Bilateral shares
USGR_imcy = (GR_pex*USGR_rer)*USGR_imc/(US_py*US_y);
USGR_imiy = (GR_pex*USGR_rer)*USGR_imi/(US_py*US_y);
USGR_imcgy = (GR_pex*USGR_rer)*USGR_imcg/(US_py*US_y);
USGR_imigy = (GR_pex*USGR_rer)*USGR_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USGR_excy  = GR_size/US_size*US_pex*GRUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USGR_exiy  = GR_size/US_size*US_pex*GRUS_imi/(US_py*US_y);
// Bilateral shares
USIT_imcy = (IT_pex*USIT_rer)*USIT_imc/(US_py*US_y);
USIT_imiy = (IT_pex*USIT_rer)*USIT_imi/(US_py*US_y);
USIT_imcgy = (IT_pex*USIT_rer)*USIT_imcg/(US_py*US_y);
USIT_imigy = (IT_pex*USIT_rer)*USIT_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USIT_excy  = IT_size/US_size*US_pex*ITUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USIT_exiy  = IT_size/US_size*US_pex*ITUS_imi/(US_py*US_y);
// Bilateral shares
USNL_imcy = (NL_pex*USNL_rer)*USNL_imc/(US_py*US_y);
USNL_imiy = (NL_pex*USNL_rer)*USNL_imi/(US_py*US_y);
USNL_imcgy = (NL_pex*USNL_rer)*USNL_imcg/(US_py*US_y);
USNL_imigy = (NL_pex*USNL_rer)*USNL_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USNL_excy  = NL_size/US_size*US_pex*NLUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USNL_exiy  = NL_size/US_size*US_pex*NLUS_imi/(US_py*US_y);
// Bilateral shares
USPT_imcy = (PT_pex*USPT_rer)*USPT_imc/(US_py*US_y);
USPT_imiy = (PT_pex*USPT_rer)*USPT_imi/(US_py*US_y);
USPT_imcgy = (PT_pex*USPT_rer)*USPT_imcg/(US_py*US_y);
USPT_imigy = (PT_pex*USPT_rer)*USPT_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USPT_excy  = PT_size/US_size*US_pex*PTUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USPT_exiy  = PT_size/US_size*US_pex*PTUS_imi/(US_py*US_y);
// Bilateral shares
USDE_imcy = (DE_pex*USDE_rer)*USDE_imc/(US_py*US_y);
USDE_imiy = (DE_pex*USDE_rer)*USDE_imi/(US_py*US_y);
USDE_imcgy = (DE_pex*USDE_rer)*USDE_imcg/(US_py*US_y);
USDE_imigy = (DE_pex*USDE_rer)*USDE_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USDE_excy  = DE_size/US_size*US_pex*DEUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USDE_exiy  = DE_size/US_size*US_pex*DEUS_imi/(US_py*US_y);
// Bilateral shares
USRU_imcy = (RU_pex*USRU_rer)*USRU_imc/(US_py*US_y);
USRU_imiy = (RU_pex*USRU_rer)*USRU_imi/(US_py*US_y);
USRU_imcgy = (RU_pex*USRU_rer)*USRU_imcg/(US_py*US_y);
USRU_imigy = (RU_pex*USRU_rer)*USRU_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USRU_excy  = RU_size/US_size*US_pex*RUUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USRU_exiy  = RU_size/US_size*US_pex*RUUS_imi/(US_py*US_y);
// Bilateral shares
USRW_imcy = (RW_pex*USRW_rer)*USRW_imc/(US_py*US_y);
USRW_imiy = (RW_pex*USRW_rer)*USRW_imi/(US_py*US_y);
USRW_imcgy = (RW_pex*USRW_rer)*USRW_imcg/(US_py*US_y);
USRW_imigy = (RW_pex*USRW_rer)*USRW_imig/(US_py*US_y);
// Exports of consumption goods to gdp
USRW_excy  = RW_size/US_size*US_pex*RWUS_imc/(US_py*US_y);
// Exports of investment goods to gdp
USRW_exiy  = RW_size/US_size*US_pex*RWUS_imi/(US_py*US_y);
// Internal real exchange rate
US_internalrer = US_pnt/US_pttc;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
RA_gammab = 0;
// International transaction cost ('risk premium')
RA_bf = (RA_bfytarget*RA_py*RA_y)/RA_rer*US_pic;
// Risk premium shock
RA_rp = 0;
// Definition of the rate of real exchange-rate depreciation
RA_rerdep = RA_rer/RA_rer(-1);
// Definition of the terms of trade
RA_tot = US_pex*RA_rer/RA_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
AT_gammab = 0;
// International transaction cost ('risk premium')
AT_bf = (AT_bfytarget*AT_py*AT_y)/AT_rer*US_pic;
// Risk premium shock
AT_rp = 0;
// Definition of the rate of real exchange-rate depreciation
AT_rerdep = AT_rer/AT_rer(-1);
// Definition of the terms of trade
AT_tot = US_pex*AT_rer/AT_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
BE_gammab = 0;
// International transaction cost ('risk premium')
BE_bf = (BE_bfytarget*BE_py*BE_y)/BE_rer*US_pic;
// Risk premium shock
BE_rp = 0;
// Definition of the rate of real exchange-rate depreciation
BE_rerdep = BE_rer/BE_rer(-1);
// Definition of the terms of trade
BE_tot = US_pex*BE_rer/BE_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
ES_gammab = 0;
// International transaction cost ('risk premium')
ES_bf = (ES_bfytarget*ES_py*ES_y)/ES_rer*US_pic;
// Risk premium shock
ES_rp = 0;
// Definition of the rate of real exchange-rate depreciation
ES_rerdep = ES_rer/ES_rer(-1);
// Definition of the terms of trade
ES_tot = US_pex*ES_rer/ES_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
FI_gammab = 0;
// International transaction cost ('risk premium')
FI_bf = (FI_bfytarget*FI_py*FI_y)/FI_rer*US_pic;
// Risk premium shock
FI_rp = 0;
// Definition of the rate of real exchange-rate depreciation
FI_rerdep = FI_rer/FI_rer(-1);
// Definition of the terms of trade
FI_tot = US_pex*FI_rer/FI_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
FR_gammab = 0;
// International transaction cost ('risk premium')
FR_bf = (FR_bfytarget*FR_py*FR_y)/FR_rer*US_pic;
// Risk premium shock
FR_rp = 0;
// Definition of the rate of real exchange-rate depreciation
FR_rerdep = FR_rer/FR_rer(-1);
// Definition of the terms of trade
FR_tot = US_pex*FR_rer/FR_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
GR_gammab = 0;
// International transaction cost ('risk premium')
GR_bf = (GR_bfytarget*GR_py*GR_y)/GR_rer*US_pic;
// Risk premium shock
GR_rp = 0;
// Definition of the rate of real exchange-rate depreciation
GR_rerdep = GR_rer/GR_rer(-1);
// Definition of the terms of trade
GR_tot = US_pex*GR_rer/GR_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
IT_gammab = 0;
// International transaction cost ('risk premium')
IT_bf = (IT_bfytarget*IT_py*IT_y)/IT_rer*US_pic;
// Risk premium shock
IT_rp = 0;
// Definition of the rate of real exchange-rate depreciation
IT_rerdep = IT_rer/IT_rer(-1);
// Definition of the terms of trade
IT_tot = US_pex*IT_rer/IT_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
NL_gammab = 0;
// International transaction cost ('risk premium')
NL_bf = (NL_bfytarget*NL_py*NL_y)/NL_rer*US_pic;
// Risk premium shock
NL_rp = 0;
// Definition of the rate of real exchange-rate depreciation
NL_rerdep = NL_rer/NL_rer(-1);
// Definition of the terms of trade
NL_tot = US_pex*NL_rer/NL_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
PT_gammab = 0;
// International transaction cost ('risk premium')
PT_bf = (PT_bfytarget*PT_py*PT_y)/PT_rer*US_pic;
// Risk premium shock
PT_rp = 0;
// Definition of the rate of real exchange-rate depreciation
PT_rerdep = PT_rer/PT_rer(-1);
// Definition of the terms of trade
PT_tot = US_pex*PT_rer/PT_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
DE_gammab = 0;
// International transaction cost ('risk premium')
DE_bf = (DE_bfytarget*DE_py*DE_y)/DE_rer*US_pic;
// Risk premium shock
DE_rp = 0;
// Definition of the rate of real exchange-rate depreciation
DE_rerdep = DE_rer/DE_rer(-1);
// Definition of the terms of trade
DE_tot = US_pex*DE_rer/DE_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
RU_gammab = 0;
// International transaction cost ('risk premium')
RU_bf = (RU_bfytarget*RU_py*RU_y)/RU_rer*US_pic;
// Risk premium shock
RU_rp = 0;
// Definition of the rate of real exchange-rate depreciation
RU_rerdep = RU_rer/RU_rer(-1);
// Definition of the terms of trade
RU_tot = US_pex*RU_rer/RU_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
RW_gammab = 0;
// International transaction cost ('risk premium')
RW_bf = (RW_bfytarget*RW_py*RW_y)/RW_rer*US_pic;
// Risk premium shock
RW_rp = 0;
// Definition of the rate of real exchange-rate depreciation
RW_rerdep = RW_rer/RW_rer(-1);
// Definition of the terms of trade
RW_tot = US_pex*RW_rer/RW_pex;
//-------------
// Closure conditions
//-------------
US_size*US_bf =
-RA_size*RA_bf
-AT_size*AT_bf
-BE_size*BE_bf
-ES_size*ES_bf
-FI_size*FI_bf
-FR_size*FR_bf
-GR_size*GR_bf
-IT_size*IT_bf
-NL_size*NL_bf
-PT_size*PT_bf
-DE_size*DE_bf
-RU_size*RU_bf
-RW_size*RW_bf
;
// Net foreign asset position
	
		
			RA_bf/US_r(-1) = -RA_bh/DE_r(-1)*RADE_rer(-1)/RA_rer(-1) + RA_bh(-1)*RADE_rer(-2) / RA_rer(-2) + RA_bf(-1) + RA_tb(-1)/RA_rer(-1);
		
	
	
		
			AT_bf/US_r(-1) = -AT_bh/DE_r(-1)*ATDE_rer(-1)/AT_rer(-1) + AT_bh(-1)*ATDE_rer(-2) / AT_rer(-2) + AT_bf(-1) + AT_tb(-1)/AT_rer(-1);
		
	
	
		
			BE_bf/US_r(-1) = -BE_bh/DE_r(-1)*BEDE_rer(-1)/BE_rer(-1) + BE_bh(-1)*BEDE_rer(-2) / BE_rer(-2) + BE_bf(-1) + BE_tb(-1)/BE_rer(-1);
		
	
	
		
			ES_bf/US_r(-1) = -ES_bh/DE_r(-1)*ESDE_rer(-1)/ES_rer(-1) + ES_bh(-1)*ESDE_rer(-2) / ES_rer(-2) + ES_bf(-1) + ES_tb(-1)/ES_rer(-1);
		
	
	
		
			FI_bf/US_r(-1) = -FI_bh/DE_r(-1)*FIDE_rer(-1)/FI_rer(-1) + FI_bh(-1)*FIDE_rer(-2) / FI_rer(-2) + FI_bf(-1) + FI_tb(-1)/FI_rer(-1);
		
	
	
		
			FR_bf/US_r(-1) = -FR_bh/DE_r(-1)*FRDE_rer(-1)/FR_rer(-1) + FR_bh(-1)*FRDE_rer(-2) / FR_rer(-2) + FR_bf(-1) + FR_tb(-1)/FR_rer(-1);
		
	
	
		
			GR_bf/US_r(-1) = -GR_bh/DE_r(-1)*GRDE_rer(-1)/GR_rer(-1) + GR_bh(-1)*GRDE_rer(-2) / GR_rer(-2) + GR_bf(-1) + GR_tb(-1)/GR_rer(-1);
		
	
	
		
			IT_bf/US_r(-1) = -IT_bh/DE_r(-1)*ITDE_rer(-1)/IT_rer(-1) + IT_bh(-1)*ITDE_rer(-2) / IT_rer(-2) + IT_bf(-1) + IT_tb(-1)/IT_rer(-1);
		
	
	
		
			NL_bf/US_r(-1) = -NL_bh/DE_r(-1)*NLDE_rer(-1)/NL_rer(-1) + NL_bh(-1)*NLDE_rer(-2) / NL_rer(-2) + NL_bf(-1) + NL_tb(-1)/NL_rer(-1);
		
	
	
		
			PT_bf/US_r(-1) = -PT_bh/DE_r(-1)*PTDE_rer(-1)/PT_rer(-1) + PT_bh(-1)*PTDE_rer(-2) / PT_rer(-2) + PT_bf(-1) + PT_tb(-1)/PT_rer(-1);
		
	
	
			DE_bf/US_r(-1) = -DE_bh/RA_r(-1) / DE_rer(-1) + DE_bh(-1) / DE_rer(-2) + DE_bf(-1) + DE_tb(-1)/DE_rer(-1);
		
	
		RU_bf/US_r(-1) = RU_bf(-1)+RU_tb(-1)/RU_rer(-1);
	
		RW_bf/US_r(-1) = RW_bf(-1)+RW_tb(-1)/RW_rer(-1);
	
US_rer = 1;
		RADE_nerdep = RA_rerdep/DE_rerdep*RA_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			RA_gammabh = 0;
			RA_bh = (RA_bhytarget*RA_py*RA_y)/RADE_rer*DE_pic;
		ATDE_nerdep = AT_rerdep/DE_rerdep*AT_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			AT_gammabh = 0;
			AT_bh = (AT_bhytarget*AT_py*AT_y)/ATDE_rer*DE_pic;
		BEDE_nerdep = BE_rerdep/DE_rerdep*BE_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			BE_gammabh = 0;
			BE_bh = (BE_bhytarget*BE_py*BE_y)/BEDE_rer*DE_pic;
		ESDE_nerdep = ES_rerdep/DE_rerdep*ES_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			ES_gammabh = 0;
			ES_bh = (ES_bhytarget*ES_py*ES_y)/ESDE_rer*DE_pic;
		FIDE_nerdep = FI_rerdep/DE_rerdep*FI_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			FI_gammabh = 0;
			FI_bh = (FI_bhytarget*FI_py*FI_y)/FIDE_rer*DE_pic;
		FRDE_nerdep = FR_rerdep/DE_rerdep*FR_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			FR_gammabh = 0;
			FR_bh = (FR_bhytarget*FR_py*FR_y)/FRDE_rer*DE_pic;
		GRDE_nerdep = GR_rerdep/DE_rerdep*GR_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			GR_gammabh = 0;
			GR_bh = (GR_bhytarget*GR_py*GR_y)/GRDE_rer*DE_pic;
		ITDE_nerdep = IT_rerdep/DE_rerdep*IT_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			IT_gammabh = 0;
			IT_bh = (IT_bhytarget*IT_py*IT_y)/ITDE_rer*DE_pic;
		NLDE_nerdep = NL_rerdep/DE_rerdep*NL_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			NL_gammabh = 0;
			NL_bh = (NL_bhytarget*NL_py*NL_y)/NLDE_rer*DE_pic;
		PTDE_nerdep = PT_rerdep/DE_rerdep*PT_pic/DE_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			PT_gammabh = 0;
			PT_bh = (PT_bhytarget*PT_py*PT_y)/PTDE_rer*DE_pic;
0 =
	+ RA_size*RA_bh
	+ AT_size*AT_bh
	+ BE_size*BE_bh
	+ ES_size*ES_bh
	+ FI_size*FI_bh
	+ FR_size*FR_bh
	+ GR_size*GR_bh
	+ IT_size*IT_bh
	+ NL_size*NL_bh
	+ PT_size*PT_bh
	+ DE_size*DE_bh
;
//-------------
// Euroarea-wide variables
//-------------
// GDP
EA_y = 
	(
	RA_size*RA_pybar*RA_y
			+ AT_size*RAAT_rerbar*AT_pybar *AT_y	
			+ BE_size*RABE_rerbar*BE_pybar *BE_y	
			+ ES_size*RAES_rerbar*ES_pybar *ES_y	
			+ FI_size*RAFI_rerbar*FI_pybar *FI_y	
			+ FR_size*RAFR_rerbar*FR_pybar *FR_y	
			+ GR_size*RAGR_rerbar*GR_pybar *GR_y	
			+ IT_size*RAIT_rerbar*IT_pybar *IT_y	
			+ NL_size*RANL_rerbar*NL_pybar *NL_y	
			+ PT_size*RAPT_rerbar*PT_pybar *PT_y	
			+ DE_size*RADE_rerbar*DE_pybar *DE_y	
	)
	/
	(
	+ RA_size
	+ AT_size
	+ BE_size
	+ ES_size
	+ FI_size
	+ FR_size
	+ GR_size
	+ IT_size
	+ NL_size
	+ PT_size
	+ DE_size
);
// GDP growth
EA_ygrowth= EA_y/EA_y(-1);
// GDP growth (yoy)
EA_ygrowth4= EA_y/EA_y(-4);
// Money
EA_m = 
	(
	RA_size*RA_m
			+ AT_size*RAAT_rerbar*AT_m	
			+ BE_size*RABE_rerbar*BE_m	
			+ ES_size*RAES_rerbar*ES_m	
			+ FI_size*RAFI_rerbar*FI_m	
			+ FR_size*RAFR_rerbar*FR_m	
			+ GR_size*RAGR_rerbar*GR_m	
			+ IT_size*RAIT_rerbar*IT_m	
			+ NL_size*RANL_rerbar*NL_m	
			+ PT_size*RAPT_rerbar*PT_m	
			+ DE_size*RADE_rerbar*DE_m	
	)
	/
	(
	+ RA_size
	+ AT_size
	+ BE_size
	+ ES_size
	+ FI_size
	+ FR_size
	+ GR_size
	+ IT_size
	+ NL_size
	+ PT_size
	+ DE_size
);
	
EA_bf = 
	(
		+ RA_size*RA_bf	
		+ AT_size*AT_bf	
		+ BE_size*BE_bf	
		+ ES_size*ES_bf	
		+ FI_size*FI_bf	
		+ FR_size*FR_bf	
		+ GR_size*GR_bf	
		+ IT_size*IT_bf	
		+ NL_size*NL_bf	
		+ PT_size*PT_bf	
		+ DE_size*DE_bf	
	)
	/
	(
	+ RA_size
	+ AT_size
	+ BE_size
	+ ES_size
	+ FI_size
	+ FR_size
	+ GR_size
	+ IT_size
	+ NL_size
	+ PT_size
	+ DE_size
);
// Annual inflation
EA_pic4 = 1 
		* RA_pic4^(RA_size/(
				+ RA_size
				+ AT_size
				+ BE_size
				+ ES_size
				+ FI_size
				+ FR_size
				+ GR_size
				+ IT_size
				+ NL_size
				+ PT_size
				+ DE_size
			)) 
