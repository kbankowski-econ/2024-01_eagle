+ATUS_rer*US_pex*GRUS_im
)
+IT_size/AT_size*ITAT_im/AT_ex*ATRA_rer*RA_pex*ITRA_im/(ATIT_rer*IT_py*IT_y
+ATRA_rer*RA_pex*ITRA_im
+ATBE_rer*BE_pex*ITBE_im
+ATES_rer*ES_pex*ITES_im
+ATFI_rer*FI_pex*ITFI_im
