+RARU_rer*RU_pex*DERU_im
+RARW_rer*RW_pex*DERW_im
+RAUS_rer*US_pex*DEUS_im
)
+RU_size/RA_size*RURA_im/RA_ex*RARW_rer*RW_pex*RURW_im/(RARU_rer*RU_py*RU_y
+RAAT_rer*AT_pex*RUAT_im
+RABE_rer*BE_pex*RUBE_im
+RAES_rer*ES_pex*RUES_im
+RAFI_rer*FI_pex*RUFI_im
