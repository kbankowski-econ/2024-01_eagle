+ATUS_rer*US_pex*ESUS_im
)
+FI_size/AT_size*FIAT_im/AT_ex*ATRA_rer*RA_pex*FIRA_im/(ATFI_rer*FI_py*FI_y
+ATRA_rer*RA_pex*FIRA_im
+ATBE_rer*BE_pex*FIBE_im
+ATES_rer*ES_pex*FIES_im
