+BEPT_rer*PT_pex*ATPT_im
+BEDE_rer*DE_pex*ATDE_im
+BERU_rer*RU_pex*ATRU_im
+BERW_rer*RW_pex*ATRW_im
+BEUS_rer*US_pex*ATUS_im
)
+ES_size/BE_size*ESBE_im/BE_ex*BERA_rer*RA_pex*ESRA_im/(BEES_rer*ES_py*ES_y
