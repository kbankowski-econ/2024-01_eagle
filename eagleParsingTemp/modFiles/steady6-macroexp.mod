// Total imports 
FR_im = 
+FR_imc
+FR_imi
+FR_imcg
+FR_imig
;
// Total import deflator
FR_im*FR_pim  = 
+FR_pimc*FR_imc
+FR_pimi*FR_imi
+FR_pimcg*FR_imcg
+FR_pimig*FR_imig
;
