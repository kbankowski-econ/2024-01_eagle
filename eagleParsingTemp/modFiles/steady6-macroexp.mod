// Bilateral real exchange rate
GRRU_rer = GR_rer/RU_rer;
// Auxiliary equation for steady-state output
GRRU_rerbar = GRRU_rer;
//Terms of Trade
GRRU_tot = RU_pex*GRRU_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = RW_pimtilde
// RWGR_pimtilde/RWGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRRW_fx/GRRW_gx;
// Definition of fx
// GRRW_fx = RW_size/GR_size*RWGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(RWGR_piim(+1)/(RWGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRRW_fx(+1);
// Definition of gx   
// GRRW_gx = GRRW_rer*RWGR_pim*RW_size/GR_size*RWGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(RWGR_piim(+1)/(RWGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRRW_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = RW_pim
// RWGR_pim^(1-GR_thetat) = (1-GR_xix)*RWGR_pimtilde^(1-GR_thetat)+GR_xix*(RWGR_pim(-1)/RW_pic)^(1-GR_thetat)*(RWGR_piim(-1)^GR_chix*RW_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
