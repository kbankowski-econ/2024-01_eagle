// Bilateral real exchange rate
NLGR_rer = NL_rer/GR_rer;
// Auxiliary equation for steady-state output
NLGR_rerbar = NLGR_rer;
//Terms of Trade
NLGR_tot = GR_pex*NLGR_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = IT_pimtilde
// ITNL_pimtilde/ITNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLIT_fx/NLIT_gx;
// Definition of fx
// NLIT_fx = IT_size/NL_size*ITNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(ITNL_piim(+1)/(ITNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLIT_fx(+1);
// Definition of gx   
// NLIT_gx = NLIT_rer*ITNL_pim*IT_size/NL_size*ITNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(ITNL_piim(+1)/(ITNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLIT_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = IT_pim
// ITNL_pim^(1-NL_thetat) = (1-NL_xix)*ITNL_pimtilde^(1-NL_thetat)+NL_xix*(ITNL_pim(-1)/IT_pic)^(1-NL_thetat)*(ITNL_piim(-1)^NL_chix*IT_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = IT_piim
// ITNL_piim = ITNL_pim/ITNL_pim(-1)*IT_pic;
// Bilateral real exchange rate
NLIT_rer = NL_rer/IT_rer;
// Auxiliary equation for steady-state output
NLIT_rerbar = NLIT_rer;
//Terms of Trade
NLIT_tot = IT_pex*NLIT_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = PT_pimtilde
// PTNL_pimtilde/PTNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLPT_fx/NLPT_gx;
// Definition of fx
// NLPT_fx = PT_size/NL_size*PTNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(PTNL_piim(+1)/(PTNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLPT_fx(+1);
// Definition of gx   
// NLPT_gx = NLPT_rer*PTNL_pim*PT_size/NL_size*PTNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(PTNL_piim(+1)/(PTNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLPT_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = PT_pim
// PTNL_pim^(1-NL_thetat) = (1-NL_xix)*PTNL_pimtilde^(1-NL_thetat)+NL_xix*(PTNL_pim(-1)/PT_pic)^(1-NL_thetat)*(PTNL_piim(-1)^NL_chix*PT_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = PT_piim
// PTNL_piim = PTNL_pim/PTNL_pim(-1)*PT_pic;
// Bilateral real exchange rate
NLPT_rer = NL_rer/PT_rer;
// Auxiliary equation for steady-state output
NLPT_rerbar = NLPT_rer;
//Terms of Trade
NLPT_tot = PT_pex*NLPT_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = DE_pimtilde
// DENL_pimtilde/DENL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLDE_fx/NLDE_gx;
// Definition of fx
// NLDE_fx = DE_size/NL_size*DENL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(DENL_piim(+1)/(DENL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLDE_fx(+1);
// Definition of gx   
// NLDE_gx = NLDE_rer*DENL_pim*DE_size/NL_size*DENL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(DENL_piim(+1)/(DENL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLDE_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = DE_pim
// DENL_pim^(1-NL_thetat) = (1-NL_xix)*DENL_pimtilde^(1-NL_thetat)+NL_xix*(DENL_pim(-1)/DE_pic)^(1-NL_thetat)*(DENL_piim(-1)^NL_chix*DE_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = DE_piim
// DENL_piim = DENL_pim/DENL_pim(-1)*DE_pic;
// Bilateral real exchange rate
NLDE_rer = NL_rer/DE_rer;
// Auxiliary equation for steady-state output
NLDE_rerbar = NLDE_rer;
//Terms of Trade
NLDE_tot = DE_pex*NLDE_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = RU_pimtilde
// RUNL_pimtilde/RUNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLRU_fx/NLRU_gx;
// Definition of fx
// NLRU_fx = RU_size/NL_size*RUNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(RUNL_piim(+1)/(RUNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLRU_fx(+1);
// Definition of gx   
// NLRU_gx = NLRU_rer*RUNL_pim*RU_size/NL_size*RUNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(RUNL_piim(+1)/(RUNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLRU_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = RU_pim
// RUNL_pim^(1-NL_thetat) = (1-NL_xix)*RUNL_pimtilde^(1-NL_thetat)+NL_xix*(RUNL_pim(-1)/RU_pic)^(1-NL_thetat)*(RUNL_piim(-1)^NL_chix*RU_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = RU_piim
// RUNL_piim = RUNL_pim/RUNL_pim(-1)*RU_pic;
// Bilateral real exchange rate
NLRU_rer = NL_rer/RU_rer;
// Auxiliary equation for steady-state output
NLRU_rerbar = NLRU_rer;
//Terms of Trade
NLRU_tot = RU_pex*NLRU_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = RW_pimtilde
// RWNL_pimtilde/RWNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLRW_fx/NLRW_gx;
// Definition of fx
// NLRW_fx = RW_size/NL_size*RWNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(RWNL_piim(+1)/(RWNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLRW_fx(+1);
// Definition of gx   
// NLRW_gx = NLRW_rer*RWNL_pim*RW_size/NL_size*RWNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(RWNL_piim(+1)/(RWNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLRW_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = RW_pim
// RWNL_pim^(1-NL_thetat) = (1-NL_xix)*RWNL_pimtilde^(1-NL_thetat)+NL_xix*(RWNL_pim(-1)/RW_pic)^(1-NL_thetat)*(RWNL_piim(-1)^NL_chix*RW_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = RW_piim
// RWNL_piim = RWNL_pim/RWNL_pim(-1)*RW_pic;
// Bilateral real exchange rate
NLRW_rer = NL_rer/RW_rer;
// Auxiliary equation for steady-state output
NLRW_rerbar = NLRW_rer;
//Terms of Trade
NLRW_tot = RW_pex*NLRW_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = US_pimtilde
// USNL_pimtilde/USNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLUS_fx/NLUS_gx;
// Definition of fx
// NLUS_fx = US_size/NL_size*USNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(USNL_piim(+1)/(USNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLUS_fx(+1);
// Definition of gx   
// NLUS_gx = NLUS_rer*USNL_pim*US_size/NL_size*USNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(USNL_piim(+1)/(USNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLUS_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = US_pim
// USNL_pim^(1-NL_thetat) = (1-NL_xix)*USNL_pimtilde^(1-NL_thetat)+NL_xix*(USNL_pim(-1)/US_pic)^(1-NL_thetat)*(USNL_piim(-1)^NL_chix*US_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = US_piim
// USNL_piim = USNL_pim/USNL_pim(-1)*US_pic;
// Bilateral real exchange rate
NLUS_rer = NL_rer/US_rer;
// Auxiliary equation for steady-state output
NLUS_rerbar = NLUS_rer;
//Terms of Trade
NLUS_tot = US_pex*NLUS_rer/NL_pex;
// Total imports 
NL_im = 
+NL_imc
+NL_imi
+NL_imcg
+NL_imig
;
// Total import deflator
NL_im*NL_pim  = 
+NL_pimc*NL_imc
+NL_pimi*NL_imi
+NL_pimcg*NL_imcg
+NL_pimig*NL_imig
;
// Effective real exchange rate: double weighting (imports)
NLRA_weightim = NLRA_rer*RA_pex*NLRA_im/(NL_pim*NL_im);
// Effective real exchange rate: double weighting (exports)
NLRA_weightex = RA_size/NL_size*RANL_im/NL_ex*NLRA_rer*RA_py*RA_y/(NLRA_rer*RA_py*RA_y
+NLAT_rer*AT_pex*RAAT_im
+NLBE_rer*BE_pex*RABE_im
+NLES_rer*ES_pex*RAES_im
+NLFI_rer*FI_pex*RAFI_im
+NLFR_rer*FR_pex*RAFR_im
+NLGR_rer*GR_pex*RAGR_im
+NLIT_rer*IT_pex*RAIT_im
+NLPT_rer*PT_pex*RAPT_im
+NLDE_rer*DE_pex*RADE_im
+NLRU_rer*RU_pex*RARU_im
+NLRW_rer*RW_pex*RARW_im
+NLUS_rer*US_pex*RAUS_im
)+
+AT_size/NL_size*ATNL_im/NL_ex*NLRA_rer*RA_pex*ATRA_im/(NLAT_rer*AT_py*AT_y
+NLRA_rer*RA_pex*ATRA_im
+NLBE_rer*BE_pex*ATBE_im
+NLES_rer*ES_pex*ATES_im
+NLFI_rer*FI_pex*ATFI_im
+NLFR_rer*FR_pex*ATFR_im
+NLGR_rer*GR_pex*ATGR_im
+NLIT_rer*IT_pex*ATIT_im
+NLPT_rer*PT_pex*ATPT_im
+NLDE_rer*DE_pex*ATDE_im
+NLRU_rer*RU_pex*ATRU_im
+NLRW_rer*RW_pex*ATRW_im
+NLUS_rer*US_pex*ATUS_im
)
+BE_size/NL_size*BENL_im/NL_ex*NLRA_rer*RA_pex*BERA_im/(NLBE_rer*BE_py*BE_y
+NLRA_rer*RA_pex*BERA_im
+NLAT_rer*AT_pex*BEAT_im
+NLES_rer*ES_pex*BEES_im
+NLFI_rer*FI_pex*BEFI_im
+NLFR_rer*FR_pex*BEFR_im
+NLGR_rer*GR_pex*BEGR_im
+NLIT_rer*IT_pex*BEIT_im
+NLPT_rer*PT_pex*BEPT_im
+NLDE_rer*DE_pex*BEDE_im
+NLRU_rer*RU_pex*BERU_im
+NLRW_rer*RW_pex*BERW_im
+NLUS_rer*US_pex*BEUS_im
)
+ES_size/NL_size*ESNL_im/NL_ex*NLRA_rer*RA_pex*ESRA_im/(NLES_rer*ES_py*ES_y
+NLRA_rer*RA_pex*ESRA_im
+NLAT_rer*AT_pex*ESAT_im
+NLBE_rer*BE_pex*ESBE_im
+NLFI_rer*FI_pex*ESFI_im
