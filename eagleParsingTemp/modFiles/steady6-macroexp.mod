+ATRW_rer*RW_pex*FIRW_im
+ATUS_rer*US_pex*FIUS_im
)
+FR_size/AT_size*FRAT_im/AT_ex*ATRA_rer*RA_pex*FRRA_im/(ATFR_rer*FR_py*FR_y
+ATRA_rer*RA_pex*FRRA_im
+ATBE_rer*BE_pex*FRBE_im
+ATES_rer*ES_pex*FRES_im
+ATFI_rer*FI_pex*FRFI_im
+ATGR_rer*GR_pex*FRGR_im
+ATIT_rer*IT_pex*FRIT_im
+ATNL_rer*NL_pex*FRNL_im
+ATPT_rer*PT_pex*FRPT_im
+ATDE_rer*DE_pex*FRDE_im
+ATRU_rer*RU_pex*FRRU_im
+ATRW_rer*RW_pex*FRRW_im
+ATUS_rer*US_pex*FRUS_im
)
+GR_size/AT_size*GRAT_im/AT_ex*ATRA_rer*RA_pex*GRRA_im/(ATGR_rer*GR_py*GR_y
+ATRA_rer*RA_pex*GRRA_im
+ATBE_rer*BE_pex*GRBE_im
+ATES_rer*ES_pex*GRES_im
+ATFI_rer*FI_pex*GRFI_im
+ATFR_rer*FR_pex*GRFR_im
+ATIT_rer*IT_pex*GRIT_im
+ATNL_rer*NL_pex*GRNL_im
+ATPT_rer*PT_pex*GRPT_im
+ATDE_rer*DE_pex*GRDE_im
+ATRU_rer*RU_pex*GRRU_im
