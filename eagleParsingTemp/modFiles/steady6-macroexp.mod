+RWUS_rer*US_pex*RAUS_im
)+
+AT_size/RW_size*ATRW_im/RW_ex*RWRA_rer*RA_pex*ATRA_im/(RWAT_rer*AT_py*AT_y
+RWRA_rer*RA_pex*ATRA_im
