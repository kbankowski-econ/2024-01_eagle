// Private consumption good  (total)
BE_qig^((BE_muig-1)/BE_muig) = (BE_nuig)^(1/BE_muig)*BE_ttig^(1-1/BE_muig)+(1-BE_nuig)^(1/BE_muig)*BE_ntig^(1-1/BE_muig);
// Demand for domestic intermediate goods - NONTRADABLE
BE_ntig = (1-BE_nuig)*(BE_pnt/BE_pig)^(-BE_muig)*BE_qig;
// Price of the consumption good (tradable)  
BE_pttig^(1-BE_mutig) = (BE_nutig)*BE_pht^(1-BE_mutig)+(1-BE_nutig)*BE_pimig^(1-BE_mutig);
// Price of the consumption good 
BE_pig^(1-BE_muig) = (BE_nuig)*BE_pttig^(1-BE_muig)+(1-BE_nuig)*BE_pnt^(1-BE_muig);
// Demand for domestic intermediate goods
BE_htig = BE_nutig*(BE_pht/BE_pttig)^(-BE_mutig)*BE_ttig;
BERA_gammaimig = 0;
BERA_gammaimigdag = 1;
BEAT_gammaimig = 0;
BEAT_gammaimigdag = 1;
BEES_gammaimig = 0;
BEES_gammaimigdag = 1;
BEFI_gammaimig = 0;
BEFI_gammaimigdag = 1;
BEFR_gammaimig = 0;
BEFR_gammaimigdag = 1;
BEGR_gammaimig = 0;
BEGR_gammaimigdag = 1;
BEIT_gammaimig = 0;
BEIT_gammaimigdag = 1;
BENL_gammaimig = 0;
BENL_gammaimigdag = 1;
BEPT_gammaimig = 0;
BEPT_gammaimigdag = 1;
BEDE_gammaimig = 0;
BEDE_gammaimigdag = 1;
BERU_gammaimig = 0;
BERU_gammaimigdag = 1;
BERW_gammaimig = 0;
BERW_gammaimigdag = 1;
BEUS_gammaimig = 0;
BEUS_gammaimigdag = 1;
// Trade balance
BE_tb =
+BE_pex*RA_size/BE_size*RABE_im
-RA_pex*BERA_rer*BERA_im
+BE_pex*AT_size/BE_size*ATBE_im
-AT_pex*BEAT_rer*BEAT_im
+BE_pex*ES_size/BE_size*ESBE_im
-ES_pex*BEES_rer*BEES_im
+BE_pex*FI_size/BE_size*FIBE_im
-FI_pex*BEFI_rer*BEFI_im
+BE_pex*FR_size/BE_size*FRBE_im
-FR_pex*BEFR_rer*BEFR_im
+BE_pex*GR_size/BE_size*GRBE_im
-GR_pex*BEGR_rer*BEGR_im
+BE_pex*IT_size/BE_size*ITBE_im
-IT_pex*BEIT_rer*BEIT_im
+BE_pex*NL_size/BE_size*NLBE_im
-NL_pex*BENL_rer*BENL_im
+BE_pex*PT_size/BE_size*PTBE_im
-PT_pex*BEPT_rer*BEPT_im
+BE_pex*DE_size/BE_size*DEBE_im
-DE_pex*BEDE_rer*BEDE_im
+BE_pex*RU_size/BE_size*RUBE_im
-RU_pex*BERU_rer*BERU_im
+BE_pex*RW_size/BE_size*RWBE_im
-RW_pex*BERW_rer*BERW_im
+BE_pex*US_size/BE_size*USBE_im
-US_pex*BEUS_rer*BEUS_im
;
// Aggregate exports (volume)
BE_ex =
+RA_size/BE_size*RABE_im
+AT_size/BE_size*ATBE_im
+ES_size/BE_size*ESBE_im
+FI_size/BE_size*FIBE_im
+FR_size/BE_size*FRBE_im
+GR_size/BE_size*GRBE_im
+IT_size/BE_size*ITBE_im
+NL_size/BE_size*NLBE_im
+PT_size/BE_size*PTBE_im
+DE_size/BE_size*DEBE_im
+RU_size/BE_size*RUBE_im
+RW_size/BE_size*RWBE_im
+US_size/BE_size*USBE_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using BE_pg = BE_pht
// TODO: check the (1-BE_gammab(-1)) adjustment here, which is not in the fiscal extention
	BE_pcg(-1)*BE_cg(-1)+BE_pig(-1)*BE_ig(-1)+BE_tr(-1)
	+BE_b(-1)*BE_pic(-1)^(-1)+BE_m(-2)*BE_pic(-1)^(-1) = BE_tauc(-1)*BE_c(-1)+(BE_taun(-1)+BE_tauwh(-1))*(BE_wi(-1)*BE_ndi(-1)+BE_wj(-1)*BE_ndj(-1))+BE_tauwf(-1)*BE_w(-1)*BE_nd(-1)+BE_tauk(-1)*(BE_rk(-1)*BE_u(-1)-(BE_gammau(-1)+BE_delta)*BE_pi(-1))*BE_k(-1)+BE_taud(-1)*BE_d(-1)+BE_t(-1)+(BE_r(-1)*(1-BE_gammab(-1)))^(-1)*BE_b+BE_m(-1);
// Government spending, using BE_pg = BE_pht
BE_pcg*BE_cg = BE_cgy*BE_pybar*BE_ybar;
BE_pig*BE_ig = BE_igy*BE_pybar*BE_ybar;
BE_t = 0;
BE_b = BE_bytarget*BE_pybar*BE_ybar;
// Auxiliary equation for steady-state output
BE_ybar = BE_y;
// Auxiliary equation for steady-state output
BE_ytbar = BE_yst;
// Auxiliary equation for steady-state output
BE_ynbar = BE_ysn;
// Auxiliary equation for steady-state output deflator
BE_pybar = BE_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
BE_trybar = BE_tr/(BE_pybar*BE_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
BE_ti = BE_upsilont*BE_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
BE_tri = BE_upsilontr*BE_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	BE_r = DE_r;
BE_pic4 = BE_pi4target;
BE_rr-1 = BE_r/BE_pi4target^(1/4)-1;
// Equilibrium real interest rate
BE_rrstar-1 = 1/BE_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
BE_c = (1-BE_omega)*BE_ci+BE_omega*BE_cj;
// Aggregate money holdings
BE_m = (1-BE_omega)*BE_mi+BE_omega*BE_mj;
// Aggregate capital stock
BE_k = (1-BE_omega)*BE_ki;
// Aggregate investment
BE_i = (1-BE_omega)*BE_ii;
// Aggregate lump-sum transfers
BE_trj = 
1/BE_omega*BE_tr-(1-BE_omega)/BE_omega*BE_tri
;
// Aggregate lump-sum taxes
BE_tj = 
1/BE_omega*BE_t-(1-BE_omega)/BE_omega*BE_ti
;
// Aggregate transaction costs
BE_gammav = (1-BE_omega)*BE_ci*BE_gammavi+BE_omega*BE_cj*BE_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
BE_ni = BE_si*BE_ndi;
// Wage dispersion
BE_si = (1-BE_xii)*(BE_witilde/BE_wi)^(-BE_etai)+BE_xii*(BE_wi(-1)/BE_wi)^(-BE_etai)*(BE_pic/(BE_pic(-1)^BE_chii*BE_pi4target^(1/4*(1-BE_chii))))^(BE_etai)*BE_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
BE_nj = BE_sj*BE_ndj;
// Wage dispersion
BE_sj = (1-BE_xij)*(BE_wjtilde/BE_wj)^(-BE_etaj)+BE_xij*(BE_wj(-1)/BE_wj)^(-BE_etaj)*(BE_pic/(BE_pic(-1)^BE_chij*BE_pi4target^(1/4*(1-BE_chij))))^(BE_etaj)*BE_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
BE_u*BE_k = BE_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using BE_x = ES_size/BE_size*ES_im
BE_ysn = BE_snt*BE_nt;
//  nontradables aggregate demand
BE_nt = 
+BE_ntc
+BE_nti
+BE_ntcg
+BE_ntig
;
// Aggregate demand for domestic intermediate goods, using BE_hg = BE_cg
BE_ht =
+BE_htc
+BE_hti
+BE_htcg
+BE_htig
;
// Price dispersion in the domestic markets
BE_sh = (1-BE_xih)*(BE_phttilde/BE_pht)^(-BE_thetat)+BE_xih*(BE_piht/(BE_piht(-1)^BE_chih*BE_pi4target^(1/4*(1-BE_chih))))^BE_thetat*BE_sh(-1);
// Price dispersion in the foreign markets
BE_sx = (1-BE_xix)*(BE_pextilde/BE_pex)^(-BE_thetat)+BE_xix*(BE_piex/(BE_piex(-1)^BE_chix*BE_pi4target^(1/4*(1-BE_chix))))^BE_thetat*BE_sx(-1);
// Price dispersion in the domestic markets
BE_snt = (1-BE_xin)*(BE_pnttilde/BE_pnt)^(-BE_thetan)+BE_xin*(BE_pint/(BE_pint(-1)^BE_chin*BE_pi4target^(1/4*(1-BE_chin))))^BE_thetan*BE_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
BE_qc = BE_c+BE_gammav;
// Aggregate investment and capital utilisation cost
BE_qi = BE_i+BE_k*BE_gammau;
// Aggregate gov demand components added to use the same structure like in private components
BE_qcg = BE_cg;
BE_qig = BE_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
BE_py*BE_y = 
+BE_qc
+BE_pi*BE_qi
+BE_pcg*BE_qcg
+BE_pig*BE_qig
+BE_pex*RA_size/BE_size*RABE_im
-(RA_pex*BERA_rer)*BERA_imc
-(RA_pex*BERA_rer)*BERA_imi
-(RA_pex*BERA_rer)*BERA_imcg
-(RA_pex*BERA_rer)*BERA_imig
+BE_pex*AT_size/BE_size*ATBE_im
-(AT_pex*BEAT_rer)*BEAT_imc
-(AT_pex*BEAT_rer)*BEAT_imi
-(AT_pex*BEAT_rer)*BEAT_imcg
-(AT_pex*BEAT_rer)*BEAT_imig
+BE_pex*ES_size/BE_size*ESBE_im
-(ES_pex*BEES_rer)*BEES_imc
-(ES_pex*BEES_rer)*BEES_imi
-(ES_pex*BEES_rer)*BEES_imcg
-(ES_pex*BEES_rer)*BEES_imig
+BE_pex*FI_size/BE_size*FIBE_im
-(FI_pex*BEFI_rer)*BEFI_imc
-(FI_pex*BEFI_rer)*BEFI_imi
-(FI_pex*BEFI_rer)*BEFI_imcg
-(FI_pex*BEFI_rer)*BEFI_imig
+BE_pex*FR_size/BE_size*FRBE_im
-(FR_pex*BEFR_rer)*BEFR_imc
-(FR_pex*BEFR_rer)*BEFR_imi
-(FR_pex*BEFR_rer)*BEFR_imcg
-(FR_pex*BEFR_rer)*BEFR_imig
+BE_pex*GR_size/BE_size*GRBE_im
-(GR_pex*BEGR_rer)*BEGR_imc
-(GR_pex*BEGR_rer)*BEGR_imi
-(GR_pex*BEGR_rer)*BEGR_imcg
-(GR_pex*BEGR_rer)*BEGR_imig
+BE_pex*IT_size/BE_size*ITBE_im
-(IT_pex*BEIT_rer)*BEIT_imc
-(IT_pex*BEIT_rer)*BEIT_imi
-(IT_pex*BEIT_rer)*BEIT_imcg
-(IT_pex*BEIT_rer)*BEIT_imig
+BE_pex*NL_size/BE_size*NLBE_im
-(NL_pex*BENL_rer)*BENL_imc
-(NL_pex*BENL_rer)*BENL_imi
-(NL_pex*BENL_rer)*BENL_imcg
-(NL_pex*BENL_rer)*BENL_imig
+BE_pex*PT_size/BE_size*PTBE_im
-(PT_pex*BEPT_rer)*BEPT_imc
-(PT_pex*BEPT_rer)*BEPT_imi
-(PT_pex*BEPT_rer)*BEPT_imcg
-(PT_pex*BEPT_rer)*BEPT_imig
+BE_pex*DE_size/BE_size*DEBE_im
-(DE_pex*BEDE_rer)*BEDE_imc
-(DE_pex*BEDE_rer)*BEDE_imi
-(DE_pex*BEDE_rer)*BEDE_imcg
-(DE_pex*BEDE_rer)*BEDE_imig
+BE_pex*RU_size/BE_size*RUBE_im
-(RU_pex*BERU_rer)*BERU_imc
-(RU_pex*BERU_rer)*BERU_imi
-(RU_pex*BERU_rer)*BERU_imcg
-(RU_pex*BERU_rer)*BERU_imig
+BE_pex*RW_size/BE_size*RWBE_im
-(RW_pex*BERW_rer)*BERW_imc
-(RW_pex*BERW_rer)*BERW_imi
-(RW_pex*BERW_rer)*BERW_imcg
-(RW_pex*BERW_rer)*BERW_imig
+BE_pex*US_size/BE_size*USBE_im
-(US_pex*BEUS_rer)*BEUS_imc
-(US_pex*BEUS_rer)*BEUS_imi
-(US_pex*BEUS_rer)*BEUS_imcg
-(US_pex*BEUS_rer)*BEUS_imig
;
// Aggregate real demand
BE_y = BE_yst+BE_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(BE_zt) = (1-BE_rhozt)*log(BE_ztbar)+BE_rhozt*log(BE_zt(-1))+BE_epszt;
log(BE_zn) = (1-BE_rhozn)*log(BE_znbar)+BE_rhozn*log(BE_zn(-1))+BE_epszn;
// Government spending shock
BE_cgy = (1-BE_rhocg)*BE_cgybar+BE_rhocg*BE_cgy(-1)+BE_epsgc;
BE_igy = (1-BE_rhoig)*BE_igybar+BE_rhoig*BE_igy(-1)+BE_epsgi;
// Transfer shock
BE_try = (1-BE_rhotr)*BE_trybar+BE_rhotr*BE_try(-1)+BE_epstr;
// Consumption tax shock
BE_tauc = (1-BE_rhotauc)*BE_taucbar+BE_rhotauc*BE_tauc(-1)+BE_epstauc;
// Dividend income tax shock
BE_taud = (1-BE_rhotaud)*BE_taudbar+BE_rhotaud*BE_taud(-1)+BE_epstaud;
// Capital income tax shock
BE_tauk = (1-BE_rhotauk)*BE_taukbar+BE_rhotauk*BE_tauk(-1)+BE_epstauk;
// Labour income tax shock
BE_taun = (1-BE_rhotaun)*BE_taunbar+BE_rhotaun*BE_taun(-1)+BE_epstaun;
// Payroll tax shock: households
BE_tauwh = (1-BE_rhotauwh)*BE_tauwhbar+BE_rhotauwh*BE_tauwh(-1)+BE_epstauwh;
// Payroll tax shock: firms
BE_tauwf = (1-BE_rhotauwf)*BE_tauwfbar+BE_rhotauwf*BE_tauwf(-1)+BE_epstauwf;
// Wage cost push shock
BE_wcst = (1-BE_rhowcst)*BE_wcstbar+BE_rhowcst*BE_wcst(-1)+BE_epswcst;
// Preference shock
log(BE_zcon) = (1-BE_rhozcon)*log(BE_zconbar)+BE_rhozcon*log(BE_zcon(-1))+BE_epszcon;
// Investment specific shock
log(BE_zinv) = (1-BE_rhozinv)*log(BE_zinvbar)+BE_rhozinv*log(BE_zinv(-1))+BE_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
BE_cy = BE_c/(BE_py*BE_y);
// Aggregate nominal investment share
BE_iy = BE_pi*BE_i/(BE_py*BE_y);
// Aggregate nominal import share  
BE_imy = (
+BE_pimc*BE_imc
+BE_pimi*BE_imi
+BE_pimcg*BE_imcg
+BE_pimig*BE_imig
)/(BE_py*BE_y);
// Aggregate nominal import share
BE_imcy = BE_pimc*BE_imc/(BE_py*BE_y);
BE_imiy = BE_pimi*BE_imi/(BE_py*BE_y);
BE_imcgy = BE_pimcg*BE_imcg/(BE_py*BE_y);
BE_imigy = BE_pimig*BE_imig/(BE_py*BE_y);
// Aggregate debt-to-output ratio
BE_by = BE_b/(BE_pybar*BE_ybar);
// Aggregate lump-sum tax-to-output ratio
BE_ty = BE_t/(BE_pybar*BE_ybar);
// Aggregate labour cost share
BE_lcy = ((1+BE_tauwf)*BE_w*BE_nd)/(BE_py*BE_y);
// Aggregate nominal Wage share
BE_wy = (BE_w*BE_nd)/(BE_py*BE_y);
// NT sector nominal Wage share
BE_wnty = (BE_w*BE_ndn)/(BE_pnt*BE_ysn);
// T sector nominal Wage share
BE_whty = (BE_w*BE_ndt)/(BE_pht*BE_yst);
// T sector share
BE_yhty = BE_pht*BE_yst/(BE_py*BE_y);
// NT sector share
BE_ynty = BE_pnt*BE_ysn/(BE_py*BE_y);
// Output gap
BE_ygap = 0;
// Output growth (gross rate)
BE_ygrowth = BE_y/BE_y(-1);
// Output growth (gross rate yoy)
BE_ygrowth4 = BE_y/BE_y(-4);
// Domestic nominal output as a share of world nominal output
BE_yshare  = BE_size*BE_py*BE_y/BE_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
BE_epsilonm = -1/8*1/(BE_r*(BE_gammav2*BE_r+BE_r-1));
// Trade balance-to-GDP ratio
BE_tby = BE_tb/(BE_py*BE_y);
// Bilateral shares
BERA_imcy = (RA_pex*BERA_rer)*BERA_imc/(BE_py*BE_y);
BERA_imiy = (RA_pex*BERA_rer)*BERA_imi/(BE_py*BE_y);
BERA_imcgy = (RA_pex*BERA_rer)*BERA_imcg/(BE_py*BE_y);
BERA_imigy = (RA_pex*BERA_rer)*BERA_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BERA_excy  = RA_size/BE_size*BE_pex*RABE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BERA_exiy  = RA_size/BE_size*BE_pex*RABE_imi/(BE_py*BE_y);
// Bilateral shares
BEAT_imcy = (AT_pex*BEAT_rer)*BEAT_imc/(BE_py*BE_y);
BEAT_imiy = (AT_pex*BEAT_rer)*BEAT_imi/(BE_py*BE_y);
BEAT_imcgy = (AT_pex*BEAT_rer)*BEAT_imcg/(BE_py*BE_y);
BEAT_imigy = (AT_pex*BEAT_rer)*BEAT_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEAT_excy  = AT_size/BE_size*BE_pex*ATBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEAT_exiy  = AT_size/BE_size*BE_pex*ATBE_imi/(BE_py*BE_y);
// Bilateral shares
BEES_imcy = (ES_pex*BEES_rer)*BEES_imc/(BE_py*BE_y);
BEES_imiy = (ES_pex*BEES_rer)*BEES_imi/(BE_py*BE_y);
BEES_imcgy = (ES_pex*BEES_rer)*BEES_imcg/(BE_py*BE_y);
BEES_imigy = (ES_pex*BEES_rer)*BEES_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEES_excy  = ES_size/BE_size*BE_pex*ESBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEES_exiy  = ES_size/BE_size*BE_pex*ESBE_imi/(BE_py*BE_y);
// Bilateral shares
BEFI_imcy = (FI_pex*BEFI_rer)*BEFI_imc/(BE_py*BE_y);
BEFI_imiy = (FI_pex*BEFI_rer)*BEFI_imi/(BE_py*BE_y);
BEFI_imcgy = (FI_pex*BEFI_rer)*BEFI_imcg/(BE_py*BE_y);
BEFI_imigy = (FI_pex*BEFI_rer)*BEFI_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEFI_excy  = FI_size/BE_size*BE_pex*FIBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEFI_exiy  = FI_size/BE_size*BE_pex*FIBE_imi/(BE_py*BE_y);
// Bilateral shares
BEFR_imcy = (FR_pex*BEFR_rer)*BEFR_imc/(BE_py*BE_y);
BEFR_imiy = (FR_pex*BEFR_rer)*BEFR_imi/(BE_py*BE_y);
BEFR_imcgy = (FR_pex*BEFR_rer)*BEFR_imcg/(BE_py*BE_y);
BEFR_imigy = (FR_pex*BEFR_rer)*BEFR_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEFR_excy  = FR_size/BE_size*BE_pex*FRBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEFR_exiy  = FR_size/BE_size*BE_pex*FRBE_imi/(BE_py*BE_y);
// Bilateral shares
BEGR_imcy = (GR_pex*BEGR_rer)*BEGR_imc/(BE_py*BE_y);
BEGR_imiy = (GR_pex*BEGR_rer)*BEGR_imi/(BE_py*BE_y);
BEGR_imcgy = (GR_pex*BEGR_rer)*BEGR_imcg/(BE_py*BE_y);
BEGR_imigy = (GR_pex*BEGR_rer)*BEGR_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEGR_excy  = GR_size/BE_size*BE_pex*GRBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEGR_exiy  = GR_size/BE_size*BE_pex*GRBE_imi/(BE_py*BE_y);
// Bilateral shares
BEIT_imcy = (IT_pex*BEIT_rer)*BEIT_imc/(BE_py*BE_y);
BEIT_imiy = (IT_pex*BEIT_rer)*BEIT_imi/(BE_py*BE_y);
BEIT_imcgy = (IT_pex*BEIT_rer)*BEIT_imcg/(BE_py*BE_y);
BEIT_imigy = (IT_pex*BEIT_rer)*BEIT_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEIT_excy  = IT_size/BE_size*BE_pex*ITBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEIT_exiy  = IT_size/BE_size*BE_pex*ITBE_imi/(BE_py*BE_y);
// Bilateral shares
BENL_imcy = (NL_pex*BENL_rer)*BENL_imc/(BE_py*BE_y);
BENL_imiy = (NL_pex*BENL_rer)*BENL_imi/(BE_py*BE_y);
BENL_imcgy = (NL_pex*BENL_rer)*BENL_imcg/(BE_py*BE_y);
BENL_imigy = (NL_pex*BENL_rer)*BENL_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BENL_excy  = NL_size/BE_size*BE_pex*NLBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BENL_exiy  = NL_size/BE_size*BE_pex*NLBE_imi/(BE_py*BE_y);
// Bilateral shares
BEPT_imcy = (PT_pex*BEPT_rer)*BEPT_imc/(BE_py*BE_y);
BEPT_imiy = (PT_pex*BEPT_rer)*BEPT_imi/(BE_py*BE_y);
BEPT_imcgy = (PT_pex*BEPT_rer)*BEPT_imcg/(BE_py*BE_y);
BEPT_imigy = (PT_pex*BEPT_rer)*BEPT_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEPT_excy  = PT_size/BE_size*BE_pex*PTBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEPT_exiy  = PT_size/BE_size*BE_pex*PTBE_imi/(BE_py*BE_y);
// Bilateral shares
BEDE_imcy = (DE_pex*BEDE_rer)*BEDE_imc/(BE_py*BE_y);
BEDE_imiy = (DE_pex*BEDE_rer)*BEDE_imi/(BE_py*BE_y);
BEDE_imcgy = (DE_pex*BEDE_rer)*BEDE_imcg/(BE_py*BE_y);
BEDE_imigy = (DE_pex*BEDE_rer)*BEDE_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEDE_excy  = DE_size/BE_size*BE_pex*DEBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEDE_exiy  = DE_size/BE_size*BE_pex*DEBE_imi/(BE_py*BE_y);
// Bilateral shares
BERU_imcy = (RU_pex*BERU_rer)*BERU_imc/(BE_py*BE_y);
BERU_imiy = (RU_pex*BERU_rer)*BERU_imi/(BE_py*BE_y);
BERU_imcgy = (RU_pex*BERU_rer)*BERU_imcg/(BE_py*BE_y);
BERU_imigy = (RU_pex*BERU_rer)*BERU_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BERU_excy  = RU_size/BE_size*BE_pex*RUBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BERU_exiy  = RU_size/BE_size*BE_pex*RUBE_imi/(BE_py*BE_y);
// Bilateral shares
BERW_imcy = (RW_pex*BERW_rer)*BERW_imc/(BE_py*BE_y);
BERW_imiy = (RW_pex*BERW_rer)*BERW_imi/(BE_py*BE_y);
BERW_imcgy = (RW_pex*BERW_rer)*BERW_imcg/(BE_py*BE_y);
BERW_imigy = (RW_pex*BERW_rer)*BERW_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BERW_excy  = RW_size/BE_size*BE_pex*RWBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BERW_exiy  = RW_size/BE_size*BE_pex*RWBE_imi/(BE_py*BE_y);
// Bilateral shares
BEUS_imcy = (US_pex*BEUS_rer)*BEUS_imc/(BE_py*BE_y);
BEUS_imiy = (US_pex*BEUS_rer)*BEUS_imi/(BE_py*BE_y);
BEUS_imcgy = (US_pex*BEUS_rer)*BEUS_imcg/(BE_py*BE_y);
BEUS_imigy = (US_pex*BEUS_rer)*BEUS_imig/(BE_py*BE_y);
// Exports of consumption goods to gdp
BEUS_excy  = US_size/BE_size*BE_pex*USBE_imc/(BE_py*BE_y);
// Exports of investment goods to gdp
BEUS_exiy  = US_size/BE_size*BE_pex*USBE_imi/(BE_py*BE_y);
// Internal real exchange rate
BE_internalrer = BE_pnt/BE_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
ES_ccesi^(1-1/ES_mucces) = (ES_nucces)^(1/ES_mucces)*ES_ci^(1-1/ES_mucces)+(1-ES_nucces)^(1/ES_mucces)*ES_cg^(1-1/ES_mucces);
// Utility
ES_utili = 
ES_zcon*log(ES_ccesi-ES_kappa*ES_ccesi(-1))-1/(1+ES_zeta)*(ES_ni)^(1+ES_zeta)+ES_beta*ES_utili(+1)
;
// Marginal utility of consumption
ES_dcci = ((ES_nucces)^(1/ES_mucces)*ES_ci^(1-1/ES_mucces)+(1-ES_nucces)^(1/ES_mucces)*ES_cg^(1-1/ES_mucces))^(1/(ES_mucces-1))*(ES_nucces^(1/ES_mucces))*(ES_ci^(-1/ES_mucces));
ES_lambdai*(1+ES_tauc+ES_gammavi+ES_vi*ES_gammavider) = ES_zcon*(ES_ccesi-ES_kappa*ES_ccesi(-1))^(-ES_sigma)*ES_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
ES_r                   = ES_beta^(-1)*ES_lambdai/ES_lambdai    *ES_pic;
// Germany
// US and the RoW
// Euler equation for money
ES_vi^(2)*ES_gammavider = 1-ES_beta*ES_lambdai(+1)/(ES_lambdai*ES_pic(+1));
// Consumption-based velocity
ES_vi = ES_ci/ES_mi;
// Transaction cost
ES_gammavi = ES_gammav1*ES_vi+ES_gammav2/ES_vi-2*(ES_gammav1*ES_gammav2)^(1/2);
// Derivative of transaction cost
ES_gammavider = ES_gammav1-ES_gammav2*ES_vi^(-2);
ES_delta = ES_ii/ES_ki;
ES_gammai = 0;
ES_gammaider = 0;
ES_gammau = 0;
ES_gammauder = ((ES_beta^(-1)-1+ES_delta)*ES_qbar-ES_delta*ES_taukbar*ES_pibar)/((1-ES_taukbar)*ES_pibar);
ES_u = 1;
ES_pi = ES_q;
// Auxiliary equation for Tobin's Q in steady state
ES_qbar = ES_q;
// Rate of return on capital
ES_q = ES_beta*((1-ES_tauk)*ES_rk+(ES_tauk*ES_delta)*ES_pi+(1-ES_delta)*ES_q);
// Optimal wage contract (FOC)
ES_witilde^(1+ES_etai*ES_zeta) = ES_etai/(ES_etai-1)*ES_fi/ES_gi+ES_wcst;
// Definition of fi
ES_fi = ES_wi^(ES_etai*(1+ES_zeta))*ES_ndi^(1+ES_zeta)+ES_xii*ES_beta*(ES_pic(+1)/(ES_pic^ES_chii*ES_pi4target^(1/4*(1-ES_chii))))^(ES_etai*(1+ES_zeta))*ES_fi(+1);
// Definition of gi
ES_gi = ES_lambdai*(1-ES_taun-ES_tauwh)*ES_wi^ES_etai*ES_ndi+ES_xii*ES_beta*(ES_pic(+1)/(ES_pic^ES_chii*ES_pi4target^(1/4*(1-ES_chii))))^(ES_etai-1)*ES_gi(+1);
// Aggregate wage rate
ES_wi^(1-ES_etai) = (1-ES_xii)*ES_witilde^(1-ES_etai)+ES_xii*ES_wi(-1)^(1-ES_etai)*(ES_pic(-1)^ES_chii*ES_pi4target^(1/4*(1-ES_chii))/ES_pic)^(1-ES_etai);
//-------------
// Household J
//-------------
ES_ccesj^(1-1/ES_mucces) = (ES_nucces)^(1/ES_mucces)*ES_cj^(1-1/ES_mucces)+(1-ES_nucces)^(1/ES_mucces)*ES_cg^(1-1/ES_mucces);
// Utility
ES_utilj = 
ES_zcon*log(ES_ccesj-ES_kappa*ES_ccesj(-1))-1/(1+ES_zeta)*(ES_nj)^(1+ES_zeta)+ES_beta*ES_utilj(+1)
;
// Marginal utility of consumption
ES_dccj = ((ES_nucces)^(1/ES_mucces)*ES_cj^(1-1/ES_mucces)+(1-ES_nucces)^(1/ES_mucces)*ES_cg^(1-1/ES_mucces))^(1/(ES_mucces-1))*(ES_nucces^(1/ES_mucces))*(ES_cj^(-1/ES_mucces));
ES_lambdaj*(1+ES_tauc+ES_gammavj+ES_vj*ES_gammavjder) = ES_zcon*(ES_ccesj-ES_kappa*ES_ccesj(-1))^(-ES_sigma)*ES_dccj;
// Budget constraint
(1+ES_tauc+ES_gammavj)*ES_cj+ES_mj = (1-ES_taun-ES_tauwh)*ES_wj*ES_nj+ES_trj-ES_tj+ES_mj(-1)*ES_pic^(-1);
// Euler equation for money
ES_vj^(2)*ES_gammavjder = 1-ES_beta*ES_lambdaj(+1)/(ES_lambdaj*ES_pic(+1));
// Consumption-based velocity
ES_vj = ES_cj/ES_mj;
// Transaction technology
ES_gammavj = ES_gammav1*ES_vj+ES_gammav2/ES_vj-2*(ES_gammav1*ES_gammav2)^(1/2);
// Derivative of transaction technology
ES_gammavjder = ES_gammav1-ES_gammav2*ES_vj^(-2);
// Optimal wage contract (FOC)
ES_wjtilde^(1+ES_etaj*ES_zeta) = ES_etaj/(ES_etaj-1)*ES_fj/ES_gj+ES_wcst;
// Definition of fj
ES_fj = ES_wj^(ES_etaj*(1+ES_zeta))*ES_ndj^(1+ES_zeta)+ES_xij*ES_beta*(ES_pic(+1)/(ES_pic^ES_chij*ES_pi4target^(1/4*(1-ES_chij))))^(ES_etaj*(1+ES_zeta))*ES_fj(+1);
// Definition of gj
ES_gj = ES_lambdaj*(1-ES_taun-ES_tauwh)*ES_wj^ES_etaj*ES_ndj+ES_xij*ES_beta*(ES_pic(+1)/(ES_pic^ES_chij*ES_pi4target^(1/4*(1-ES_chij))))^(ES_etaj-1)*ES_gj(+1);
// Aggregate wage rate
ES_wj^(1-ES_etaj) = (1-ES_xij)*ES_wjtilde^(1-ES_etaj)+ES_xij*ES_wj(-1)^(1-ES_etaj)*(ES_pic(-1)^ES_chij*ES_pi4target^(1/4*(1-ES_chij))/ES_pic)^(1-ES_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
ES_kg = (1-ES_deltag)*ES_kg(-1)+ES_ig(-1);
// Production function tradable
ES_yst = EA_z*ES_zt*ES_kg^ES_alphag*ES_kdt^ES_alphat*ES_ndt^(1-ES_alphat)-ES_psitbar;
// Production function nontradable
ES_ysn = EA_z*ES_zn*ES_kg^ES_alphag*ES_kdn^ES_alphan*ES_ndn^(1-ES_alphan)-ES_psinbar;
// Real marginal cost tradable
ES_mct = 1/(EA_z*ES_zt*ES_kg^ES_alphag*(ES_alphat)^(ES_alphat)*(1-ES_alphat)^(1-ES_alphat))*ES_rk^(ES_alphat)*((1+ES_tauwf)*ES_w)^(1-ES_alphat);
// Real marginal cost nontradable
ES_mcn = 1/(EA_z*ES_zn*ES_kg^ES_alphag*(ES_alphan)^(ES_alphan)*(1-ES_alphan)^(1-ES_alphan))*ES_rk^(ES_alphan)*((1+ES_tauwf)*ES_w)^(1-ES_alphan);
// Wage Inflation (qoq)
ES_piw = ES_w/ES_w(-1)*ES_pic;
// Wage Inflation (yoy)
ES_piw4 = ES_pic4;
// Auxiliary equation for steady-state fixed cost
ES_psitbar = ES_psit*ES_ytbar;
// Auxiliary equation for steady-state fixed cost
ES_psinbar = ES_psin*ES_ynbar;
// Capital input (FOC)
ES_rk = ES_alphat*(ES_yst+ES_psitbar)/ES_kdt*ES_mct;
// Capital input (FOC)
ES_rk = ES_alphan*(ES_ysn+ES_psinbar)/ES_kdn*ES_mcn;
// Total capital demand
ES_kd = ES_kdt+ES_kdn;
// Demand for labour services by household I
ES_ndi = 
(1-ES_omega)*(ES_wi/ES_w)^(-ES_eta)*ES_nd
;
// Demand for labour services by household J
ES_ndj = 
ES_omega*(ES_wj/ES_w)^(-ES_eta)*ES_nd
;
// Aggregate labour demand
ES_nd^(1-1/ES_eta) = 
(1-ES_omega)^(1/ES_eta)*ES_ndi^(1-1/ES_eta)+ES_omega^(1/ES_eta)*ES_ndj^(1-1/ES_eta)
;
// Total demand 
ES_nd = ES_ndt+ES_ndn;
// Aggregate dividends
ES_d = ES_py*ES_y-ES_rk*ES_kd-(1+ES_tauwf)*ES_w*ES_nd;
// Non-tradable sector dividends
ES_dn = ES_pnt*ES_ysn-ES_rk*ES_kdn-(1+ES_tauwf)*ES_w*ES_ndn;
// Tradable sector dividends
ES_dt = ES_pht*ES_ht
+ES_pex*ES_ex
-ES_rk*ES_kdt-(1+ES_tauwf)*ES_w*ES_ndt;
// Optimal price contract set in domestic markets (FOC)
ES_phttilde/ES_pht = ES_thetat/(ES_thetat-1)*ES_fh/ES_gh;
// Definition of fh
ES_fh = ES_mct*ES_ht+ES_xih*ES_beta*ES_lambdai(+1)/ES_lambdai*(ES_piht(+1)/(ES_piht^ES_chih*ES_pi4target^(1/4*(1-ES_chih))))^ES_thetat*ES_fh(+1);
// Definition of gh
ES_gh = ES_pht*ES_ht+ES_xih*ES_beta*ES_lambdai(+1)/ES_lambdai*(ES_piht(+1)/(ES_piht^ES_chih*ES_pi4target^(1/4*(1-ES_chih))))^(ES_thetat-1)*ES_gh(+1);
// Aggregate intermediate-good price dynamics
ES_pht^(1-ES_thetat) = (1-ES_xih)*ES_phttilde^(1-ES_thetat)+ES_xih*(ES_pht(-1)/ES_pic)^(1-ES_thetat)*(ES_piht(-1)^ES_chih*ES_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation
ES_piht = ES_pht/ES_pht(-1)*ES_pic;
// Optimal price contract set in domestic markets (FOC)
ES_pnttilde/ES_pnt = ES_thetan/(ES_thetan-1)*ES_fn/ES_gn;
// Definition of fn
ES_fn = ES_mcn*ES_nt+ES_xin*ES_beta*ES_lambdai(+1)/ES_lambdai*(ES_pint(+1)/(ES_pint^ES_chin*ES_pi4target^(1/4*(1-ES_chin))))^ES_thetan*ES_fn(+1);
// Definition of gn
ES_gn = ES_pnt*ES_nt+ES_xin*ES_beta*ES_lambdai(+1)/ES_lambdai*(ES_pint(+1)/(ES_pint^ES_chin*ES_pi4target^(1/4*(1-ES_chin))))^(ES_thetan-1)*ES_gn(+1);
// Aggregate intermediate-good price dynamics
ES_pnt^(1-ES_thetan) = (1-ES_xin)*ES_pnttilde^(1-ES_thetan)+ES_xin*(ES_pnt(-1)/ES_pic)^(1-ES_thetan)*(ES_pint(-1)^ES_chin*ES_pi4target^(1/4*(1-ES_chin)))^(1-ES_thetan);
// Intermediate-good price inflation
ES_pint = ES_pnt/ES_pnt(-1)*ES_pic;
// Optimal price contract set in domestic markets (FOC)
ES_pextilde/ES_pex = ES_thetat/(ES_thetat-1)*ES_fx/ES_gx;
// Definition of fh
ES_fx = ES_mct*ES_ex+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(ES_piex(+1)/(ES_piex^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ES_fx(+1);
// Definition of gh
ES_gx = ES_pex*ES_ex+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(ES_piex(+1)/(ES_piex^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ES_gx(+1);
// Aggregate intermediate-good price dynamics
ES_pex^(1-ES_thetat) = (1-ES_xix)*ES_pextilde^(1-ES_thetat)+ES_xix*(ES_pex(-1)/ES_pic)^(1-ES_thetat)*(ES_piex(-1)^ES_chix*ES_pi4target^(1/4*(1-ES_chix)))^(1-ES_thetat);
// Intermediate-good price inflation
ES_piex = ES_pex/ES_pex(-1)*ES_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = RA_pimtilde
// RAES_pimtilde/RAES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESRA_fx/ESRA_gx;
// Definition of fx
// ESRA_fx = RA_size/ES_size*RAES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(RAES_piim(+1)/(RAES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESRA_fx(+1);
// Definition of gx   
// ESRA_gx = ESRA_rer*RAES_pim*RA_size/ES_size*RAES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(RAES_piim(+1)/(RAES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESRA_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = RA_pim
// RAES_pim^(1-ES_thetat) = (1-ES_xix)*RAES_pimtilde^(1-ES_thetat)+ES_xix*(RAES_pim(-1)/RA_pic)^(1-ES_thetat)*(RAES_piim(-1)^ES_chix*RA_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = RA_piim
// RAES_piim = RAES_pim/RAES_pim(-1)*RA_pic;
// Bilateral real exchange rate
ESRA_rer = ES_rer/RA_rer;
// Auxiliary equation for steady-state output
ESRA_rerbar = ESRA_rer;
//Terms of Trade
ESRA_tot = RA_pex*ESRA_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = AT_pimtilde
// ATES_pimtilde/ATES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESAT_fx/ESAT_gx;
// Definition of fx
// ESAT_fx = AT_size/ES_size*ATES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(ATES_piim(+1)/(ATES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESAT_fx(+1);
// Definition of gx   
// ESAT_gx = ESAT_rer*ATES_pim*AT_size/ES_size*ATES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(ATES_piim(+1)/(ATES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESAT_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = AT_pim
// ATES_pim^(1-ES_thetat) = (1-ES_xix)*ATES_pimtilde^(1-ES_thetat)+ES_xix*(ATES_pim(-1)/AT_pic)^(1-ES_thetat)*(ATES_piim(-1)^ES_chix*AT_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = AT_piim
// ATES_piim = ATES_pim/ATES_pim(-1)*AT_pic;
// Bilateral real exchange rate
ESAT_rer = ES_rer/AT_rer;
// Auxiliary equation for steady-state output
ESAT_rerbar = ESAT_rer;
//Terms of Trade
ESAT_tot = AT_pex*ESAT_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = BE_pimtilde
// BEES_pimtilde/BEES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESBE_fx/ESBE_gx;
// Definition of fx
// ESBE_fx = BE_size/ES_size*BEES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(BEES_piim(+1)/(BEES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESBE_fx(+1);
// Definition of gx   
// ESBE_gx = ESBE_rer*BEES_pim*BE_size/ES_size*BEES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(BEES_piim(+1)/(BEES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESBE_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = BE_pim
// BEES_pim^(1-ES_thetat) = (1-ES_xix)*BEES_pimtilde^(1-ES_thetat)+ES_xix*(BEES_pim(-1)/BE_pic)^(1-ES_thetat)*(BEES_piim(-1)^ES_chix*BE_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = BE_piim
// BEES_piim = BEES_pim/BEES_pim(-1)*BE_pic;
// Bilateral real exchange rate
ESBE_rer = ES_rer/BE_rer;
// Auxiliary equation for steady-state output
ESBE_rerbar = ESBE_rer;
//Terms of Trade
ESBE_tot = BE_pex*ESBE_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = FI_pimtilde
// FIES_pimtilde/FIES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESFI_fx/ESFI_gx;
// Definition of fx
// ESFI_fx = FI_size/ES_size*FIES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(FIES_piim(+1)/(FIES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESFI_fx(+1);
// Definition of gx   
// ESFI_gx = ESFI_rer*FIES_pim*FI_size/ES_size*FIES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(FIES_piim(+1)/(FIES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESFI_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = FI_pim
// FIES_pim^(1-ES_thetat) = (1-ES_xix)*FIES_pimtilde^(1-ES_thetat)+ES_xix*(FIES_pim(-1)/FI_pic)^(1-ES_thetat)*(FIES_piim(-1)^ES_chix*FI_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = FI_piim
// FIES_piim = FIES_pim/FIES_pim(-1)*FI_pic;
// Bilateral real exchange rate
ESFI_rer = ES_rer/FI_rer;
// Auxiliary equation for steady-state output
ESFI_rerbar = ESFI_rer;
//Terms of Trade
ESFI_tot = FI_pex*ESFI_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = FR_pimtilde
// FRES_pimtilde/FRES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESFR_fx/ESFR_gx;
// Definition of fx
// ESFR_fx = FR_size/ES_size*FRES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(FRES_piim(+1)/(FRES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESFR_fx(+1);
// Definition of gx   
// ESFR_gx = ESFR_rer*FRES_pim*FR_size/ES_size*FRES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(FRES_piim(+1)/(FRES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESFR_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = FR_pim
// FRES_pim^(1-ES_thetat) = (1-ES_xix)*FRES_pimtilde^(1-ES_thetat)+ES_xix*(FRES_pim(-1)/FR_pic)^(1-ES_thetat)*(FRES_piim(-1)^ES_chix*FR_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = FR_piim
// FRES_piim = FRES_pim/FRES_pim(-1)*FR_pic;
// Bilateral real exchange rate
ESFR_rer = ES_rer/FR_rer;
// Auxiliary equation for steady-state output
ESFR_rerbar = ESFR_rer;
//Terms of Trade
ESFR_tot = FR_pex*ESFR_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = GR_pimtilde
// GRES_pimtilde/GRES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESGR_fx/ESGR_gx;
// Definition of fx
// ESGR_fx = GR_size/ES_size*GRES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(GRES_piim(+1)/(GRES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESGR_fx(+1);
// Definition of gx   
// ESGR_gx = ESGR_rer*GRES_pim*GR_size/ES_size*GRES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(GRES_piim(+1)/(GRES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESGR_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = GR_pim
// GRES_pim^(1-ES_thetat) = (1-ES_xix)*GRES_pimtilde^(1-ES_thetat)+ES_xix*(GRES_pim(-1)/GR_pic)^(1-ES_thetat)*(GRES_piim(-1)^ES_chix*GR_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = GR_piim
// GRES_piim = GRES_pim/GRES_pim(-1)*GR_pic;
// Bilateral real exchange rate
ESGR_rer = ES_rer/GR_rer;
// Auxiliary equation for steady-state output
ESGR_rerbar = ESGR_rer;
//Terms of Trade
ESGR_tot = GR_pex*ESGR_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = IT_pimtilde
// ITES_pimtilde/ITES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESIT_fx/ESIT_gx;
// Definition of fx
// ESIT_fx = IT_size/ES_size*ITES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(ITES_piim(+1)/(ITES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESIT_fx(+1);
// Definition of gx   
// ESIT_gx = ESIT_rer*ITES_pim*IT_size/ES_size*ITES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(ITES_piim(+1)/(ITES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESIT_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = IT_pim
// ITES_pim^(1-ES_thetat) = (1-ES_xix)*ITES_pimtilde^(1-ES_thetat)+ES_xix*(ITES_pim(-1)/IT_pic)^(1-ES_thetat)*(ITES_piim(-1)^ES_chix*IT_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = IT_piim
// ITES_piim = ITES_pim/ITES_pim(-1)*IT_pic;
// Bilateral real exchange rate
ESIT_rer = ES_rer/IT_rer;
// Auxiliary equation for steady-state output
ESIT_rerbar = ESIT_rer;
//Terms of Trade
ESIT_tot = IT_pex*ESIT_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = NL_pimtilde
// NLES_pimtilde/NLES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESNL_fx/ESNL_gx;
// Definition of fx
// ESNL_fx = NL_size/ES_size*NLES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(NLES_piim(+1)/(NLES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESNL_fx(+1);
// Definition of gx   
// ESNL_gx = ESNL_rer*NLES_pim*NL_size/ES_size*NLES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(NLES_piim(+1)/(NLES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESNL_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = NL_pim
// NLES_pim^(1-ES_thetat) = (1-ES_xix)*NLES_pimtilde^(1-ES_thetat)+ES_xix*(NLES_pim(-1)/NL_pic)^(1-ES_thetat)*(NLES_piim(-1)^ES_chix*NL_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = NL_piim
// NLES_piim = NLES_pim/NLES_pim(-1)*NL_pic;
// Bilateral real exchange rate
ESNL_rer = ES_rer/NL_rer;
// Auxiliary equation for steady-state output
ESNL_rerbar = ESNL_rer;
//Terms of Trade
ESNL_tot = NL_pex*ESNL_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = PT_pimtilde
// PTES_pimtilde/PTES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESPT_fx/ESPT_gx;
// Definition of fx
// ESPT_fx = PT_size/ES_size*PTES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(PTES_piim(+1)/(PTES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESPT_fx(+1);
// Definition of gx   
// ESPT_gx = ESPT_rer*PTES_pim*PT_size/ES_size*PTES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(PTES_piim(+1)/(PTES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESPT_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = PT_pim
// PTES_pim^(1-ES_thetat) = (1-ES_xix)*PTES_pimtilde^(1-ES_thetat)+ES_xix*(PTES_pim(-1)/PT_pic)^(1-ES_thetat)*(PTES_piim(-1)^ES_chix*PT_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = PT_piim
// PTES_piim = PTES_pim/PTES_pim(-1)*PT_pic;
// Bilateral real exchange rate
ESPT_rer = ES_rer/PT_rer;
// Auxiliary equation for steady-state output
ESPT_rerbar = ESPT_rer;
//Terms of Trade
ESPT_tot = PT_pex*ESPT_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = DE_pimtilde
// DEES_pimtilde/DEES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESDE_fx/ESDE_gx;
// Definition of fx
// ESDE_fx = DE_size/ES_size*DEES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(DEES_piim(+1)/(DEES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESDE_fx(+1);
// Definition of gx   
// ESDE_gx = ESDE_rer*DEES_pim*DE_size/ES_size*DEES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(DEES_piim(+1)/(DEES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESDE_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = DE_pim
// DEES_pim^(1-ES_thetat) = (1-ES_xix)*DEES_pimtilde^(1-ES_thetat)+ES_xix*(DEES_pim(-1)/DE_pic)^(1-ES_thetat)*(DEES_piim(-1)^ES_chix*DE_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = DE_piim
// DEES_piim = DEES_pim/DEES_pim(-1)*DE_pic;
// Bilateral real exchange rate
ESDE_rer = ES_rer/DE_rer;
// Auxiliary equation for steady-state output
ESDE_rerbar = ESDE_rer;
//Terms of Trade
ESDE_tot = DE_pex*ESDE_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = RU_pimtilde
// RUES_pimtilde/RUES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESRU_fx/ESRU_gx;
// Definition of fx
// ESRU_fx = RU_size/ES_size*RUES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(RUES_piim(+1)/(RUES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESRU_fx(+1);
// Definition of gx   
// ESRU_gx = ESRU_rer*RUES_pim*RU_size/ES_size*RUES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(RUES_piim(+1)/(RUES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESRU_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = RU_pim
// RUES_pim^(1-ES_thetat) = (1-ES_xix)*RUES_pimtilde^(1-ES_thetat)+ES_xix*(RUES_pim(-1)/RU_pic)^(1-ES_thetat)*(RUES_piim(-1)^ES_chix*RU_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = RU_piim
// RUES_piim = RUES_pim/RUES_pim(-1)*RU_pic;
// Bilateral real exchange rate
ESRU_rer = ES_rer/RU_rer;
// Auxiliary equation for steady-state output
ESRU_rerbar = ESRU_rer;
//Terms of Trade
ESRU_tot = RU_pex*ESRU_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = RW_pimtilde
// RWES_pimtilde/RWES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESRW_fx/ESRW_gx;
// Definition of fx
// ESRW_fx = RW_size/ES_size*RWES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(RWES_piim(+1)/(RWES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESRW_fx(+1);
// Definition of gx   
// ESRW_gx = ESRW_rer*RWES_pim*RW_size/ES_size*RWES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(RWES_piim(+1)/(RWES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESRW_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = RW_pim
// RWES_pim^(1-ES_thetat) = (1-ES_xix)*RWES_pimtilde^(1-ES_thetat)+ES_xix*(RWES_pim(-1)/RW_pic)^(1-ES_thetat)*(RWES_piim(-1)^ES_chix*RW_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = RW_piim
// RWES_piim = RWES_pim/RWES_pim(-1)*RW_pic;
// Bilateral real exchange rate
ESRW_rer = ES_rer/RW_rer;
// Auxiliary equation for steady-state output
ESRW_rerbar = ESRW_rer;
//Terms of Trade
ESRW_tot = RW_pex*ESRW_rer/ES_pex;
// Optimal price contract set in foreign markets (FOC), using ES_pxtilde = US_pimtilde
// USES_pimtilde/USES_pim = ES_cpim*ES_thetat/(ES_thetat-1)*ESUS_fx/ESUS_gx;
// Definition of fx
// ESUS_fx = US_size/ES_size*USES_im*ES_mct+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(USES_piim(+1)/(USES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ESUS_fx(+1);
// Definition of gx   
// ESUS_gx = ESUS_rer*USES_pim*US_size/ES_size*USES_im+ES_xix*ES_beta*ES_lambdai(+1)/ES_lambdai*(USES_piim(+1)/(USES_piim^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^(ES_thetat-1)*ESUS_gx(+1);
// Aggregate intermediate-good price dynamics, using ES_px = US_pim
// USES_pim^(1-ES_thetat) = (1-ES_xix)*USES_pimtilde^(1-ES_thetat)+ES_xix*(USES_pim(-1)/US_pic)^(1-ES_thetat)*(USES_piim(-1)^ES_chix*US_pi4target^(1/4*(1-ES_chih)))^(1-ES_thetat);
// Intermediate-good price inflation, using ES_pix = US_piim
// USES_piim = USES_pim/USES_pim(-1)*US_pic;
// Bilateral real exchange rate
ESUS_rer = ES_rer/US_rer;
// Auxiliary equation for steady-state output
ESUS_rerbar = ESUS_rer;
//Terms of Trade
ESUS_tot = US_pex*ESUS_rer/ES_pex;
// Total imports 
ES_im = 
+ES_imc
+ES_imi
+ES_imcg
+ES_imig
;
// Total import deflator
ES_im*ES_pim  = 
+ES_pimc*ES_imc
+ES_pimi*ES_imi
+ES_pimcg*ES_imcg
+ES_pimig*ES_imig
;
// Effective real exchange rate: double weighting (imports)
ESRA_weightim = ESRA_rer*RA_pex*ESRA_im/(ES_pim*ES_im);
// Effective real exchange rate: double weighting (exports)
ESRA_weightex = RA_size/ES_size*RAES_im/ES_ex*ESRA_rer*RA_py*RA_y/(ESRA_rer*RA_py*RA_y
+ESAT_rer*AT_pex*RAAT_im
+ESBE_rer*BE_pex*RABE_im
+ESFI_rer*FI_pex*RAFI_im
+ESFR_rer*FR_pex*RAFR_im
+ESGR_rer*GR_pex*RAGR_im
+ESIT_rer*IT_pex*RAIT_im
+ESNL_rer*NL_pex*RANL_im
+ESPT_rer*PT_pex*RAPT_im
+ESDE_rer*DE_pex*RADE_im
+ESRU_rer*RU_pex*RARU_im
+ESRW_rer*RW_pex*RARW_im
+ESUS_rer*US_pex*RAUS_im
)+
+AT_size/ES_size*ATES_im/ES_ex*ESRA_rer*RA_pex*ATRA_im/(ESAT_rer*AT_py*AT_y
+ESRA_rer*RA_pex*ATRA_im
+ESBE_rer*BE_pex*ATBE_im
+ESFI_rer*FI_pex*ATFI_im
+ESFR_rer*FR_pex*ATFR_im
+ESGR_rer*GR_pex*ATGR_im
