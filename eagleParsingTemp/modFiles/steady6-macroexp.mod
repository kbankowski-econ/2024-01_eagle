// Private consumption good (tradable)
PT_ttcg^((PT_mutcg-1)/PT_mutcg) = (PT_nutcg)^(1/PT_mutcg)*PT_htcg^(1-1/PT_mutcg)+(1-PT_nutcg)^(1/PT_mutcg)*PT_imcg^(1-1/PT_mutcg);
// Private consumption good  (total)
PT_qcg^((PT_mucg-1)/PT_mucg) = (PT_nucg)^(1/PT_mucg)*PT_ttcg^(1-1/PT_mucg)+(1-PT_nucg)^(1/PT_mucg)*PT_ntcg^(1-1/PT_mucg);
// Demand for domestic intermediate goods - NONTRADABLE
PT_ntcg = (1-PT_nucg)*(PT_pnt/PT_pcg)^(-PT_mucg)*PT_qcg;
// Price of the consumption good (tradable)  
