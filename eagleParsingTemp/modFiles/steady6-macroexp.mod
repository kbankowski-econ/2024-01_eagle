+BEDE_rer*DE_pex*USDE_im
+BERU_rer*RU_pex*USRU_im
+BERW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
BERA_weight = BE_pim*BE_im/(BE_pim*BE_im+BE_pex*BE_ex)*BERA_weightim+BE_pex*BE_ex/(BE_pim*BE_im+BE_pex*BE_ex)*BERA_weightex;
// Effective real exchange rate: double weighting (imports)
BEAT_weightim = BEAT_rer*AT_pex*BEAT_im/(BE_pim*BE_im);
// Effective real exchange rate: double weighting (exports)
BEAT_weightex = AT_size/BE_size*ATBE_im/BE_ex*BEAT_rer*AT_py*AT_y/(BEAT_rer*AT_py*AT_y
+BERA_rer*RA_pex*ATRA_im
+BEES_rer*ES_pex*ATES_im
