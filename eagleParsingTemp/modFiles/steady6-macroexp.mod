+BERW_rer*RW_pex*FIRW_im
+BEUS_rer*US_pex*FIUS_im
)
+FR_size/BE_size*FRBE_im/BE_ex*BERA_rer*RA_pex*FRRA_im/(BEFR_rer*FR_py*FR_y
+BERA_rer*RA_pex*FRRA_im
+BEAT_rer*AT_pex*FRAT_im
+BEES_rer*ES_pex*FRES_im
+BEFI_rer*FI_pex*FRFI_im
+BEGR_rer*GR_pex*FRGR_im
+BEIT_rer*IT_pex*FRIT_im
