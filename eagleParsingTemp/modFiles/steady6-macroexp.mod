// NLES_fx = ES_size/NL_size*ESNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(ESNL_piim(+1)/(ESNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLES_fx(+1);
// Definition of gx   
