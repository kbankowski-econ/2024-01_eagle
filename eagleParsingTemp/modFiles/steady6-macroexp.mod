// Aggregate intermediate-good price dynamics, using NL_px = ES_pim
// ESNL_pim^(1-NL_thetat) = (1-NL_xix)*ESNL_pimtilde^(1-NL_thetat)+NL_xix*(ESNL_pim(-1)/ES_pic)^(1-NL_thetat)*(ESNL_piim(-1)^NL_chix*ES_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
