+GRUS_rer*US_pex*ESUS_im
)
+FI_size/GR_size*FIGR_im/GR_ex*GRRA_rer*RA_pex*FIRA_im/(GRFI_rer*FI_py*FI_y
+GRRA_rer*RA_pex*FIRA_im
+GRAT_rer*AT_pex*FIAT_im
+GRBE_rer*BE_pex*FIBE_im
