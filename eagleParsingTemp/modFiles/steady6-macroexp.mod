FIFR_gammaimc = 0;
FIFR_gammaimcdag = 1;
FIGR_gammaimc = 0;
FIGR_gammaimcdag = 1;
FIIT_gammaimc = 0;
FIIT_gammaimcdag = 1;
FINL_gammaimc = 0;
FINL_gammaimcdag = 1;
FIPT_gammaimc = 0;
FIPT_gammaimcdag = 1;
FIDE_gammaimc = 0;
FIDE_gammaimcdag = 1;
FIRU_gammaimc = 0;
FIRU_gammaimcdag = 1;
FIRW_gammaimc = 0;
FIRW_gammaimcdag = 1;
FIUS_gammaimc = 0;
FIUS_gammaimcdag = 1;
// Private consumption good (tradable)
FI_tti^((FI_muti-1)/FI_muti) = (FI_nuti)^(1/FI_muti)*FI_hti^(1-1/FI_muti)+(1-FI_nuti)^(1/FI_muti)*FI_imi^(1-1/FI_muti);
// Private consumption good  (total)
FI_qi^((FI_mui-1)/FI_mui) = (FI_nui)^(1/FI_mui)*FI_tti^(1-1/FI_mui)+(1-FI_nui)^(1/FI_mui)*FI_nti^(1-1/FI_mui);
// Demand for domestic intermediate goods - NONTRADABLE
FI_nti = (1-FI_nui)*(FI_pnt/FI_pi)^(-FI_mui)*FI_qi;
// Price of the consumption good (tradable)  
FI_ptti^(1-FI_muti) = (FI_nuti)*FI_pht^(1-FI_muti)+(1-FI_nuti)*FI_pimi^(1-FI_muti);
// Price of the consumption good 
FI_pi^(1-FI_mui) = (FI_nui)*FI_ptti^(1-FI_mui)+(1-FI_nui)*FI_pnt^(1-FI_mui);
// Auxiliary equation for the price of the investment good in steady state
// this only appears in the capacity utilisation cost; not needed for consumption where it is one by assumption; neither for gov demand components where there is no adjustment cost
FI_pibar = FI_pi;
// Demand for domestic intermediate goods
FI_hti = FI_nuti*(FI_pht/FI_ptti)^(-FI_muti)*FI_tti;
FIRA_gammaimi = 0;
FIRA_gammaimidag = 1;
FIAT_gammaimi = 0;
FIAT_gammaimidag = 1;
FIBE_gammaimi = 0;
FIBE_gammaimidag = 1;
FIES_gammaimi = 0;
FIES_gammaimidag = 1;
FIFR_gammaimi = 0;
FIFR_gammaimidag = 1;
FIGR_gammaimi = 0;
FIGR_gammaimidag = 1;
FIIT_gammaimi = 0;
FIIT_gammaimidag = 1;
FINL_gammaimi = 0;
FINL_gammaimidag = 1;
FIPT_gammaimi = 0;
FIPT_gammaimidag = 1;
FIDE_gammaimi = 0;
FIDE_gammaimidag = 1;
FIRU_gammaimi = 0;
FIRU_gammaimidag = 1;
FIRW_gammaimi = 0;
FIRW_gammaimidag = 1;
FIUS_gammaimi = 0;
FIUS_gammaimidag = 1;
// Private consumption good (tradable)
FI_ttcg^((FI_mutcg-1)/FI_mutcg) = (FI_nutcg)^(1/FI_mutcg)*FI_htcg^(1-1/FI_mutcg)+(1-FI_nutcg)^(1/FI_mutcg)*FI_imcg^(1-1/FI_mutcg);
// Private consumption good  (total)
FI_qcg^((FI_mucg-1)/FI_mucg) = (FI_nucg)^(1/FI_mucg)*FI_ttcg^(1-1/FI_mucg)+(1-FI_nucg)^(1/FI_mucg)*FI_ntcg^(1-1/FI_mucg);
// Demand for domestic intermediate goods - NONTRADABLE
FI_ntcg = (1-FI_nucg)*(FI_pnt/FI_pcg)^(-FI_mucg)*FI_qcg;
// Price of the consumption good (tradable)  
FI_pttcg^(1-FI_mutcg) = (FI_nutcg)*FI_pht^(1-FI_mutcg)+(1-FI_nutcg)*FI_pimcg^(1-FI_mutcg);
// Price of the consumption good 
FI_pcg^(1-FI_mucg) = (FI_nucg)*FI_pttcg^(1-FI_mucg)+(1-FI_nucg)*FI_pnt^(1-FI_mucg);
// Demand for domestic intermediate goods
FI_htcg = FI_nutcg*(FI_pht/FI_pttcg)^(-FI_mutcg)*FI_ttcg;
FIRA_gammaimcg = 0;
FIRA_gammaimcgdag = 1;
FIAT_gammaimcg = 0;
FIAT_gammaimcgdag = 1;
FIBE_gammaimcg = 0;
FIBE_gammaimcgdag = 1;
FIES_gammaimcg = 0;
FIES_gammaimcgdag = 1;
FIFR_gammaimcg = 0;
FIFR_gammaimcgdag = 1;
FIGR_gammaimcg = 0;
FIGR_gammaimcgdag = 1;
FIIT_gammaimcg = 0;
FIIT_gammaimcgdag = 1;
FINL_gammaimcg = 0;
FINL_gammaimcgdag = 1;
FIPT_gammaimcg = 0;
FIPT_gammaimcgdag = 1;
FIDE_gammaimcg = 0;
FIDE_gammaimcgdag = 1;
FIRU_gammaimcg = 0;
FIRU_gammaimcgdag = 1;
FIRW_gammaimcg = 0;
FIRW_gammaimcgdag = 1;
FIUS_gammaimcg = 0;
FIUS_gammaimcgdag = 1;
// Private consumption good (tradable)
FI_ttig^((FI_mutig-1)/FI_mutig) = (FI_nutig)^(1/FI_mutig)*FI_htig^(1-1/FI_mutig)+(1-FI_nutig)^(1/FI_mutig)*FI_imig^(1-1/FI_mutig);
// Private consumption good  (total)
FI_qig^((FI_muig-1)/FI_muig) = (FI_nuig)^(1/FI_muig)*FI_ttig^(1-1/FI_muig)+(1-FI_nuig)^(1/FI_muig)*FI_ntig^(1-1/FI_muig);
// Demand for domestic intermediate goods - NONTRADABLE
FI_ntig = (1-FI_nuig)*(FI_pnt/FI_pig)^(-FI_muig)*FI_qig;
// Price of the consumption good (tradable)  
FI_pttig^(1-FI_mutig) = (FI_nutig)*FI_pht^(1-FI_mutig)+(1-FI_nutig)*FI_pimig^(1-FI_mutig);
// Price of the consumption good 
FI_pig^(1-FI_muig) = (FI_nuig)*FI_pttig^(1-FI_muig)+(1-FI_nuig)*FI_pnt^(1-FI_muig);
// Demand for domestic intermediate goods
FI_htig = FI_nutig*(FI_pht/FI_pttig)^(-FI_mutig)*FI_ttig;
FIRA_gammaimig = 0;
FIRA_gammaimigdag = 1;
FIAT_gammaimig = 0;
FIAT_gammaimigdag = 1;
FIBE_gammaimig = 0;
FIBE_gammaimigdag = 1;
FIES_gammaimig = 0;
FIES_gammaimigdag = 1;
FIFR_gammaimig = 0;
FIFR_gammaimigdag = 1;
FIGR_gammaimig = 0;
FIGR_gammaimigdag = 1;
FIIT_gammaimig = 0;
FIIT_gammaimigdag = 1;
FINL_gammaimig = 0;
FINL_gammaimigdag = 1;
FIPT_gammaimig = 0;
FIPT_gammaimigdag = 1;
FIDE_gammaimig = 0;
FIDE_gammaimigdag = 1;
FIRU_gammaimig = 0;
FIRU_gammaimigdag = 1;
FIRW_gammaimig = 0;
FIRW_gammaimigdag = 1;
FIUS_gammaimig = 0;
FIUS_gammaimigdag = 1;
// Trade balance
FI_tb =
+FI_pex*RA_size/FI_size*RAFI_im
-RA_pex*FIRA_rer*FIRA_im
+FI_pex*AT_size/FI_size*ATFI_im
-AT_pex*FIAT_rer*FIAT_im
+FI_pex*BE_size/FI_size*BEFI_im
-BE_pex*FIBE_rer*FIBE_im
+FI_pex*ES_size/FI_size*ESFI_im
-ES_pex*FIES_rer*FIES_im
+FI_pex*FR_size/FI_size*FRFI_im
-FR_pex*FIFR_rer*FIFR_im
+FI_pex*GR_size/FI_size*GRFI_im
-GR_pex*FIGR_rer*FIGR_im
+FI_pex*IT_size/FI_size*ITFI_im
-IT_pex*FIIT_rer*FIIT_im
+FI_pex*NL_size/FI_size*NLFI_im
-NL_pex*FINL_rer*FINL_im
+FI_pex*PT_size/FI_size*PTFI_im
-PT_pex*FIPT_rer*FIPT_im
+FI_pex*DE_size/FI_size*DEFI_im
-DE_pex*FIDE_rer*FIDE_im
+FI_pex*RU_size/FI_size*RUFI_im
-RU_pex*FIRU_rer*FIRU_im
+FI_pex*RW_size/FI_size*RWFI_im
-RW_pex*FIRW_rer*FIRW_im
+FI_pex*US_size/FI_size*USFI_im
-US_pex*FIUS_rer*FIUS_im
;
// Aggregate exports (volume)
FI_ex =
+RA_size/FI_size*RAFI_im
+AT_size/FI_size*ATFI_im
+BE_size/FI_size*BEFI_im
+ES_size/FI_size*ESFI_im
+FR_size/FI_size*FRFI_im
+GR_size/FI_size*GRFI_im
+IT_size/FI_size*ITFI_im
+NL_size/FI_size*NLFI_im
+PT_size/FI_size*PTFI_im
+DE_size/FI_size*DEFI_im
+RU_size/FI_size*RUFI_im
+RW_size/FI_size*RWFI_im
+US_size/FI_size*USFI_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using FI_pg = FI_pht
// TODO: check the (1-FI_gammab(-1)) adjustment here, which is not in the fiscal extention
	FI_pcg(-1)*FI_cg(-1)+FI_pig(-1)*FI_ig(-1)+FI_tr(-1)
	+FI_b(-1)*FI_pic(-1)^(-1)+FI_m(-2)*FI_pic(-1)^(-1) = FI_tauc(-1)*FI_c(-1)+(FI_taun(-1)+FI_tauwh(-1))*(FI_wi(-1)*FI_ndi(-1)+FI_wj(-1)*FI_ndj(-1))+FI_tauwf(-1)*FI_w(-1)*FI_nd(-1)+FI_tauk(-1)*(FI_rk(-1)*FI_u(-1)-(FI_gammau(-1)+FI_delta)*FI_pi(-1))*FI_k(-1)+FI_taud(-1)*FI_d(-1)+FI_t(-1)+(FI_r(-1)*(1-FI_gammab(-1)))^(-1)*FI_b+FI_m(-1);
// Government spending, using FI_pg = FI_pht
FI_pcg*FI_cg = FI_cgy*FI_pybar*FI_ybar;
FI_pig*FI_ig = FI_igy*FI_pybar*FI_ybar;
FI_t = 0;
FI_b = FI_bytarget*FI_pybar*FI_ybar;
// Auxiliary equation for steady-state output
FI_ybar = FI_y;
// Auxiliary equation for steady-state output
FI_ytbar = FI_yst;
// Auxiliary equation for steady-state output
FI_ynbar = FI_ysn;
// Auxiliary equation for steady-state output deflator
FI_pybar = FI_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
FI_trybar = FI_tr/(FI_pybar*FI_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
FI_ti = FI_upsilont*FI_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
FI_tri = FI_upsilontr*FI_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	FI_r = DE_r;
FI_pic4 = FI_pi4target;
FI_rr-1 = FI_r/FI_pi4target^(1/4)-1;
// Equilibrium real interest rate
FI_rrstar-1 = 1/FI_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
FI_c = (1-FI_omega)*FI_ci+FI_omega*FI_cj;
// Aggregate money holdings
FI_m = (1-FI_omega)*FI_mi+FI_omega*FI_mj;
// Aggregate capital stock
FI_k = (1-FI_omega)*FI_ki;
// Aggregate investment
FI_i = (1-FI_omega)*FI_ii;
// Aggregate lump-sum transfers
FI_trj = 
1/FI_omega*FI_tr-(1-FI_omega)/FI_omega*FI_tri
;
// Aggregate lump-sum taxes
FI_tj = 
1/FI_omega*FI_t-(1-FI_omega)/FI_omega*FI_ti
;
// Aggregate transaction costs
FI_gammav = (1-FI_omega)*FI_ci*FI_gammavi+FI_omega*FI_cj*FI_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
FI_ni = FI_si*FI_ndi;
// Wage dispersion
FI_si = (1-FI_xii)*(FI_witilde/FI_wi)^(-FI_etai)+FI_xii*(FI_wi(-1)/FI_wi)^(-FI_etai)*(FI_pic/(FI_pic(-1)^FI_chii*FI_pi4target^(1/4*(1-FI_chii))))^(FI_etai)*FI_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
FI_nj = FI_sj*FI_ndj;
// Wage dispersion
FI_sj = (1-FI_xij)*(FI_wjtilde/FI_wj)^(-FI_etaj)+FI_xij*(FI_wj(-1)/FI_wj)^(-FI_etaj)*(FI_pic/(FI_pic(-1)^FI_chij*FI_pi4target^(1/4*(1-FI_chij))))^(FI_etaj)*FI_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
FI_u*FI_k = FI_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using FI_x = FR_size/FI_size*FR_im
FI_ysn = FI_snt*FI_nt;
//  nontradables aggregate demand
FI_nt = 
+FI_ntc
+FI_nti
+FI_ntcg
+FI_ntig
;
// Aggregate demand for domestic intermediate goods, using FI_hg = FI_cg
FI_ht =
+FI_htc
+FI_hti
+FI_htcg
+FI_htig
;
// Price dispersion in the domestic markets
FI_sh = (1-FI_xih)*(FI_phttilde/FI_pht)^(-FI_thetat)+FI_xih*(FI_piht/(FI_piht(-1)^FI_chih*FI_pi4target^(1/4*(1-FI_chih))))^FI_thetat*FI_sh(-1);
// Price dispersion in the foreign markets
FI_sx = (1-FI_xix)*(FI_pextilde/FI_pex)^(-FI_thetat)+FI_xix*(FI_piex/(FI_piex(-1)^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FI_sx(-1);
// Price dispersion in the domestic markets
FI_snt = (1-FI_xin)*(FI_pnttilde/FI_pnt)^(-FI_thetan)+FI_xin*(FI_pint/(FI_pint(-1)^FI_chin*FI_pi4target^(1/4*(1-FI_chin))))^FI_thetan*FI_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
FI_qc = FI_c+FI_gammav;
// Aggregate investment and capital utilisation cost
FI_qi = FI_i+FI_k*FI_gammau;
// Aggregate gov demand components added to use the same structure like in private components
FI_qcg = FI_cg;
FI_qig = FI_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
FI_py*FI_y = 
+FI_qc
+FI_pi*FI_qi
+FI_pcg*FI_qcg
+FI_pig*FI_qig
+FI_pex*RA_size/FI_size*RAFI_im
-(RA_pex*FIRA_rer)*FIRA_imc
-(RA_pex*FIRA_rer)*FIRA_imi
-(RA_pex*FIRA_rer)*FIRA_imcg
-(RA_pex*FIRA_rer)*FIRA_imig
+FI_pex*AT_size/FI_size*ATFI_im
-(AT_pex*FIAT_rer)*FIAT_imc
-(AT_pex*FIAT_rer)*FIAT_imi
-(AT_pex*FIAT_rer)*FIAT_imcg
-(AT_pex*FIAT_rer)*FIAT_imig
+FI_pex*BE_size/FI_size*BEFI_im
-(BE_pex*FIBE_rer)*FIBE_imc
-(BE_pex*FIBE_rer)*FIBE_imi
-(BE_pex*FIBE_rer)*FIBE_imcg
-(BE_pex*FIBE_rer)*FIBE_imig
+FI_pex*ES_size/FI_size*ESFI_im
-(ES_pex*FIES_rer)*FIES_imc
-(ES_pex*FIES_rer)*FIES_imi
-(ES_pex*FIES_rer)*FIES_imcg
-(ES_pex*FIES_rer)*FIES_imig
+FI_pex*FR_size/FI_size*FRFI_im
-(FR_pex*FIFR_rer)*FIFR_imc
-(FR_pex*FIFR_rer)*FIFR_imi
-(FR_pex*FIFR_rer)*FIFR_imcg
-(FR_pex*FIFR_rer)*FIFR_imig
+FI_pex*GR_size/FI_size*GRFI_im
-(GR_pex*FIGR_rer)*FIGR_imc
-(GR_pex*FIGR_rer)*FIGR_imi
-(GR_pex*FIGR_rer)*FIGR_imcg
-(GR_pex*FIGR_rer)*FIGR_imig
+FI_pex*IT_size/FI_size*ITFI_im
-(IT_pex*FIIT_rer)*FIIT_imc
-(IT_pex*FIIT_rer)*FIIT_imi
-(IT_pex*FIIT_rer)*FIIT_imcg
-(IT_pex*FIIT_rer)*FIIT_imig
+FI_pex*NL_size/FI_size*NLFI_im
-(NL_pex*FINL_rer)*FINL_imc
-(NL_pex*FINL_rer)*FINL_imi
-(NL_pex*FINL_rer)*FINL_imcg
-(NL_pex*FINL_rer)*FINL_imig
+FI_pex*PT_size/FI_size*PTFI_im
-(PT_pex*FIPT_rer)*FIPT_imc
-(PT_pex*FIPT_rer)*FIPT_imi
-(PT_pex*FIPT_rer)*FIPT_imcg
-(PT_pex*FIPT_rer)*FIPT_imig
+FI_pex*DE_size/FI_size*DEFI_im
-(DE_pex*FIDE_rer)*FIDE_imc
-(DE_pex*FIDE_rer)*FIDE_imi
-(DE_pex*FIDE_rer)*FIDE_imcg
-(DE_pex*FIDE_rer)*FIDE_imig
+FI_pex*RU_size/FI_size*RUFI_im
-(RU_pex*FIRU_rer)*FIRU_imc
-(RU_pex*FIRU_rer)*FIRU_imi
-(RU_pex*FIRU_rer)*FIRU_imcg
-(RU_pex*FIRU_rer)*FIRU_imig
+FI_pex*RW_size/FI_size*RWFI_im
-(RW_pex*FIRW_rer)*FIRW_imc
-(RW_pex*FIRW_rer)*FIRW_imi
-(RW_pex*FIRW_rer)*FIRW_imcg
-(RW_pex*FIRW_rer)*FIRW_imig
+FI_pex*US_size/FI_size*USFI_im
-(US_pex*FIUS_rer)*FIUS_imc
-(US_pex*FIUS_rer)*FIUS_imi
-(US_pex*FIUS_rer)*FIUS_imcg
-(US_pex*FIUS_rer)*FIUS_imig
;
// Aggregate real demand
FI_y = FI_yst+FI_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(FI_zt) = (1-FI_rhozt)*log(FI_ztbar)+FI_rhozt*log(FI_zt(-1))+FI_epszt;
log(FI_zn) = (1-FI_rhozn)*log(FI_znbar)+FI_rhozn*log(FI_zn(-1))+FI_epszn;
// Government spending shock
FI_cgy = (1-FI_rhocg)*FI_cgybar+FI_rhocg*FI_cgy(-1)+FI_epsgc;
FI_igy = (1-FI_rhoig)*FI_igybar+FI_rhoig*FI_igy(-1)+FI_epsgi;
// Transfer shock
FI_try = (1-FI_rhotr)*FI_trybar+FI_rhotr*FI_try(-1)+FI_epstr;
// Consumption tax shock
FI_tauc = (1-FI_rhotauc)*FI_taucbar+FI_rhotauc*FI_tauc(-1)+FI_epstauc;
// Dividend income tax shock
FI_taud = (1-FI_rhotaud)*FI_taudbar+FI_rhotaud*FI_taud(-1)+FI_epstaud;
// Capital income tax shock
FI_tauk = (1-FI_rhotauk)*FI_taukbar+FI_rhotauk*FI_tauk(-1)+FI_epstauk;
// Labour income tax shock
FI_taun = (1-FI_rhotaun)*FI_taunbar+FI_rhotaun*FI_taun(-1)+FI_epstaun;
// Payroll tax shock: households
FI_tauwh = (1-FI_rhotauwh)*FI_tauwhbar+FI_rhotauwh*FI_tauwh(-1)+FI_epstauwh;
// Payroll tax shock: firms
FI_tauwf = (1-FI_rhotauwf)*FI_tauwfbar+FI_rhotauwf*FI_tauwf(-1)+FI_epstauwf;
// Wage cost push shock
FI_wcst = (1-FI_rhowcst)*FI_wcstbar+FI_rhowcst*FI_wcst(-1)+FI_epswcst;
// Preference shock
log(FI_zcon) = (1-FI_rhozcon)*log(FI_zconbar)+FI_rhozcon*log(FI_zcon(-1))+FI_epszcon;
// Investment specific shock
log(FI_zinv) = (1-FI_rhozinv)*log(FI_zinvbar)+FI_rhozinv*log(FI_zinv(-1))+FI_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
FI_cy = FI_c/(FI_py*FI_y);
// Aggregate nominal investment share
FI_iy = FI_pi*FI_i/(FI_py*FI_y);
// Aggregate nominal import share  
FI_imy = (
+FI_pimc*FI_imc
+FI_pimi*FI_imi
+FI_pimcg*FI_imcg
+FI_pimig*FI_imig
)/(FI_py*FI_y);
// Aggregate nominal import share
FI_imcy = FI_pimc*FI_imc/(FI_py*FI_y);
FI_imiy = FI_pimi*FI_imi/(FI_py*FI_y);
FI_imcgy = FI_pimcg*FI_imcg/(FI_py*FI_y);
FI_imigy = FI_pimig*FI_imig/(FI_py*FI_y);
// Aggregate debt-to-output ratio
FI_by = FI_b/(FI_pybar*FI_ybar);
// Aggregate lump-sum tax-to-output ratio
FI_ty = FI_t/(FI_pybar*FI_ybar);
// Aggregate labour cost share
FI_lcy = ((1+FI_tauwf)*FI_w*FI_nd)/(FI_py*FI_y);
// Aggregate nominal Wage share
FI_wy = (FI_w*FI_nd)/(FI_py*FI_y);
// NT sector nominal Wage share
FI_wnty = (FI_w*FI_ndn)/(FI_pnt*FI_ysn);
// T sector nominal Wage share
FI_whty = (FI_w*FI_ndt)/(FI_pht*FI_yst);
// T sector share
FI_yhty = FI_pht*FI_yst/(FI_py*FI_y);
// NT sector share
FI_ynty = FI_pnt*FI_ysn/(FI_py*FI_y);
// Output gap
FI_ygap = 0;
// Output growth (gross rate)
FI_ygrowth = FI_y/FI_y(-1);
// Output growth (gross rate yoy)
FI_ygrowth4 = FI_y/FI_y(-4);
// Domestic nominal output as a share of world nominal output
FI_yshare  = FI_size*FI_py*FI_y/FI_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
FI_epsilonm = -1/8*1/(FI_r*(FI_gammav2*FI_r+FI_r-1));
// Trade balance-to-GDP ratio
FI_tby = FI_tb/(FI_py*FI_y);
// Bilateral shares
FIRA_imcy = (RA_pex*FIRA_rer)*FIRA_imc/(FI_py*FI_y);
FIRA_imiy = (RA_pex*FIRA_rer)*FIRA_imi/(FI_py*FI_y);
FIRA_imcgy = (RA_pex*FIRA_rer)*FIRA_imcg/(FI_py*FI_y);
FIRA_imigy = (RA_pex*FIRA_rer)*FIRA_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIRA_excy  = RA_size/FI_size*FI_pex*RAFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIRA_exiy  = RA_size/FI_size*FI_pex*RAFI_imi/(FI_py*FI_y);
// Bilateral shares
FIAT_imcy = (AT_pex*FIAT_rer)*FIAT_imc/(FI_py*FI_y);
FIAT_imiy = (AT_pex*FIAT_rer)*FIAT_imi/(FI_py*FI_y);
FIAT_imcgy = (AT_pex*FIAT_rer)*FIAT_imcg/(FI_py*FI_y);
FIAT_imigy = (AT_pex*FIAT_rer)*FIAT_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIAT_excy  = AT_size/FI_size*FI_pex*ATFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIAT_exiy  = AT_size/FI_size*FI_pex*ATFI_imi/(FI_py*FI_y);
// Bilateral shares
FIBE_imcy = (BE_pex*FIBE_rer)*FIBE_imc/(FI_py*FI_y);
FIBE_imiy = (BE_pex*FIBE_rer)*FIBE_imi/(FI_py*FI_y);
FIBE_imcgy = (BE_pex*FIBE_rer)*FIBE_imcg/(FI_py*FI_y);
FIBE_imigy = (BE_pex*FIBE_rer)*FIBE_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIBE_excy  = BE_size/FI_size*FI_pex*BEFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIBE_exiy  = BE_size/FI_size*FI_pex*BEFI_imi/(FI_py*FI_y);
// Bilateral shares
FIES_imcy = (ES_pex*FIES_rer)*FIES_imc/(FI_py*FI_y);
FIES_imiy = (ES_pex*FIES_rer)*FIES_imi/(FI_py*FI_y);
FIES_imcgy = (ES_pex*FIES_rer)*FIES_imcg/(FI_py*FI_y);
FIES_imigy = (ES_pex*FIES_rer)*FIES_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIES_excy  = ES_size/FI_size*FI_pex*ESFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIES_exiy  = ES_size/FI_size*FI_pex*ESFI_imi/(FI_py*FI_y);
// Bilateral shares
FIFR_imcy = (FR_pex*FIFR_rer)*FIFR_imc/(FI_py*FI_y);
FIFR_imiy = (FR_pex*FIFR_rer)*FIFR_imi/(FI_py*FI_y);
FIFR_imcgy = (FR_pex*FIFR_rer)*FIFR_imcg/(FI_py*FI_y);
FIFR_imigy = (FR_pex*FIFR_rer)*FIFR_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIFR_excy  = FR_size/FI_size*FI_pex*FRFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIFR_exiy  = FR_size/FI_size*FI_pex*FRFI_imi/(FI_py*FI_y);
// Bilateral shares
FIGR_imcy = (GR_pex*FIGR_rer)*FIGR_imc/(FI_py*FI_y);
FIGR_imiy = (GR_pex*FIGR_rer)*FIGR_imi/(FI_py*FI_y);
FIGR_imcgy = (GR_pex*FIGR_rer)*FIGR_imcg/(FI_py*FI_y);
FIGR_imigy = (GR_pex*FIGR_rer)*FIGR_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIGR_excy  = GR_size/FI_size*FI_pex*GRFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIGR_exiy  = GR_size/FI_size*FI_pex*GRFI_imi/(FI_py*FI_y);
// Bilateral shares
FIIT_imcy = (IT_pex*FIIT_rer)*FIIT_imc/(FI_py*FI_y);
FIIT_imiy = (IT_pex*FIIT_rer)*FIIT_imi/(FI_py*FI_y);
FIIT_imcgy = (IT_pex*FIIT_rer)*FIIT_imcg/(FI_py*FI_y);
FIIT_imigy = (IT_pex*FIIT_rer)*FIIT_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIIT_excy  = IT_size/FI_size*FI_pex*ITFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIIT_exiy  = IT_size/FI_size*FI_pex*ITFI_imi/(FI_py*FI_y);
// Bilateral shares
FINL_imcy = (NL_pex*FINL_rer)*FINL_imc/(FI_py*FI_y);
FINL_imiy = (NL_pex*FINL_rer)*FINL_imi/(FI_py*FI_y);
FINL_imcgy = (NL_pex*FINL_rer)*FINL_imcg/(FI_py*FI_y);
FINL_imigy = (NL_pex*FINL_rer)*FINL_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FINL_excy  = NL_size/FI_size*FI_pex*NLFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FINL_exiy  = NL_size/FI_size*FI_pex*NLFI_imi/(FI_py*FI_y);
// Bilateral shares
FIPT_imcy = (PT_pex*FIPT_rer)*FIPT_imc/(FI_py*FI_y);
FIPT_imiy = (PT_pex*FIPT_rer)*FIPT_imi/(FI_py*FI_y);
FIPT_imcgy = (PT_pex*FIPT_rer)*FIPT_imcg/(FI_py*FI_y);
FIPT_imigy = (PT_pex*FIPT_rer)*FIPT_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIPT_excy  = PT_size/FI_size*FI_pex*PTFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIPT_exiy  = PT_size/FI_size*FI_pex*PTFI_imi/(FI_py*FI_y);
// Bilateral shares
FIDE_imcy = (DE_pex*FIDE_rer)*FIDE_imc/(FI_py*FI_y);
FIDE_imiy = (DE_pex*FIDE_rer)*FIDE_imi/(FI_py*FI_y);
FIDE_imcgy = (DE_pex*FIDE_rer)*FIDE_imcg/(FI_py*FI_y);
FIDE_imigy = (DE_pex*FIDE_rer)*FIDE_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIDE_excy  = DE_size/FI_size*FI_pex*DEFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIDE_exiy  = DE_size/FI_size*FI_pex*DEFI_imi/(FI_py*FI_y);
// Bilateral shares
FIRU_imcy = (RU_pex*FIRU_rer)*FIRU_imc/(FI_py*FI_y);
FIRU_imiy = (RU_pex*FIRU_rer)*FIRU_imi/(FI_py*FI_y);
FIRU_imcgy = (RU_pex*FIRU_rer)*FIRU_imcg/(FI_py*FI_y);
FIRU_imigy = (RU_pex*FIRU_rer)*FIRU_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIRU_excy  = RU_size/FI_size*FI_pex*RUFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIRU_exiy  = RU_size/FI_size*FI_pex*RUFI_imi/(FI_py*FI_y);
// Bilateral shares
FIRW_imcy = (RW_pex*FIRW_rer)*FIRW_imc/(FI_py*FI_y);
FIRW_imiy = (RW_pex*FIRW_rer)*FIRW_imi/(FI_py*FI_y);
FIRW_imcgy = (RW_pex*FIRW_rer)*FIRW_imcg/(FI_py*FI_y);
FIRW_imigy = (RW_pex*FIRW_rer)*FIRW_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIRW_excy  = RW_size/FI_size*FI_pex*RWFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIRW_exiy  = RW_size/FI_size*FI_pex*RWFI_imi/(FI_py*FI_y);
// Bilateral shares
FIUS_imcy = (US_pex*FIUS_rer)*FIUS_imc/(FI_py*FI_y);
FIUS_imiy = (US_pex*FIUS_rer)*FIUS_imi/(FI_py*FI_y);
FIUS_imcgy = (US_pex*FIUS_rer)*FIUS_imcg/(FI_py*FI_y);
FIUS_imigy = (US_pex*FIUS_rer)*FIUS_imig/(FI_py*FI_y);
// Exports of consumption goods to gdp
FIUS_excy  = US_size/FI_size*FI_pex*USFI_imc/(FI_py*FI_y);
// Exports of investment goods to gdp
FIUS_exiy  = US_size/FI_size*FI_pex*USFI_imi/(FI_py*FI_y);
// Internal real exchange rate
FI_internalrer = FI_pnt/FI_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
FR_ccesi^(1-1/FR_mucces) = (FR_nucces)^(1/FR_mucces)*FR_ci^(1-1/FR_mucces)+(1-FR_nucces)^(1/FR_mucces)*FR_cg^(1-1/FR_mucces);
// Utility
FR_utili = 
FR_zcon*log(FR_ccesi-FR_kappa*FR_ccesi(-1))-1/(1+FR_zeta)*(FR_ni)^(1+FR_zeta)+FR_beta*FR_utili(+1)
;
// Marginal utility of consumption
FR_dcci = ((FR_nucces)^(1/FR_mucces)*FR_ci^(1-1/FR_mucces)+(1-FR_nucces)^(1/FR_mucces)*FR_cg^(1-1/FR_mucces))^(1/(FR_mucces-1))*(FR_nucces^(1/FR_mucces))*(FR_ci^(-1/FR_mucces));
FR_lambdai*(1+FR_tauc+FR_gammavi+FR_vi*FR_gammavider) = FR_zcon*(FR_ccesi-FR_kappa*FR_ccesi(-1))^(-FR_sigma)*FR_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
FR_r                   = FR_beta^(-1)*FR_lambdai/FR_lambdai    *FR_pic;
// Germany
// US and the RoW
// Euler equation for money
FR_vi^(2)*FR_gammavider = 1-FR_beta*FR_lambdai(+1)/(FR_lambdai*FR_pic(+1));
// Consumption-based velocity
FR_vi = FR_ci/FR_mi;
// Transaction cost
FR_gammavi = FR_gammav1*FR_vi+FR_gammav2/FR_vi-2*(FR_gammav1*FR_gammav2)^(1/2);
// Derivative of transaction cost
FR_gammavider = FR_gammav1-FR_gammav2*FR_vi^(-2);
FR_delta = FR_ii/FR_ki;
FR_gammai = 0;
FR_gammaider = 0;
FR_gammau = 0;
FR_gammauder = ((FR_beta^(-1)-1+FR_delta)*FR_qbar-FR_delta*FR_taukbar*FR_pibar)/((1-FR_taukbar)*FR_pibar);
FR_u = 1;
FR_pi = FR_q;
// Auxiliary equation for Tobin's Q in steady state
FR_qbar = FR_q;
// Rate of return on capital
FR_q = FR_beta*((1-FR_tauk)*FR_rk+(FR_tauk*FR_delta)*FR_pi+(1-FR_delta)*FR_q);
// Optimal wage contract (FOC)
FR_witilde^(1+FR_etai*FR_zeta) = FR_etai/(FR_etai-1)*FR_fi/FR_gi+FR_wcst;
// Definition of fi
FR_fi = FR_wi^(FR_etai*(1+FR_zeta))*FR_ndi^(1+FR_zeta)+FR_xii*FR_beta*(FR_pic(+1)/(FR_pic^FR_chii*FR_pi4target^(1/4*(1-FR_chii))))^(FR_etai*(1+FR_zeta))*FR_fi(+1);
// Definition of gi
FR_gi = FR_lambdai*(1-FR_taun-FR_tauwh)*FR_wi^FR_etai*FR_ndi+FR_xii*FR_beta*(FR_pic(+1)/(FR_pic^FR_chii*FR_pi4target^(1/4*(1-FR_chii))))^(FR_etai-1)*FR_gi(+1);
// Aggregate wage rate
FR_wi^(1-FR_etai) = (1-FR_xii)*FR_witilde^(1-FR_etai)+FR_xii*FR_wi(-1)^(1-FR_etai)*(FR_pic(-1)^FR_chii*FR_pi4target^(1/4*(1-FR_chii))/FR_pic)^(1-FR_etai);
//-------------
// Household J
//-------------
FR_ccesj^(1-1/FR_mucces) = (FR_nucces)^(1/FR_mucces)*FR_cj^(1-1/FR_mucces)+(1-FR_nucces)^(1/FR_mucces)*FR_cg^(1-1/FR_mucces);
// Utility
FR_utilj = 
FR_zcon*log(FR_ccesj-FR_kappa*FR_ccesj(-1))-1/(1+FR_zeta)*(FR_nj)^(1+FR_zeta)+FR_beta*FR_utilj(+1)
;
// Marginal utility of consumption
FR_dccj = ((FR_nucces)^(1/FR_mucces)*FR_cj^(1-1/FR_mucces)+(1-FR_nucces)^(1/FR_mucces)*FR_cg^(1-1/FR_mucces))^(1/(FR_mucces-1))*(FR_nucces^(1/FR_mucces))*(FR_cj^(-1/FR_mucces));
FR_lambdaj*(1+FR_tauc+FR_gammavj+FR_vj*FR_gammavjder) = FR_zcon*(FR_ccesj-FR_kappa*FR_ccesj(-1))^(-FR_sigma)*FR_dccj;
// Budget constraint
(1+FR_tauc+FR_gammavj)*FR_cj+FR_mj = (1-FR_taun-FR_tauwh)*FR_wj*FR_nj+FR_trj-FR_tj+FR_mj(-1)*FR_pic^(-1);
// Euler equation for money
FR_vj^(2)*FR_gammavjder = 1-FR_beta*FR_lambdaj(+1)/(FR_lambdaj*FR_pic(+1));
// Consumption-based velocity
FR_vj = FR_cj/FR_mj;
// Transaction technology
FR_gammavj = FR_gammav1*FR_vj+FR_gammav2/FR_vj-2*(FR_gammav1*FR_gammav2)^(1/2);
// Derivative of transaction technology
FR_gammavjder = FR_gammav1-FR_gammav2*FR_vj^(-2);
// Optimal wage contract (FOC)
FR_wjtilde^(1+FR_etaj*FR_zeta) = FR_etaj/(FR_etaj-1)*FR_fj/FR_gj+FR_wcst;
// Definition of fj
FR_fj = FR_wj^(FR_etaj*(1+FR_zeta))*FR_ndj^(1+FR_zeta)+FR_xij*FR_beta*(FR_pic(+1)/(FR_pic^FR_chij*FR_pi4target^(1/4*(1-FR_chij))))^(FR_etaj*(1+FR_zeta))*FR_fj(+1);
// Definition of gj
FR_gj = FR_lambdaj*(1-FR_taun-FR_tauwh)*FR_wj^FR_etaj*FR_ndj+FR_xij*FR_beta*(FR_pic(+1)/(FR_pic^FR_chij*FR_pi4target^(1/4*(1-FR_chij))))^(FR_etaj-1)*FR_gj(+1);
// Aggregate wage rate
FR_wj^(1-FR_etaj) = (1-FR_xij)*FR_wjtilde^(1-FR_etaj)+FR_xij*FR_wj(-1)^(1-FR_etaj)*(FR_pic(-1)^FR_chij*FR_pi4target^(1/4*(1-FR_chij))/FR_pic)^(1-FR_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
FR_kg = (1-FR_deltag)*FR_kg(-1)+FR_ig(-1);
// Production function tradable
FR_yst = FR_zt*FR_kg^FR_alphag*FR_kdt^FR_alphat*FR_ndt^(1-FR_alphat)-FR_psitbar;
// Production function nontradable
FR_ysn = FR_zn*FR_kg^FR_alphag*FR_kdn^FR_alphan*FR_ndn^(1-FR_alphan)-FR_psinbar;
// Real marginal cost tradable
FR_mct = 1/(FR_zt*FR_kg^FR_alphag*(FR_alphat)^(FR_alphat)*(1-FR_alphat)^(1-FR_alphat))*FR_rk^(FR_alphat)*((1+FR_tauwf)*FR_w)^(1-FR_alphat);
// Real marginal cost nontradable
FR_mcn = 1/(FR_zn*FR_kg^FR_alphag*(FR_alphan)^(FR_alphan)*(1-FR_alphan)^(1-FR_alphan))*FR_rk^(FR_alphan)*((1+FR_tauwf)*FR_w)^(1-FR_alphan);
// Wage Inflation (qoq)
FR_piw = FR_w/FR_w(-1)*FR_pic;
// Wage Inflation (yoy)
FR_piw4 = FR_pic4;
// Auxiliary equation for steady-state fixed cost
FR_psitbar = FR_psit*FR_ytbar;
// Auxiliary equation for steady-state fixed cost
FR_psinbar = FR_psin*FR_ynbar;
// Capital input (FOC)
FR_rk = FR_alphat*(FR_yst+FR_psitbar)/FR_kdt*FR_mct;
// Capital input (FOC)
FR_rk = FR_alphan*(FR_ysn+FR_psinbar)/FR_kdn*FR_mcn;
// Total capital demand
FR_kd = FR_kdt+FR_kdn;
// Demand for labour services by household I
FR_ndi = 
(1-FR_omega)*(FR_wi/FR_w)^(-FR_eta)*FR_nd
;
// Demand for labour services by household J
FR_ndj = 
FR_omega*(FR_wj/FR_w)^(-FR_eta)*FR_nd
;
// Aggregate labour demand
FR_nd^(1-1/FR_eta) = 
(1-FR_omega)^(1/FR_eta)*FR_ndi^(1-1/FR_eta)+FR_omega^(1/FR_eta)*FR_ndj^(1-1/FR_eta)
;
// Total demand 
FR_nd = FR_ndt+FR_ndn;
// Aggregate dividends
FR_d = FR_py*FR_y-FR_rk*FR_kd-(1+FR_tauwf)*FR_w*FR_nd;
// Non-tradable sector dividends
FR_dn = FR_pnt*FR_ysn-FR_rk*FR_kdn-(1+FR_tauwf)*FR_w*FR_ndn;
// Tradable sector dividends
FR_dt = FR_pht*FR_ht
+FR_pex*FR_ex
-FR_rk*FR_kdt-(1+FR_tauwf)*FR_w*FR_ndt;
// Optimal price contract set in domestic markets (FOC)
FR_phttilde/FR_pht = FR_thetat/(FR_thetat-1)*FR_fh/FR_gh;
// Definition of fh
FR_fh = FR_mct*FR_ht+FR_xih*FR_beta*FR_lambdai(+1)/FR_lambdai*(FR_piht(+1)/(FR_piht^FR_chih*FR_pi4target^(1/4*(1-FR_chih))))^FR_thetat*FR_fh(+1);
// Definition of gh
FR_gh = FR_pht*FR_ht+FR_xih*FR_beta*FR_lambdai(+1)/FR_lambdai*(FR_piht(+1)/(FR_piht^FR_chih*FR_pi4target^(1/4*(1-FR_chih))))^(FR_thetat-1)*FR_gh(+1);
// Aggregate intermediate-good price dynamics
FR_pht^(1-FR_thetat) = (1-FR_xih)*FR_phttilde^(1-FR_thetat)+FR_xih*(FR_pht(-1)/FR_pic)^(1-FR_thetat)*(FR_piht(-1)^FR_chih*FR_pi4target^(1/4*(1-FR_chih)))^(1-FR_thetat);
// Intermediate-good price inflation
FR_piht = FR_pht/FR_pht(-1)*FR_pic;
// Optimal price contract set in domestic markets (FOC)
FR_pnttilde/FR_pnt = FR_thetan/(FR_thetan-1)*FR_fn/FR_gn;
// Definition of fn
FR_fn = FR_mcn*FR_nt+FR_xin*FR_beta*FR_lambdai(+1)/FR_lambdai*(FR_pint(+1)/(FR_pint^FR_chin*FR_pi4target^(1/4*(1-FR_chin))))^FR_thetan*FR_fn(+1);
// Definition of gn
FR_gn = FR_pnt*FR_nt+FR_xin*FR_beta*FR_lambdai(+1)/FR_lambdai*(FR_pint(+1)/(FR_pint^FR_chin*FR_pi4target^(1/4*(1-FR_chin))))^(FR_thetan-1)*FR_gn(+1);
// Aggregate intermediate-good price dynamics
FR_pnt^(1-FR_thetan) = (1-FR_xin)*FR_pnttilde^(1-FR_thetan)+FR_xin*(FR_pnt(-1)/FR_pic)^(1-FR_thetan)*(FR_pint(-1)^FR_chin*FR_pi4target^(1/4*(1-FR_chin)))^(1-FR_thetan);
// Intermediate-good price inflation
FR_pint = FR_pnt/FR_pnt(-1)*FR_pic;
// Optimal price contract set in domestic markets (FOC)
FR_pextilde/FR_pex = FR_thetat/(FR_thetat-1)*FR_fx/FR_gx;
// Definition of fh
FR_fx = FR_mct*FR_ex+FR_xix*FR_beta*FR_lambdai(+1)/FR_lambdai*(FR_piex(+1)/(FR_piex^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^FR_thetat*FR_fx(+1);
// Definition of gh
FR_gx = FR_pex*FR_ex+FR_xix*FR_beta*FR_lambdai(+1)/FR_lambdai*(FR_piex(+1)/(FR_piex^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^(FR_thetat-1)*FR_gx(+1);
// Aggregate intermediate-good price dynamics
FR_pex^(1-FR_thetat) = (1-FR_xix)*FR_pextilde^(1-FR_thetat)+FR_xix*(FR_pex(-1)/FR_pic)^(1-FR_thetat)*(FR_piex(-1)^FR_chix*FR_pi4target^(1/4*(1-FR_chix)))^(1-FR_thetat);
// Intermediate-good price inflation
FR_piex = FR_pex/FR_pex(-1)*FR_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using FR_pxtilde = RA_pimtilde
// RAFR_pimtilde/RAFR_pim = FR_cpim*FR_thetat/(FR_thetat-1)*FRRA_fx/FRRA_gx;
// Definition of fx
// FRRA_fx = RA_size/FR_size*RAFR_im*FR_mct+FR_xix*FR_beta*FR_lambdai(+1)/FR_lambdai*(RAFR_piim(+1)/(RAFR_piim^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^FR_thetat*FRRA_fx(+1);
// Definition of gx   
// FRRA_gx = FRRA_rer*RAFR_pim*RA_size/FR_size*RAFR_im+FR_xix*FR_beta*FR_lambdai(+1)/FR_lambdai*(RAFR_piim(+1)/(RAFR_piim^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^(FR_thetat-1)*FRRA_gx(+1);
// Aggregate intermediate-good price dynamics, using FR_px = RA_pim
// RAFR_pim^(1-FR_thetat) = (1-FR_xix)*RAFR_pimtilde^(1-FR_thetat)+FR_xix*(RAFR_pim(-1)/RA_pic)^(1-FR_thetat)*(RAFR_piim(-1)^FR_chix*RA_pi4target^(1/4*(1-FR_chih)))^(1-FR_thetat);
// Intermediate-good price inflation, using FR_pix = RA_piim
// RAFR_piim = RAFR_pim/RAFR_pim(-1)*RA_pic;
// Bilateral real exchange rate
FRRA_rer = FR_rer/RA_rer;
// Auxiliary equation for steady-state output
FRRA_rerbar = FRRA_rer;
//Terms of Trade
FRRA_tot = RA_pex*FRRA_rer/FR_pex;
// Optimal price contract set in foreign markets (FOC), using FR_pxtilde = AT_pimtilde
// ATFR_pimtilde/ATFR_pim = FR_cpim*FR_thetat/(FR_thetat-1)*FRAT_fx/FRAT_gx;
// Definition of fx
// FRAT_fx = AT_size/FR_size*ATFR_im*FR_mct+FR_xix*FR_beta*FR_lambdai(+1)/FR_lambdai*(ATFR_piim(+1)/(ATFR_piim^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^FR_thetat*FRAT_fx(+1);
// Definition of gx   
// FRAT_gx = FRAT_rer*ATFR_pim*AT_size/FR_size*ATFR_im+FR_xix*FR_beta*FR_lambdai(+1)/FR_lambdai*(ATFR_piim(+1)/(ATFR_piim^FR_chix*FR_pi4target^(1/4*(1-FR_chix))))^(FR_thetat-1)*FRAT_gx(+1);
// Aggregate intermediate-good price dynamics, using FR_px = AT_pim
// ATFR_pim^(1-FR_thetat) = (1-FR_xix)*ATFR_pimtilde^(1-FR_thetat)+FR_xix*(ATFR_pim(-1)/AT_pic)^(1-FR_thetat)*(ATFR_piim(-1)^FR_chix*AT_pi4target^(1/4*(1-FR_chih)))^(1-FR_thetat);
// Intermediate-good price inflation, using FR_pix = AT_piim
// ATFR_piim = ATFR_pim/ATFR_pim(-1)*AT_pic;
// Bilateral real exchange rate
FRAT_rer = FR_rer/AT_rer;
// Auxiliary equation for steady-state output
FRAT_rerbar = FRAT_rer;
//Terms of Trade
FRAT_tot = AT_pex*FRAT_rer/FR_pex;
// Optimal price contract set in foreign markets (FOC), using FR_pxtilde = BE_pimtilde
