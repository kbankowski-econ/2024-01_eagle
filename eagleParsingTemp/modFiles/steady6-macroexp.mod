+GRUS_rer*US_pex*ATUS_im
)
+BE_size/GR_size*BEGR_im/GR_ex*GRRA_rer*RA_pex*BERA_im/(GRBE_rer*BE_py*BE_y
+GRRA_rer*RA_pex*BERA_im
+GRAT_rer*AT_pex*BEAT_im
+GRES_rer*ES_pex*BEES_im
+GRFI_rer*FI_pex*BEFI_im
