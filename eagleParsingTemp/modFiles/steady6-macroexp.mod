+DEUS_rer*US_pex*NLUS_im
)
+PT_size/DE_size*PTDE_im/DE_ex*DERA_rer*RA_pex*PTRA_im/(DEPT_rer*PT_py*PT_y
+DERA_rer*RA_pex*PTRA_im
+DEAT_rer*AT_pex*PTAT_im
