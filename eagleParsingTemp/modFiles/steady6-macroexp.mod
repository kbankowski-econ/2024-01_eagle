+NL_size/RA_size*NLRA_im/RA_ex*RARW_rer*RW_pex*NLRW_im/(RANL_rer*NL_py*NL_y
+RAAT_rer*AT_pex*NLAT_im
+RABE_rer*BE_pex*NLBE_im
