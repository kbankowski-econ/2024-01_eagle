-RU_pex*RARU_rer*RARU_im
+RA_pex*RW_size/RA_size*RWRA_im
-RW_pex*RARW_rer*RARW_im
+RA_pex*US_size/RA_size*USRA_im
-US_pex*RAUS_rer*RAUS_im
;
// Aggregate exports (volume)
RA_ex =
+AT_size/RA_size*ATRA_im
+BE_size/RA_size*BERA_im
+ES_size/RA_size*ESRA_im
+FI_size/RA_size*FIRA_im
+FR_size/RA_size*FRRA_im
+GR_size/RA_size*GRRA_im
+IT_size/RA_size*ITRA_im
+NL_size/RA_size*NLRA_im
+PT_size/RA_size*PTRA_im
+DE_size/RA_size*DERA_im
+RU_size/RA_size*RURA_im
+RW_size/RA_size*RWRA_im
+US_size/RA_size*USRA_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using RA_pg = RA_pht
// TODO: check the (1-RA_gammab(-1)) adjustment here, which is not in the fiscal extention
	RA_pcg(-1)*RA_cg(-1)+RA_pig(-1)*RA_ig(-1)+RA_tr(-1)
	+RA_b(-1)*RA_pic(-1)^(-1)+RA_m(-2)*RA_pic(-1)^(-1) = RA_tauc(-1)*RA_c(-1)+(RA_taun(-1)+RA_tauwh(-1))*(RA_wi(-1)*RA_ndi(-1)+RA_wj(-1)*RA_ndj(-1))+RA_tauwf(-1)*RA_w(-1)*RA_nd(-1)+RA_tauk(-1)*(RA_rk(-1)*RA_u(-1)-(RA_gammau(-1)+RA_delta)*RA_pi(-1))*RA_k(-1)+RA_taud(-1)*RA_d(-1)+RA_t(-1)+(RA_r(-1)*(1-RA_gammab(-1)))^(-1)*RA_b+RA_m(-1);
// Government spending, using RA_pg = RA_pht
RA_pcg*RA_cg = RA_cgy*RA_pybar*RA_ybar;
RA_pig*RA_ig = RA_igy*RA_pybar*RA_ybar;
RA_t = 0;
RA_b = RA_bytarget*RA_pybar*RA_ybar;
// Auxiliary equation for steady-state output
RA_ybar = RA_y;
// Auxiliary equation for steady-state output
RA_ytbar = RA_yst;
// Auxiliary equation for steady-state output
RA_ynbar = RA_ysn;
// Auxiliary equation for steady-state output deflator
RA_pybar = RA_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
RA_trybar = RA_tr/(RA_pybar*RA_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
RA_ti = RA_upsilont*RA_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
RA_tri = RA_upsilontr*RA_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	RA_r = DE_r;
RA_pic4 = RA_pi4target;
RA_rr-1 = RA_r/RA_pi4target^(1/4)-1;
// Equilibrium real interest rate
RA_rrstar-1 = 1/RA_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
RA_c = (1-RA_omega)*RA_ci+RA_omega*RA_cj;
// Aggregate money holdings
RA_m = (1-RA_omega)*RA_mi+RA_omega*RA_mj;
// Aggregate capital stock
RA_k = (1-RA_omega)*RA_ki;
// Aggregate investment
RA_i = (1-RA_omega)*RA_ii;
// Aggregate lump-sum transfers
RA_trj = 
1/RA_omega*RA_tr-(1-RA_omega)/RA_omega*RA_tri
;
// Aggregate lump-sum taxes
RA_tj = 
1/RA_omega*RA_t-(1-RA_omega)/RA_omega*RA_ti
;
// Aggregate transaction costs
RA_gammav = (1-RA_omega)*RA_ci*RA_gammavi+RA_omega*RA_cj*RA_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
RA_ni = RA_si*RA_ndi;
// Wage dispersion
RA_si = (1-RA_xii)*(RA_witilde/RA_wi)^(-RA_etai)+RA_xii*(RA_wi(-1)/RA_wi)^(-RA_etai)*(RA_pic/(RA_pic(-1)^RA_chii*RA_pi4target^(1/4*(1-RA_chii))))^(RA_etai)*RA_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
RA_nj = RA_sj*RA_ndj;
// Wage dispersion
RA_sj = (1-RA_xij)*(RA_wjtilde/RA_wj)^(-RA_etaj)+RA_xij*(RA_wj(-1)/RA_wj)^(-RA_etaj)*(RA_pic/(RA_pic(-1)^RA_chij*RA_pi4target^(1/4*(1-RA_chij))))^(RA_etaj)*RA_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
RA_u*RA_k = RA_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using RA_x = AT_size/RA_size*AT_im
RA_ysn = RA_snt*RA_nt;
//  nontradables aggregate demand
RA_nt = 
+RA_ntc
+RA_nti
+RA_ntcg
+RA_ntig
;
// Aggregate demand for domestic intermediate goods, using RA_hg = RA_cg
RA_ht =
+RA_htc
+RA_hti
+RA_htcg
+RA_htig
;
// Price dispersion in the domestic markets
RA_sh = (1-RA_xih)*(RA_phttilde/RA_pht)^(-RA_thetat)+RA_xih*(RA_piht/(RA_piht(-1)^RA_chih*RA_pi4target^(1/4*(1-RA_chih))))^RA_thetat*RA_sh(-1);
// Price dispersion in the foreign markets
RA_sx = (1-RA_xix)*(RA_pextilde/RA_pex)^(-RA_thetat)+RA_xix*(RA_piex/(RA_piex(-1)^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RA_sx(-1);
// Price dispersion in the domestic markets
RA_snt = (1-RA_xin)*(RA_pnttilde/RA_pnt)^(-RA_thetan)+RA_xin*(RA_pint/(RA_pint(-1)^RA_chin*RA_pi4target^(1/4*(1-RA_chin))))^RA_thetan*RA_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
RA_qc = RA_c+RA_gammav;
// Aggregate investment and capital utilisation cost
RA_qi = RA_i+RA_k*RA_gammau;
// Aggregate gov demand components added to use the same structure like in private components
RA_qcg = RA_cg;
RA_qig = RA_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
RA_py*RA_y = 
+RA_qc
+RA_pi*RA_qi
+RA_pcg*RA_qcg
+RA_pig*RA_qig
+RA_pex*AT_size/RA_size*ATRA_im
-(AT_pex*RAAT_rer)*RAAT_imc
-(AT_pex*RAAT_rer)*RAAT_imi
-(AT_pex*RAAT_rer)*RAAT_imcg
-(AT_pex*RAAT_rer)*RAAT_imig
+RA_pex*BE_size/RA_size*BERA_im
-(BE_pex*RABE_rer)*RABE_imc
-(BE_pex*RABE_rer)*RABE_imi
-(BE_pex*RABE_rer)*RABE_imcg
-(BE_pex*RABE_rer)*RABE_imig
+RA_pex*ES_size/RA_size*ESRA_im
-(ES_pex*RAES_rer)*RAES_imc
-(ES_pex*RAES_rer)*RAES_imi
-(ES_pex*RAES_rer)*RAES_imcg
-(ES_pex*RAES_rer)*RAES_imig
+RA_pex*FI_size/RA_size*FIRA_im
-(FI_pex*RAFI_rer)*RAFI_imc
-(FI_pex*RAFI_rer)*RAFI_imi
-(FI_pex*RAFI_rer)*RAFI_imcg
-(FI_pex*RAFI_rer)*RAFI_imig
+RA_pex*FR_size/RA_size*FRRA_im
-(FR_pex*RAFR_rer)*RAFR_imc
-(FR_pex*RAFR_rer)*RAFR_imi
-(FR_pex*RAFR_rer)*RAFR_imcg
-(FR_pex*RAFR_rer)*RAFR_imig
+RA_pex*GR_size/RA_size*GRRA_im
-(GR_pex*RAGR_rer)*RAGR_imc
-(GR_pex*RAGR_rer)*RAGR_imi
-(GR_pex*RAGR_rer)*RAGR_imcg
-(GR_pex*RAGR_rer)*RAGR_imig
+RA_pex*IT_size/RA_size*ITRA_im
-(IT_pex*RAIT_rer)*RAIT_imc
-(IT_pex*RAIT_rer)*RAIT_imi
-(IT_pex*RAIT_rer)*RAIT_imcg
-(IT_pex*RAIT_rer)*RAIT_imig
+RA_pex*NL_size/RA_size*NLRA_im
-(NL_pex*RANL_rer)*RANL_imc
-(NL_pex*RANL_rer)*RANL_imi
-(NL_pex*RANL_rer)*RANL_imcg
-(NL_pex*RANL_rer)*RANL_imig
+RA_pex*PT_size/RA_size*PTRA_im
-(PT_pex*RAPT_rer)*RAPT_imc
-(PT_pex*RAPT_rer)*RAPT_imi
-(PT_pex*RAPT_rer)*RAPT_imcg
-(PT_pex*RAPT_rer)*RAPT_imig
+RA_pex*DE_size/RA_size*DERA_im
-(DE_pex*RADE_rer)*RADE_imc
-(DE_pex*RADE_rer)*RADE_imi
-(DE_pex*RADE_rer)*RADE_imcg
-(DE_pex*RADE_rer)*RADE_imig
+RA_pex*RU_size/RA_size*RURA_im
-(RU_pex*RARU_rer)*RARU_imc
-(RU_pex*RARU_rer)*RARU_imi
-(RU_pex*RARU_rer)*RARU_imcg
-(RU_pex*RARU_rer)*RARU_imig
+RA_pex*RW_size/RA_size*RWRA_im
-(RW_pex*RARW_rer)*RARW_imc
-(RW_pex*RARW_rer)*RARW_imi
-(RW_pex*RARW_rer)*RARW_imcg
-(RW_pex*RARW_rer)*RARW_imig
+RA_pex*US_size/RA_size*USRA_im
-(US_pex*RAUS_rer)*RAUS_imc
-(US_pex*RAUS_rer)*RAUS_imi
-(US_pex*RAUS_rer)*RAUS_imcg
-(US_pex*RAUS_rer)*RAUS_imig
;
// Aggregate real demand
RA_y = RA_yst+RA_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(RA_zt) = (1-RA_rhozt)*log(RA_ztbar)+RA_rhozt*log(RA_zt(-1))+RA_epszt;
log(RA_zn) = (1-RA_rhozn)*log(RA_znbar)+RA_rhozn*log(RA_zn(-1))+RA_epszn;
// Government spending shock
RA_cgy = (1-RA_rhocg)*RA_cgybar+RA_rhocg*RA_cgy(-1)+RA_epsgc;
RA_igy = (1-RA_rhoig)*RA_igybar+RA_rhoig*RA_igy(-1)+RA_epsgi;
// Transfer shock
RA_try = (1-RA_rhotr)*RA_trybar+RA_rhotr*RA_try(-1)+RA_epstr;
// Consumption tax shock
RA_tauc = (1-RA_rhotauc)*RA_taucbar+RA_rhotauc*RA_tauc(-1)+RA_epstauc;
// Dividend income tax shock
RA_taud = (1-RA_rhotaud)*RA_taudbar+RA_rhotaud*RA_taud(-1)+RA_epstaud;
// Capital income tax shock
RA_tauk = (1-RA_rhotauk)*RA_taukbar+RA_rhotauk*RA_tauk(-1)+RA_epstauk;
// Labour income tax shock
RA_taun = (1-RA_rhotaun)*RA_taunbar+RA_rhotaun*RA_taun(-1)+RA_epstaun;
// Payroll tax shock: households
RA_tauwh = (1-RA_rhotauwh)*RA_tauwhbar+RA_rhotauwh*RA_tauwh(-1)+RA_epstauwh;
// Payroll tax shock: firms
RA_tauwf = (1-RA_rhotauwf)*RA_tauwfbar+RA_rhotauwf*RA_tauwf(-1)+RA_epstauwf;
// Wage cost push shock
RA_wcst = (1-RA_rhowcst)*RA_wcstbar+RA_rhowcst*RA_wcst(-1)+RA_epswcst;
// Preference shock
log(RA_zcon) = (1-RA_rhozcon)*log(RA_zconbar)+RA_rhozcon*log(RA_zcon(-1))+RA_epszcon;
// Investment specific shock
log(RA_zinv) = (1-RA_rhozinv)*log(RA_zinvbar)+RA_rhozinv*log(RA_zinv(-1))+RA_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
RA_cy = RA_c/(RA_py*RA_y);
// Aggregate nominal investment share
RA_iy = RA_pi*RA_i/(RA_py*RA_y);
// Aggregate nominal import share  
RA_imy = (
+RA_pimc*RA_imc
+RA_pimi*RA_imi
+RA_pimcg*RA_imcg
+RA_pimig*RA_imig
)/(RA_py*RA_y);
// Aggregate nominal import share
RA_imcy = RA_pimc*RA_imc/(RA_py*RA_y);
RA_imiy = RA_pimi*RA_imi/(RA_py*RA_y);
RA_imcgy = RA_pimcg*RA_imcg/(RA_py*RA_y);
RA_imigy = RA_pimig*RA_imig/(RA_py*RA_y);
// Aggregate debt-to-output ratio
RA_by = RA_b/(RA_pybar*RA_ybar);
// Aggregate lump-sum tax-to-output ratio
RA_ty = RA_t/(RA_pybar*RA_ybar);
// Aggregate labour cost share
RA_lcy = ((1+RA_tauwf)*RA_w*RA_nd)/(RA_py*RA_y);
// Aggregate nominal Wage share
RA_wy = (RA_w*RA_nd)/(RA_py*RA_y);
// NT sector nominal Wage share
RA_wnty = (RA_w*RA_ndn)/(RA_pnt*RA_ysn);
// T sector nominal Wage share
RA_whty = (RA_w*RA_ndt)/(RA_pht*RA_yst);
// T sector share
RA_yhty = RA_pht*RA_yst/(RA_py*RA_y);
// NT sector share
RA_ynty = RA_pnt*RA_ysn/(RA_py*RA_y);
// Output gap
RA_ygap = 0;
// Output growth (gross rate)
RA_ygrowth = RA_y/RA_y(-1);
// Output growth (gross rate yoy)
RA_ygrowth4 = RA_y/RA_y(-4);
// Domestic nominal output as a share of world nominal output
RA_yshare  = RA_size*RA_py*RA_y/RA_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
RA_epsilonm = -1/8*1/(RA_r*(RA_gammav2*RA_r+RA_r-1));
// Trade balance-to-GDP ratio
RA_tby = RA_tb/(RA_py*RA_y);
// Bilateral shares
RAAT_imcy = (AT_pex*RAAT_rer)*RAAT_imc/(RA_py*RA_y);
RAAT_imiy = (AT_pex*RAAT_rer)*RAAT_imi/(RA_py*RA_y);
RAAT_imcgy = (AT_pex*RAAT_rer)*RAAT_imcg/(RA_py*RA_y);
RAAT_imigy = (AT_pex*RAAT_rer)*RAAT_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAAT_excy  = AT_size/RA_size*RA_pex*ATRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAAT_exiy  = AT_size/RA_size*RA_pex*ATRA_imi/(RA_py*RA_y);
// Bilateral shares
RABE_imcy = (BE_pex*RABE_rer)*RABE_imc/(RA_py*RA_y);
RABE_imiy = (BE_pex*RABE_rer)*RABE_imi/(RA_py*RA_y);
RABE_imcgy = (BE_pex*RABE_rer)*RABE_imcg/(RA_py*RA_y);
RABE_imigy = (BE_pex*RABE_rer)*RABE_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RABE_excy  = BE_size/RA_size*RA_pex*BERA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RABE_exiy  = BE_size/RA_size*RA_pex*BERA_imi/(RA_py*RA_y);
// Bilateral shares
RAES_imcy = (ES_pex*RAES_rer)*RAES_imc/(RA_py*RA_y);
RAES_imiy = (ES_pex*RAES_rer)*RAES_imi/(RA_py*RA_y);
RAES_imcgy = (ES_pex*RAES_rer)*RAES_imcg/(RA_py*RA_y);
RAES_imigy = (ES_pex*RAES_rer)*RAES_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAES_excy  = ES_size/RA_size*RA_pex*ESRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAES_exiy  = ES_size/RA_size*RA_pex*ESRA_imi/(RA_py*RA_y);
// Bilateral shares
RAFI_imcy = (FI_pex*RAFI_rer)*RAFI_imc/(RA_py*RA_y);
RAFI_imiy = (FI_pex*RAFI_rer)*RAFI_imi/(RA_py*RA_y);
RAFI_imcgy = (FI_pex*RAFI_rer)*RAFI_imcg/(RA_py*RA_y);
RAFI_imigy = (FI_pex*RAFI_rer)*RAFI_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAFI_excy  = FI_size/RA_size*RA_pex*FIRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAFI_exiy  = FI_size/RA_size*RA_pex*FIRA_imi/(RA_py*RA_y);
// Bilateral shares
RAFR_imcy = (FR_pex*RAFR_rer)*RAFR_imc/(RA_py*RA_y);
RAFR_imiy = (FR_pex*RAFR_rer)*RAFR_imi/(RA_py*RA_y);
RAFR_imcgy = (FR_pex*RAFR_rer)*RAFR_imcg/(RA_py*RA_y);
RAFR_imigy = (FR_pex*RAFR_rer)*RAFR_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAFR_excy  = FR_size/RA_size*RA_pex*FRRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAFR_exiy  = FR_size/RA_size*RA_pex*FRRA_imi/(RA_py*RA_y);
// Bilateral shares
RAGR_imcy = (GR_pex*RAGR_rer)*RAGR_imc/(RA_py*RA_y);
RAGR_imiy = (GR_pex*RAGR_rer)*RAGR_imi/(RA_py*RA_y);
RAGR_imcgy = (GR_pex*RAGR_rer)*RAGR_imcg/(RA_py*RA_y);
RAGR_imigy = (GR_pex*RAGR_rer)*RAGR_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAGR_excy  = GR_size/RA_size*RA_pex*GRRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAGR_exiy  = GR_size/RA_size*RA_pex*GRRA_imi/(RA_py*RA_y);
// Bilateral shares
RAIT_imcy = (IT_pex*RAIT_rer)*RAIT_imc/(RA_py*RA_y);
RAIT_imiy = (IT_pex*RAIT_rer)*RAIT_imi/(RA_py*RA_y);
RAIT_imcgy = (IT_pex*RAIT_rer)*RAIT_imcg/(RA_py*RA_y);
RAIT_imigy = (IT_pex*RAIT_rer)*RAIT_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAIT_excy  = IT_size/RA_size*RA_pex*ITRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAIT_exiy  = IT_size/RA_size*RA_pex*ITRA_imi/(RA_py*RA_y);
// Bilateral shares
RANL_imcy = (NL_pex*RANL_rer)*RANL_imc/(RA_py*RA_y);
RANL_imiy = (NL_pex*RANL_rer)*RANL_imi/(RA_py*RA_y);
RANL_imcgy = (NL_pex*RANL_rer)*RANL_imcg/(RA_py*RA_y);
RANL_imigy = (NL_pex*RANL_rer)*RANL_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RANL_excy  = NL_size/RA_size*RA_pex*NLRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RANL_exiy  = NL_size/RA_size*RA_pex*NLRA_imi/(RA_py*RA_y);
// Bilateral shares
RAPT_imcy = (PT_pex*RAPT_rer)*RAPT_imc/(RA_py*RA_y);
RAPT_imiy = (PT_pex*RAPT_rer)*RAPT_imi/(RA_py*RA_y);
RAPT_imcgy = (PT_pex*RAPT_rer)*RAPT_imcg/(RA_py*RA_y);
RAPT_imigy = (PT_pex*RAPT_rer)*RAPT_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAPT_excy  = PT_size/RA_size*RA_pex*PTRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAPT_exiy  = PT_size/RA_size*RA_pex*PTRA_imi/(RA_py*RA_y);
// Bilateral shares
RADE_imcy = (DE_pex*RADE_rer)*RADE_imc/(RA_py*RA_y);
RADE_imiy = (DE_pex*RADE_rer)*RADE_imi/(RA_py*RA_y);
RADE_imcgy = (DE_pex*RADE_rer)*RADE_imcg/(RA_py*RA_y);
RADE_imigy = (DE_pex*RADE_rer)*RADE_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RADE_excy  = DE_size/RA_size*RA_pex*DERA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RADE_exiy  = DE_size/RA_size*RA_pex*DERA_imi/(RA_py*RA_y);
// Bilateral shares
RARU_imcy = (RU_pex*RARU_rer)*RARU_imc/(RA_py*RA_y);
RARU_imiy = (RU_pex*RARU_rer)*RARU_imi/(RA_py*RA_y);
RARU_imcgy = (RU_pex*RARU_rer)*RARU_imcg/(RA_py*RA_y);
RARU_imigy = (RU_pex*RARU_rer)*RARU_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RARU_excy  = RU_size/RA_size*RA_pex*RURA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RARU_exiy  = RU_size/RA_size*RA_pex*RURA_imi/(RA_py*RA_y);
// Bilateral shares
RARW_imcy = (RW_pex*RARW_rer)*RARW_imc/(RA_py*RA_y);
RARW_imiy = (RW_pex*RARW_rer)*RARW_imi/(RA_py*RA_y);
RARW_imcgy = (RW_pex*RARW_rer)*RARW_imcg/(RA_py*RA_y);
RARW_imigy = (RW_pex*RARW_rer)*RARW_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RARW_excy  = RW_size/RA_size*RA_pex*RWRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RARW_exiy  = RW_size/RA_size*RA_pex*RWRA_imi/(RA_py*RA_y);
// Bilateral shares
RAUS_imcy = (US_pex*RAUS_rer)*RAUS_imc/(RA_py*RA_y);
RAUS_imiy = (US_pex*RAUS_rer)*RAUS_imi/(RA_py*RA_y);
RAUS_imcgy = (US_pex*RAUS_rer)*RAUS_imcg/(RA_py*RA_y);
RAUS_imigy = (US_pex*RAUS_rer)*RAUS_imig/(RA_py*RA_y);
// Exports of consumption goods to gdp
RAUS_excy  = US_size/RA_size*RA_pex*USRA_imc/(RA_py*RA_y);
// Exports of investment goods to gdp
RAUS_exiy  = US_size/RA_size*RA_pex*USRA_imi/(RA_py*RA_y);
// Internal real exchange rate
RA_internalrer = RA_pnt/RA_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
AT_ccesi^(1-1/AT_mucces) = (AT_nucces)^(1/AT_mucces)*AT_ci^(1-1/AT_mucces)+(1-AT_nucces)^(1/AT_mucces)*AT_cg^(1-1/AT_mucces);
// Utility
AT_utili = 
AT_zcon*log(AT_ccesi-AT_kappa*AT_ccesi(-1))-1/(1+AT_zeta)*(AT_ni)^(1+AT_zeta)+AT_beta*AT_utili(+1)
;
// Marginal utility of consumption
AT_dcci = ((AT_nucces)^(1/AT_mucces)*AT_ci^(1-1/AT_mucces)+(1-AT_nucces)^(1/AT_mucces)*AT_cg^(1-1/AT_mucces))^(1/(AT_mucces-1))*(AT_nucces^(1/AT_mucces))*(AT_ci^(-1/AT_mucces));
AT_lambdai*(1+AT_tauc+AT_gammavi+AT_vi*AT_gammavider) = AT_zcon*(AT_ccesi-AT_kappa*AT_ccesi(-1))^(-AT_sigma)*AT_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
AT_r                   = AT_beta^(-1)*AT_lambdai/AT_lambdai    *AT_pic;
// Germany
// US and the RoW
// Euler equation for money
AT_vi^(2)*AT_gammavider = 1-AT_beta*AT_lambdai(+1)/(AT_lambdai*AT_pic(+1));
// Consumption-based velocity
AT_vi = AT_ci/AT_mi;
// Transaction cost
AT_gammavi = AT_gammav1*AT_vi+AT_gammav2/AT_vi-2*(AT_gammav1*AT_gammav2)^(1/2);
// Derivative of transaction cost
AT_gammavider = AT_gammav1-AT_gammav2*AT_vi^(-2);
AT_delta = AT_ii/AT_ki;
AT_gammai = 0;
AT_gammaider = 0;
AT_gammau = 0;
AT_gammauder = ((AT_beta^(-1)-1+AT_delta)*AT_qbar-AT_delta*AT_taukbar*AT_pibar)/((1-AT_taukbar)*AT_pibar);
AT_u = 1;
AT_pi = AT_q;
// Auxiliary equation for Tobin's Q in steady state
AT_qbar = AT_q;
// Rate of return on capital
AT_q = AT_beta*((1-AT_tauk)*AT_rk+(AT_tauk*AT_delta)*AT_pi+(1-AT_delta)*AT_q);
// Optimal wage contract (FOC)
AT_witilde^(1+AT_etai*AT_zeta) = AT_etai/(AT_etai-1)*AT_fi/AT_gi+AT_wcst;
// Definition of fi
AT_fi = AT_wi^(AT_etai*(1+AT_zeta))*AT_ndi^(1+AT_zeta)+AT_xii*AT_beta*(AT_pic(+1)/(AT_pic^AT_chii*AT_pi4target^(1/4*(1-AT_chii))))^(AT_etai*(1+AT_zeta))*AT_fi(+1);
// Definition of gi
AT_gi = AT_lambdai*(1-AT_taun-AT_tauwh)*AT_wi^AT_etai*AT_ndi+AT_xii*AT_beta*(AT_pic(+1)/(AT_pic^AT_chii*AT_pi4target^(1/4*(1-AT_chii))))^(AT_etai-1)*AT_gi(+1);
// Aggregate wage rate
AT_wi^(1-AT_etai) = (1-AT_xii)*AT_witilde^(1-AT_etai)+AT_xii*AT_wi(-1)^(1-AT_etai)*(AT_pic(-1)^AT_chii*AT_pi4target^(1/4*(1-AT_chii))/AT_pic)^(1-AT_etai);
//-------------
// Household J
//-------------
AT_ccesj^(1-1/AT_mucces) = (AT_nucces)^(1/AT_mucces)*AT_cj^(1-1/AT_mucces)+(1-AT_nucces)^(1/AT_mucces)*AT_cg^(1-1/AT_mucces);
// Utility
AT_utilj = 
AT_zcon*log(AT_ccesj-AT_kappa*AT_ccesj(-1))-1/(1+AT_zeta)*(AT_nj)^(1+AT_zeta)+AT_beta*AT_utilj(+1)
;
// Marginal utility of consumption
AT_dccj = ((AT_nucces)^(1/AT_mucces)*AT_cj^(1-1/AT_mucces)+(1-AT_nucces)^(1/AT_mucces)*AT_cg^(1-1/AT_mucces))^(1/(AT_mucces-1))*(AT_nucces^(1/AT_mucces))*(AT_cj^(-1/AT_mucces));
AT_lambdaj*(1+AT_tauc+AT_gammavj+AT_vj*AT_gammavjder) = AT_zcon*(AT_ccesj-AT_kappa*AT_ccesj(-1))^(-AT_sigma)*AT_dccj;
// Budget constraint
(1+AT_tauc+AT_gammavj)*AT_cj+AT_mj = (1-AT_taun-AT_tauwh)*AT_wj*AT_nj+AT_trj-AT_tj+AT_mj(-1)*AT_pic^(-1);
// Euler equation for money
AT_vj^(2)*AT_gammavjder = 1-AT_beta*AT_lambdaj(+1)/(AT_lambdaj*AT_pic(+1));
// Consumption-based velocity
AT_vj = AT_cj/AT_mj;
// Transaction technology
AT_gammavj = AT_gammav1*AT_vj+AT_gammav2/AT_vj-2*(AT_gammav1*AT_gammav2)^(1/2);
// Derivative of transaction technology
AT_gammavjder = AT_gammav1-AT_gammav2*AT_vj^(-2);
// Optimal wage contract (FOC)
AT_wjtilde^(1+AT_etaj*AT_zeta) = AT_etaj/(AT_etaj-1)*AT_fj/AT_gj+AT_wcst;
// Definition of fj
AT_fj = AT_wj^(AT_etaj*(1+AT_zeta))*AT_ndj^(1+AT_zeta)+AT_xij*AT_beta*(AT_pic(+1)/(AT_pic^AT_chij*AT_pi4target^(1/4*(1-AT_chij))))^(AT_etaj*(1+AT_zeta))*AT_fj(+1);
// Definition of gj
AT_gj = AT_lambdaj*(1-AT_taun-AT_tauwh)*AT_wj^AT_etaj*AT_ndj+AT_xij*AT_beta*(AT_pic(+1)/(AT_pic^AT_chij*AT_pi4target^(1/4*(1-AT_chij))))^(AT_etaj-1)*AT_gj(+1);
// Aggregate wage rate
AT_wj^(1-AT_etaj) = (1-AT_xij)*AT_wjtilde^(1-AT_etaj)+AT_xij*AT_wj(-1)^(1-AT_etaj)*(AT_pic(-1)^AT_chij*AT_pi4target^(1/4*(1-AT_chij))/AT_pic)^(1-AT_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
AT_kg = (1-AT_deltag)*AT_kg(-1)+AT_ig(-1);
// Production function tradable
AT_yst = EA_z*AT_zt*AT_kg^AT_alphag*AT_kdt^AT_alphat*AT_ndt^(1-AT_alphat)-AT_psitbar;
// Production function nontradable
AT_ysn = EA_z*AT_zn*AT_kg^AT_alphag*AT_kdn^AT_alphan*AT_ndn^(1-AT_alphan)-AT_psinbar;
// Real marginal cost tradable
AT_mct = 1/(EA_z*AT_zt*AT_kg^AT_alphag*(AT_alphat)^(AT_alphat)*(1-AT_alphat)^(1-AT_alphat))*AT_rk^(AT_alphat)*((1+AT_tauwf)*AT_w)^(1-AT_alphat);
// Real marginal cost nontradable
AT_mcn = 1/(EA_z*AT_zn*AT_kg^AT_alphag*(AT_alphan)^(AT_alphan)*(1-AT_alphan)^(1-AT_alphan))*AT_rk^(AT_alphan)*((1+AT_tauwf)*AT_w)^(1-AT_alphan);
// Wage Inflation (qoq)
AT_piw = AT_w/AT_w(-1)*AT_pic;
// Wage Inflation (yoy)
AT_piw4 = AT_pic4;
// Auxiliary equation for steady-state fixed cost
AT_psitbar = AT_psit*AT_ytbar;
// Auxiliary equation for steady-state fixed cost
AT_psinbar = AT_psin*AT_ynbar;
// Capital input (FOC)
AT_rk = AT_alphat*(AT_yst+AT_psitbar)/AT_kdt*AT_mct;
// Capital input (FOC)
AT_rk = AT_alphan*(AT_ysn+AT_psinbar)/AT_kdn*AT_mcn;
// Total capital demand
AT_kd = AT_kdt+AT_kdn;
// Demand for labour services by household I
AT_ndi = 
(1-AT_omega)*(AT_wi/AT_w)^(-AT_eta)*AT_nd
;
// Demand for labour services by household J
AT_ndj = 
AT_omega*(AT_wj/AT_w)^(-AT_eta)*AT_nd
;
// Aggregate labour demand
AT_nd^(1-1/AT_eta) = 
(1-AT_omega)^(1/AT_eta)*AT_ndi^(1-1/AT_eta)+AT_omega^(1/AT_eta)*AT_ndj^(1-1/AT_eta)
;
// Total demand 
AT_nd = AT_ndt+AT_ndn;
// Aggregate dividends
AT_d = AT_py*AT_y-AT_rk*AT_kd-(1+AT_tauwf)*AT_w*AT_nd;
// Non-tradable sector dividends
AT_dn = AT_pnt*AT_ysn-AT_rk*AT_kdn-(1+AT_tauwf)*AT_w*AT_ndn;
// Tradable sector dividends
AT_dt = AT_pht*AT_ht
+AT_pex*AT_ex
-AT_rk*AT_kdt-(1+AT_tauwf)*AT_w*AT_ndt;
// Optimal price contract set in domestic markets (FOC)
AT_phttilde/AT_pht = AT_thetat/(AT_thetat-1)*AT_fh/AT_gh;
// Definition of fh
AT_fh = AT_mct*AT_ht+AT_xih*AT_beta*AT_lambdai(+1)/AT_lambdai*(AT_piht(+1)/(AT_piht^AT_chih*AT_pi4target^(1/4*(1-AT_chih))))^AT_thetat*AT_fh(+1);
// Definition of gh
AT_gh = AT_pht*AT_ht+AT_xih*AT_beta*AT_lambdai(+1)/AT_lambdai*(AT_piht(+1)/(AT_piht^AT_chih*AT_pi4target^(1/4*(1-AT_chih))))^(AT_thetat-1)*AT_gh(+1);
// Aggregate intermediate-good price dynamics
AT_pht^(1-AT_thetat) = (1-AT_xih)*AT_phttilde^(1-AT_thetat)+AT_xih*(AT_pht(-1)/AT_pic)^(1-AT_thetat)*(AT_piht(-1)^AT_chih*AT_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation
AT_piht = AT_pht/AT_pht(-1)*AT_pic;
// Optimal price contract set in domestic markets (FOC)
AT_pnttilde/AT_pnt = AT_thetan/(AT_thetan-1)*AT_fn/AT_gn;
// Definition of fn
AT_fn = AT_mcn*AT_nt+AT_xin*AT_beta*AT_lambdai(+1)/AT_lambdai*(AT_pint(+1)/(AT_pint^AT_chin*AT_pi4target^(1/4*(1-AT_chin))))^AT_thetan*AT_fn(+1);
// Definition of gn
AT_gn = AT_pnt*AT_nt+AT_xin*AT_beta*AT_lambdai(+1)/AT_lambdai*(AT_pint(+1)/(AT_pint^AT_chin*AT_pi4target^(1/4*(1-AT_chin))))^(AT_thetan-1)*AT_gn(+1);
// Aggregate intermediate-good price dynamics
AT_pnt^(1-AT_thetan) = (1-AT_xin)*AT_pnttilde^(1-AT_thetan)+AT_xin*(AT_pnt(-1)/AT_pic)^(1-AT_thetan)*(AT_pint(-1)^AT_chin*AT_pi4target^(1/4*(1-AT_chin)))^(1-AT_thetan);
// Intermediate-good price inflation
AT_pint = AT_pnt/AT_pnt(-1)*AT_pic;
// Optimal price contract set in domestic markets (FOC)
AT_pextilde/AT_pex = AT_thetat/(AT_thetat-1)*AT_fx/AT_gx;
// Definition of fh
AT_fx = AT_mct*AT_ex+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(AT_piex(+1)/(AT_piex^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*AT_fx(+1);
// Definition of gh
AT_gx = AT_pex*AT_ex+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(AT_piex(+1)/(AT_piex^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*AT_gx(+1);
// Aggregate intermediate-good price dynamics
AT_pex^(1-AT_thetat) = (1-AT_xix)*AT_pextilde^(1-AT_thetat)+AT_xix*(AT_pex(-1)/AT_pic)^(1-AT_thetat)*(AT_piex(-1)^AT_chix*AT_pi4target^(1/4*(1-AT_chix)))^(1-AT_thetat);
// Intermediate-good price inflation
AT_piex = AT_pex/AT_pex(-1)*AT_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = RA_pimtilde
// RAAT_pimtilde/RAAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATRA_fx/ATRA_gx;
// Definition of fx
// ATRA_fx = RA_size/AT_size*RAAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(RAAT_piim(+1)/(RAAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATRA_fx(+1);
// Definition of gx   
// ATRA_gx = ATRA_rer*RAAT_pim*RA_size/AT_size*RAAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(RAAT_piim(+1)/(RAAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATRA_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = RA_pim
// RAAT_pim^(1-AT_thetat) = (1-AT_xix)*RAAT_pimtilde^(1-AT_thetat)+AT_xix*(RAAT_pim(-1)/RA_pic)^(1-AT_thetat)*(RAAT_piim(-1)^AT_chix*RA_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = RA_piim
// RAAT_piim = RAAT_pim/RAAT_pim(-1)*RA_pic;
// Bilateral real exchange rate
ATRA_rer = AT_rer/RA_rer;
// Auxiliary equation for steady-state output
ATRA_rerbar = ATRA_rer;
//Terms of Trade
ATRA_tot = RA_pex*ATRA_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = BE_pimtilde
// BEAT_pimtilde/BEAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATBE_fx/ATBE_gx;
// Definition of fx
// ATBE_fx = BE_size/AT_size*BEAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(BEAT_piim(+1)/(BEAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATBE_fx(+1);
// Definition of gx   
// ATBE_gx = ATBE_rer*BEAT_pim*BE_size/AT_size*BEAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(BEAT_piim(+1)/(BEAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATBE_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = BE_pim
// BEAT_pim^(1-AT_thetat) = (1-AT_xix)*BEAT_pimtilde^(1-AT_thetat)+AT_xix*(BEAT_pim(-1)/BE_pic)^(1-AT_thetat)*(BEAT_piim(-1)^AT_chix*BE_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = BE_piim
// BEAT_piim = BEAT_pim/BEAT_pim(-1)*BE_pic;
// Bilateral real exchange rate
ATBE_rer = AT_rer/BE_rer;
// Auxiliary equation for steady-state output
ATBE_rerbar = ATBE_rer;
//Terms of Trade
ATBE_tot = BE_pex*ATBE_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = ES_pimtilde
// ESAT_pimtilde/ESAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATES_fx/ATES_gx;
// Definition of fx
// ATES_fx = ES_size/AT_size*ESAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(ESAT_piim(+1)/(ESAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATES_fx(+1);
// Definition of gx   
// ATES_gx = ATES_rer*ESAT_pim*ES_size/AT_size*ESAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(ESAT_piim(+1)/(ESAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATES_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = ES_pim
// ESAT_pim^(1-AT_thetat) = (1-AT_xix)*ESAT_pimtilde^(1-AT_thetat)+AT_xix*(ESAT_pim(-1)/ES_pic)^(1-AT_thetat)*(ESAT_piim(-1)^AT_chix*ES_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = ES_piim
// ESAT_piim = ESAT_pim/ESAT_pim(-1)*ES_pic;
// Bilateral real exchange rate
ATES_rer = AT_rer/ES_rer;
// Auxiliary equation for steady-state output
ATES_rerbar = ATES_rer;
//Terms of Trade
ATES_tot = ES_pex*ATES_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = FI_pimtilde
// FIAT_pimtilde/FIAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATFI_fx/ATFI_gx;
// Definition of fx
// ATFI_fx = FI_size/AT_size*FIAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(FIAT_piim(+1)/(FIAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATFI_fx(+1);
// Definition of gx   
// ATFI_gx = ATFI_rer*FIAT_pim*FI_size/AT_size*FIAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(FIAT_piim(+1)/(FIAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATFI_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = FI_pim
// FIAT_pim^(1-AT_thetat) = (1-AT_xix)*FIAT_pimtilde^(1-AT_thetat)+AT_xix*(FIAT_pim(-1)/FI_pic)^(1-AT_thetat)*(FIAT_piim(-1)^AT_chix*FI_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = FI_piim
// FIAT_piim = FIAT_pim/FIAT_pim(-1)*FI_pic;
// Bilateral real exchange rate
ATFI_rer = AT_rer/FI_rer;
// Auxiliary equation for steady-state output
ATFI_rerbar = ATFI_rer;
//Terms of Trade
ATFI_tot = FI_pex*ATFI_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = FR_pimtilde
// FRAT_pimtilde/FRAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATFR_fx/ATFR_gx;
// Definition of fx
// ATFR_fx = FR_size/AT_size*FRAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(FRAT_piim(+1)/(FRAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATFR_fx(+1);
// Definition of gx   
// ATFR_gx = ATFR_rer*FRAT_pim*FR_size/AT_size*FRAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(FRAT_piim(+1)/(FRAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATFR_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = FR_pim
// FRAT_pim^(1-AT_thetat) = (1-AT_xix)*FRAT_pimtilde^(1-AT_thetat)+AT_xix*(FRAT_pim(-1)/FR_pic)^(1-AT_thetat)*(FRAT_piim(-1)^AT_chix*FR_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = FR_piim
// FRAT_piim = FRAT_pim/FRAT_pim(-1)*FR_pic;
// Bilateral real exchange rate
ATFR_rer = AT_rer/FR_rer;
// Auxiliary equation for steady-state output
ATFR_rerbar = ATFR_rer;
//Terms of Trade
ATFR_tot = FR_pex*ATFR_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = GR_pimtilde
// GRAT_pimtilde/GRAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATGR_fx/ATGR_gx;
// Definition of fx
// ATGR_fx = GR_size/AT_size*GRAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(GRAT_piim(+1)/(GRAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATGR_fx(+1);
// Definition of gx   
// ATGR_gx = ATGR_rer*GRAT_pim*GR_size/AT_size*GRAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(GRAT_piim(+1)/(GRAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATGR_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = GR_pim
// GRAT_pim^(1-AT_thetat) = (1-AT_xix)*GRAT_pimtilde^(1-AT_thetat)+AT_xix*(GRAT_pim(-1)/GR_pic)^(1-AT_thetat)*(GRAT_piim(-1)^AT_chix*GR_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = GR_piim
// GRAT_piim = GRAT_pim/GRAT_pim(-1)*GR_pic;
// Bilateral real exchange rate
ATGR_rer = AT_rer/GR_rer;
// Auxiliary equation for steady-state output
ATGR_rerbar = ATGR_rer;
//Terms of Trade
ATGR_tot = GR_pex*ATGR_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = IT_pimtilde
// ITAT_pimtilde/ITAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATIT_fx/ATIT_gx;
// Definition of fx
// ATIT_fx = IT_size/AT_size*ITAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(ITAT_piim(+1)/(ITAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATIT_fx(+1);
// Definition of gx   
// ATIT_gx = ATIT_rer*ITAT_pim*IT_size/AT_size*ITAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(ITAT_piim(+1)/(ITAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATIT_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = IT_pim
// ITAT_pim^(1-AT_thetat) = (1-AT_xix)*ITAT_pimtilde^(1-AT_thetat)+AT_xix*(ITAT_pim(-1)/IT_pic)^(1-AT_thetat)*(ITAT_piim(-1)^AT_chix*IT_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = IT_piim
// ITAT_piim = ITAT_pim/ITAT_pim(-1)*IT_pic;
// Bilateral real exchange rate
ATIT_rer = AT_rer/IT_rer;
// Auxiliary equation for steady-state output
ATIT_rerbar = ATIT_rer;
//Terms of Trade
ATIT_tot = IT_pex*ATIT_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = NL_pimtilde
// NLAT_pimtilde/NLAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATNL_fx/ATNL_gx;
// Definition of fx
// ATNL_fx = NL_size/AT_size*NLAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(NLAT_piim(+1)/(NLAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATNL_fx(+1);
// Definition of gx   
// ATNL_gx = ATNL_rer*NLAT_pim*NL_size/AT_size*NLAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(NLAT_piim(+1)/(NLAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATNL_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = NL_pim
// NLAT_pim^(1-AT_thetat) = (1-AT_xix)*NLAT_pimtilde^(1-AT_thetat)+AT_xix*(NLAT_pim(-1)/NL_pic)^(1-AT_thetat)*(NLAT_piim(-1)^AT_chix*NL_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = NL_piim
// NLAT_piim = NLAT_pim/NLAT_pim(-1)*NL_pic;
// Bilateral real exchange rate
ATNL_rer = AT_rer/NL_rer;
// Auxiliary equation for steady-state output
ATNL_rerbar = ATNL_rer;
//Terms of Trade
ATNL_tot = NL_pex*ATNL_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = PT_pimtilde
// PTAT_pimtilde/PTAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATPT_fx/ATPT_gx;
// Definition of fx
// ATPT_fx = PT_size/AT_size*PTAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(PTAT_piim(+1)/(PTAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATPT_fx(+1);
// Definition of gx   
// ATPT_gx = ATPT_rer*PTAT_pim*PT_size/AT_size*PTAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(PTAT_piim(+1)/(PTAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATPT_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = PT_pim
// PTAT_pim^(1-AT_thetat) = (1-AT_xix)*PTAT_pimtilde^(1-AT_thetat)+AT_xix*(PTAT_pim(-1)/PT_pic)^(1-AT_thetat)*(PTAT_piim(-1)^AT_chix*PT_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = PT_piim
// PTAT_piim = PTAT_pim/PTAT_pim(-1)*PT_pic;
// Bilateral real exchange rate
ATPT_rer = AT_rer/PT_rer;
// Auxiliary equation for steady-state output
ATPT_rerbar = ATPT_rer;
//Terms of Trade
ATPT_tot = PT_pex*ATPT_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = DE_pimtilde
// DEAT_pimtilde/DEAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATDE_fx/ATDE_gx;
// Definition of fx
// ATDE_fx = DE_size/AT_size*DEAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(DEAT_piim(+1)/(DEAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATDE_fx(+1);
// Definition of gx   
// ATDE_gx = ATDE_rer*DEAT_pim*DE_size/AT_size*DEAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(DEAT_piim(+1)/(DEAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATDE_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = DE_pim
// DEAT_pim^(1-AT_thetat) = (1-AT_xix)*DEAT_pimtilde^(1-AT_thetat)+AT_xix*(DEAT_pim(-1)/DE_pic)^(1-AT_thetat)*(DEAT_piim(-1)^AT_chix*DE_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = DE_piim
// DEAT_piim = DEAT_pim/DEAT_pim(-1)*DE_pic;
// Bilateral real exchange rate
ATDE_rer = AT_rer/DE_rer;
// Auxiliary equation for steady-state output
ATDE_rerbar = ATDE_rer;
//Terms of Trade
ATDE_tot = DE_pex*ATDE_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = RU_pimtilde
// RUAT_pimtilde/RUAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATRU_fx/ATRU_gx;
// Definition of fx
// ATRU_fx = RU_size/AT_size*RUAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(RUAT_piim(+1)/(RUAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATRU_fx(+1);
// Definition of gx   
// ATRU_gx = ATRU_rer*RUAT_pim*RU_size/AT_size*RUAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(RUAT_piim(+1)/(RUAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATRU_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = RU_pim
// RUAT_pim^(1-AT_thetat) = (1-AT_xix)*RUAT_pimtilde^(1-AT_thetat)+AT_xix*(RUAT_pim(-1)/RU_pic)^(1-AT_thetat)*(RUAT_piim(-1)^AT_chix*RU_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = RU_piim
// RUAT_piim = RUAT_pim/RUAT_pim(-1)*RU_pic;
// Bilateral real exchange rate
ATRU_rer = AT_rer/RU_rer;
// Auxiliary equation for steady-state output
ATRU_rerbar = ATRU_rer;
//Terms of Trade
ATRU_tot = RU_pex*ATRU_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = RW_pimtilde
// RWAT_pimtilde/RWAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATRW_fx/ATRW_gx;
// Definition of fx
// ATRW_fx = RW_size/AT_size*RWAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(RWAT_piim(+1)/(RWAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATRW_fx(+1);
// Definition of gx   
// ATRW_gx = ATRW_rer*RWAT_pim*RW_size/AT_size*RWAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(RWAT_piim(+1)/(RWAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATRW_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = RW_pim
// RWAT_pim^(1-AT_thetat) = (1-AT_xix)*RWAT_pimtilde^(1-AT_thetat)+AT_xix*(RWAT_pim(-1)/RW_pic)^(1-AT_thetat)*(RWAT_piim(-1)^AT_chix*RW_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = RW_piim
// RWAT_piim = RWAT_pim/RWAT_pim(-1)*RW_pic;
// Bilateral real exchange rate
ATRW_rer = AT_rer/RW_rer;
// Auxiliary equation for steady-state output
ATRW_rerbar = ATRW_rer;
//Terms of Trade
ATRW_tot = RW_pex*ATRW_rer/AT_pex;
// Optimal price contract set in foreign markets (FOC), using AT_pxtilde = US_pimtilde
// USAT_pimtilde/USAT_pim = AT_cpim*AT_thetat/(AT_thetat-1)*ATUS_fx/ATUS_gx;
// Definition of fx
// ATUS_fx = US_size/AT_size*USAT_im*AT_mct+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(USAT_piim(+1)/(USAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^AT_thetat*ATUS_fx(+1);
// Definition of gx   
// ATUS_gx = ATUS_rer*USAT_pim*US_size/AT_size*USAT_im+AT_xix*AT_beta*AT_lambdai(+1)/AT_lambdai*(USAT_piim(+1)/(USAT_piim^AT_chix*AT_pi4target^(1/4*(1-AT_chix))))^(AT_thetat-1)*ATUS_gx(+1);
// Aggregate intermediate-good price dynamics, using AT_px = US_pim
// USAT_pim^(1-AT_thetat) = (1-AT_xix)*USAT_pimtilde^(1-AT_thetat)+AT_xix*(USAT_pim(-1)/US_pic)^(1-AT_thetat)*(USAT_piim(-1)^AT_chix*US_pi4target^(1/4*(1-AT_chih)))^(1-AT_thetat);
// Intermediate-good price inflation, using AT_pix = US_piim
// USAT_piim = USAT_pim/USAT_pim(-1)*US_pic;
// Bilateral real exchange rate
ATUS_rer = AT_rer/US_rer;
// Auxiliary equation for steady-state output
ATUS_rerbar = ATUS_rer;
//Terms of Trade
ATUS_tot = US_pex*ATUS_rer/AT_pex;
// Total imports 
AT_im = 
+AT_imc
+AT_imi
+AT_imcg
+AT_imig
;
// Total import deflator
AT_im*AT_pim  = 
+AT_pimc*AT_imc
+AT_pimi*AT_imi
+AT_pimcg*AT_imcg
+AT_pimig*AT_imig
;
// Effective real exchange rate: double weighting (imports)
ATRA_weightim = ATRA_rer*RA_pex*ATRA_im/(AT_pim*AT_im);
// Effective real exchange rate: double weighting (exports)
ATRA_weightex = RA_size/AT_size*RAAT_im/AT_ex*ATRA_rer*RA_py*RA_y/(ATRA_rer*RA_py*RA_y
+ATBE_rer*BE_pex*RABE_im
+ATES_rer*ES_pex*RAES_im
+ATFI_rer*FI_pex*RAFI_im
+ATFR_rer*FR_pex*RAFR_im
+ATGR_rer*GR_pex*RAGR_im
+ATIT_rer*IT_pex*RAIT_im
+ATNL_rer*NL_pex*RANL_im
+ATPT_rer*PT_pex*RAPT_im
+ATDE_rer*DE_pex*RADE_im
+ATRU_rer*RU_pex*RARU_im
+ATRW_rer*RW_pex*RARW_im
+ATUS_rer*US_pex*RAUS_im
)+
+BE_size/AT_size*BEAT_im/AT_ex*ATRA_rer*RA_pex*BERA_im/(ATBE_rer*BE_py*BE_y
+ATRA_rer*RA_pex*BERA_im
+ATES_rer*ES_pex*BEES_im
+ATFI_rer*FI_pex*BEFI_im
+ATFR_rer*FR_pex*BEFR_im
+ATGR_rer*GR_pex*BEGR_im
