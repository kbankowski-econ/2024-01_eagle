// Trade balance
DE_tb =
+DE_pex*RA_size/DE_size*RADE_im
-RA_pex*DERA_rer*DERA_im
+DE_pex*AT_size/DE_size*ATDE_im
-AT_pex*DEAT_rer*DEAT_im
+DE_pex*BE_size/DE_size*BEDE_im
-BE_pex*DEBE_rer*DEBE_im
+DE_pex*ES_size/DE_size*ESDE_im
-ES_pex*DEES_rer*DEES_im
+DE_pex*FI_size/DE_size*FIDE_im
-FI_pex*DEFI_rer*DEFI_im
+DE_pex*FR_size/DE_size*FRDE_im
-FR_pex*DEFR_rer*DEFR_im
+DE_pex*GR_size/DE_size*GRDE_im
-GR_pex*DEGR_rer*DEGR_im
+DE_pex*IT_size/DE_size*ITDE_im
-IT_pex*DEIT_rer*DEIT_im
+DE_pex*NL_size/DE_size*NLDE_im
-NL_pex*DENL_rer*DENL_im
+DE_pex*PT_size/DE_size*PTDE_im
-PT_pex*DEPT_rer*DEPT_im
+DE_pex*RU_size/DE_size*RUDE_im
-RU_pex*DERU_rer*DERU_im
+DE_pex*RW_size/DE_size*RWDE_im
-RW_pex*DERW_rer*DERW_im
+DE_pex*US_size/DE_size*USDE_im
-US_pex*DEUS_rer*DEUS_im
;
// Aggregate exports (volume)
DE_ex =
+RA_size/DE_size*RADE_im
+AT_size/DE_size*ATDE_im
+BE_size/DE_size*BEDE_im
+ES_size/DE_size*ESDE_im
+FI_size/DE_size*FIDE_im
+FR_size/DE_size*FRDE_im
+GR_size/DE_size*GRDE_im
+IT_size/DE_size*ITDE_im
+NL_size/DE_size*NLDE_im
