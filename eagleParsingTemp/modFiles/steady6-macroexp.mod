+BEUS_rer*US_pex*FRUS_im
)
+GR_size/BE_size*GRBE_im/BE_ex*BERA_rer*RA_pex*GRRA_im/(BEGR_rer*GR_py*GR_y
+BERA_rer*RA_pex*GRRA_im
+BEAT_rer*AT_pex*GRAT_im
+BEES_rer*ES_pex*GRES_im
+BEFI_rer*FI_pex*GRFI_im
