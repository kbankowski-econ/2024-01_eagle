+RARW_rer*RW_pex*NLRW_im
+RAUS_rer*US_pex*NLUS_im
)
+PT_size/RA_size*PTRA_im/RA_ex*RARW_rer*RW_pex*PTRW_im/(RAPT_rer*PT_py*PT_y
+RAAT_rer*AT_pex*PTAT_im
