+ESDE_rer*DE_pex*USDE_im
+ESRU_rer*RU_pex*USRU_im
+ESRW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
ESRA_weight = ES_pim*ES_im/(ES_pim*ES_im+ES_pex*ES_ex)*ESRA_weightim+ES_pex*ES_ex/(ES_pim*ES_im+ES_pex*ES_ex)*ESRA_weightex;
// Effective real exchange rate: double weighting (imports)
ESAT_weightim = ESAT_rer*AT_pex*ESAT_im/(ES_pim*ES_im);
// Effective real exchange rate: double weighting (exports)
ESAT_weightex = AT_size/ES_size*ATES_im/ES_ex*ESAT_rer*AT_py*AT_y/(ESAT_rer*AT_py*AT_y
+ESRA_rer*RA_pex*ATRA_im
+ESBE_rer*BE_pex*ATBE_im
+ESFI_rer*FI_pex*ATFI_im
+ESFR_rer*FR_pex*ATFR_im
