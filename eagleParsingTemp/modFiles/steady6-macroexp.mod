-PTNL_numig
-PTDE_numig
-PTRU_numig
-PTRW_numig
-PTUS_numig
)*(IT_pex*PTIT_rer)^(1-PT_mumig);
// Private consumption good (import) inflation
PT_piimig = PT_pimig/PT_pimig(-1)*PT_pic;
// Private consumption good (import) inflation
PT_piimc4 = PT_pimc/PT_pimc(-4)*PT_pic4;
// Private consumption good (import) inflation
PT_piex4 = PT_pex/PT_pex(-4)*PT_pic4;
// Wedge between aggregate demand and production, using PT_x = DE_size/PT_size*DE_im
PT_yst = PT_sh*PT_ht+PT_sx*PT_ex;
// Aggregate demand for bilateral imported intermediate goods
PTRA_im = 
+PTRA_imc
+PTRA_imi
+PTRA_imcg
+PTRA_imig
;
PTAT_im = 
+PTAT_imc
