NLDE_imig = NLDE_numig*((DE_pex*NLDE_rer)/NL_pimig)^(-NL_mumig)*NL_imig;
// Demand for bilateral consumption import goods
NLRU_imig = NLRU_numig*((RU_pex*NLRU_rer)/NL_pimig)^(-NL_mumig)*NL_imig;
// Demand for bilateral consumption import goods
NLRW_imig = NLRW_numig*((RW_pex*NLRW_rer)/NL_pimig)^(-NL_mumig)*NL_imig;
// Demand for bilateral consumption import goods
NLUS_imig = NLUS_numig*((US_pex*NLUS_rer)/NL_pimig)^(-NL_mumig)*NL_imig;
NLGR_imig = (1
-NLRA_numig
-NLAT_numig
-NLBE_numig
-NLES_numig
-NLFI_numig
-NLFR_numig
-NLIT_numig
-NLPT_numig
-NLDE_numig
-NLRU_numig
-NLRW_numig
-NLUS_numig
)*((GR_pex*NLGR_rer)/NL_pimig)^(-NL_mumig)*NL_imig;
// Price of the consumption good (import)
NL_pimig^(1-NL_mumig) =
+NLRA_numig * (RA_pex*NLRA_rer)^(1-NL_mumig)
+NLAT_numig * (AT_pex*NLAT_rer)^(1-NL_mumig)
+NLBE_numig * (BE_pex*NLBE_rer)^(1-NL_mumig)
+NLES_numig * (ES_pex*NLES_rer)^(1-NL_mumig)
+NLFI_numig * (FI_pex*NLFI_rer)^(1-NL_mumig)
+NLFR_numig * (FR_pex*NLFR_rer)^(1-NL_mumig)
+NLIT_numig * (IT_pex*NLIT_rer)^(1-NL_mumig)
+NLPT_numig * (PT_pex*NLPT_rer)^(1-NL_mumig)
+NLDE_numig * (DE_pex*NLDE_rer)^(1-NL_mumig)
+NLRU_numig * (RU_pex*NLRU_rer)^(1-NL_mumig)
+NLRW_numig * (RW_pex*NLRW_rer)^(1-NL_mumig)
+NLUS_numig * (US_pex*NLUS_rer)^(1-NL_mumig)
+(1
-NLRA_numig
-NLAT_numig
-NLBE_numig
-NLES_numig
-NLFI_numig
-NLFR_numig
-NLIT_numig
-NLPT_numig
-NLDE_numig
-NLRU_numig
-NLRW_numig
-NLUS_numig
)*(GR_pex*NLGR_rer)^(1-NL_mumig);
// Private consumption good (import) inflation
NL_piimig = NL_pimig/NL_pimig(-1)*NL_pic;
// Private consumption good (import) inflation
NL_piimc4 = NL_pimc/NL_pimc(-4)*NL_pic4;
// Private consumption good (import) inflation
NL_piex4 = NL_pex/NL_pex(-4)*NL_pic4;
// Wedge between aggregate demand and production, using NL_x = PT_size/NL_size*PT_im
NL_yst = NL_sh*NL_ht+NL_sx*NL_ex;
// Aggregate demand for bilateral imported intermediate goods
NLRA_im = 
+NLRA_imc
+NLRA_imi
+NLRA_imcg
+NLRA_imig
;
NLAT_im = 
+NLAT_imc
+NLAT_imi
+NLAT_imcg
+NLAT_imig
;
NLBE_im = 
+NLBE_imc
+NLBE_imi
+NLBE_imcg
+NLBE_imig
;
NLES_im = 
+NLES_imc
+NLES_imi
+NLES_imcg
+NLES_imig
;
NLFI_im = 
+NLFI_imc
+NLFI_imi
+NLFI_imcg
+NLFI_imig
;
NLFR_im = 
+NLFR_imc
+NLFR_imi
+NLFR_imcg
+NLFR_imig
;
NLGR_im = 
+NLGR_imc
+NLGR_imi
+NLGR_imcg
+NLGR_imig
;
NLIT_im = 
+NLIT_imc
+NLIT_imi
+NLIT_imcg
+NLIT_imig
;
NLPT_im = 
+NLPT_imc
+NLPT_imi
+NLPT_imcg
+NLPT_imig
;
NLDE_im = 
+NLDE_imc
+NLDE_imi
+NLDE_imcg
+NLDE_imig
;
NLRU_im = 
+NLRU_imc
+NLRU_imi
+NLRU_imcg
+NLRU_imig
;
NLRW_im = 
+NLRW_imc
+NLRW_imi
+NLRW_imcg
+NLRW_imig
;
NLUS_im = 
+NLUS_imc
+NLUS_imi
+NLUS_imcg
+NLUS_imig
;
// Private consumption good firm
// Private consumption good (tradable)
NL_ttc^((NL_mutc-1)/NL_mutc) = (NL_nutc)^(1/NL_mutc)*NL_htc^(1-1/NL_mutc)+(1-NL_nutc)^(1/NL_mutc)*NL_imc^(1-1/NL_mutc);
// Private consumption good  (total)
NL_qc^((NL_muc-1)/NL_muc) = (NL_nuc)^(1/NL_muc)*NL_ttc^(1-1/NL_muc)+(1-NL_nuc)^(1/NL_muc)*NL_ntc^(1-1/NL_muc);
// Demand for domestic intermediate goods - NONTRADABLE
NL_ntc = (1-NL_nuc)*(NL_pnt)^(-NL_muc)*NL_qc;
// Price of the consumption good (tradable)  
NL_pttc^(1-NL_mutc) = (NL_nutc)*NL_pht^(1-NL_mutc)+(1-NL_nutc)*NL_pimc^(1-NL_mutc);
// Price of the consumption good 
1^(1-NL_muc) = (NL_nuc)*NL_pttc^(1-NL_muc)+(1-NL_nuc)*NL_pnt^(1-NL_muc);
// Demand for domestic intermediate goods
NL_htc = NL_nutc*(NL_pht/NL_pttc)^(-NL_mutc)*NL_ttc;
NLRA_gammaimc = 0;
NLRA_gammaimcdag = 1;
NLAT_gammaimc = 0;
NLAT_gammaimcdag = 1;
NLBE_gammaimc = 0;
NLBE_gammaimcdag = 1;
NLES_gammaimc = 0;
NLES_gammaimcdag = 1;
NLFI_gammaimc = 0;
NLFI_gammaimcdag = 1;
NLFR_gammaimc = 0;
NLFR_gammaimcdag = 1;
NLGR_gammaimc = 0;
NLGR_gammaimcdag = 1;
NLIT_gammaimc = 0;
NLIT_gammaimcdag = 1;
NLPT_gammaimc = 0;
NLPT_gammaimcdag = 1;
NLDE_gammaimc = 0;
NLDE_gammaimcdag = 1;
NLRU_gammaimc = 0;
NLRU_gammaimcdag = 1;
NLRW_gammaimc = 0;
NLRW_gammaimcdag = 1;
NLUS_gammaimc = 0;
NLUS_gammaimcdag = 1;
// Private consumption good (tradable)
NL_tti^((NL_muti-1)/NL_muti) = (NL_nuti)^(1/NL_muti)*NL_hti^(1-1/NL_muti)+(1-NL_nuti)^(1/NL_muti)*NL_imi^(1-1/NL_muti);
// Private consumption good  (total)
NL_qi^((NL_mui-1)/NL_mui) = (NL_nui)^(1/NL_mui)*NL_tti^(1-1/NL_mui)+(1-NL_nui)^(1/NL_mui)*NL_nti^(1-1/NL_mui);
// Demand for domestic intermediate goods - NONTRADABLE
NL_nti = (1-NL_nui)*(NL_pnt/NL_pi)^(-NL_mui)*NL_qi;
// Price of the consumption good (tradable)  
NL_ptti^(1-NL_muti) = (NL_nuti)*NL_pht^(1-NL_muti)+(1-NL_nuti)*NL_pimi^(1-NL_muti);
// Price of the consumption good 
NL_pi^(1-NL_mui) = (NL_nui)*NL_ptti^(1-NL_mui)+(1-NL_nui)*NL_pnt^(1-NL_mui);
// Auxiliary equation for the price of the investment good in steady state
// this only appears in the capacity utilisation cost; not needed for consumption where it is one by assumption; neither for gov demand components where there is no adjustment cost
NL_pibar = NL_pi;
// Demand for domestic intermediate goods
NL_hti = NL_nuti*(NL_pht/NL_ptti)^(-NL_muti)*NL_tti;
NLRA_gammaimi = 0;
NLRA_gammaimidag = 1;
NLAT_gammaimi = 0;
NLAT_gammaimidag = 1;
NLBE_gammaimi = 0;
NLBE_gammaimidag = 1;
NLES_gammaimi = 0;
NLES_gammaimidag = 1;
NLFI_gammaimi = 0;
NLFI_gammaimidag = 1;
NLFR_gammaimi = 0;
NLFR_gammaimidag = 1;
NLGR_gammaimi = 0;
NLGR_gammaimidag = 1;
NLIT_gammaimi = 0;
NLIT_gammaimidag = 1;
NLPT_gammaimi = 0;
NLPT_gammaimidag = 1;
NLDE_gammaimi = 0;
NLDE_gammaimidag = 1;
NLRU_gammaimi = 0;
NLRU_gammaimidag = 1;
NLRW_gammaimi = 0;
NLRW_gammaimidag = 1;
NLUS_gammaimi = 0;
NLUS_gammaimidag = 1;
// Private consumption good (tradable)
NL_ttcg^((NL_mutcg-1)/NL_mutcg) = (NL_nutcg)^(1/NL_mutcg)*NL_htcg^(1-1/NL_mutcg)+(1-NL_nutcg)^(1/NL_mutcg)*NL_imcg^(1-1/NL_mutcg);
// Private consumption good  (total)
NL_qcg^((NL_mucg-1)/NL_mucg) = (NL_nucg)^(1/NL_mucg)*NL_ttcg^(1-1/NL_mucg)+(1-NL_nucg)^(1/NL_mucg)*NL_ntcg^(1-1/NL_mucg);
// Demand for domestic intermediate goods - NONTRADABLE
NL_ntcg = (1-NL_nucg)*(NL_pnt/NL_pcg)^(-NL_mucg)*NL_qcg;
// Price of the consumption good (tradable)  
NL_pttcg^(1-NL_mutcg) = (NL_nutcg)*NL_pht^(1-NL_mutcg)+(1-NL_nutcg)*NL_pimcg^(1-NL_mutcg);
// Price of the consumption good 
NL_pcg^(1-NL_mucg) = (NL_nucg)*NL_pttcg^(1-NL_mucg)+(1-NL_nucg)*NL_pnt^(1-NL_mucg);
// Demand for domestic intermediate goods
NL_htcg = NL_nutcg*(NL_pht/NL_pttcg)^(-NL_mutcg)*NL_ttcg;
NLRA_gammaimcg = 0;
NLRA_gammaimcgdag = 1;
NLAT_gammaimcg = 0;
NLAT_gammaimcgdag = 1;
NLBE_gammaimcg = 0;
NLBE_gammaimcgdag = 1;
NLES_gammaimcg = 0;
NLES_gammaimcgdag = 1;
NLFI_gammaimcg = 0;
NLFI_gammaimcgdag = 1;
NLFR_gammaimcg = 0;
NLFR_gammaimcgdag = 1;
NLGR_gammaimcg = 0;
NLGR_gammaimcgdag = 1;
NLIT_gammaimcg = 0;
NLIT_gammaimcgdag = 1;
NLPT_gammaimcg = 0;
NLPT_gammaimcgdag = 1;
NLDE_gammaimcg = 0;
NLDE_gammaimcgdag = 1;
NLRU_gammaimcg = 0;
NLRU_gammaimcgdag = 1;
NLRW_gammaimcg = 0;
NLRW_gammaimcgdag = 1;
NLUS_gammaimcg = 0;
NLUS_gammaimcgdag = 1;
// Private consumption good (tradable)
NL_ttig^((NL_mutig-1)/NL_mutig) = (NL_nutig)^(1/NL_mutig)*NL_htig^(1-1/NL_mutig)+(1-NL_nutig)^(1/NL_mutig)*NL_imig^(1-1/NL_mutig);
// Private consumption good  (total)
NL_qig^((NL_muig-1)/NL_muig) = (NL_nuig)^(1/NL_muig)*NL_ttig^(1-1/NL_muig)+(1-NL_nuig)^(1/NL_muig)*NL_ntig^(1-1/NL_muig);
// Demand for domestic intermediate goods - NONTRADABLE
NL_ntig = (1-NL_nuig)*(NL_pnt/NL_pig)^(-NL_muig)*NL_qig;
// Price of the consumption good (tradable)  
NL_pttig^(1-NL_mutig) = (NL_nutig)*NL_pht^(1-NL_mutig)+(1-NL_nutig)*NL_pimig^(1-NL_mutig);
// Price of the consumption good 
NL_pig^(1-NL_muig) = (NL_nuig)*NL_pttig^(1-NL_muig)+(1-NL_nuig)*NL_pnt^(1-NL_muig);
// Demand for domestic intermediate goods
NL_htig = NL_nutig*(NL_pht/NL_pttig)^(-NL_mutig)*NL_ttig;
NLRA_gammaimig = 0;
NLRA_gammaimigdag = 1;
NLAT_gammaimig = 0;
NLAT_gammaimigdag = 1;
NLBE_gammaimig = 0;
NLBE_gammaimigdag = 1;
NLES_gammaimig = 0;
NLES_gammaimigdag = 1;
NLFI_gammaimig = 0;
NLFI_gammaimigdag = 1;
NLFR_gammaimig = 0;
NLFR_gammaimigdag = 1;
NLGR_gammaimig = 0;
NLGR_gammaimigdag = 1;
NLIT_gammaimig = 0;
NLIT_gammaimigdag = 1;
NLPT_gammaimig = 0;
NLPT_gammaimigdag = 1;
NLDE_gammaimig = 0;
NLDE_gammaimigdag = 1;
NLRU_gammaimig = 0;
NLRU_gammaimigdag = 1;
NLRW_gammaimig = 0;
NLRW_gammaimigdag = 1;
NLUS_gammaimig = 0;
NLUS_gammaimigdag = 1;
// Trade balance
NL_tb =
+NL_pex*RA_size/NL_size*RANL_im
-RA_pex*NLRA_rer*NLRA_im
+NL_pex*AT_size/NL_size*ATNL_im
-AT_pex*NLAT_rer*NLAT_im
+NL_pex*BE_size/NL_size*BENL_im
-BE_pex*NLBE_rer*NLBE_im
+NL_pex*ES_size/NL_size*ESNL_im
-ES_pex*NLES_rer*NLES_im
+NL_pex*FI_size/NL_size*FINL_im
-FI_pex*NLFI_rer*NLFI_im
+NL_pex*FR_size/NL_size*FRNL_im
-FR_pex*NLFR_rer*NLFR_im
+NL_pex*GR_size/NL_size*GRNL_im
-GR_pex*NLGR_rer*NLGR_im
+NL_pex*IT_size/NL_size*ITNL_im
-IT_pex*NLIT_rer*NLIT_im
+NL_pex*PT_size/NL_size*PTNL_im
-PT_pex*NLPT_rer*NLPT_im
+NL_pex*DE_size/NL_size*DENL_im
-DE_pex*NLDE_rer*NLDE_im
+NL_pex*RU_size/NL_size*RUNL_im
-RU_pex*NLRU_rer*NLRU_im
+NL_pex*RW_size/NL_size*RWNL_im
-RW_pex*NLRW_rer*NLRW_im
+NL_pex*US_size/NL_size*USNL_im
-US_pex*NLUS_rer*NLUS_im
;
// Aggregate exports (volume)
NL_ex =
+RA_size/NL_size*RANL_im
+AT_size/NL_size*ATNL_im
+BE_size/NL_size*BENL_im
+ES_size/NL_size*ESNL_im
+FI_size/NL_size*FINL_im
+FR_size/NL_size*FRNL_im
+GR_size/NL_size*GRNL_im
+IT_size/NL_size*ITNL_im
+PT_size/NL_size*PTNL_im
+DE_size/NL_size*DENL_im
+RU_size/NL_size*RUNL_im
+RW_size/NL_size*RWNL_im
+US_size/NL_size*USNL_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using NL_pg = NL_pht
// TODO: check the (1-NL_gammab(-1)) adjustment here, which is not in the fiscal extention
	NL_pcg(-1)*NL_cg(-1)+NL_pig(-1)*NL_ig(-1)+NL_tr(-1)
	+NL_b(-1)*NL_pic(-1)^(-1)+NL_m(-2)*NL_pic(-1)^(-1) = NL_tauc(-1)*NL_c(-1)+(NL_taun(-1)+NL_tauwh(-1))*(NL_wi(-1)*NL_ndi(-1)+NL_wj(-1)*NL_ndj(-1))+NL_tauwf(-1)*NL_w(-1)*NL_nd(-1)+NL_tauk(-1)*(NL_rk(-1)*NL_u(-1)-(NL_gammau(-1)+NL_delta)*NL_pi(-1))*NL_k(-1)+NL_taud(-1)*NL_d(-1)+NL_t(-1)+(NL_r(-1)*(1-NL_gammab(-1)))^(-1)*NL_b+NL_m(-1);
// Government spending, using NL_pg = NL_pht
NL_pcg*NL_cg = NL_cgy*NL_pybar*NL_ybar;
NL_pig*NL_ig = NL_igy*NL_pybar*NL_ybar;
NL_t = 0;
NL_b = NL_bytarget*NL_pybar*NL_ybar;
// Auxiliary equation for steady-state output
NL_ybar = NL_y;
// Auxiliary equation for steady-state output
NL_ytbar = NL_yst;
// Auxiliary equation for steady-state output
NL_ynbar = NL_ysn;
// Auxiliary equation for steady-state output deflator
NL_pybar = NL_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
NL_trybar = NL_tr/(NL_pybar*NL_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
NL_ti = NL_upsilont*NL_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
NL_tri = NL_upsilontr*NL_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	NL_r = DE_r;
NL_pic4 = NL_pi4target;
NL_rr-1 = NL_r/NL_pi4target^(1/4)-1;
// Equilibrium real interest rate
NL_rrstar-1 = 1/NL_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
NL_c = (1-NL_omega)*NL_ci+NL_omega*NL_cj;
// Aggregate money holdings
NL_m = (1-NL_omega)*NL_mi+NL_omega*NL_mj;
// Aggregate capital stock
NL_k = (1-NL_omega)*NL_ki;
// Aggregate investment
NL_i = (1-NL_omega)*NL_ii;
// Aggregate lump-sum transfers
NL_trj = 
1/NL_omega*NL_tr-(1-NL_omega)/NL_omega*NL_tri
;
// Aggregate lump-sum taxes
NL_tj = 
1/NL_omega*NL_t-(1-NL_omega)/NL_omega*NL_ti
;
// Aggregate transaction costs
NL_gammav = (1-NL_omega)*NL_ci*NL_gammavi+NL_omega*NL_cj*NL_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
NL_ni = NL_si*NL_ndi;
// Wage dispersion
NL_si = (1-NL_xii)*(NL_witilde/NL_wi)^(-NL_etai)+NL_xii*(NL_wi(-1)/NL_wi)^(-NL_etai)*(NL_pic/(NL_pic(-1)^NL_chii*NL_pi4target^(1/4*(1-NL_chii))))^(NL_etai)*NL_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
NL_nj = NL_sj*NL_ndj;
// Wage dispersion
NL_sj = (1-NL_xij)*(NL_wjtilde/NL_wj)^(-NL_etaj)+NL_xij*(NL_wj(-1)/NL_wj)^(-NL_etaj)*(NL_pic/(NL_pic(-1)^NL_chij*NL_pi4target^(1/4*(1-NL_chij))))^(NL_etaj)*NL_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
NL_u*NL_k = NL_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using NL_x = PT_size/NL_size*PT_im
NL_ysn = NL_snt*NL_nt;
//  nontradables aggregate demand
NL_nt = 
+NL_ntc
+NL_nti
+NL_ntcg
+NL_ntig
;
// Aggregate demand for domestic intermediate goods, using NL_hg = NL_cg
NL_ht =
+NL_htc
+NL_hti
+NL_htcg
+NL_htig
;
// Price dispersion in the domestic markets
NL_sh = (1-NL_xih)*(NL_phttilde/NL_pht)^(-NL_thetat)+NL_xih*(NL_piht/(NL_piht(-1)^NL_chih*NL_pi4target^(1/4*(1-NL_chih))))^NL_thetat*NL_sh(-1);
// Price dispersion in the foreign markets
NL_sx = (1-NL_xix)*(NL_pextilde/NL_pex)^(-NL_thetat)+NL_xix*(NL_piex/(NL_piex(-1)^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NL_sx(-1);
// Price dispersion in the domestic markets
NL_snt = (1-NL_xin)*(NL_pnttilde/NL_pnt)^(-NL_thetan)+NL_xin*(NL_pint/(NL_pint(-1)^NL_chin*NL_pi4target^(1/4*(1-NL_chin))))^NL_thetan*NL_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
NL_qc = NL_c+NL_gammav;
// Aggregate investment and capital utilisation cost
NL_qi = NL_i+NL_k*NL_gammau;
// Aggregate gov demand components added to use the same structure like in private components
NL_qcg = NL_cg;
NL_qig = NL_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
NL_py*NL_y = 
+NL_qc
+NL_pi*NL_qi
+NL_pcg*NL_qcg
+NL_pig*NL_qig
+NL_pex*RA_size/NL_size*RANL_im
-(RA_pex*NLRA_rer)*NLRA_imc
-(RA_pex*NLRA_rer)*NLRA_imi
-(RA_pex*NLRA_rer)*NLRA_imcg
-(RA_pex*NLRA_rer)*NLRA_imig
+NL_pex*AT_size/NL_size*ATNL_im
-(AT_pex*NLAT_rer)*NLAT_imc
-(AT_pex*NLAT_rer)*NLAT_imi
-(AT_pex*NLAT_rer)*NLAT_imcg
-(AT_pex*NLAT_rer)*NLAT_imig
+NL_pex*BE_size/NL_size*BENL_im
-(BE_pex*NLBE_rer)*NLBE_imc
-(BE_pex*NLBE_rer)*NLBE_imi
-(BE_pex*NLBE_rer)*NLBE_imcg
-(BE_pex*NLBE_rer)*NLBE_imig
+NL_pex*ES_size/NL_size*ESNL_im
-(ES_pex*NLES_rer)*NLES_imc
-(ES_pex*NLES_rer)*NLES_imi
-(ES_pex*NLES_rer)*NLES_imcg
-(ES_pex*NLES_rer)*NLES_imig
+NL_pex*FI_size/NL_size*FINL_im
-(FI_pex*NLFI_rer)*NLFI_imc
-(FI_pex*NLFI_rer)*NLFI_imi
-(FI_pex*NLFI_rer)*NLFI_imcg
-(FI_pex*NLFI_rer)*NLFI_imig
+NL_pex*FR_size/NL_size*FRNL_im
-(FR_pex*NLFR_rer)*NLFR_imc
-(FR_pex*NLFR_rer)*NLFR_imi
-(FR_pex*NLFR_rer)*NLFR_imcg
-(FR_pex*NLFR_rer)*NLFR_imig
+NL_pex*GR_size/NL_size*GRNL_im
-(GR_pex*NLGR_rer)*NLGR_imc
-(GR_pex*NLGR_rer)*NLGR_imi
-(GR_pex*NLGR_rer)*NLGR_imcg
-(GR_pex*NLGR_rer)*NLGR_imig
+NL_pex*IT_size/NL_size*ITNL_im
-(IT_pex*NLIT_rer)*NLIT_imc
-(IT_pex*NLIT_rer)*NLIT_imi
-(IT_pex*NLIT_rer)*NLIT_imcg
-(IT_pex*NLIT_rer)*NLIT_imig
+NL_pex*PT_size/NL_size*PTNL_im
-(PT_pex*NLPT_rer)*NLPT_imc
-(PT_pex*NLPT_rer)*NLPT_imi
-(PT_pex*NLPT_rer)*NLPT_imcg
-(PT_pex*NLPT_rer)*NLPT_imig
+NL_pex*DE_size/NL_size*DENL_im
-(DE_pex*NLDE_rer)*NLDE_imc
-(DE_pex*NLDE_rer)*NLDE_imi
-(DE_pex*NLDE_rer)*NLDE_imcg
-(DE_pex*NLDE_rer)*NLDE_imig
+NL_pex*RU_size/NL_size*RUNL_im
-(RU_pex*NLRU_rer)*NLRU_imc
-(RU_pex*NLRU_rer)*NLRU_imi
-(RU_pex*NLRU_rer)*NLRU_imcg
-(RU_pex*NLRU_rer)*NLRU_imig
+NL_pex*RW_size/NL_size*RWNL_im
-(RW_pex*NLRW_rer)*NLRW_imc
-(RW_pex*NLRW_rer)*NLRW_imi
-(RW_pex*NLRW_rer)*NLRW_imcg
-(RW_pex*NLRW_rer)*NLRW_imig
+NL_pex*US_size/NL_size*USNL_im
-(US_pex*NLUS_rer)*NLUS_imc
-(US_pex*NLUS_rer)*NLUS_imi
-(US_pex*NLUS_rer)*NLUS_imcg
-(US_pex*NLUS_rer)*NLUS_imig
;
// Aggregate real demand
NL_y = NL_yst+NL_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(NL_zt) = (1-NL_rhozt)*log(NL_ztbar)+NL_rhozt*log(NL_zt(-1))+NL_epszt;
log(NL_zn) = (1-NL_rhozn)*log(NL_znbar)+NL_rhozn*log(NL_zn(-1))+NL_epszn;
// Government spending shock
NL_cgy = (1-NL_rhocg)*NL_cgybar+NL_rhocg*NL_cgy(-1)+NL_epsgc;
NL_igy = (1-NL_rhoig)*NL_igybar+NL_rhoig*NL_igy(-1)+NL_epsgi;
// Transfer shock
NL_try = (1-NL_rhotr)*NL_trybar+NL_rhotr*NL_try(-1)+NL_epstr;
// Consumption tax shock
NL_tauc = (1-NL_rhotauc)*NL_taucbar+NL_rhotauc*NL_tauc(-1)+NL_epstauc;
// Dividend income tax shock
NL_taud = (1-NL_rhotaud)*NL_taudbar+NL_rhotaud*NL_taud(-1)+NL_epstaud;
// Capital income tax shock
NL_tauk = (1-NL_rhotauk)*NL_taukbar+NL_rhotauk*NL_tauk(-1)+NL_epstauk;
// Labour income tax shock
NL_taun = (1-NL_rhotaun)*NL_taunbar+NL_rhotaun*NL_taun(-1)+NL_epstaun;
// Payroll tax shock: households
NL_tauwh = (1-NL_rhotauwh)*NL_tauwhbar+NL_rhotauwh*NL_tauwh(-1)+NL_epstauwh;
// Payroll tax shock: firms
NL_tauwf = (1-NL_rhotauwf)*NL_tauwfbar+NL_rhotauwf*NL_tauwf(-1)+NL_epstauwf;
// Wage cost push shock
NL_wcst = (1-NL_rhowcst)*NL_wcstbar+NL_rhowcst*NL_wcst(-1)+NL_epswcst;
// Preference shock
log(NL_zcon) = (1-NL_rhozcon)*log(NL_zconbar)+NL_rhozcon*log(NL_zcon(-1))+NL_epszcon;
// Investment specific shock
log(NL_zinv) = (1-NL_rhozinv)*log(NL_zinvbar)+NL_rhozinv*log(NL_zinv(-1))+NL_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
NL_cy = NL_c/(NL_py*NL_y);
// Aggregate nominal investment share
NL_iy = NL_pi*NL_i/(NL_py*NL_y);
// Aggregate nominal import share  
NL_imy = (
+NL_pimc*NL_imc
+NL_pimi*NL_imi
+NL_pimcg*NL_imcg
+NL_pimig*NL_imig
)/(NL_py*NL_y);
// Aggregate nominal import share
NL_imcy = NL_pimc*NL_imc/(NL_py*NL_y);
NL_imiy = NL_pimi*NL_imi/(NL_py*NL_y);
NL_imcgy = NL_pimcg*NL_imcg/(NL_py*NL_y);
NL_imigy = NL_pimig*NL_imig/(NL_py*NL_y);
// Aggregate debt-to-output ratio
NL_by = NL_b/(NL_pybar*NL_ybar);
// Aggregate lump-sum tax-to-output ratio
NL_ty = NL_t/(NL_pybar*NL_ybar);
// Aggregate labour cost share
NL_lcy = ((1+NL_tauwf)*NL_w*NL_nd)/(NL_py*NL_y);
// Aggregate nominal Wage share
NL_wy = (NL_w*NL_nd)/(NL_py*NL_y);
// NT sector nominal Wage share
NL_wnty = (NL_w*NL_ndn)/(NL_pnt*NL_ysn);
// T sector nominal Wage share
NL_whty = (NL_w*NL_ndt)/(NL_pht*NL_yst);
// T sector share
NL_yhty = NL_pht*NL_yst/(NL_py*NL_y);
// NT sector share
NL_ynty = NL_pnt*NL_ysn/(NL_py*NL_y);
// Output gap
NL_ygap = 0;
// Output growth (gross rate)
NL_ygrowth = NL_y/NL_y(-1);
// Output growth (gross rate yoy)
NL_ygrowth4 = NL_y/NL_y(-4);
// Domestic nominal output as a share of world nominal output
NL_yshare  = NL_size*NL_py*NL_y/NL_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
NL_epsilonm = -1/8*1/(NL_r*(NL_gammav2*NL_r+NL_r-1));
// Trade balance-to-GDP ratio
NL_tby = NL_tb/(NL_py*NL_y);
// Bilateral shares
NLRA_imcy = (RA_pex*NLRA_rer)*NLRA_imc/(NL_py*NL_y);
NLRA_imiy = (RA_pex*NLRA_rer)*NLRA_imi/(NL_py*NL_y);
NLRA_imcgy = (RA_pex*NLRA_rer)*NLRA_imcg/(NL_py*NL_y);
NLRA_imigy = (RA_pex*NLRA_rer)*NLRA_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLRA_excy  = RA_size/NL_size*NL_pex*RANL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLRA_exiy  = RA_size/NL_size*NL_pex*RANL_imi/(NL_py*NL_y);
// Bilateral shares
NLAT_imcy = (AT_pex*NLAT_rer)*NLAT_imc/(NL_py*NL_y);
NLAT_imiy = (AT_pex*NLAT_rer)*NLAT_imi/(NL_py*NL_y);
NLAT_imcgy = (AT_pex*NLAT_rer)*NLAT_imcg/(NL_py*NL_y);
NLAT_imigy = (AT_pex*NLAT_rer)*NLAT_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLAT_excy  = AT_size/NL_size*NL_pex*ATNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLAT_exiy  = AT_size/NL_size*NL_pex*ATNL_imi/(NL_py*NL_y);
// Bilateral shares
NLBE_imcy = (BE_pex*NLBE_rer)*NLBE_imc/(NL_py*NL_y);
NLBE_imiy = (BE_pex*NLBE_rer)*NLBE_imi/(NL_py*NL_y);
NLBE_imcgy = (BE_pex*NLBE_rer)*NLBE_imcg/(NL_py*NL_y);
NLBE_imigy = (BE_pex*NLBE_rer)*NLBE_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLBE_excy  = BE_size/NL_size*NL_pex*BENL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLBE_exiy  = BE_size/NL_size*NL_pex*BENL_imi/(NL_py*NL_y);
// Bilateral shares
NLES_imcy = (ES_pex*NLES_rer)*NLES_imc/(NL_py*NL_y);
NLES_imiy = (ES_pex*NLES_rer)*NLES_imi/(NL_py*NL_y);
NLES_imcgy = (ES_pex*NLES_rer)*NLES_imcg/(NL_py*NL_y);
NLES_imigy = (ES_pex*NLES_rer)*NLES_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLES_excy  = ES_size/NL_size*NL_pex*ESNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLES_exiy  = ES_size/NL_size*NL_pex*ESNL_imi/(NL_py*NL_y);
// Bilateral shares
NLFI_imcy = (FI_pex*NLFI_rer)*NLFI_imc/(NL_py*NL_y);
NLFI_imiy = (FI_pex*NLFI_rer)*NLFI_imi/(NL_py*NL_y);
NLFI_imcgy = (FI_pex*NLFI_rer)*NLFI_imcg/(NL_py*NL_y);
NLFI_imigy = (FI_pex*NLFI_rer)*NLFI_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLFI_excy  = FI_size/NL_size*NL_pex*FINL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLFI_exiy  = FI_size/NL_size*NL_pex*FINL_imi/(NL_py*NL_y);
// Bilateral shares
NLFR_imcy = (FR_pex*NLFR_rer)*NLFR_imc/(NL_py*NL_y);
NLFR_imiy = (FR_pex*NLFR_rer)*NLFR_imi/(NL_py*NL_y);
NLFR_imcgy = (FR_pex*NLFR_rer)*NLFR_imcg/(NL_py*NL_y);
NLFR_imigy = (FR_pex*NLFR_rer)*NLFR_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLFR_excy  = FR_size/NL_size*NL_pex*FRNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLFR_exiy  = FR_size/NL_size*NL_pex*FRNL_imi/(NL_py*NL_y);
// Bilateral shares
NLGR_imcy = (GR_pex*NLGR_rer)*NLGR_imc/(NL_py*NL_y);
NLGR_imiy = (GR_pex*NLGR_rer)*NLGR_imi/(NL_py*NL_y);
NLGR_imcgy = (GR_pex*NLGR_rer)*NLGR_imcg/(NL_py*NL_y);
NLGR_imigy = (GR_pex*NLGR_rer)*NLGR_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLGR_excy  = GR_size/NL_size*NL_pex*GRNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLGR_exiy  = GR_size/NL_size*NL_pex*GRNL_imi/(NL_py*NL_y);
// Bilateral shares
NLIT_imcy = (IT_pex*NLIT_rer)*NLIT_imc/(NL_py*NL_y);
NLIT_imiy = (IT_pex*NLIT_rer)*NLIT_imi/(NL_py*NL_y);
NLIT_imcgy = (IT_pex*NLIT_rer)*NLIT_imcg/(NL_py*NL_y);
NLIT_imigy = (IT_pex*NLIT_rer)*NLIT_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLIT_excy  = IT_size/NL_size*NL_pex*ITNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLIT_exiy  = IT_size/NL_size*NL_pex*ITNL_imi/(NL_py*NL_y);
// Bilateral shares
NLPT_imcy = (PT_pex*NLPT_rer)*NLPT_imc/(NL_py*NL_y);
NLPT_imiy = (PT_pex*NLPT_rer)*NLPT_imi/(NL_py*NL_y);
NLPT_imcgy = (PT_pex*NLPT_rer)*NLPT_imcg/(NL_py*NL_y);
NLPT_imigy = (PT_pex*NLPT_rer)*NLPT_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLPT_excy  = PT_size/NL_size*NL_pex*PTNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLPT_exiy  = PT_size/NL_size*NL_pex*PTNL_imi/(NL_py*NL_y);
// Bilateral shares
NLDE_imcy = (DE_pex*NLDE_rer)*NLDE_imc/(NL_py*NL_y);
NLDE_imiy = (DE_pex*NLDE_rer)*NLDE_imi/(NL_py*NL_y);
NLDE_imcgy = (DE_pex*NLDE_rer)*NLDE_imcg/(NL_py*NL_y);
NLDE_imigy = (DE_pex*NLDE_rer)*NLDE_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLDE_excy  = DE_size/NL_size*NL_pex*DENL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLDE_exiy  = DE_size/NL_size*NL_pex*DENL_imi/(NL_py*NL_y);
// Bilateral shares
NLRU_imcy = (RU_pex*NLRU_rer)*NLRU_imc/(NL_py*NL_y);
NLRU_imiy = (RU_pex*NLRU_rer)*NLRU_imi/(NL_py*NL_y);
NLRU_imcgy = (RU_pex*NLRU_rer)*NLRU_imcg/(NL_py*NL_y);
NLRU_imigy = (RU_pex*NLRU_rer)*NLRU_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLRU_excy  = RU_size/NL_size*NL_pex*RUNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLRU_exiy  = RU_size/NL_size*NL_pex*RUNL_imi/(NL_py*NL_y);
// Bilateral shares
NLRW_imcy = (RW_pex*NLRW_rer)*NLRW_imc/(NL_py*NL_y);
NLRW_imiy = (RW_pex*NLRW_rer)*NLRW_imi/(NL_py*NL_y);
NLRW_imcgy = (RW_pex*NLRW_rer)*NLRW_imcg/(NL_py*NL_y);
NLRW_imigy = (RW_pex*NLRW_rer)*NLRW_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLRW_excy  = RW_size/NL_size*NL_pex*RWNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLRW_exiy  = RW_size/NL_size*NL_pex*RWNL_imi/(NL_py*NL_y);
// Bilateral shares
NLUS_imcy = (US_pex*NLUS_rer)*NLUS_imc/(NL_py*NL_y);
NLUS_imiy = (US_pex*NLUS_rer)*NLUS_imi/(NL_py*NL_y);
NLUS_imcgy = (US_pex*NLUS_rer)*NLUS_imcg/(NL_py*NL_y);
NLUS_imigy = (US_pex*NLUS_rer)*NLUS_imig/(NL_py*NL_y);
// Exports of consumption goods to gdp
NLUS_excy  = US_size/NL_size*NL_pex*USNL_imc/(NL_py*NL_y);
// Exports of investment goods to gdp
NLUS_exiy  = US_size/NL_size*NL_pex*USNL_imi/(NL_py*NL_y);
// Internal real exchange rate
NL_internalrer = NL_pnt/NL_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
PT_ccesi^(1-1/PT_mucces) = (PT_nucces)^(1/PT_mucces)*PT_ci^(1-1/PT_mucces)+(1-PT_nucces)^(1/PT_mucces)*PT_cg^(1-1/PT_mucces);
// Utility
PT_utili = 
PT_zcon*log(PT_ccesi-PT_kappa*PT_ccesi(-1))-1/(1+PT_zeta)*(PT_ni)^(1+PT_zeta)+PT_beta*PT_utili(+1)
;
// Marginal utility of consumption
PT_dcci = ((PT_nucces)^(1/PT_mucces)*PT_ci^(1-1/PT_mucces)+(1-PT_nucces)^(1/PT_mucces)*PT_cg^(1-1/PT_mucces))^(1/(PT_mucces-1))*(PT_nucces^(1/PT_mucces))*(PT_ci^(-1/PT_mucces));
PT_lambdai*(1+PT_tauc+PT_gammavi+PT_vi*PT_gammavider) = PT_zcon*(PT_ccesi-PT_kappa*PT_ccesi(-1))^(-PT_sigma)*PT_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
PT_r                   = PT_beta^(-1)*PT_lambdai/PT_lambdai    *PT_pic;
// Germany
// US and the RoW
// Euler equation for money
PT_vi^(2)*PT_gammavider = 1-PT_beta*PT_lambdai(+1)/(PT_lambdai*PT_pic(+1));
// Consumption-based velocity
PT_vi = PT_ci/PT_mi;
// Transaction cost
PT_gammavi = PT_gammav1*PT_vi+PT_gammav2/PT_vi-2*(PT_gammav1*PT_gammav2)^(1/2);
// Derivative of transaction cost
PT_gammavider = PT_gammav1-PT_gammav2*PT_vi^(-2);
PT_delta = PT_ii/PT_ki;
PT_gammai = 0;
PT_gammaider = 0;
PT_gammau = 0;
PT_gammauder = ((PT_beta^(-1)-1+PT_delta)*PT_qbar-PT_delta*PT_taukbar*PT_pibar)/((1-PT_taukbar)*PT_pibar);
PT_u = 1;
PT_pi = PT_q;
// Auxiliary equation for Tobin's Q in steady state
PT_qbar = PT_q;
// Rate of return on capital
PT_q = PT_beta*((1-PT_tauk)*PT_rk+(PT_tauk*PT_delta)*PT_pi+(1-PT_delta)*PT_q);
// Optimal wage contract (FOC)
PT_witilde^(1+PT_etai*PT_zeta) = PT_etai/(PT_etai-1)*PT_fi/PT_gi+PT_wcst;
// Definition of fi
PT_fi = PT_wi^(PT_etai*(1+PT_zeta))*PT_ndi^(1+PT_zeta)+PT_xii*PT_beta*(PT_pic(+1)/(PT_pic^PT_chii*PT_pi4target^(1/4*(1-PT_chii))))^(PT_etai*(1+PT_zeta))*PT_fi(+1);
// Definition of gi
PT_gi = PT_lambdai*(1-PT_taun-PT_tauwh)*PT_wi^PT_etai*PT_ndi+PT_xii*PT_beta*(PT_pic(+1)/(PT_pic^PT_chii*PT_pi4target^(1/4*(1-PT_chii))))^(PT_etai-1)*PT_gi(+1);
// Aggregate wage rate
PT_wi^(1-PT_etai) = (1-PT_xii)*PT_witilde^(1-PT_etai)+PT_xii*PT_wi(-1)^(1-PT_etai)*(PT_pic(-1)^PT_chii*PT_pi4target^(1/4*(1-PT_chii))/PT_pic)^(1-PT_etai);
//-------------
// Household J
//-------------
PT_ccesj^(1-1/PT_mucces) = (PT_nucces)^(1/PT_mucces)*PT_cj^(1-1/PT_mucces)+(1-PT_nucces)^(1/PT_mucces)*PT_cg^(1-1/PT_mucces);
// Utility
PT_utilj = 
PT_zcon*log(PT_ccesj-PT_kappa*PT_ccesj(-1))-1/(1+PT_zeta)*(PT_nj)^(1+PT_zeta)+PT_beta*PT_utilj(+1)
;
// Marginal utility of consumption
PT_dccj = ((PT_nucces)^(1/PT_mucces)*PT_cj^(1-1/PT_mucces)+(1-PT_nucces)^(1/PT_mucces)*PT_cg^(1-1/PT_mucces))^(1/(PT_mucces-1))*(PT_nucces^(1/PT_mucces))*(PT_cj^(-1/PT_mucces));
PT_lambdaj*(1+PT_tauc+PT_gammavj+PT_vj*PT_gammavjder) = PT_zcon*(PT_ccesj-PT_kappa*PT_ccesj(-1))^(-PT_sigma)*PT_dccj;
// Budget constraint
(1+PT_tauc+PT_gammavj)*PT_cj+PT_mj = (1-PT_taun-PT_tauwh)*PT_wj*PT_nj+PT_trj-PT_tj+PT_mj(-1)*PT_pic^(-1);
// Euler equation for money
PT_vj^(2)*PT_gammavjder = 1-PT_beta*PT_lambdaj(+1)/(PT_lambdaj*PT_pic(+1));
// Consumption-based velocity
PT_vj = PT_cj/PT_mj;
// Transaction technology
PT_gammavj = PT_gammav1*PT_vj+PT_gammav2/PT_vj-2*(PT_gammav1*PT_gammav2)^(1/2);
// Derivative of transaction technology
PT_gammavjder = PT_gammav1-PT_gammav2*PT_vj^(-2);
// Optimal wage contract (FOC)
PT_wjtilde^(1+PT_etaj*PT_zeta) = PT_etaj/(PT_etaj-1)*PT_fj/PT_gj+PT_wcst;
// Definition of fj
PT_fj = PT_wj^(PT_etaj*(1+PT_zeta))*PT_ndj^(1+PT_zeta)+PT_xij*PT_beta*(PT_pic(+1)/(PT_pic^PT_chij*PT_pi4target^(1/4*(1-PT_chij))))^(PT_etaj*(1+PT_zeta))*PT_fj(+1);
// Definition of gj
PT_gj = PT_lambdaj*(1-PT_taun-PT_tauwh)*PT_wj^PT_etaj*PT_ndj+PT_xij*PT_beta*(PT_pic(+1)/(PT_pic^PT_chij*PT_pi4target^(1/4*(1-PT_chij))))^(PT_etaj-1)*PT_gj(+1);
// Aggregate wage rate
PT_wj^(1-PT_etaj) = (1-PT_xij)*PT_wjtilde^(1-PT_etaj)+PT_xij*PT_wj(-1)^(1-PT_etaj)*(PT_pic(-1)^PT_chij*PT_pi4target^(1/4*(1-PT_chij))/PT_pic)^(1-PT_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
PT_kg = (1-PT_deltag)*PT_kg(-1)+PT_ig(-1);
// Production function tradable
PT_yst = PT_zt*PT_kg^PT_alphag*PT_kdt^PT_alphat*PT_ndt^(1-PT_alphat)-PT_psitbar;
// Production function nontradable
PT_ysn = PT_zn*PT_kg^PT_alphag*PT_kdn^PT_alphan*PT_ndn^(1-PT_alphan)-PT_psinbar;
// Real marginal cost tradable
PT_mct = 1/(PT_zt*PT_kg^PT_alphag*(PT_alphat)^(PT_alphat)*(1-PT_alphat)^(1-PT_alphat))*PT_rk^(PT_alphat)*((1+PT_tauwf)*PT_w)^(1-PT_alphat);
// Real marginal cost nontradable
PT_mcn = 1/(PT_zn*PT_kg^PT_alphag*(PT_alphan)^(PT_alphan)*(1-PT_alphan)^(1-PT_alphan))*PT_rk^(PT_alphan)*((1+PT_tauwf)*PT_w)^(1-PT_alphan);
// Wage Inflation (qoq)
PT_piw = PT_w/PT_w(-1)*PT_pic;
// Wage Inflation (yoy)
PT_piw4 = PT_pic4;
// Auxiliary equation for steady-state fixed cost
PT_psitbar = PT_psit*PT_ytbar;
// Auxiliary equation for steady-state fixed cost
PT_psinbar = PT_psin*PT_ynbar;
// Capital input (FOC)
PT_rk = PT_alphat*(PT_yst+PT_psitbar)/PT_kdt*PT_mct;
// Capital input (FOC)
PT_rk = PT_alphan*(PT_ysn+PT_psinbar)/PT_kdn*PT_mcn;
// Total capital demand
PT_kd = PT_kdt+PT_kdn;
// Demand for labour services by household I
PT_ndi = 
(1-PT_omega)*(PT_wi/PT_w)^(-PT_eta)*PT_nd
;
// Demand for labour services by household J
PT_ndj = 
PT_omega*(PT_wj/PT_w)^(-PT_eta)*PT_nd
;
// Aggregate labour demand
PT_nd^(1-1/PT_eta) = 
(1-PT_omega)^(1/PT_eta)*PT_ndi^(1-1/PT_eta)+PT_omega^(1/PT_eta)*PT_ndj^(1-1/PT_eta)
;
// Total demand 
PT_nd = PT_ndt+PT_ndn;
// Aggregate dividends
PT_d = PT_py*PT_y-PT_rk*PT_kd-(1+PT_tauwf)*PT_w*PT_nd;
// Non-tradable sector dividends
PT_dn = PT_pnt*PT_ysn-PT_rk*PT_kdn-(1+PT_tauwf)*PT_w*PT_ndn;
// Tradable sector dividends
PT_dt = PT_pht*PT_ht
+PT_pex*PT_ex
-PT_rk*PT_kdt-(1+PT_tauwf)*PT_w*PT_ndt;
// Optimal price contract set in domestic markets (FOC)
PT_phttilde/PT_pht = PT_thetat/(PT_thetat-1)*PT_fh/PT_gh;
// Definition of fh
PT_fh = PT_mct*PT_ht+PT_xih*PT_beta*PT_lambdai(+1)/PT_lambdai*(PT_piht(+1)/(PT_piht^PT_chih*PT_pi4target^(1/4*(1-PT_chih))))^PT_thetat*PT_fh(+1);
// Definition of gh
PT_gh = PT_pht*PT_ht+PT_xih*PT_beta*PT_lambdai(+1)/PT_lambdai*(PT_piht(+1)/(PT_piht^PT_chih*PT_pi4target^(1/4*(1-PT_chih))))^(PT_thetat-1)*PT_gh(+1);
// Aggregate intermediate-good price dynamics
PT_pht^(1-PT_thetat) = (1-PT_xih)*PT_phttilde^(1-PT_thetat)+PT_xih*(PT_pht(-1)/PT_pic)^(1-PT_thetat)*(PT_piht(-1)^PT_chih*PT_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation
PT_piht = PT_pht/PT_pht(-1)*PT_pic;
// Optimal price contract set in domestic markets (FOC)
PT_pnttilde/PT_pnt = PT_thetan/(PT_thetan-1)*PT_fn/PT_gn;
// Definition of fn
PT_fn = PT_mcn*PT_nt+PT_xin*PT_beta*PT_lambdai(+1)/PT_lambdai*(PT_pint(+1)/(PT_pint^PT_chin*PT_pi4target^(1/4*(1-PT_chin))))^PT_thetan*PT_fn(+1);
// Definition of gn
PT_gn = PT_pnt*PT_nt+PT_xin*PT_beta*PT_lambdai(+1)/PT_lambdai*(PT_pint(+1)/(PT_pint^PT_chin*PT_pi4target^(1/4*(1-PT_chin))))^(PT_thetan-1)*PT_gn(+1);
// Aggregate intermediate-good price dynamics
PT_pnt^(1-PT_thetan) = (1-PT_xin)*PT_pnttilde^(1-PT_thetan)+PT_xin*(PT_pnt(-1)/PT_pic)^(1-PT_thetan)*(PT_pint(-1)^PT_chin*PT_pi4target^(1/4*(1-PT_chin)))^(1-PT_thetan);
// Intermediate-good price inflation
PT_pint = PT_pnt/PT_pnt(-1)*PT_pic;
// Optimal price contract set in domestic markets (FOC)
PT_pextilde/PT_pex = PT_thetat/(PT_thetat-1)*PT_fx/PT_gx;
// Definition of fh
PT_fx = PT_mct*PT_ex+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(PT_piex(+1)/(PT_piex^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PT_fx(+1);
// Definition of gh
PT_gx = PT_pex*PT_ex+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(PT_piex(+1)/(PT_piex^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PT_gx(+1);
// Aggregate intermediate-good price dynamics
PT_pex^(1-PT_thetat) = (1-PT_xix)*PT_pextilde^(1-PT_thetat)+PT_xix*(PT_pex(-1)/PT_pic)^(1-PT_thetat)*(PT_piex(-1)^PT_chix*PT_pi4target^(1/4*(1-PT_chix)))^(1-PT_thetat);
// Intermediate-good price inflation
PT_piex = PT_pex/PT_pex(-1)*PT_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = RA_pimtilde
// RAPT_pimtilde/RAPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTRA_fx/PTRA_gx;
// Definition of fx
// PTRA_fx = RA_size/PT_size*RAPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(RAPT_piim(+1)/(RAPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTRA_fx(+1);
// Definition of gx   
// PTRA_gx = PTRA_rer*RAPT_pim*RA_size/PT_size*RAPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(RAPT_piim(+1)/(RAPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTRA_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = RA_pim
// RAPT_pim^(1-PT_thetat) = (1-PT_xix)*RAPT_pimtilde^(1-PT_thetat)+PT_xix*(RAPT_pim(-1)/RA_pic)^(1-PT_thetat)*(RAPT_piim(-1)^PT_chix*RA_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = RA_piim
// RAPT_piim = RAPT_pim/RAPT_pim(-1)*RA_pic;
// Bilateral real exchange rate
PTRA_rer = PT_rer/RA_rer;
// Auxiliary equation for steady-state output
PTRA_rerbar = PTRA_rer;
//Terms of Trade
PTRA_tot = RA_pex*PTRA_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = AT_pimtilde
// ATPT_pimtilde/ATPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTAT_fx/PTAT_gx;
// Definition of fx
// PTAT_fx = AT_size/PT_size*ATPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(ATPT_piim(+1)/(ATPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTAT_fx(+1);
// Definition of gx   
// PTAT_gx = PTAT_rer*ATPT_pim*AT_size/PT_size*ATPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(ATPT_piim(+1)/(ATPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTAT_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = AT_pim
// ATPT_pim^(1-PT_thetat) = (1-PT_xix)*ATPT_pimtilde^(1-PT_thetat)+PT_xix*(ATPT_pim(-1)/AT_pic)^(1-PT_thetat)*(ATPT_piim(-1)^PT_chix*AT_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = AT_piim
// ATPT_piim = ATPT_pim/ATPT_pim(-1)*AT_pic;
// Bilateral real exchange rate
PTAT_rer = PT_rer/AT_rer;
// Auxiliary equation for steady-state output
PTAT_rerbar = PTAT_rer;
//Terms of Trade
PTAT_tot = AT_pex*PTAT_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = BE_pimtilde
// BEPT_pimtilde/BEPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTBE_fx/PTBE_gx;
// Definition of fx
// PTBE_fx = BE_size/PT_size*BEPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(BEPT_piim(+1)/(BEPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTBE_fx(+1);
// Definition of gx   
// PTBE_gx = PTBE_rer*BEPT_pim*BE_size/PT_size*BEPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(BEPT_piim(+1)/(BEPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTBE_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = BE_pim
// BEPT_pim^(1-PT_thetat) = (1-PT_xix)*BEPT_pimtilde^(1-PT_thetat)+PT_xix*(BEPT_pim(-1)/BE_pic)^(1-PT_thetat)*(BEPT_piim(-1)^PT_chix*BE_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = BE_piim
// BEPT_piim = BEPT_pim/BEPT_pim(-1)*BE_pic;
// Bilateral real exchange rate
PTBE_rer = PT_rer/BE_rer;
// Auxiliary equation for steady-state output
PTBE_rerbar = PTBE_rer;
//Terms of Trade
PTBE_tot = BE_pex*PTBE_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = ES_pimtilde
// ESPT_pimtilde/ESPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTES_fx/PTES_gx;
// Definition of fx
// PTES_fx = ES_size/PT_size*ESPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(ESPT_piim(+1)/(ESPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTES_fx(+1);
// Definition of gx   
// PTES_gx = PTES_rer*ESPT_pim*ES_size/PT_size*ESPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(ESPT_piim(+1)/(ESPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTES_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = ES_pim
// ESPT_pim^(1-PT_thetat) = (1-PT_xix)*ESPT_pimtilde^(1-PT_thetat)+PT_xix*(ESPT_pim(-1)/ES_pic)^(1-PT_thetat)*(ESPT_piim(-1)^PT_chix*ES_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = ES_piim
// ESPT_piim = ESPT_pim/ESPT_pim(-1)*ES_pic;
// Bilateral real exchange rate
PTES_rer = PT_rer/ES_rer;
// Auxiliary equation for steady-state output
PTES_rerbar = PTES_rer;
//Terms of Trade
PTES_tot = ES_pex*PTES_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = FI_pimtilde
// FIPT_pimtilde/FIPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTFI_fx/PTFI_gx;
// Definition of fx
// PTFI_fx = FI_size/PT_size*FIPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(FIPT_piim(+1)/(FIPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTFI_fx(+1);
// Definition of gx   
// PTFI_gx = PTFI_rer*FIPT_pim*FI_size/PT_size*FIPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(FIPT_piim(+1)/(FIPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTFI_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = FI_pim
// FIPT_pim^(1-PT_thetat) = (1-PT_xix)*FIPT_pimtilde^(1-PT_thetat)+PT_xix*(FIPT_pim(-1)/FI_pic)^(1-PT_thetat)*(FIPT_piim(-1)^PT_chix*FI_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = FI_piim
