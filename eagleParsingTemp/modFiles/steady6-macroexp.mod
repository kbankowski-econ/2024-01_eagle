RWRU_weight = RW_pim*RW_im/(RW_pim*RW_im+RW_pex*RW_ex)*RWRU_weightim+RW_pex*RW_ex/(RW_pim*RW_im+RW_pex*RW_ex)*RWRU_weightex;
// Effective real exchange rate: double weighting (imports)
