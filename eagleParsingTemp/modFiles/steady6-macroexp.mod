)
+NL_size/BE_size*NLBE_im/BE_ex*BERA_rer*RA_pex*NLRA_im/(BENL_rer*NL_py*NL_y
+BERA_rer*RA_pex*NLRA_im
+BEAT_rer*AT_pex*NLAT_im
+BEES_rer*ES_pex*NLES_im
