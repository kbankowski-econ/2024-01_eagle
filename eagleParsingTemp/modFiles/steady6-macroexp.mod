+ATRW_rer*RW_pex*BERW_im
+ATUS_rer*US_pex*BEUS_im
)
+ES_size/AT_size*ESAT_im/AT_ex*ATRA_rer*RA_pex*ESRA_im/(ATES_rer*ES_py*ES_y
+ATRA_rer*RA_pex*ESRA_im
+ATBE_rer*BE_pex*ESBE_im
+ATFI_rer*FI_pex*ESFI_im
+ATFR_rer*FR_pex*ESFR_im
