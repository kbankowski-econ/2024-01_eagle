// NLBE_fx = BE_size/NL_size*BENL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(BENL_piim(+1)/(BENL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLBE_fx(+1);
// Definition of gx   
// NLBE_gx = NLBE_rer*BENL_pim*BE_size/NL_size*BENL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(BENL_piim(+1)/(BENL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLBE_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = BE_pim
// BENL_pim^(1-NL_thetat) = (1-NL_xix)*BENL_pimtilde^(1-NL_thetat)+NL_xix*(BENL_pim(-1)/BE_pic)^(1-NL_thetat)*(BENL_piim(-1)^NL_chix*BE_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = BE_piim
