+ESRW_rer*RW_pex*RURW_im
+ESUS_rer*US_pex*RUUS_im
)
+RW_size/ES_size*RWES_im/ES_ex*ESUS_rer*US_pex*RWUS_im/(ESRW_rer*RW_py*RW_y
+ESRA_rer*RA_pex*RWRA_im
+ESAT_rer*AT_pex*RWAT_im
+ESBE_rer*BE_pex*RWBE_im
+ESFI_rer*FI_pex*RWFI_im
+ESFR_rer*FR_pex*RWFR_im
+ESGR_rer*GR_pex*RWGR_im
+ESIT_rer*IT_pex*RWIT_im
+ESNL_rer*NL_pex*RWNL_im
+ESPT_rer*PT_pex*RWPT_im
+ESDE_rer*DE_pex*RWDE_im
+ESRU_rer*RU_pex*RWRU_im
+ESUS_rer*US_pex*RWUS_im
)
;
// Effective real exchange rate: double weighting (overall)
ESUS_weight = ES_pim*ES_im/(ES_pim*ES_im+ES_pex*ES_ex)*ESUS_weightim+ES_pex*ES_ex/(ES_pim*ES_im+ES_pex*ES_ex)*ESUS_weightex;
// Effective real exchange rate
ES_reer = 1
*ESRA_rer^ESRA_weight
*ESAT_rer^ESAT_weight
*ESBE_rer^ESBE_weight
*ESFI_rer^ESFI_weight
*ESFR_rer^ESFR_weight
*ESGR_rer^ESGR_weight
*ESIT_rer^ESIT_weight
*ESNL_rer^ESNL_weight
*ESPT_rer^ESPT_weight
*ESDE_rer^ESDE_weight
*ESRU_rer^ESRU_weight
*ESRW_rer^ESRW_weight
*ESUS_rer^ESUS_weight
;
// Effective terms of trade
ES_etot = 1
*ESRA_tot^ESRA_weight
*ESAT_tot^ESAT_weight
*ESBE_tot^ESBE_weight
*ESFI_tot^ESFI_weight
*ESFR_tot^ESFR_weight
*ESGR_tot^ESGR_weight
*ESIT_tot^ESIT_weight
*ESNL_tot^ESNL_weight
*ESPT_tot^ESPT_weight
*ESDE_tot^ESDE_weight
*ESRU_tot^ESRU_weight
*ESRW_tot^ESRW_weight
*ESUS_tot^ESUS_weight
;
//-----------------
// Final-good firms
//-----------------
// Private consumption good (import)
ES_imc^((ES_mumc-1)/ES_mumc) =
+ESRA_numc ^(1/ES_mumc)*ESRA_imc^(1-1/ES_mumc)
+ESBE_numc ^(1/ES_mumc)*ESBE_imc^(1-1/ES_mumc)
+ESFI_numc ^(1/ES_mumc)*ESFI_imc^(1-1/ES_mumc)
+ESFR_numc ^(1/ES_mumc)*ESFR_imc^(1-1/ES_mumc)
+ESGR_numc ^(1/ES_mumc)*ESGR_imc^(1-1/ES_mumc)
+ESIT_numc ^(1/ES_mumc)*ESIT_imc^(1-1/ES_mumc)
+ESNL_numc ^(1/ES_mumc)*ESNL_imc^(1-1/ES_mumc)
+ESPT_numc ^(1/ES_mumc)*ESPT_imc^(1-1/ES_mumc)
+ESDE_numc ^(1/ES_mumc)*ESDE_imc^(1-1/ES_mumc)
+ESRU_numc ^(1/ES_mumc)*ESRU_imc^(1-1/ES_mumc)
+ESRW_numc ^(1/ES_mumc)*ESRW_imc^(1-1/ES_mumc)
+ESUS_numc ^(1/ES_mumc)*ESUS_imc^(1-1/ES_mumc)
+(1
-ESRA_numc
-ESBE_numc
-ESFI_numc
-ESFR_numc
-ESGR_numc
-ESIT_numc
-ESNL_numc
-ESPT_numc
-ESDE_numc
-ESRU_numc
-ESRW_numc
-ESUS_numc
)^(1/ES_mumc)*ESAT_imc^(1-1/ES_mumc);
// Demand for bilateral consumption import goods
ESRA_imc = ESRA_numc*((RA_pex*ESRA_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESBE_imc = ESBE_numc*((BE_pex*ESBE_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESFR_imc = ESFR_numc*((FR_pex*ESFR_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESGR_imc = ESGR_numc*((GR_pex*ESGR_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESIT_imc = ESIT_numc*((IT_pex*ESIT_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESNL_imc = ESNL_numc*((NL_pex*ESNL_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESPT_imc = ESPT_numc*((PT_pex*ESPT_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESDE_imc = ESDE_numc*((DE_pex*ESDE_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESRU_imc = ESRU_numc*((RU_pex*ESRU_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESRW_imc = ESRW_numc*((RW_pex*ESRW_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Demand for bilateral consumption import goods
ESUS_imc = ESUS_numc*((US_pex*ESUS_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
ESAT_imc = (1
-ESRA_numc
-ESBE_numc
-ESFI_numc
-ESFR_numc
-ESGR_numc
-ESIT_numc
-ESNL_numc
-ESPT_numc
-ESDE_numc
-ESRU_numc
-ESRW_numc
-ESUS_numc
)*((AT_pex*ESAT_rer)/ES_pimc)^(-ES_mumc)*ES_imc;
// Price of the consumption good (import)
