+ESRW_rer*RW_pex*ATRW_im
+ESUS_rer*US_pex*ATUS_im
)
+BE_size/ES_size*BEES_im/ES_ex*ESRA_rer*RA_pex*BERA_im/(ESBE_rer*BE_py*BE_y
+ESRA_rer*RA_pex*BERA_im
+ESAT_rer*AT_pex*BEAT_im
+ESFI_rer*FI_pex*BEFI_im
+ESFR_rer*FR_pex*BEFR_im
