// Bilateral real exchange rate
RURW_rer = RU_rer/RW_rer;
// Auxiliary equation for steady-state output
RURW_rerbar = RURW_rer;
//Terms of Trade
RURW_tot = RW_pex*RURW_rer/RU_pex;
// Optimal price contract set in foreign markets (FOC), using RU_pxtilde = US_pimtilde
// USRU_pimtilde/USRU_pim = RU_cpim*RU_thetat/(RU_thetat-1)*RUUS_fx/RUUS_gx;
// Definition of fx
// RUUS_fx = US_size/RU_size*USRU_im*RU_mct+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(USRU_piim(+1)/(USRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^RU_thetat*RUUS_fx(+1);
// Definition of gx   
// RUUS_gx = RUUS_rer*USRU_pim*US_size/RU_size*USRU_im+RU_xix*RU_beta*RU_lambdai(+1)/RU_lambdai*(USRU_piim(+1)/(USRU_piim^RU_chix*RU_pi4target^(1/4*(1-RU_chix))))^(RU_thetat-1)*RUUS_gx(+1);
// Aggregate intermediate-good price dynamics, using RU_px = US_pim
// USRU_pim^(1-RU_thetat) = (1-RU_xix)*USRU_pimtilde^(1-RU_thetat)+RU_xix*(USRU_pim(-1)/US_pic)^(1-RU_thetat)*(USRU_piim(-1)^RU_chix*US_pi4target^(1/4*(1-RU_chih)))^(1-RU_thetat);
// Intermediate-good price inflation, using RU_pix = US_piim
// USRU_piim = USRU_pim/USRU_pim(-1)*US_pic;
// Bilateral real exchange rate
RUUS_rer = RU_rer/US_rer;
// Auxiliary equation for steady-state output
RUUS_rerbar = RUUS_rer;
//Terms of Trade
RUUS_tot = US_pex*RUUS_rer/RU_pex;
// Total imports 
RU_im = 
+RU_imc
+RU_imi
+RU_imcg
+RU_imig
;
// Total import deflator
RU_im*RU_pim  = 
+RU_pimc*RU_imc
+RU_pimi*RU_imi
+RU_pimcg*RU_imcg
+RU_pimig*RU_imig
;
// Effective real exchange rate: double weighting (imports)
RURA_weightim = RURA_rer*RA_pex*RURA_im/(RU_pim*RU_im);
// Effective real exchange rate: double weighting (exports)
RURA_weightex = RA_size/RU_size*RARU_im/RU_ex*RURA_rer*RA_py*RA_y/(RURA_rer*RA_py*RA_y
+RUAT_rer*AT_pex*RAAT_im
+RUBE_rer*BE_pex*RABE_im
+RUES_rer*ES_pex*RAES_im
+RUFI_rer*FI_pex*RAFI_im
