model(block, bytecode, cutoff = 0);
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
RA_ccesi^(1-1/RA_mucces) = (RA_nucces)^(1/RA_mucces)*RA_ci^(1-1/RA_mucces)+(1-RA_nucces)^(1/RA_mucces)*RA_cg^(1-1/RA_mucces);
// Utility
RA_utili = 
RA_zcon*log(RA_ccesi-RA_kappa*RA_ccesi(-1))-1/(1+RA_zeta)*(RA_ni)^(1+RA_zeta)+RA_beta*RA_utili(+1)
;
// Marginal utility of consumption
RA_dcci = ((RA_nucces)^(1/RA_mucces)*RA_ci^(1-1/RA_mucces)+(1-RA_nucces)^(1/RA_mucces)*RA_cg^(1-1/RA_mucces))^(1/(RA_mucces-1))*(RA_nucces^(1/RA_mucces))*(RA_ci^(-1/RA_mucces));
RA_lambdai*(1+RA_tauc+RA_gammavi+RA_vi*RA_gammavider) = RA_zcon*(RA_ccesi-RA_kappa*RA_ccesi(-1))^(-RA_sigma)*RA_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
RA_r                   = RA_beta^(-1)*RA_lambdai/RA_lambdai    *RA_pic;
// Germany
// US and the RoW
// Euler equation for money
RA_vi^(2)*RA_gammavider = 1-RA_beta*RA_lambdai(+1)/(RA_lambdai*RA_pic(+1));
// Consumption-based velocity
RA_vi = RA_ci/RA_mi;
// Transaction cost
RA_gammavi = RA_gammav1*RA_vi+RA_gammav2/RA_vi-2*(RA_gammav1*RA_gammav2)^(1/2);
// Derivative of transaction cost
RA_gammavider = RA_gammav1-RA_gammav2*RA_vi^(-2);
RA_delta = RA_ii/RA_ki;
RA_gammai = 0;
RA_gammaider = 0;
RA_gammau = 0;
RA_gammauder = ((RA_beta^(-1)-1+RA_delta)*RA_qbar-RA_delta*RA_taukbar*RA_pibar)/((1-RA_taukbar)*RA_pibar);
RA_u = 1;
RA_pi = RA_q;
// Auxiliary equation for Tobin's Q in steady state
RA_qbar = RA_q;
// Rate of return on capital
RA_q = RA_beta*((1-RA_tauk)*RA_rk+(RA_tauk*RA_delta)*RA_pi+(1-RA_delta)*RA_q);
// Optimal wage contract (FOC)
RA_witilde^(1+RA_etai*RA_zeta) = RA_etai/(RA_etai-1)*RA_fi/RA_gi+RA_wcst;
// Definition of fi
RA_fi = RA_wi^(RA_etai*(1+RA_zeta))*RA_ndi^(1+RA_zeta)+RA_xii*RA_beta*(RA_pic(+1)/(RA_pic^RA_chii*RA_pi4target^(1/4*(1-RA_chii))))^(RA_etai*(1+RA_zeta))*RA_fi(+1);
// Definition of gi
RA_gi = RA_lambdai*(1-RA_taun-RA_tauwh)*RA_wi^RA_etai*RA_ndi+RA_xii*RA_beta*(RA_pic(+1)/(RA_pic^RA_chii*RA_pi4target^(1/4*(1-RA_chii))))^(RA_etai-1)*RA_gi(+1);
// Aggregate wage rate
RA_wi^(1-RA_etai) = (1-RA_xii)*RA_witilde^(1-RA_etai)+RA_xii*RA_wi(-1)^(1-RA_etai)*(RA_pic(-1)^RA_chii*RA_pi4target^(1/4*(1-RA_chii))/RA_pic)^(1-RA_etai);
//-------------
// Household J
//-------------
RA_ccesj^(1-1/RA_mucces) = (RA_nucces)^(1/RA_mucces)*RA_cj^(1-1/RA_mucces)+(1-RA_nucces)^(1/RA_mucces)*RA_cg^(1-1/RA_mucces);
// Utility
RA_utilj = 
RA_zcon*log(RA_ccesj-RA_kappa*RA_ccesj(-1))-1/(1+RA_zeta)*(RA_nj)^(1+RA_zeta)+RA_beta*RA_utilj(+1)
;
// Marginal utility of consumption
RA_dccj = ((RA_nucces)^(1/RA_mucces)*RA_cj^(1-1/RA_mucces)+(1-RA_nucces)^(1/RA_mucces)*RA_cg^(1-1/RA_mucces))^(1/(RA_mucces-1))*(RA_nucces^(1/RA_mucces))*(RA_cj^(-1/RA_mucces));
RA_lambdaj*(1+RA_tauc+RA_gammavj+RA_vj*RA_gammavjder) = RA_zcon*(RA_ccesj-RA_kappa*RA_ccesj(-1))^(-RA_sigma)*RA_dccj;
// Budget constraint
(1+RA_tauc+RA_gammavj)*RA_cj+RA_mj = (1-RA_taun-RA_tauwh)*RA_wj*RA_nj+RA_trj-RA_tj+RA_mj(-1)*RA_pic^(-1);
// Euler equation for money
RA_vj^(2)*RA_gammavjder = 1-RA_beta*RA_lambdaj(+1)/(RA_lambdaj*RA_pic(+1));
// Consumption-based velocity
RA_vj = RA_cj/RA_mj;
// Transaction technology
RA_gammavj = RA_gammav1*RA_vj+RA_gammav2/RA_vj-2*(RA_gammav1*RA_gammav2)^(1/2);
// Derivative of transaction technology
RA_gammavjder = RA_gammav1-RA_gammav2*RA_vj^(-2);
// Optimal wage contract (FOC)
RA_wjtilde^(1+RA_etaj*RA_zeta) = RA_etaj/(RA_etaj-1)*RA_fj/RA_gj+RA_wcst;
// Definition of fj
RA_fj = RA_wj^(RA_etaj*(1+RA_zeta))*RA_ndj^(1+RA_zeta)+RA_xij*RA_beta*(RA_pic(+1)/(RA_pic^RA_chij*RA_pi4target^(1/4*(1-RA_chij))))^(RA_etaj*(1+RA_zeta))*RA_fj(+1);
// Definition of gj
RA_gj = RA_lambdaj*(1-RA_taun-RA_tauwh)*RA_wj^RA_etaj*RA_ndj+RA_xij*RA_beta*(RA_pic(+1)/(RA_pic^RA_chij*RA_pi4target^(1/4*(1-RA_chij))))^(RA_etaj-1)*RA_gj(+1);
// Aggregate wage rate
RA_wj^(1-RA_etaj) = (1-RA_xij)*RA_wjtilde^(1-RA_etaj)+RA_xij*RA_wj(-1)^(1-RA_etaj)*(RA_pic(-1)^RA_chij*RA_pi4target^(1/4*(1-RA_chij))/RA_pic)^(1-RA_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
RA_kg = (1-RA_deltag)*RA_kg(-1)+RA_ig(-1);
// Production function tradable
RA_yst = EA_z*RA_zt*RA_kg^RA_alphag*RA_kdt^RA_alphat*RA_ndt^(1-RA_alphat)-RA_psitbar;
// Production function nontradable
RA_ysn = EA_z*RA_zn*RA_kg^RA_alphag*RA_kdn^RA_alphan*RA_ndn^(1-RA_alphan)-RA_psinbar;
// Real marginal cost tradable
RA_mct = 1/(EA_z*RA_zt*RA_kg^RA_alphag*(RA_alphat)^(RA_alphat)*(1-RA_alphat)^(1-RA_alphat))*RA_rk^(RA_alphat)*((1+RA_tauwf)*RA_w)^(1-RA_alphat);
// Real marginal cost nontradable
RA_mcn = 1/(EA_z*RA_zn*RA_kg^RA_alphag*(RA_alphan)^(RA_alphan)*(1-RA_alphan)^(1-RA_alphan))*RA_rk^(RA_alphan)*((1+RA_tauwf)*RA_w)^(1-RA_alphan);
// Wage Inflation (qoq)
RA_piw = RA_w/RA_w(-1)*RA_pic;
// Wage Inflation (yoy)
RA_piw4 = RA_pic4;
// Auxiliary equation for steady-state fixed cost
RA_psitbar = RA_psit*RA_ytbar;
// Auxiliary equation for steady-state fixed cost
RA_psinbar = RA_psin*RA_ynbar;
// Capital input (FOC)
RA_rk = RA_alphat*(RA_yst+RA_psitbar)/RA_kdt*RA_mct;
// Capital input (FOC)
RA_rk = RA_alphan*(RA_ysn+RA_psinbar)/RA_kdn*RA_mcn;
// Total capital demand
RA_kd = RA_kdt+RA_kdn;
// Demand for labour services by household I
RA_ndi = 
(1-RA_omega)*(RA_wi/RA_w)^(-RA_eta)*RA_nd
;
// Demand for labour services by household J
RA_ndj = 
RA_omega*(RA_wj/RA_w)^(-RA_eta)*RA_nd
;
// Aggregate labour demand
RA_nd^(1-1/RA_eta) = 
(1-RA_omega)^(1/RA_eta)*RA_ndi^(1-1/RA_eta)+RA_omega^(1/RA_eta)*RA_ndj^(1-1/RA_eta)
;
// Total demand 
RA_nd = RA_ndt+RA_ndn;
// Aggregate dividends
RA_d = RA_py*RA_y-RA_rk*RA_kd-(1+RA_tauwf)*RA_w*RA_nd;
// Non-tradable sector dividends
RA_dn = RA_pnt*RA_ysn-RA_rk*RA_kdn-(1+RA_tauwf)*RA_w*RA_ndn;
// Tradable sector dividends
RA_dt = RA_pht*RA_ht
+RA_pex*RA_ex
-RA_rk*RA_kdt-(1+RA_tauwf)*RA_w*RA_ndt;
// Optimal price contract set in domestic markets (FOC)
RA_phttilde/RA_pht = RA_thetat/(RA_thetat-1)*RA_fh/RA_gh;
// Definition of fh
RA_fh = RA_mct*RA_ht+RA_xih*RA_beta*RA_lambdai(+1)/RA_lambdai*(RA_piht(+1)/(RA_piht^RA_chih*RA_pi4target^(1/4*(1-RA_chih))))^RA_thetat*RA_fh(+1);
// Definition of gh
RA_gh = RA_pht*RA_ht+RA_xih*RA_beta*RA_lambdai(+1)/RA_lambdai*(RA_piht(+1)/(RA_piht^RA_chih*RA_pi4target^(1/4*(1-RA_chih))))^(RA_thetat-1)*RA_gh(+1);
// Aggregate intermediate-good price dynamics
RA_pht^(1-RA_thetat) = (1-RA_xih)*RA_phttilde^(1-RA_thetat)+RA_xih*(RA_pht(-1)/RA_pic)^(1-RA_thetat)*(RA_piht(-1)^RA_chih*RA_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation
RA_piht = RA_pht/RA_pht(-1)*RA_pic;
// Optimal price contract set in domestic markets (FOC)
RA_pnttilde/RA_pnt = RA_thetan/(RA_thetan-1)*RA_fn/RA_gn;
// Definition of fn
RA_fn = RA_mcn*RA_nt+RA_xin*RA_beta*RA_lambdai(+1)/RA_lambdai*(RA_pint(+1)/(RA_pint^RA_chin*RA_pi4target^(1/4*(1-RA_chin))))^RA_thetan*RA_fn(+1);
// Definition of gn
RA_gn = RA_pnt*RA_nt+RA_xin*RA_beta*RA_lambdai(+1)/RA_lambdai*(RA_pint(+1)/(RA_pint^RA_chin*RA_pi4target^(1/4*(1-RA_chin))))^(RA_thetan-1)*RA_gn(+1);
// Aggregate intermediate-good price dynamics
RA_pnt^(1-RA_thetan) = (1-RA_xin)*RA_pnttilde^(1-RA_thetan)+RA_xin*(RA_pnt(-1)/RA_pic)^(1-RA_thetan)*(RA_pint(-1)^RA_chin*RA_pi4target^(1/4*(1-RA_chin)))^(1-RA_thetan);
// Intermediate-good price inflation
RA_pint = RA_pnt/RA_pnt(-1)*RA_pic;
// Optimal price contract set in domestic markets (FOC)
RA_pextilde/RA_pex = RA_thetat/(RA_thetat-1)*RA_fx/RA_gx;
// Definition of fh
RA_fx = RA_mct*RA_ex+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(RA_piex(+1)/(RA_piex^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RA_fx(+1);
// Definition of gh
RA_gx = RA_pex*RA_ex+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(RA_piex(+1)/(RA_piex^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RA_gx(+1);
// Aggregate intermediate-good price dynamics
RA_pex^(1-RA_thetat) = (1-RA_xix)*RA_pextilde^(1-RA_thetat)+RA_xix*(RA_pex(-1)/RA_pic)^(1-RA_thetat)*(RA_piex(-1)^RA_chix*RA_pi4target^(1/4*(1-RA_chix)))^(1-RA_thetat);
// Intermediate-good price inflation
RA_piex = RA_pex/RA_pex(-1)*RA_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = AT_pimtilde
// ATRA_pimtilde/ATRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAAT_fx/RAAT_gx;
// Definition of fx
// RAAT_fx = AT_size/RA_size*ATRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(ATRA_piim(+1)/(ATRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAAT_fx(+1);
// Definition of gx   
// RAAT_gx = RAAT_rer*ATRA_pim*AT_size/RA_size*ATRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(ATRA_piim(+1)/(ATRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAAT_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = AT_pim
// ATRA_pim^(1-RA_thetat) = (1-RA_xix)*ATRA_pimtilde^(1-RA_thetat)+RA_xix*(ATRA_pim(-1)/AT_pic)^(1-RA_thetat)*(ATRA_piim(-1)^RA_chix*AT_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = AT_piim
// ATRA_piim = ATRA_pim/ATRA_pim(-1)*AT_pic;
// Bilateral real exchange rate
RAAT_rer = RA_rer/AT_rer;
// Auxiliary equation for steady-state output
RAAT_rerbar = RAAT_rer;
//Terms of Trade
RAAT_tot = AT_pex*RAAT_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = BE_pimtilde
// BERA_pimtilde/BERA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RABE_fx/RABE_gx;
// Definition of fx
// RABE_fx = BE_size/RA_size*BERA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(BERA_piim(+1)/(BERA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RABE_fx(+1);
// Definition of gx   
// RABE_gx = RABE_rer*BERA_pim*BE_size/RA_size*BERA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(BERA_piim(+1)/(BERA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RABE_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = BE_pim
// BERA_pim^(1-RA_thetat) = (1-RA_xix)*BERA_pimtilde^(1-RA_thetat)+RA_xix*(BERA_pim(-1)/BE_pic)^(1-RA_thetat)*(BERA_piim(-1)^RA_chix*BE_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = BE_piim
// BERA_piim = BERA_pim/BERA_pim(-1)*BE_pic;
// Bilateral real exchange rate
RABE_rer = RA_rer/BE_rer;
// Auxiliary equation for steady-state output
RABE_rerbar = RABE_rer;
//Terms of Trade
RABE_tot = BE_pex*RABE_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = ES_pimtilde
// ESRA_pimtilde/ESRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAES_fx/RAES_gx;
// Definition of fx
// RAES_fx = ES_size/RA_size*ESRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(ESRA_piim(+1)/(ESRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAES_fx(+1);
// Definition of gx   
// RAES_gx = RAES_rer*ESRA_pim*ES_size/RA_size*ESRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(ESRA_piim(+1)/(ESRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAES_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = ES_pim
// ESRA_pim^(1-RA_thetat) = (1-RA_xix)*ESRA_pimtilde^(1-RA_thetat)+RA_xix*(ESRA_pim(-1)/ES_pic)^(1-RA_thetat)*(ESRA_piim(-1)^RA_chix*ES_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = ES_piim
// ESRA_piim = ESRA_pim/ESRA_pim(-1)*ES_pic;
// Bilateral real exchange rate
RAES_rer = RA_rer/ES_rer;
// Auxiliary equation for steady-state output
RAES_rerbar = RAES_rer;
//Terms of Trade
RAES_tot = ES_pex*RAES_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = FI_pimtilde
// FIRA_pimtilde/FIRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAFI_fx/RAFI_gx;
// Definition of fx
// RAFI_fx = FI_size/RA_size*FIRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(FIRA_piim(+1)/(FIRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAFI_fx(+1);
// Definition of gx   
// RAFI_gx = RAFI_rer*FIRA_pim*FI_size/RA_size*FIRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(FIRA_piim(+1)/(FIRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAFI_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = FI_pim
// FIRA_pim^(1-RA_thetat) = (1-RA_xix)*FIRA_pimtilde^(1-RA_thetat)+RA_xix*(FIRA_pim(-1)/FI_pic)^(1-RA_thetat)*(FIRA_piim(-1)^RA_chix*FI_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = FI_piim
// FIRA_piim = FIRA_pim/FIRA_pim(-1)*FI_pic;
// Bilateral real exchange rate
RAFI_rer = RA_rer/FI_rer;
// Auxiliary equation for steady-state output
RAFI_rerbar = RAFI_rer;
//Terms of Trade
RAFI_tot = FI_pex*RAFI_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = FR_pimtilde
// FRRA_pimtilde/FRRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAFR_fx/RAFR_gx;
// Definition of fx
// RAFR_fx = FR_size/RA_size*FRRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(FRRA_piim(+1)/(FRRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAFR_fx(+1);
// Definition of gx   
// RAFR_gx = RAFR_rer*FRRA_pim*FR_size/RA_size*FRRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(FRRA_piim(+1)/(FRRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAFR_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = FR_pim
// FRRA_pim^(1-RA_thetat) = (1-RA_xix)*FRRA_pimtilde^(1-RA_thetat)+RA_xix*(FRRA_pim(-1)/FR_pic)^(1-RA_thetat)*(FRRA_piim(-1)^RA_chix*FR_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = FR_piim
// FRRA_piim = FRRA_pim/FRRA_pim(-1)*FR_pic;
// Bilateral real exchange rate
RAFR_rer = RA_rer/FR_rer;
// Auxiliary equation for steady-state output
RAFR_rerbar = RAFR_rer;
//Terms of Trade
RAFR_tot = FR_pex*RAFR_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = GR_pimtilde
// GRRA_pimtilde/GRRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAGR_fx/RAGR_gx;
// Definition of fx
// RAGR_fx = GR_size/RA_size*GRRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(GRRA_piim(+1)/(GRRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAGR_fx(+1);
// Definition of gx   
// RAGR_gx = RAGR_rer*GRRA_pim*GR_size/RA_size*GRRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(GRRA_piim(+1)/(GRRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAGR_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = GR_pim
// GRRA_pim^(1-RA_thetat) = (1-RA_xix)*GRRA_pimtilde^(1-RA_thetat)+RA_xix*(GRRA_pim(-1)/GR_pic)^(1-RA_thetat)*(GRRA_piim(-1)^RA_chix*GR_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = GR_piim
// GRRA_piim = GRRA_pim/GRRA_pim(-1)*GR_pic;
// Bilateral real exchange rate
RAGR_rer = RA_rer/GR_rer;
// Auxiliary equation for steady-state output
RAGR_rerbar = RAGR_rer;
//Terms of Trade
RAGR_tot = GR_pex*RAGR_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = IT_pimtilde
// ITRA_pimtilde/ITRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAIT_fx/RAIT_gx;
// Definition of fx
// RAIT_fx = IT_size/RA_size*ITRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(ITRA_piim(+1)/(ITRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAIT_fx(+1);
// Definition of gx   
// RAIT_gx = RAIT_rer*ITRA_pim*IT_size/RA_size*ITRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(ITRA_piim(+1)/(ITRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAIT_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = IT_pim
// ITRA_pim^(1-RA_thetat) = (1-RA_xix)*ITRA_pimtilde^(1-RA_thetat)+RA_xix*(ITRA_pim(-1)/IT_pic)^(1-RA_thetat)*(ITRA_piim(-1)^RA_chix*IT_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = IT_piim
// ITRA_piim = ITRA_pim/ITRA_pim(-1)*IT_pic;
// Bilateral real exchange rate
RAIT_rer = RA_rer/IT_rer;
// Auxiliary equation for steady-state output
RAIT_rerbar = RAIT_rer;
//Terms of Trade
RAIT_tot = IT_pex*RAIT_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = NL_pimtilde
// NLRA_pimtilde/NLRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RANL_fx/RANL_gx;
// Definition of fx
// RANL_fx = NL_size/RA_size*NLRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(NLRA_piim(+1)/(NLRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RANL_fx(+1);
// Definition of gx   
// RANL_gx = RANL_rer*NLRA_pim*NL_size/RA_size*NLRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(NLRA_piim(+1)/(NLRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RANL_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = NL_pim
// NLRA_pim^(1-RA_thetat) = (1-RA_xix)*NLRA_pimtilde^(1-RA_thetat)+RA_xix*(NLRA_pim(-1)/NL_pic)^(1-RA_thetat)*(NLRA_piim(-1)^RA_chix*NL_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = NL_piim
// NLRA_piim = NLRA_pim/NLRA_pim(-1)*NL_pic;
// Bilateral real exchange rate
RANL_rer = RA_rer/NL_rer;
// Auxiliary equation for steady-state output
RANL_rerbar = RANL_rer;
//Terms of Trade
RANL_tot = NL_pex*RANL_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = PT_pimtilde
// PTRA_pimtilde/PTRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAPT_fx/RAPT_gx;
// Definition of fx
// RAPT_fx = PT_size/RA_size*PTRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(PTRA_piim(+1)/(PTRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAPT_fx(+1);
// Definition of gx   
// RAPT_gx = RAPT_rer*PTRA_pim*PT_size/RA_size*PTRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(PTRA_piim(+1)/(PTRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAPT_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = PT_pim
// PTRA_pim^(1-RA_thetat) = (1-RA_xix)*PTRA_pimtilde^(1-RA_thetat)+RA_xix*(PTRA_pim(-1)/PT_pic)^(1-RA_thetat)*(PTRA_piim(-1)^RA_chix*PT_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = PT_piim
// PTRA_piim = PTRA_pim/PTRA_pim(-1)*PT_pic;
// Bilateral real exchange rate
RAPT_rer = RA_rer/PT_rer;
// Auxiliary equation for steady-state output
RAPT_rerbar = RAPT_rer;
//Terms of Trade
RAPT_tot = PT_pex*RAPT_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = DE_pimtilde
// DERA_pimtilde/DERA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RADE_fx/RADE_gx;
// Definition of fx
// RADE_fx = DE_size/RA_size*DERA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(DERA_piim(+1)/(DERA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RADE_fx(+1);
// Definition of gx   
// RADE_gx = RADE_rer*DERA_pim*DE_size/RA_size*DERA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(DERA_piim(+1)/(DERA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RADE_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = DE_pim
// DERA_pim^(1-RA_thetat) = (1-RA_xix)*DERA_pimtilde^(1-RA_thetat)+RA_xix*(DERA_pim(-1)/DE_pic)^(1-RA_thetat)*(DERA_piim(-1)^RA_chix*DE_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = DE_piim
// DERA_piim = DERA_pim/DERA_pim(-1)*DE_pic;
// Bilateral real exchange rate
RADE_rer = RA_rer/DE_rer;
// Auxiliary equation for steady-state output
RADE_rerbar = RADE_rer;
//Terms of Trade
RADE_tot = DE_pex*RADE_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = RU_pimtilde
// RURA_pimtilde/RURA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RARU_fx/RARU_gx;
// Definition of fx
// RARU_fx = RU_size/RA_size*RURA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(RURA_piim(+1)/(RURA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RARU_fx(+1);
// Definition of gx   
// RARU_gx = RARU_rer*RURA_pim*RU_size/RA_size*RURA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(RURA_piim(+1)/(RURA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RARU_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = RU_pim
// RURA_pim^(1-RA_thetat) = (1-RA_xix)*RURA_pimtilde^(1-RA_thetat)+RA_xix*(RURA_pim(-1)/RU_pic)^(1-RA_thetat)*(RURA_piim(-1)^RA_chix*RU_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = RU_piim
// RURA_piim = RURA_pim/RURA_pim(-1)*RU_pic;
// Bilateral real exchange rate
RARU_rer = RA_rer/RU_rer;
// Auxiliary equation for steady-state output
RARU_rerbar = RARU_rer;
//Terms of Trade
RARU_tot = RU_pex*RARU_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = RW_pimtilde
// RWRA_pimtilde/RWRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RARW_fx/RARW_gx;
// Definition of fx
// RARW_fx = RW_size/RA_size*RWRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(RWRA_piim(+1)/(RWRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RARW_fx(+1);
// Definition of gx   
// RARW_gx = RARW_rer*RWRA_pim*RW_size/RA_size*RWRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(RWRA_piim(+1)/(RWRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RARW_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = RW_pim
// RWRA_pim^(1-RA_thetat) = (1-RA_xix)*RWRA_pimtilde^(1-RA_thetat)+RA_xix*(RWRA_pim(-1)/RW_pic)^(1-RA_thetat)*(RWRA_piim(-1)^RA_chix*RW_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = RW_piim
// RWRA_piim = RWRA_pim/RWRA_pim(-1)*RW_pic;
// Bilateral real exchange rate
RARW_rer = RA_rer/RW_rer;
// Auxiliary equation for steady-state output
RARW_rerbar = RARW_rer;
//Terms of Trade
RARW_tot = RW_pex*RARW_rer/RA_pex;
// Optimal price contract set in foreign markets (FOC), using RA_pxtilde = US_pimtilde
// USRA_pimtilde/USRA_pim = RA_cpim*RA_thetat/(RA_thetat-1)*RAUS_fx/RAUS_gx;
// Definition of fx
// RAUS_fx = US_size/RA_size*USRA_im*RA_mct+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(USRA_piim(+1)/(USRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^RA_thetat*RAUS_fx(+1);
// Definition of gx   
// RAUS_gx = RAUS_rer*USRA_pim*US_size/RA_size*USRA_im+RA_xix*RA_beta*RA_lambdai(+1)/RA_lambdai*(USRA_piim(+1)/(USRA_piim^RA_chix*RA_pi4target^(1/4*(1-RA_chix))))^(RA_thetat-1)*RAUS_gx(+1);
// Aggregate intermediate-good price dynamics, using RA_px = US_pim
// USRA_pim^(1-RA_thetat) = (1-RA_xix)*USRA_pimtilde^(1-RA_thetat)+RA_xix*(USRA_pim(-1)/US_pic)^(1-RA_thetat)*(USRA_piim(-1)^RA_chix*US_pi4target^(1/4*(1-RA_chih)))^(1-RA_thetat);
// Intermediate-good price inflation, using RA_pix = US_piim
// USRA_piim = USRA_pim/USRA_pim(-1)*US_pic;
// Bilateral real exchange rate
RAUS_rer = RA_rer/US_rer;
// Auxiliary equation for steady-state output
RAUS_rerbar = RAUS_rer;
//Terms of Trade
RAUS_tot = US_pex*RAUS_rer/RA_pex;
// Total imports 
RA_im = 
+RA_imc
+RA_imi
+RA_imcg
+RA_imig
;
// Total import deflator
RA_im*RA_pim  = 
+RA_pimc*RA_imc
+RA_pimi*RA_imi
+RA_pimcg*RA_imcg
+RA_pimig*RA_imig
;
// Effective real exchange rate: double weighting (imports)
RAAT_weightim = RAAT_rer*AT_pex*RAAT_im/(RA_pim*RA_im);
// Effective real exchange rate: double weighting (exports)
RAAT_weightex = AT_size/RA_size*ATRA_im/RA_ex*RAAT_rer*AT_py*AT_y/(RAAT_rer*AT_py*AT_y
+RABE_rer*BE_pex*ATBE_im
+RAES_rer*ES_pex*ATES_im
