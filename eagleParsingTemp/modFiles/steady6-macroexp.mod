+PTRW_numig * (RW_pex*PTRW_rer)^(1-PT_mumig)
+PTUS_numig * (US_pex*PTUS_rer)^(1-PT_mumig)
+(1
-PTRA_numig
-PTAT_numig
-PTBE_numig
-PTES_numig
