// Aggregate intermediate-good price dynamics, using NL_px = FI_pim
// FINL_pim^(1-NL_thetat) = (1-NL_xix)*FINL_pimtilde^(1-NL_thetat)+NL_xix*(FINL_pim(-1)/FI_pic)^(1-NL_thetat)*(FINL_piim(-1)^NL_chix*FI_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = FI_piim
