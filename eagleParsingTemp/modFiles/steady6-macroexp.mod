)
+FR_size/BE_size*FRBE_im/BE_ex*BEAT_rer*AT_pex*FRAT_im/(BEFR_rer*FR_py*FR_y
+BERA_rer*RA_pex*FRRA_im
+BEAT_rer*AT_pex*FRAT_im
