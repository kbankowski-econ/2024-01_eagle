+ATUS_rer*US_pex*BEUS_im
)+
+RA_size/AT_size*RAAT_im/AT_ex*ATBE_rer*BE_pex*RABE_im/(ATRA_rer*RA_py*RA_y
+ATBE_rer*BE_pex*RABE_im
+ATES_rer*ES_pex*RAES_im
+ATFI_rer*FI_pex*RAFI_im
