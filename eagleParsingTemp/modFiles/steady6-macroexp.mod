)
+RW_size/AT_size*RWAT_im/AT_ex*ATRA_rer*RA_pex*RWRA_im/(ATRW_rer*RW_py*RW_y
+ATRA_rer*RA_pex*RWRA_im
+ATBE_rer*BE_pex*RWBE_im
+ATES_rer*ES_pex*RWES_im
+ATFI_rer*FI_pex*RWFI_im
+ATFR_rer*FR_pex*RWFR_im
+ATGR_rer*GR_pex*RWGR_im
+ATIT_rer*IT_pex*RWIT_im
+ATNL_rer*NL_pex*RWNL_im
+ATPT_rer*PT_pex*RWPT_im
+ATDE_rer*DE_pex*RWDE_im
+ATRU_rer*RU_pex*RWRU_im
+ATUS_rer*US_pex*RWUS_im
)
+US_size/AT_size*USAT_im/AT_ex*ATRA_rer*RA_pex*USRA_im/(ATUS_rer*US_py*US_y
+ATRA_rer*RA_pex*USRA_im
+ATBE_rer*BE_pex*USBE_im
+ATES_rer*ES_pex*USES_im
+ATFI_rer*FI_pex*USFI_im
+ATFR_rer*FR_pex*USFR_im
+ATGR_rer*GR_pex*USGR_im
+ATIT_rer*IT_pex*USIT_im
+ATNL_rer*NL_pex*USNL_im
+ATPT_rer*PT_pex*USPT_im
+ATDE_rer*DE_pex*USDE_im
+ATRU_rer*RU_pex*USRU_im
+ATRW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
ATRA_weight = AT_pim*AT_im/(AT_pim*AT_im+AT_pex*AT_ex)*ATRA_weightim+AT_pex*AT_ex/(AT_pim*AT_im+AT_pex*AT_ex)*ATRA_weightex;
// Effective real exchange rate: double weighting (imports)
ATBE_weightim = ATBE_rer*BE_pex*ATBE_im/(AT_pim*AT_im);
// Effective real exchange rate: double weighting (exports)
ATBE_weightex = BE_size/AT_size*BEAT_im/AT_ex*ATBE_rer*BE_py*BE_y/(ATBE_rer*BE_py*BE_y
+ATRA_rer*RA_pex*BERA_im
+ATES_rer*ES_pex*BEES_im
+ATFI_rer*FI_pex*BEFI_im
+ATFR_rer*FR_pex*BEFR_im
+ATGR_rer*GR_pex*BEGR_im
