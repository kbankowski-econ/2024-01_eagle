)
+FI_size/BE_size*FIBE_im/BE_ex*BERA_rer*RA_pex*FIRA_im/(BEFI_rer*FI_py*FI_y
+BERA_rer*RA_pex*FIRA_im
+BEAT_rer*AT_pex*FIAT_im
+BEES_rer*ES_pex*FIES_im
+BEFR_rer*FR_pex*FIFR_im
