)
+FR_size/ES_size*FRES_im/ES_ex*ESRA_rer*RA_pex*FRRA_im/(ESFR_rer*FR_py*FR_y
+ESRA_rer*RA_pex*FRRA_im
+ESAT_rer*AT_pex*FRAT_im
