+RAGR_rer*GR_pex*RUGR_im
+RAIT_rer*IT_pex*RUIT_im
+RANL_rer*NL_pex*RUNL_im
+RAPT_rer*PT_pex*RUPT_im
+RADE_rer*DE_pex*RUDE_im
+RARW_rer*RW_pex*RURW_im
+RAUS_rer*US_pex*RUUS_im
)
+US_size/RA_size*USRA_im/RA_ex*RARW_rer*RW_pex*USRW_im/(RAUS_rer*US_py*US_y
