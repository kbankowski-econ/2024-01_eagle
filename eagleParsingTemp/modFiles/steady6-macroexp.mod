// Private consumption good  (total)
DE_qi^((DE_mui-1)/DE_mui) = (DE_nui)^(1/DE_mui)*DE_tti^(1-1/DE_mui)+(1-DE_nui)^(1/DE_mui)*DE_nti^(1-1/DE_mui);
// Demand for domestic intermediate goods - NONTRADABLE
