+ATUS_rer*US_pex*NLUS_im
)
+PT_size/AT_size*PTAT_im/AT_ex*ATRA_rer*RA_pex*PTRA_im/(ATPT_rer*PT_py*PT_y
+ATRA_rer*RA_pex*PTRA_im
+ATBE_rer*BE_pex*PTBE_im
+ATES_rer*ES_pex*PTES_im
+ATFI_rer*FI_pex*PTFI_im
