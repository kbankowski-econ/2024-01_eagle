// Effective real exchange rate: double weighting (overall)
RWRA_weight = RW_pim*RW_im/(RW_pim*RW_im+RW_pex*RW_ex)*RWRA_weightim+RW_pex*RW_ex/(RW_pim*RW_im+RW_pex*RW_ex)*RWRA_weightex;
// Effective real exchange rate: double weighting (imports)
RWAT_weightim = RWAT_rer*AT_pex*RWAT_im/(RW_pim*RW_im);
// Effective real exchange rate: double weighting (exports)
RWAT_weightex = AT_size/RW_size*ATRW_im/RW_ex*RWAT_rer*AT_py*AT_y/(RWAT_rer*AT_py*AT_y
