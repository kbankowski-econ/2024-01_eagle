+FIES_rer*ES_pex*RWES_im
+FIFR_rer*FR_pex*RWFR_im
+FIGR_rer*GR_pex*RWGR_im
+FIIT_rer*IT_pex*RWIT_im
+FINL_rer*NL_pex*RWNL_im
