// Bilateral real exchange rate
PTRW_rer = PT_rer/RW_rer;
// Auxiliary equation for steady-state output
PTRW_rerbar = PTRW_rer;
//Terms of Trade
PTRW_tot = RW_pex*PTRW_rer/PT_pex;
// Optimal price contract set in foreign markets (FOC), using PT_pxtilde = US_pimtilde
// USPT_pimtilde/USPT_pim = PT_cpim*PT_thetat/(PT_thetat-1)*PTUS_fx/PTUS_gx;
// Definition of fx
// PTUS_fx = US_size/PT_size*USPT_im*PT_mct+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(USPT_piim(+1)/(USPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PTUS_fx(+1);
// Definition of gx   
// PTUS_gx = PTUS_rer*USPT_pim*US_size/PT_size*USPT_im+PT_xix*PT_beta*PT_lambdai(+1)/PT_lambdai*(USPT_piim(+1)/(USPT_piim^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^(PT_thetat-1)*PTUS_gx(+1);
// Aggregate intermediate-good price dynamics, using PT_px = US_pim
// USPT_pim^(1-PT_thetat) = (1-PT_xix)*USPT_pimtilde^(1-PT_thetat)+PT_xix*(USPT_pim(-1)/US_pic)^(1-PT_thetat)*(USPT_piim(-1)^PT_chix*US_pi4target^(1/4*(1-PT_chih)))^(1-PT_thetat);
// Intermediate-good price inflation, using PT_pix = US_piim
// USPT_piim = USPT_pim/USPT_pim(-1)*US_pic;
// Bilateral real exchange rate
PTUS_rer = PT_rer/US_rer;
// Auxiliary equation for steady-state output
PTUS_rerbar = PTUS_rer;
//Terms of Trade
PTUS_tot = US_pex*PTUS_rer/PT_pex;
// Total imports 
PT_im = 
+PT_imc
+PT_imi
+PT_imcg
+PT_imig
;
// Total import deflator
PT_im*PT_pim  = 
+PT_pimc*PT_imc
+PT_pimi*PT_imi
+PT_pimcg*PT_imcg
+PT_pimig*PT_imig
;
// Effective real exchange rate: double weighting (imports)
PTRA_weightim = PTRA_rer*RA_pex*PTRA_im/(PT_pim*PT_im);
// Effective real exchange rate: double weighting (exports)
PTRA_weightex = RA_size/PT_size*RAPT_im/PT_ex*PTRA_rer*RA_py*RA_y/(PTRA_rer*RA_py*RA_y
+PTAT_rer*AT_pex*RAAT_im
