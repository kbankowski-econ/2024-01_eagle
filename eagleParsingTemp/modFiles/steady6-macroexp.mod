// GRES_fx = ES_size/GR_size*ESGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(ESGR_piim(+1)/(ESGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRES_fx(+1);
