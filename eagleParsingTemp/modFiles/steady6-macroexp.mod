+ESUS_rer*US_pex*ATUS_im
)+
+RA_size/ES_size*RAES_im/ES_ex*ESAT_rer*AT_pex*RAAT_im/(ESRA_rer*RA_py*RA_y
+ESAT_rer*AT_pex*RAAT_im
+ESBE_rer*BE_pex*RABE_im
+ESFI_rer*FI_pex*RAFI_im
+ESFR_rer*FR_pex*RAFR_im
