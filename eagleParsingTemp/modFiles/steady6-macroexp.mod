RUUS_weight = RU_pim*RU_im/(RU_pim*RU_im+RU_pex*RU_ex)*RUUS_weightim+RU_pex*RU_ex/(RU_pim*RU_im+RU_pex*RU_ex)*RUUS_weightex;
