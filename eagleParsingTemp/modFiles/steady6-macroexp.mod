PTRW_gammaimigdag = 1;
PTUS_gammaimig = 0;
PTUS_gammaimigdag = 1;
// Trade balance
PT_tb =
+PT_pex*RA_size/PT_size*RAPT_im
-RA_pex*PTRA_rer*PTRA_im
+PT_pex*AT_size/PT_size*ATPT_im
-AT_pex*PTAT_rer*PTAT_im
+PT_pex*BE_size/PT_size*BEPT_im
-BE_pex*PTBE_rer*PTBE_im
+PT_pex*ES_size/PT_size*ESPT_im
-ES_pex*PTES_rer*PTES_im
+PT_pex*FI_size/PT_size*FIPT_im
-FI_pex*PTFI_rer*PTFI_im
+PT_pex*FR_size/PT_size*FRPT_im
-FR_pex*PTFR_rer*PTFR_im
+PT_pex*GR_size/PT_size*GRPT_im
-GR_pex*PTGR_rer*PTGR_im
+PT_pex*IT_size/PT_size*ITPT_im
-IT_pex*PTIT_rer*PTIT_im
+PT_pex*NL_size/PT_size*NLPT_im
-NL_pex*PTNL_rer*PTNL_im
+PT_pex*DE_size/PT_size*DEPT_im
-DE_pex*PTDE_rer*PTDE_im
+PT_pex*RU_size/PT_size*RUPT_im
-RU_pex*PTRU_rer*PTRU_im
+PT_pex*RW_size/PT_size*RWPT_im
-RW_pex*PTRW_rer*PTRW_im
+PT_pex*US_size/PT_size*USPT_im
-US_pex*PTUS_rer*PTUS_im
;
// Aggregate exports (volume)
PT_ex =
+RA_size/PT_size*RAPT_im
+AT_size/PT_size*ATPT_im
+BE_size/PT_size*BEPT_im
+ES_size/PT_size*ESPT_im
+FI_size/PT_size*FIPT_im
+FR_size/PT_size*FRPT_im
+GR_size/PT_size*GRPT_im
+IT_size/PT_size*ITPT_im
+NL_size/PT_size*NLPT_im
+DE_size/PT_size*DEPT_im
+RU_size/PT_size*RUPT_im
+RW_size/PT_size*RWPT_im
+US_size/PT_size*USPT_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using PT_pg = PT_pht
// TODO: check the (1-PT_gammab(-1)) adjustment here, which is not in the fiscal extention
	PT_pcg(-1)*PT_cg(-1)+PT_pig(-1)*PT_ig(-1)+PT_tr(-1)
	+PT_b(-1)*PT_pic(-1)^(-1)+PT_m(-2)*PT_pic(-1)^(-1) = PT_tauc(-1)*PT_c(-1)+(PT_taun(-1)+PT_tauwh(-1))*(PT_wi(-1)*PT_ndi(-1)+PT_wj(-1)*PT_ndj(-1))+PT_tauwf(-1)*PT_w(-1)*PT_nd(-1)+PT_tauk(-1)*(PT_rk(-1)*PT_u(-1)-(PT_gammau(-1)+PT_delta)*PT_pi(-1))*PT_k(-1)+PT_taud(-1)*PT_d(-1)+PT_t(-1)+(PT_r(-1)*(1-PT_gammab(-1)))^(-1)*PT_b+PT_m(-1);
// Government spending, using PT_pg = PT_pht
PT_pcg*PT_cg = PT_cgy*PT_pybar*PT_ybar;
PT_pig*PT_ig = PT_igy*PT_pybar*PT_ybar;
PT_t = 0;
PT_b = PT_bytarget*PT_pybar*PT_ybar;
// Auxiliary equation for steady-state output
PT_ybar = PT_y;
// Auxiliary equation for steady-state output
PT_ytbar = PT_yst;
// Auxiliary equation for steady-state output
PT_ynbar = PT_ysn;
// Auxiliary equation for steady-state output deflator
PT_pybar = PT_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
PT_trybar = PT_tr/(PT_pybar*PT_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
PT_ti = PT_upsilont*PT_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
PT_tri = PT_upsilontr*PT_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	PT_r = DE_r;
PT_pic4 = PT_pi4target;
PT_rr-1 = PT_r/PT_pi4target^(1/4)-1;
// Equilibrium real interest rate
PT_rrstar-1 = 1/PT_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
PT_c = (1-PT_omega)*PT_ci+PT_omega*PT_cj;
// Aggregate money holdings
PT_m = (1-PT_omega)*PT_mi+PT_omega*PT_mj;
// Aggregate capital stock
PT_k = (1-PT_omega)*PT_ki;
// Aggregate investment
PT_i = (1-PT_omega)*PT_ii;
// Aggregate lump-sum transfers
PT_trj = 
1/PT_omega*PT_tr-(1-PT_omega)/PT_omega*PT_tri
;
// Aggregate lump-sum taxes
PT_tj = 
1/PT_omega*PT_t-(1-PT_omega)/PT_omega*PT_ti
;
// Aggregate transaction costs
PT_gammav = (1-PT_omega)*PT_ci*PT_gammavi+PT_omega*PT_cj*PT_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
PT_ni = PT_si*PT_ndi;
// Wage dispersion
PT_si = (1-PT_xii)*(PT_witilde/PT_wi)^(-PT_etai)+PT_xii*(PT_wi(-1)/PT_wi)^(-PT_etai)*(PT_pic/(PT_pic(-1)^PT_chii*PT_pi4target^(1/4*(1-PT_chii))))^(PT_etai)*PT_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
PT_nj = PT_sj*PT_ndj;
// Wage dispersion
PT_sj = (1-PT_xij)*(PT_wjtilde/PT_wj)^(-PT_etaj)+PT_xij*(PT_wj(-1)/PT_wj)^(-PT_etaj)*(PT_pic/(PT_pic(-1)^PT_chij*PT_pi4target^(1/4*(1-PT_chij))))^(PT_etaj)*PT_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
PT_u*PT_k = PT_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using PT_x = DE_size/PT_size*DE_im
PT_ysn = PT_snt*PT_nt;
//  nontradables aggregate demand
PT_nt = 
+PT_ntc
+PT_nti
+PT_ntcg
+PT_ntig
;
// Aggregate demand for domestic intermediate goods, using PT_hg = PT_cg
PT_ht =
+PT_htc
+PT_hti
+PT_htcg
+PT_htig
;
// Price dispersion in the domestic markets
PT_sh = (1-PT_xih)*(PT_phttilde/PT_pht)^(-PT_thetat)+PT_xih*(PT_piht/(PT_piht(-1)^PT_chih*PT_pi4target^(1/4*(1-PT_chih))))^PT_thetat*PT_sh(-1);
// Price dispersion in the foreign markets
PT_sx = (1-PT_xix)*(PT_pextilde/PT_pex)^(-PT_thetat)+PT_xix*(PT_piex/(PT_piex(-1)^PT_chix*PT_pi4target^(1/4*(1-PT_chix))))^PT_thetat*PT_sx(-1);
// Price dispersion in the domestic markets
PT_snt = (1-PT_xin)*(PT_pnttilde/PT_pnt)^(-PT_thetan)+PT_xin*(PT_pint/(PT_pint(-1)^PT_chin*PT_pi4target^(1/4*(1-PT_chin))))^PT_thetan*PT_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
PT_qc = PT_c+PT_gammav;
// Aggregate investment and capital utilisation cost
PT_qi = PT_i+PT_k*PT_gammau;
// Aggregate gov demand components added to use the same structure like in private components
PT_qcg = PT_cg;
PT_qig = PT_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
PT_py*PT_y = 
+PT_qc
+PT_pi*PT_qi
+PT_pcg*PT_qcg
+PT_pig*PT_qig
+PT_pex*RA_size/PT_size*RAPT_im
-(RA_pex*PTRA_rer)*PTRA_imc
-(RA_pex*PTRA_rer)*PTRA_imi
-(RA_pex*PTRA_rer)*PTRA_imcg
-(RA_pex*PTRA_rer)*PTRA_imig
+PT_pex*AT_size/PT_size*ATPT_im
-(AT_pex*PTAT_rer)*PTAT_imc
-(AT_pex*PTAT_rer)*PTAT_imi
-(AT_pex*PTAT_rer)*PTAT_imcg
-(AT_pex*PTAT_rer)*PTAT_imig
+PT_pex*BE_size/PT_size*BEPT_im
-(BE_pex*PTBE_rer)*PTBE_imc
-(BE_pex*PTBE_rer)*PTBE_imi
-(BE_pex*PTBE_rer)*PTBE_imcg
-(BE_pex*PTBE_rer)*PTBE_imig
+PT_pex*ES_size/PT_size*ESPT_im
-(ES_pex*PTES_rer)*PTES_imc
-(ES_pex*PTES_rer)*PTES_imi
-(ES_pex*PTES_rer)*PTES_imcg
-(ES_pex*PTES_rer)*PTES_imig
+PT_pex*FI_size/PT_size*FIPT_im
-(FI_pex*PTFI_rer)*PTFI_imc
-(FI_pex*PTFI_rer)*PTFI_imi
-(FI_pex*PTFI_rer)*PTFI_imcg
-(FI_pex*PTFI_rer)*PTFI_imig
+PT_pex*FR_size/PT_size*FRPT_im
-(FR_pex*PTFR_rer)*PTFR_imc
-(FR_pex*PTFR_rer)*PTFR_imi
-(FR_pex*PTFR_rer)*PTFR_imcg
-(FR_pex*PTFR_rer)*PTFR_imig
+PT_pex*GR_size/PT_size*GRPT_im
-(GR_pex*PTGR_rer)*PTGR_imc
-(GR_pex*PTGR_rer)*PTGR_imi
-(GR_pex*PTGR_rer)*PTGR_imcg
-(GR_pex*PTGR_rer)*PTGR_imig
+PT_pex*IT_size/PT_size*ITPT_im
-(IT_pex*PTIT_rer)*PTIT_imc
-(IT_pex*PTIT_rer)*PTIT_imi
-(IT_pex*PTIT_rer)*PTIT_imcg
-(IT_pex*PTIT_rer)*PTIT_imig
+PT_pex*NL_size/PT_size*NLPT_im
-(NL_pex*PTNL_rer)*PTNL_imc
-(NL_pex*PTNL_rer)*PTNL_imi
-(NL_pex*PTNL_rer)*PTNL_imcg
-(NL_pex*PTNL_rer)*PTNL_imig
+PT_pex*DE_size/PT_size*DEPT_im
-(DE_pex*PTDE_rer)*PTDE_imc
-(DE_pex*PTDE_rer)*PTDE_imi
-(DE_pex*PTDE_rer)*PTDE_imcg
-(DE_pex*PTDE_rer)*PTDE_imig
+PT_pex*RU_size/PT_size*RUPT_im
-(RU_pex*PTRU_rer)*PTRU_imc
-(RU_pex*PTRU_rer)*PTRU_imi
-(RU_pex*PTRU_rer)*PTRU_imcg
-(RU_pex*PTRU_rer)*PTRU_imig
+PT_pex*RW_size/PT_size*RWPT_im
-(RW_pex*PTRW_rer)*PTRW_imc
-(RW_pex*PTRW_rer)*PTRW_imi
-(RW_pex*PTRW_rer)*PTRW_imcg
-(RW_pex*PTRW_rer)*PTRW_imig
+PT_pex*US_size/PT_size*USPT_im
-(US_pex*PTUS_rer)*PTUS_imc
-(US_pex*PTUS_rer)*PTUS_imi
-(US_pex*PTUS_rer)*PTUS_imcg
-(US_pex*PTUS_rer)*PTUS_imig
;
// Aggregate real demand
PT_y = PT_yst+PT_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(PT_zt) = (1-PT_rhozt)*log(PT_ztbar)+PT_rhozt*log(PT_zt(-1))+PT_epszt;
log(PT_zn) = (1-PT_rhozn)*log(PT_znbar)+PT_rhozn*log(PT_zn(-1))+PT_epszn;
// Government spending shock
PT_cgy = (1-PT_rhocg)*PT_cgybar+PT_rhocg*PT_cgy(-1)+PT_epsgc;
PT_igy = (1-PT_rhoig)*PT_igybar+PT_rhoig*PT_igy(-1)+PT_epsgi;
// Transfer shock
PT_try = (1-PT_rhotr)*PT_trybar+PT_rhotr*PT_try(-1)+PT_epstr;
// Consumption tax shock
PT_tauc = (1-PT_rhotauc)*PT_taucbar+PT_rhotauc*PT_tauc(-1)+PT_epstauc;
// Dividend income tax shock
PT_taud = (1-PT_rhotaud)*PT_taudbar+PT_rhotaud*PT_taud(-1)+PT_epstaud;
// Capital income tax shock
PT_tauk = (1-PT_rhotauk)*PT_taukbar+PT_rhotauk*PT_tauk(-1)+PT_epstauk;
// Labour income tax shock
PT_taun = (1-PT_rhotaun)*PT_taunbar+PT_rhotaun*PT_taun(-1)+PT_epstaun;
// Payroll tax shock: households
PT_tauwh = (1-PT_rhotauwh)*PT_tauwhbar+PT_rhotauwh*PT_tauwh(-1)+PT_epstauwh;
// Payroll tax shock: firms
PT_tauwf = (1-PT_rhotauwf)*PT_tauwfbar+PT_rhotauwf*PT_tauwf(-1)+PT_epstauwf;
// Wage cost push shock
PT_wcst = (1-PT_rhowcst)*PT_wcstbar+PT_rhowcst*PT_wcst(-1)+PT_epswcst;
// Preference shock
log(PT_zcon) = (1-PT_rhozcon)*log(PT_zconbar)+PT_rhozcon*log(PT_zcon(-1))+PT_epszcon;
// Investment specific shock
log(PT_zinv) = (1-PT_rhozinv)*log(PT_zinvbar)+PT_rhozinv*log(PT_zinv(-1))+PT_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
PT_cy = PT_c/(PT_py*PT_y);
// Aggregate nominal investment share
PT_iy = PT_pi*PT_i/(PT_py*PT_y);
// Aggregate nominal import share  
PT_imy = (
+PT_pimc*PT_imc
+PT_pimi*PT_imi
+PT_pimcg*PT_imcg
+PT_pimig*PT_imig
)/(PT_py*PT_y);
// Aggregate nominal import share
PT_imcy = PT_pimc*PT_imc/(PT_py*PT_y);
PT_imiy = PT_pimi*PT_imi/(PT_py*PT_y);
PT_imcgy = PT_pimcg*PT_imcg/(PT_py*PT_y);
PT_imigy = PT_pimig*PT_imig/(PT_py*PT_y);
// Aggregate debt-to-output ratio
PT_by = PT_b/(PT_pybar*PT_ybar);
// Aggregate lump-sum tax-to-output ratio
PT_ty = PT_t/(PT_pybar*PT_ybar);
// Aggregate labour cost share
PT_lcy = ((1+PT_tauwf)*PT_w*PT_nd)/(PT_py*PT_y);
// Aggregate nominal Wage share
PT_wy = (PT_w*PT_nd)/(PT_py*PT_y);
// NT sector nominal Wage share
PT_wnty = (PT_w*PT_ndn)/(PT_pnt*PT_ysn);
// T sector nominal Wage share
PT_whty = (PT_w*PT_ndt)/(PT_pht*PT_yst);
// T sector share
PT_yhty = PT_pht*PT_yst/(PT_py*PT_y);
// NT sector share
PT_ynty = PT_pnt*PT_ysn/(PT_py*PT_y);
// Output gap
PT_ygap = 0;
// Output growth (gross rate)
PT_ygrowth = PT_y/PT_y(-1);
// Output growth (gross rate yoy)
PT_ygrowth4 = PT_y/PT_y(-4);
// Domestic nominal output as a share of world nominal output
PT_yshare  = PT_size*PT_py*PT_y/PT_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
PT_epsilonm = -1/8*1/(PT_r*(PT_gammav2*PT_r+PT_r-1));
// Trade balance-to-GDP ratio
PT_tby = PT_tb/(PT_py*PT_y);
// Bilateral shares
PTRA_imcy = (RA_pex*PTRA_rer)*PTRA_imc/(PT_py*PT_y);
PTRA_imiy = (RA_pex*PTRA_rer)*PTRA_imi/(PT_py*PT_y);
PTRA_imcgy = (RA_pex*PTRA_rer)*PTRA_imcg/(PT_py*PT_y);
PTRA_imigy = (RA_pex*PTRA_rer)*PTRA_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTRA_excy  = RA_size/PT_size*PT_pex*RAPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTRA_exiy  = RA_size/PT_size*PT_pex*RAPT_imi/(PT_py*PT_y);
// Bilateral shares
PTAT_imcy = (AT_pex*PTAT_rer)*PTAT_imc/(PT_py*PT_y);
PTAT_imiy = (AT_pex*PTAT_rer)*PTAT_imi/(PT_py*PT_y);
PTAT_imcgy = (AT_pex*PTAT_rer)*PTAT_imcg/(PT_py*PT_y);
PTAT_imigy = (AT_pex*PTAT_rer)*PTAT_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTAT_excy  = AT_size/PT_size*PT_pex*ATPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTAT_exiy  = AT_size/PT_size*PT_pex*ATPT_imi/(PT_py*PT_y);
// Bilateral shares
PTBE_imcy = (BE_pex*PTBE_rer)*PTBE_imc/(PT_py*PT_y);
PTBE_imiy = (BE_pex*PTBE_rer)*PTBE_imi/(PT_py*PT_y);
PTBE_imcgy = (BE_pex*PTBE_rer)*PTBE_imcg/(PT_py*PT_y);
PTBE_imigy = (BE_pex*PTBE_rer)*PTBE_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTBE_excy  = BE_size/PT_size*PT_pex*BEPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTBE_exiy  = BE_size/PT_size*PT_pex*BEPT_imi/(PT_py*PT_y);
// Bilateral shares
PTES_imcy = (ES_pex*PTES_rer)*PTES_imc/(PT_py*PT_y);
PTES_imiy = (ES_pex*PTES_rer)*PTES_imi/(PT_py*PT_y);
PTES_imcgy = (ES_pex*PTES_rer)*PTES_imcg/(PT_py*PT_y);
PTES_imigy = (ES_pex*PTES_rer)*PTES_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTES_excy  = ES_size/PT_size*PT_pex*ESPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTES_exiy  = ES_size/PT_size*PT_pex*ESPT_imi/(PT_py*PT_y);
// Bilateral shares
PTFI_imcy = (FI_pex*PTFI_rer)*PTFI_imc/(PT_py*PT_y);
PTFI_imiy = (FI_pex*PTFI_rer)*PTFI_imi/(PT_py*PT_y);
PTFI_imcgy = (FI_pex*PTFI_rer)*PTFI_imcg/(PT_py*PT_y);
PTFI_imigy = (FI_pex*PTFI_rer)*PTFI_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTFI_excy  = FI_size/PT_size*PT_pex*FIPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTFI_exiy  = FI_size/PT_size*PT_pex*FIPT_imi/(PT_py*PT_y);
// Bilateral shares
PTFR_imcy = (FR_pex*PTFR_rer)*PTFR_imc/(PT_py*PT_y);
PTFR_imiy = (FR_pex*PTFR_rer)*PTFR_imi/(PT_py*PT_y);
PTFR_imcgy = (FR_pex*PTFR_rer)*PTFR_imcg/(PT_py*PT_y);
PTFR_imigy = (FR_pex*PTFR_rer)*PTFR_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTFR_excy  = FR_size/PT_size*PT_pex*FRPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTFR_exiy  = FR_size/PT_size*PT_pex*FRPT_imi/(PT_py*PT_y);
// Bilateral shares
PTGR_imcy = (GR_pex*PTGR_rer)*PTGR_imc/(PT_py*PT_y);
PTGR_imiy = (GR_pex*PTGR_rer)*PTGR_imi/(PT_py*PT_y);
PTGR_imcgy = (GR_pex*PTGR_rer)*PTGR_imcg/(PT_py*PT_y);
PTGR_imigy = (GR_pex*PTGR_rer)*PTGR_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTGR_excy  = GR_size/PT_size*PT_pex*GRPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTGR_exiy  = GR_size/PT_size*PT_pex*GRPT_imi/(PT_py*PT_y);
// Bilateral shares
PTIT_imcy = (IT_pex*PTIT_rer)*PTIT_imc/(PT_py*PT_y);
PTIT_imiy = (IT_pex*PTIT_rer)*PTIT_imi/(PT_py*PT_y);
PTIT_imcgy = (IT_pex*PTIT_rer)*PTIT_imcg/(PT_py*PT_y);
PTIT_imigy = (IT_pex*PTIT_rer)*PTIT_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTIT_excy  = IT_size/PT_size*PT_pex*ITPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTIT_exiy  = IT_size/PT_size*PT_pex*ITPT_imi/(PT_py*PT_y);
// Bilateral shares
PTNL_imcy = (NL_pex*PTNL_rer)*PTNL_imc/(PT_py*PT_y);
PTNL_imiy = (NL_pex*PTNL_rer)*PTNL_imi/(PT_py*PT_y);
PTNL_imcgy = (NL_pex*PTNL_rer)*PTNL_imcg/(PT_py*PT_y);
PTNL_imigy = (NL_pex*PTNL_rer)*PTNL_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTNL_excy  = NL_size/PT_size*PT_pex*NLPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTNL_exiy  = NL_size/PT_size*PT_pex*NLPT_imi/(PT_py*PT_y);
// Bilateral shares
PTDE_imcy = (DE_pex*PTDE_rer)*PTDE_imc/(PT_py*PT_y);
PTDE_imiy = (DE_pex*PTDE_rer)*PTDE_imi/(PT_py*PT_y);
PTDE_imcgy = (DE_pex*PTDE_rer)*PTDE_imcg/(PT_py*PT_y);
PTDE_imigy = (DE_pex*PTDE_rer)*PTDE_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTDE_excy  = DE_size/PT_size*PT_pex*DEPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTDE_exiy  = DE_size/PT_size*PT_pex*DEPT_imi/(PT_py*PT_y);
// Bilateral shares
PTRU_imcy = (RU_pex*PTRU_rer)*PTRU_imc/(PT_py*PT_y);
PTRU_imiy = (RU_pex*PTRU_rer)*PTRU_imi/(PT_py*PT_y);
PTRU_imcgy = (RU_pex*PTRU_rer)*PTRU_imcg/(PT_py*PT_y);
PTRU_imigy = (RU_pex*PTRU_rer)*PTRU_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTRU_excy  = RU_size/PT_size*PT_pex*RUPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTRU_exiy  = RU_size/PT_size*PT_pex*RUPT_imi/(PT_py*PT_y);
// Bilateral shares
PTRW_imcy = (RW_pex*PTRW_rer)*PTRW_imc/(PT_py*PT_y);
PTRW_imiy = (RW_pex*PTRW_rer)*PTRW_imi/(PT_py*PT_y);
PTRW_imcgy = (RW_pex*PTRW_rer)*PTRW_imcg/(PT_py*PT_y);
PTRW_imigy = (RW_pex*PTRW_rer)*PTRW_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTRW_excy  = RW_size/PT_size*PT_pex*RWPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTRW_exiy  = RW_size/PT_size*PT_pex*RWPT_imi/(PT_py*PT_y);
// Bilateral shares
PTUS_imcy = (US_pex*PTUS_rer)*PTUS_imc/(PT_py*PT_y);
PTUS_imiy = (US_pex*PTUS_rer)*PTUS_imi/(PT_py*PT_y);
PTUS_imcgy = (US_pex*PTUS_rer)*PTUS_imcg/(PT_py*PT_y);
PTUS_imigy = (US_pex*PTUS_rer)*PTUS_imig/(PT_py*PT_y);
// Exports of consumption goods to gdp
PTUS_excy  = US_size/PT_size*PT_pex*USPT_imc/(PT_py*PT_y);
// Exports of investment goods to gdp
PTUS_exiy  = US_size/PT_size*PT_pex*USPT_imi/(PT_py*PT_y);
// Internal real exchange rate
PT_internalrer = PT_pnt/PT_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
DE_ccesi^(1-1/DE_mucces) = (DE_nucces)^(1/DE_mucces)*DE_ci^(1-1/DE_mucces)+(1-DE_nucces)^(1/DE_mucces)*DE_cg^(1-1/DE_mucces);
// Utility
DE_utili = 
DE_zcon*log(DE_ccesi-DE_kappa*DE_ccesi(-1))-1/(1+DE_zeta)*(DE_ni)^(1+DE_zeta)+DE_beta*DE_utili(+1)
;
// Marginal utility of consumption
DE_dcci = ((DE_nucces)^(1/DE_mucces)*DE_ci^(1-1/DE_mucces)+(1-DE_nucces)^(1/DE_mucces)*DE_cg^(1-1/DE_mucces))^(1/(DE_mucces-1))*(DE_nucces^(1/DE_mucces))*(DE_ci^(-1/DE_mucces));
DE_lambdai*(1+DE_tauc+DE_gammavi+DE_vi*DE_gammavider) = DE_zcon*(DE_ccesi-DE_kappa*DE_ccesi(-1))^(-DE_sigma)*DE_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
// Germany
DE_r = DE_beta^(-1)*DE_lambdai/DE_lambdai(+1)*DE_pic(+1);
// US and the RoW
// Euler equation for money
DE_vi^(2)*DE_gammavider = 1-DE_beta*DE_lambdai(+1)/(DE_lambdai*DE_pic(+1));
// Consumption-based velocity
DE_vi = DE_ci/DE_mi;
// Transaction cost
DE_gammavi = DE_gammav1*DE_vi+DE_gammav2/DE_vi-2*(DE_gammav1*DE_gammav2)^(1/2);
// Derivative of transaction cost
DE_gammavider = DE_gammav1-DE_gammav2*DE_vi^(-2);
DE_delta = DE_ii/DE_ki;
DE_gammai = 0;
DE_gammaider = 0;
DE_gammau = 0;
DE_gammauder = ((DE_beta^(-1)-1+DE_delta)*DE_qbar-DE_delta*DE_taukbar*DE_pibar)/((1-DE_taukbar)*DE_pibar);
DE_u = 1;
DE_pi = DE_q;
// Auxiliary equation for Tobin's Q in steady state
DE_qbar = DE_q;
// Rate of return on capital
DE_q = DE_beta*((1-DE_tauk)*DE_rk+(DE_tauk*DE_delta)*DE_pi+(1-DE_delta)*DE_q);
// Optimal wage contract (FOC)
DE_witilde^(1+DE_etai*DE_zeta) = DE_etai/(DE_etai-1)*DE_fi/DE_gi+DE_wcst;
// Definition of fi
DE_fi = DE_wi^(DE_etai*(1+DE_zeta))*DE_ndi^(1+DE_zeta)+DE_xii*DE_beta*(DE_pic(+1)/(DE_pic^DE_chii*DE_pi4target^(1/4*(1-DE_chii))))^(DE_etai*(1+DE_zeta))*DE_fi(+1);
// Definition of gi
DE_gi = DE_lambdai*(1-DE_taun-DE_tauwh)*DE_wi^DE_etai*DE_ndi+DE_xii*DE_beta*(DE_pic(+1)/(DE_pic^DE_chii*DE_pi4target^(1/4*(1-DE_chii))))^(DE_etai-1)*DE_gi(+1);
// Aggregate wage rate
DE_wi^(1-DE_etai) = (1-DE_xii)*DE_witilde^(1-DE_etai)+DE_xii*DE_wi(-1)^(1-DE_etai)*(DE_pic(-1)^DE_chii*DE_pi4target^(1/4*(1-DE_chii))/DE_pic)^(1-DE_etai);
//-------------
// Household J
//-------------
DE_ccesj^(1-1/DE_mucces) = (DE_nucces)^(1/DE_mucces)*DE_cj^(1-1/DE_mucces)+(1-DE_nucces)^(1/DE_mucces)*DE_cg^(1-1/DE_mucces);
// Utility
DE_utilj = 
DE_zcon*log(DE_ccesj-DE_kappa*DE_ccesj(-1))-1/(1+DE_zeta)*(DE_nj)^(1+DE_zeta)+DE_beta*DE_utilj(+1)
;
// Marginal utility of consumption
DE_dccj = ((DE_nucces)^(1/DE_mucces)*DE_cj^(1-1/DE_mucces)+(1-DE_nucces)^(1/DE_mucces)*DE_cg^(1-1/DE_mucces))^(1/(DE_mucces-1))*(DE_nucces^(1/DE_mucces))*(DE_cj^(-1/DE_mucces));
DE_lambdaj*(1+DE_tauc+DE_gammavj+DE_vj*DE_gammavjder) = DE_zcon*(DE_ccesj-DE_kappa*DE_ccesj(-1))^(-DE_sigma)*DE_dccj;
// Budget constraint
(1+DE_tauc+DE_gammavj)*DE_cj+DE_mj = (1-DE_taun-DE_tauwh)*DE_wj*DE_nj+DE_trj-DE_tj+DE_mj(-1)*DE_pic^(-1);
// Euler equation for money
DE_vj^(2)*DE_gammavjder = 1-DE_beta*DE_lambdaj(+1)/(DE_lambdaj*DE_pic(+1));
// Consumption-based velocity
DE_vj = DE_cj/DE_mj;
// Transaction technology
DE_gammavj = DE_gammav1*DE_vj+DE_gammav2/DE_vj-2*(DE_gammav1*DE_gammav2)^(1/2);
// Derivative of transaction technology
DE_gammavjder = DE_gammav1-DE_gammav2*DE_vj^(-2);
// Optimal wage contract (FOC)
DE_wjtilde^(1+DE_etaj*DE_zeta) = DE_etaj/(DE_etaj-1)*DE_fj/DE_gj+DE_wcst;
// Definition of fj
DE_fj = DE_wj^(DE_etaj*(1+DE_zeta))*DE_ndj^(1+DE_zeta)+DE_xij*DE_beta*(DE_pic(+1)/(DE_pic^DE_chij*DE_pi4target^(1/4*(1-DE_chij))))^(DE_etaj*(1+DE_zeta))*DE_fj(+1);
// Definition of gj
DE_gj = DE_lambdaj*(1-DE_taun-DE_tauwh)*DE_wj^DE_etaj*DE_ndj+DE_xij*DE_beta*(DE_pic(+1)/(DE_pic^DE_chij*DE_pi4target^(1/4*(1-DE_chij))))^(DE_etaj-1)*DE_gj(+1);
// Aggregate wage rate
DE_wj^(1-DE_etaj) = (1-DE_xij)*DE_wjtilde^(1-DE_etaj)+DE_xij*DE_wj(-1)^(1-DE_etaj)*(DE_pic(-1)^DE_chij*DE_pi4target^(1/4*(1-DE_chij))/DE_pic)^(1-DE_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
DE_kg = (1-DE_deltag)*DE_kg(-1)+DE_ig(-1);
// Production function tradable
DE_yst = DE_zt*DE_kg^DE_alphag*DE_kdt^DE_alphat*DE_ndt^(1-DE_alphat)-DE_psitbar;
// Production function nontradable
DE_ysn = DE_zn*DE_kg^DE_alphag*DE_kdn^DE_alphan*DE_ndn^(1-DE_alphan)-DE_psinbar;
// Real marginal cost tradable
DE_mct = 1/(DE_zt*DE_kg^DE_alphag*(DE_alphat)^(DE_alphat)*(1-DE_alphat)^(1-DE_alphat))*DE_rk^(DE_alphat)*((1+DE_tauwf)*DE_w)^(1-DE_alphat);
// Real marginal cost nontradable
DE_mcn = 1/(DE_zn*DE_kg^DE_alphag*(DE_alphan)^(DE_alphan)*(1-DE_alphan)^(1-DE_alphan))*DE_rk^(DE_alphan)*((1+DE_tauwf)*DE_w)^(1-DE_alphan);
// Wage Inflation (qoq)
DE_piw = DE_w/DE_w(-1)*DE_pic;
// Wage Inflation (yoy)
DE_piw4 = DE_pic4;
// Auxiliary equation for steady-state fixed cost
DE_psitbar = DE_psit*DE_ytbar;
// Auxiliary equation for steady-state fixed cost
DE_psinbar = DE_psin*DE_ynbar;
// Capital input (FOC)
DE_rk = DE_alphat*(DE_yst+DE_psitbar)/DE_kdt*DE_mct;
// Capital input (FOC)
DE_rk = DE_alphan*(DE_ysn+DE_psinbar)/DE_kdn*DE_mcn;
// Total capital demand
DE_kd = DE_kdt+DE_kdn;
// Demand for labour services by household I
DE_ndi = 
(1-DE_omega)*(DE_wi/DE_w)^(-DE_eta)*DE_nd
;
// Demand for labour services by household J
DE_ndj = 
DE_omega*(DE_wj/DE_w)^(-DE_eta)*DE_nd
;
// Aggregate labour demand
DE_nd^(1-1/DE_eta) = 
(1-DE_omega)^(1/DE_eta)*DE_ndi^(1-1/DE_eta)+DE_omega^(1/DE_eta)*DE_ndj^(1-1/DE_eta)
;
// Total demand 
DE_nd = DE_ndt+DE_ndn;
// Aggregate dividends
DE_d = DE_py*DE_y-DE_rk*DE_kd-(1+DE_tauwf)*DE_w*DE_nd;
// Non-tradable sector dividends
DE_dn = DE_pnt*DE_ysn-DE_rk*DE_kdn-(1+DE_tauwf)*DE_w*DE_ndn;
// Tradable sector dividends
DE_dt = DE_pht*DE_ht
+DE_pex*DE_ex
-DE_rk*DE_kdt-(1+DE_tauwf)*DE_w*DE_ndt;
// Optimal price contract set in domestic markets (FOC)
DE_phttilde/DE_pht = DE_thetat/(DE_thetat-1)*DE_fh/DE_gh;
// Definition of fh
DE_fh = DE_mct*DE_ht+DE_xih*DE_beta*DE_lambdai(+1)/DE_lambdai*(DE_piht(+1)/(DE_piht^DE_chih*DE_pi4target^(1/4*(1-DE_chih))))^DE_thetat*DE_fh(+1);
// Definition of gh
DE_gh = DE_pht*DE_ht+DE_xih*DE_beta*DE_lambdai(+1)/DE_lambdai*(DE_piht(+1)/(DE_piht^DE_chih*DE_pi4target^(1/4*(1-DE_chih))))^(DE_thetat-1)*DE_gh(+1);
// Aggregate intermediate-good price dynamics
DE_pht^(1-DE_thetat) = (1-DE_xih)*DE_phttilde^(1-DE_thetat)+DE_xih*(DE_pht(-1)/DE_pic)^(1-DE_thetat)*(DE_piht(-1)^DE_chih*DE_pi4target^(1/4*(1-DE_chih)))^(1-DE_thetat);
// Intermediate-good price inflation
DE_piht = DE_pht/DE_pht(-1)*DE_pic;
// Optimal price contract set in domestic markets (FOC)
DE_pnttilde/DE_pnt = DE_thetan/(DE_thetan-1)*DE_fn/DE_gn;
// Definition of fn
DE_fn = DE_mcn*DE_nt+DE_xin*DE_beta*DE_lambdai(+1)/DE_lambdai*(DE_pint(+1)/(DE_pint^DE_chin*DE_pi4target^(1/4*(1-DE_chin))))^DE_thetan*DE_fn(+1);
// Definition of gn
DE_gn = DE_pnt*DE_nt+DE_xin*DE_beta*DE_lambdai(+1)/DE_lambdai*(DE_pint(+1)/(DE_pint^DE_chin*DE_pi4target^(1/4*(1-DE_chin))))^(DE_thetan-1)*DE_gn(+1);
// Aggregate intermediate-good price dynamics
DE_pnt^(1-DE_thetan) = (1-DE_xin)*DE_pnttilde^(1-DE_thetan)+DE_xin*(DE_pnt(-1)/DE_pic)^(1-DE_thetan)*(DE_pint(-1)^DE_chin*DE_pi4target^(1/4*(1-DE_chin)))^(1-DE_thetan);
// Intermediate-good price inflation
DE_pint = DE_pnt/DE_pnt(-1)*DE_pic;
// Optimal price contract set in domestic markets (FOC)
DE_pextilde/DE_pex = DE_thetat/(DE_thetat-1)*DE_fx/DE_gx;
// Definition of fh
DE_fx = DE_mct*DE_ex+DE_xix*DE_beta*DE_lambdai(+1)/DE_lambdai*(DE_piex(+1)/(DE_piex^DE_chix*DE_pi4target^(1/4*(1-DE_chix))))^DE_thetat*DE_fx(+1);
// Definition of gh
DE_gx = DE_pex*DE_ex+DE_xix*DE_beta*DE_lambdai(+1)/DE_lambdai*(DE_piex(+1)/(DE_piex^DE_chix*DE_pi4target^(1/4*(1-DE_chix))))^(DE_thetat-1)*DE_gx(+1);
// Aggregate intermediate-good price dynamics
DE_pex^(1-DE_thetat) = (1-DE_xix)*DE_pextilde^(1-DE_thetat)+DE_xix*(DE_pex(-1)/DE_pic)^(1-DE_thetat)*(DE_piex(-1)^DE_chix*DE_pi4target^(1/4*(1-DE_chix)))^(1-DE_thetat);
// Intermediate-good price inflation
DE_piex = DE_pex/DE_pex(-1)*DE_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using DE_pxtilde = RA_pimtilde
// RADE_pimtilde/RADE_pim = DE_cpim*DE_thetat/(DE_thetat-1)*DERA_fx/DERA_gx;
// Definition of fx
// DERA_fx = RA_size/DE_size*RADE_im*DE_mct+DE_xix*DE_beta*DE_lambdai(+1)/DE_lambdai*(RADE_piim(+1)/(RADE_piim^DE_chix*DE_pi4target^(1/4*(1-DE_chix))))^DE_thetat*DERA_fx(+1);
// Definition of gx   
// DERA_gx = DERA_rer*RADE_pim*RA_size/DE_size*RADE_im+DE_xix*DE_beta*DE_lambdai(+1)/DE_lambdai*(RADE_piim(+1)/(RADE_piim^DE_chix*DE_pi4target^(1/4*(1-DE_chix))))^(DE_thetat-1)*DERA_gx(+1);
// Aggregate intermediate-good price dynamics, using DE_px = RA_pim
// RADE_pim^(1-DE_thetat) = (1-DE_xix)*RADE_pimtilde^(1-DE_thetat)+DE_xix*(RADE_pim(-1)/RA_pic)^(1-DE_thetat)*(RADE_piim(-1)^DE_chix*RA_pi4target^(1/4*(1-DE_chih)))^(1-DE_thetat);
// Intermediate-good price inflation, using DE_pix = RA_piim
// RADE_piim = RADE_pim/RADE_pim(-1)*RA_pic;
// Bilateral real exchange rate
DERA_rer = DE_rer/RA_rer;
// Auxiliary equation for steady-state output
DERA_rerbar = DERA_rer;
//Terms of Trade
DERA_tot = RA_pex*DERA_rer/DE_pex;
// Optimal price contract set in foreign markets (FOC), using DE_pxtilde = AT_pimtilde
// ATDE_pimtilde/ATDE_pim = DE_cpim*DE_thetat/(DE_thetat-1)*DEAT_fx/DEAT_gx;
