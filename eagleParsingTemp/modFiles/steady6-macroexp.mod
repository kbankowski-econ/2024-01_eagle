-ITBE_numig
-ITES_numig
-ITFI_numig
-ITGR_numig
-ITNL_numig
-ITPT_numig
-ITDE_numig
-ITRU_numig
-ITRW_numig
-ITUS_numig
)*(FR_pex*ITFR_rer)^(1-IT_mumig);
// Private consumption good (import) inflation
IT_piimig = IT_pimig/IT_pimig(-1)*IT_pic;
// Private consumption good (import) inflation
IT_piimc4 = IT_pimc/IT_pimc(-4)*IT_pic4;
// Private consumption good (import) inflation
IT_piex4 = IT_pex/IT_pex(-4)*IT_pic4;
// Wedge between aggregate demand and production, using IT_x = NL_size/IT_size*NL_im
IT_yst = IT_sh*IT_ht+IT_sx*IT_ex;
// Aggregate demand for bilateral imported intermediate goods
ITRA_im = 
+ITRA_imc
+ITRA_imi
+ITRA_imcg
+ITRA_imig
;
ITAT_im = 
+ITAT_imc
+ITAT_imi
+ITAT_imcg
+ITAT_imig
;
ITBE_im = 
+ITBE_imc
+ITBE_imi
+ITBE_imcg
+ITBE_imig
;
ITES_im = 
+ITES_imc
+ITES_imi
+ITES_imcg
+ITES_imig
;
ITFI_im = 
+ITFI_imc
+ITFI_imi
+ITFI_imcg
+ITFI_imig
;
ITFR_im = 
+ITFR_imc
+ITFR_imi
+ITFR_imcg
+ITFR_imig
;
ITGR_im = 
+ITGR_imc
+ITGR_imi
+ITGR_imcg
+ITGR_imig
;
ITNL_im = 
+ITNL_imc
+ITNL_imi
+ITNL_imcg
+ITNL_imig
;
ITPT_im = 
+ITPT_imc
+ITPT_imi
+ITPT_imcg
+ITPT_imig
;
ITDE_im = 
+ITDE_imc
+ITDE_imi
+ITDE_imcg
+ITDE_imig
;
ITRU_im = 
+ITRU_imc
+ITRU_imi
+ITRU_imcg
+ITRU_imig
;
ITRW_im = 
+ITRW_imc
+ITRW_imi
+ITRW_imcg
+ITRW_imig
;
ITUS_im = 
+ITUS_imc
+ITUS_imi
+ITUS_imcg
+ITUS_imig
;
// Private consumption good firm
// Private consumption good (tradable)
IT_ttc^((IT_mutc-1)/IT_mutc) = (IT_nutc)^(1/IT_mutc)*IT_htc^(1-1/IT_mutc)+(1-IT_nutc)^(1/IT_mutc)*IT_imc^(1-1/IT_mutc);
// Private consumption good  (total)
IT_qc^((IT_muc-1)/IT_muc) = (IT_nuc)^(1/IT_muc)*IT_ttc^(1-1/IT_muc)+(1-IT_nuc)^(1/IT_muc)*IT_ntc^(1-1/IT_muc);
// Demand for domestic intermediate goods - NONTRADABLE
IT_ntc = (1-IT_nuc)*(IT_pnt)^(-IT_muc)*IT_qc;
// Price of the consumption good (tradable)  
IT_pttc^(1-IT_mutc) = (IT_nutc)*IT_pht^(1-IT_mutc)+(1-IT_nutc)*IT_pimc^(1-IT_mutc);
// Price of the consumption good 
1^(1-IT_muc) = (IT_nuc)*IT_pttc^(1-IT_muc)+(1-IT_nuc)*IT_pnt^(1-IT_muc);
// Demand for domestic intermediate goods
IT_htc = IT_nutc*(IT_pht/IT_pttc)^(-IT_mutc)*IT_ttc;
ITRA_gammaimc = 0;
ITRA_gammaimcdag = 1;
ITAT_gammaimc = 0;
ITAT_gammaimcdag = 1;
ITBE_gammaimc = 0;
ITBE_gammaimcdag = 1;
ITES_gammaimc = 0;
ITES_gammaimcdag = 1;
ITFI_gammaimc = 0;
ITFI_gammaimcdag = 1;
ITFR_gammaimc = 0;
ITFR_gammaimcdag = 1;
ITGR_gammaimc = 0;
ITGR_gammaimcdag = 1;
ITNL_gammaimc = 0;
ITNL_gammaimcdag = 1;
ITPT_gammaimc = 0;
ITPT_gammaimcdag = 1;
ITDE_gammaimc = 0;
ITDE_gammaimcdag = 1;
ITRU_gammaimc = 0;
ITRU_gammaimcdag = 1;
ITRW_gammaimc = 0;
ITRW_gammaimcdag = 1;
ITUS_gammaimc = 0;
ITUS_gammaimcdag = 1;
// Private consumption good (tradable)
IT_tti^((IT_muti-1)/IT_muti) = (IT_nuti)^(1/IT_muti)*IT_hti^(1-1/IT_muti)+(1-IT_nuti)^(1/IT_muti)*IT_imi^(1-1/IT_muti);
// Private consumption good  (total)
IT_qi^((IT_mui-1)/IT_mui) = (IT_nui)^(1/IT_mui)*IT_tti^(1-1/IT_mui)+(1-IT_nui)^(1/IT_mui)*IT_nti^(1-1/IT_mui);
// Demand for domestic intermediate goods - NONTRADABLE
IT_nti = (1-IT_nui)*(IT_pnt/IT_pi)^(-IT_mui)*IT_qi;
// Price of the consumption good (tradable)  
IT_ptti^(1-IT_muti) = (IT_nuti)*IT_pht^(1-IT_muti)+(1-IT_nuti)*IT_pimi^(1-IT_muti);
// Price of the consumption good 
IT_pi^(1-IT_mui) = (IT_nui)*IT_ptti^(1-IT_mui)+(1-IT_nui)*IT_pnt^(1-IT_mui);
// Auxiliary equation for the price of the investment good in steady state
// this only appears in the capacity utilisation cost; not needed for consumption where it is one by assumption; neither for gov demand components where there is no adjustment cost
IT_pibar = IT_pi;
// Demand for domestic intermediate goods
IT_hti = IT_nuti*(IT_pht/IT_ptti)^(-IT_muti)*IT_tti;
ITRA_gammaimi = 0;
ITRA_gammaimidag = 1;
ITAT_gammaimi = 0;
ITAT_gammaimidag = 1;
ITBE_gammaimi = 0;
ITBE_gammaimidag = 1;
ITES_gammaimi = 0;
ITES_gammaimidag = 1;
ITFI_gammaimi = 0;
ITFI_gammaimidag = 1;
ITFR_gammaimi = 0;
ITFR_gammaimidag = 1;
ITGR_gammaimi = 0;
ITGR_gammaimidag = 1;
ITNL_gammaimi = 0;
ITNL_gammaimidag = 1;
ITPT_gammaimi = 0;
ITPT_gammaimidag = 1;
ITDE_gammaimi = 0;
ITDE_gammaimidag = 1;
ITRU_gammaimi = 0;
ITRU_gammaimidag = 1;
ITRW_gammaimi = 0;
ITRW_gammaimidag = 1;
ITUS_gammaimi = 0;
ITUS_gammaimidag = 1;
// Private consumption good (tradable)
IT_ttcg^((IT_mutcg-1)/IT_mutcg) = (IT_nutcg)^(1/IT_mutcg)*IT_htcg^(1-1/IT_mutcg)+(1-IT_nutcg)^(1/IT_mutcg)*IT_imcg^(1-1/IT_mutcg);
// Private consumption good  (total)
IT_qcg^((IT_mucg-1)/IT_mucg) = (IT_nucg)^(1/IT_mucg)*IT_ttcg^(1-1/IT_mucg)+(1-IT_nucg)^(1/IT_mucg)*IT_ntcg^(1-1/IT_mucg);
// Demand for domestic intermediate goods - NONTRADABLE
IT_ntcg = (1-IT_nucg)*(IT_pnt/IT_pcg)^(-IT_mucg)*IT_qcg;
// Price of the consumption good (tradable)  
IT_pttcg^(1-IT_mutcg) = (IT_nutcg)*IT_pht^(1-IT_mutcg)+(1-IT_nutcg)*IT_pimcg^(1-IT_mutcg);
// Price of the consumption good 
IT_pcg^(1-IT_mucg) = (IT_nucg)*IT_pttcg^(1-IT_mucg)+(1-IT_nucg)*IT_pnt^(1-IT_mucg);
// Demand for domestic intermediate goods
IT_htcg = IT_nutcg*(IT_pht/IT_pttcg)^(-IT_mutcg)*IT_ttcg;
ITRA_gammaimcg = 0;
ITRA_gammaimcgdag = 1;
ITAT_gammaimcg = 0;
ITAT_gammaimcgdag = 1;
ITBE_gammaimcg = 0;
ITBE_gammaimcgdag = 1;
ITES_gammaimcg = 0;
ITES_gammaimcgdag = 1;
ITFI_gammaimcg = 0;
ITFI_gammaimcgdag = 1;
ITFR_gammaimcg = 0;
ITFR_gammaimcgdag = 1;
ITGR_gammaimcg = 0;
ITGR_gammaimcgdag = 1;
ITNL_gammaimcg = 0;
ITNL_gammaimcgdag = 1;
ITPT_gammaimcg = 0;
ITPT_gammaimcgdag = 1;
ITDE_gammaimcg = 0;
ITDE_gammaimcgdag = 1;
ITRU_gammaimcg = 0;
ITRU_gammaimcgdag = 1;
ITRW_gammaimcg = 0;
ITRW_gammaimcgdag = 1;
ITUS_gammaimcg = 0;
ITUS_gammaimcgdag = 1;
// Private consumption good (tradable)
IT_ttig^((IT_mutig-1)/IT_mutig) = (IT_nutig)^(1/IT_mutig)*IT_htig^(1-1/IT_mutig)+(1-IT_nutig)^(1/IT_mutig)*IT_imig^(1-1/IT_mutig);
// Private consumption good  (total)
IT_qig^((IT_muig-1)/IT_muig) = (IT_nuig)^(1/IT_muig)*IT_ttig^(1-1/IT_muig)+(1-IT_nuig)^(1/IT_muig)*IT_ntig^(1-1/IT_muig);
// Demand for domestic intermediate goods - NONTRADABLE
IT_ntig = (1-IT_nuig)*(IT_pnt/IT_pig)^(-IT_muig)*IT_qig;
// Price of the consumption good (tradable)  
IT_pttig^(1-IT_mutig) = (IT_nutig)*IT_pht^(1-IT_mutig)+(1-IT_nutig)*IT_pimig^(1-IT_mutig);
// Price of the consumption good 
IT_pig^(1-IT_muig) = (IT_nuig)*IT_pttig^(1-IT_muig)+(1-IT_nuig)*IT_pnt^(1-IT_muig);
// Demand for domestic intermediate goods
IT_htig = IT_nutig*(IT_pht/IT_pttig)^(-IT_mutig)*IT_ttig;
ITRA_gammaimig = 0;
ITRA_gammaimigdag = 1;
ITAT_gammaimig = 0;
ITAT_gammaimigdag = 1;
ITBE_gammaimig = 0;
ITBE_gammaimigdag = 1;
ITES_gammaimig = 0;
ITES_gammaimigdag = 1;
ITFI_gammaimig = 0;
ITFI_gammaimigdag = 1;
ITFR_gammaimig = 0;
ITFR_gammaimigdag = 1;
ITGR_gammaimig = 0;
ITGR_gammaimigdag = 1;
ITNL_gammaimig = 0;
ITNL_gammaimigdag = 1;
ITPT_gammaimig = 0;
ITPT_gammaimigdag = 1;
ITDE_gammaimig = 0;
ITDE_gammaimigdag = 1;
ITRU_gammaimig = 0;
ITRU_gammaimigdag = 1;
ITRW_gammaimig = 0;
ITRW_gammaimigdag = 1;
ITUS_gammaimig = 0;
ITUS_gammaimigdag = 1;
// Trade balance
IT_tb =
+IT_pex*RA_size/IT_size*RAIT_im
-RA_pex*ITRA_rer*ITRA_im
+IT_pex*AT_size/IT_size*ATIT_im
-AT_pex*ITAT_rer*ITAT_im
+IT_pex*BE_size/IT_size*BEIT_im
-BE_pex*ITBE_rer*ITBE_im
+IT_pex*ES_size/IT_size*ESIT_im
-ES_pex*ITES_rer*ITES_im
+IT_pex*FI_size/IT_size*FIIT_im
-FI_pex*ITFI_rer*ITFI_im
+IT_pex*FR_size/IT_size*FRIT_im
-FR_pex*ITFR_rer*ITFR_im
+IT_pex*GR_size/IT_size*GRIT_im
-GR_pex*ITGR_rer*ITGR_im
+IT_pex*NL_size/IT_size*NLIT_im
-NL_pex*ITNL_rer*ITNL_im
+IT_pex*PT_size/IT_size*PTIT_im
-PT_pex*ITPT_rer*ITPT_im
+IT_pex*DE_size/IT_size*DEIT_im
-DE_pex*ITDE_rer*ITDE_im
+IT_pex*RU_size/IT_size*RUIT_im
-RU_pex*ITRU_rer*ITRU_im
+IT_pex*RW_size/IT_size*RWIT_im
-RW_pex*ITRW_rer*ITRW_im
+IT_pex*US_size/IT_size*USIT_im
-US_pex*ITUS_rer*ITUS_im
;
// Aggregate exports (volume)
IT_ex =
+RA_size/IT_size*RAIT_im
+AT_size/IT_size*ATIT_im
+BE_size/IT_size*BEIT_im
+ES_size/IT_size*ESIT_im
+FI_size/IT_size*FIIT_im
+FR_size/IT_size*FRIT_im
+GR_size/IT_size*GRIT_im
+NL_size/IT_size*NLIT_im
+PT_size/IT_size*PTIT_im
+DE_size/IT_size*DEIT_im
+RU_size/IT_size*RUIT_im
+RW_size/IT_size*RWIT_im
+US_size/IT_size*USIT_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using IT_pg = IT_pht
// TODO: check the (1-IT_gammab(-1)) adjustment here, which is not in the fiscal extention
	IT_pcg(-1)*IT_cg(-1)+IT_pig(-1)*IT_ig(-1)+IT_tr(-1)
	+IT_b(-1)*IT_pic(-1)^(-1)+IT_m(-2)*IT_pic(-1)^(-1) = IT_tauc(-1)*IT_c(-1)+(IT_taun(-1)+IT_tauwh(-1))*(IT_wi(-1)*IT_ndi(-1)+IT_wj(-1)*IT_ndj(-1))+IT_tauwf(-1)*IT_w(-1)*IT_nd(-1)+IT_tauk(-1)*(IT_rk(-1)*IT_u(-1)-(IT_gammau(-1)+IT_delta)*IT_pi(-1))*IT_k(-1)+IT_taud(-1)*IT_d(-1)+IT_t(-1)+(IT_r(-1)*(1-IT_gammab(-1)))^(-1)*IT_b+IT_m(-1);
// Government spending, using IT_pg = IT_pht
IT_pcg*IT_cg = IT_cgy*IT_pybar*IT_ybar;
IT_pig*IT_ig = IT_igy*IT_pybar*IT_ybar;
IT_t = 0;
IT_b = IT_bytarget*IT_pybar*IT_ybar;
// Auxiliary equation for steady-state output
IT_ybar = IT_y;
// Auxiliary equation for steady-state output
IT_ytbar = IT_yst;
// Auxiliary equation for steady-state output
IT_ynbar = IT_ysn;
// Auxiliary equation for steady-state output deflator
IT_pybar = IT_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
IT_trybar = IT_tr/(IT_pybar*IT_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
IT_ti = IT_upsilont*IT_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
IT_tri = IT_upsilontr*IT_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	IT_r = DE_r;
IT_pic4 = IT_pi4target;
IT_rr-1 = IT_r/IT_pi4target^(1/4)-1;
// Equilibrium real interest rate
IT_rrstar-1 = 1/IT_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
IT_c = (1-IT_omega)*IT_ci+IT_omega*IT_cj;
// Aggregate money holdings
IT_m = (1-IT_omega)*IT_mi+IT_omega*IT_mj;
// Aggregate capital stock
IT_k = (1-IT_omega)*IT_ki;
// Aggregate investment
IT_i = (1-IT_omega)*IT_ii;
// Aggregate lump-sum transfers
IT_trj = 
1/IT_omega*IT_tr-(1-IT_omega)/IT_omega*IT_tri
;
// Aggregate lump-sum taxes
IT_tj = 
1/IT_omega*IT_t-(1-IT_omega)/IT_omega*IT_ti
;
// Aggregate transaction costs
IT_gammav = (1-IT_omega)*IT_ci*IT_gammavi+IT_omega*IT_cj*IT_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
IT_ni = IT_si*IT_ndi;
// Wage dispersion
IT_si = (1-IT_xii)*(IT_witilde/IT_wi)^(-IT_etai)+IT_xii*(IT_wi(-1)/IT_wi)^(-IT_etai)*(IT_pic/(IT_pic(-1)^IT_chii*IT_pi4target^(1/4*(1-IT_chii))))^(IT_etai)*IT_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
IT_nj = IT_sj*IT_ndj;
// Wage dispersion
IT_sj = (1-IT_xij)*(IT_wjtilde/IT_wj)^(-IT_etaj)+IT_xij*(IT_wj(-1)/IT_wj)^(-IT_etaj)*(IT_pic/(IT_pic(-1)^IT_chij*IT_pi4target^(1/4*(1-IT_chij))))^(IT_etaj)*IT_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
IT_u*IT_k = IT_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using IT_x = NL_size/IT_size*NL_im
IT_ysn = IT_snt*IT_nt;
//  nontradables aggregate demand
IT_nt = 
+IT_ntc
+IT_nti
+IT_ntcg
+IT_ntig
;
// Aggregate demand for domestic intermediate goods, using IT_hg = IT_cg
IT_ht =
+IT_htc
+IT_hti
+IT_htcg
+IT_htig
;
// Price dispersion in the domestic markets
IT_sh = (1-IT_xih)*(IT_phttilde/IT_pht)^(-IT_thetat)+IT_xih*(IT_piht/(IT_piht(-1)^IT_chih*IT_pi4target^(1/4*(1-IT_chih))))^IT_thetat*IT_sh(-1);
// Price dispersion in the foreign markets
IT_sx = (1-IT_xix)*(IT_pextilde/IT_pex)^(-IT_thetat)+IT_xix*(IT_piex/(IT_piex(-1)^IT_chix*IT_pi4target^(1/4*(1-IT_chix))))^IT_thetat*IT_sx(-1);
// Price dispersion in the domestic markets
IT_snt = (1-IT_xin)*(IT_pnttilde/IT_pnt)^(-IT_thetan)+IT_xin*(IT_pint/(IT_pint(-1)^IT_chin*IT_pi4target^(1/4*(1-IT_chin))))^IT_thetan*IT_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
IT_qc = IT_c+IT_gammav;
// Aggregate investment and capital utilisation cost
IT_qi = IT_i+IT_k*IT_gammau;
// Aggregate gov demand components added to use the same structure like in private components
IT_qcg = IT_cg;
IT_qig = IT_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
IT_py*IT_y = 
+IT_qc
+IT_pi*IT_qi
+IT_pcg*IT_qcg
+IT_pig*IT_qig
+IT_pex*RA_size/IT_size*RAIT_im
-(RA_pex*ITRA_rer)*ITRA_imc
-(RA_pex*ITRA_rer)*ITRA_imi
-(RA_pex*ITRA_rer)*ITRA_imcg
-(RA_pex*ITRA_rer)*ITRA_imig
+IT_pex*AT_size/IT_size*ATIT_im
-(AT_pex*ITAT_rer)*ITAT_imc
-(AT_pex*ITAT_rer)*ITAT_imi
-(AT_pex*ITAT_rer)*ITAT_imcg
-(AT_pex*ITAT_rer)*ITAT_imig
+IT_pex*BE_size/IT_size*BEIT_im
-(BE_pex*ITBE_rer)*ITBE_imc
-(BE_pex*ITBE_rer)*ITBE_imi
-(BE_pex*ITBE_rer)*ITBE_imcg
-(BE_pex*ITBE_rer)*ITBE_imig
+IT_pex*ES_size/IT_size*ESIT_im
-(ES_pex*ITES_rer)*ITES_imc
-(ES_pex*ITES_rer)*ITES_imi
-(ES_pex*ITES_rer)*ITES_imcg
-(ES_pex*ITES_rer)*ITES_imig
+IT_pex*FI_size/IT_size*FIIT_im
-(FI_pex*ITFI_rer)*ITFI_imc
-(FI_pex*ITFI_rer)*ITFI_imi
-(FI_pex*ITFI_rer)*ITFI_imcg
-(FI_pex*ITFI_rer)*ITFI_imig
+IT_pex*FR_size/IT_size*FRIT_im
-(FR_pex*ITFR_rer)*ITFR_imc
-(FR_pex*ITFR_rer)*ITFR_imi
-(FR_pex*ITFR_rer)*ITFR_imcg
-(FR_pex*ITFR_rer)*ITFR_imig
+IT_pex*GR_size/IT_size*GRIT_im
-(GR_pex*ITGR_rer)*ITGR_imc
-(GR_pex*ITGR_rer)*ITGR_imi
-(GR_pex*ITGR_rer)*ITGR_imcg
-(GR_pex*ITGR_rer)*ITGR_imig
+IT_pex*NL_size/IT_size*NLIT_im
-(NL_pex*ITNL_rer)*ITNL_imc
-(NL_pex*ITNL_rer)*ITNL_imi
-(NL_pex*ITNL_rer)*ITNL_imcg
-(NL_pex*ITNL_rer)*ITNL_imig
+IT_pex*PT_size/IT_size*PTIT_im
-(PT_pex*ITPT_rer)*ITPT_imc
-(PT_pex*ITPT_rer)*ITPT_imi
-(PT_pex*ITPT_rer)*ITPT_imcg
-(PT_pex*ITPT_rer)*ITPT_imig
+IT_pex*DE_size/IT_size*DEIT_im
-(DE_pex*ITDE_rer)*ITDE_imc
-(DE_pex*ITDE_rer)*ITDE_imi
-(DE_pex*ITDE_rer)*ITDE_imcg
-(DE_pex*ITDE_rer)*ITDE_imig
+IT_pex*RU_size/IT_size*RUIT_im
-(RU_pex*ITRU_rer)*ITRU_imc
-(RU_pex*ITRU_rer)*ITRU_imi
-(RU_pex*ITRU_rer)*ITRU_imcg
-(RU_pex*ITRU_rer)*ITRU_imig
+IT_pex*RW_size/IT_size*RWIT_im
-(RW_pex*ITRW_rer)*ITRW_imc
-(RW_pex*ITRW_rer)*ITRW_imi
-(RW_pex*ITRW_rer)*ITRW_imcg
-(RW_pex*ITRW_rer)*ITRW_imig
+IT_pex*US_size/IT_size*USIT_im
-(US_pex*ITUS_rer)*ITUS_imc
-(US_pex*ITUS_rer)*ITUS_imi
-(US_pex*ITUS_rer)*ITUS_imcg
-(US_pex*ITUS_rer)*ITUS_imig
;
// Aggregate real demand
IT_y = IT_yst+IT_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(IT_zt) = (1-IT_rhozt)*log(IT_ztbar)+IT_rhozt*log(IT_zt(-1))+IT_epszt;
log(IT_zn) = (1-IT_rhozn)*log(IT_znbar)+IT_rhozn*log(IT_zn(-1))+IT_epszn;
// Government spending shock
IT_cgy = (1-IT_rhocg)*IT_cgybar+IT_rhocg*IT_cgy(-1)+IT_epsgc;
IT_igy = (1-IT_rhoig)*IT_igybar+IT_rhoig*IT_igy(-1)+IT_epsgi;
// Transfer shock
IT_try = (1-IT_rhotr)*IT_trybar+IT_rhotr*IT_try(-1)+IT_epstr;
// Consumption tax shock
IT_tauc = (1-IT_rhotauc)*IT_taucbar+IT_rhotauc*IT_tauc(-1)+IT_epstauc;
// Dividend income tax shock
IT_taud = (1-IT_rhotaud)*IT_taudbar+IT_rhotaud*IT_taud(-1)+IT_epstaud;
// Capital income tax shock
IT_tauk = (1-IT_rhotauk)*IT_taukbar+IT_rhotauk*IT_tauk(-1)+IT_epstauk;
// Labour income tax shock
IT_taun = (1-IT_rhotaun)*IT_taunbar+IT_rhotaun*IT_taun(-1)+IT_epstaun;
// Payroll tax shock: households
IT_tauwh = (1-IT_rhotauwh)*IT_tauwhbar+IT_rhotauwh*IT_tauwh(-1)+IT_epstauwh;
// Payroll tax shock: firms
IT_tauwf = (1-IT_rhotauwf)*IT_tauwfbar+IT_rhotauwf*IT_tauwf(-1)+IT_epstauwf;
// Wage cost push shock
IT_wcst = (1-IT_rhowcst)*IT_wcstbar+IT_rhowcst*IT_wcst(-1)+IT_epswcst;
// Preference shock
log(IT_zcon) = (1-IT_rhozcon)*log(IT_zconbar)+IT_rhozcon*log(IT_zcon(-1))+IT_epszcon;
// Investment specific shock
log(IT_zinv) = (1-IT_rhozinv)*log(IT_zinvbar)+IT_rhozinv*log(IT_zinv(-1))+IT_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
IT_cy = IT_c/(IT_py*IT_y);
// Aggregate nominal investment share
IT_iy = IT_pi*IT_i/(IT_py*IT_y);
// Aggregate nominal import share  
IT_imy = (
+IT_pimc*IT_imc
+IT_pimi*IT_imi
+IT_pimcg*IT_imcg
+IT_pimig*IT_imig
)/(IT_py*IT_y);
// Aggregate nominal import share
IT_imcy = IT_pimc*IT_imc/(IT_py*IT_y);
IT_imiy = IT_pimi*IT_imi/(IT_py*IT_y);
IT_imcgy = IT_pimcg*IT_imcg/(IT_py*IT_y);
IT_imigy = IT_pimig*IT_imig/(IT_py*IT_y);
// Aggregate debt-to-output ratio
IT_by = IT_b/(IT_pybar*IT_ybar);
// Aggregate lump-sum tax-to-output ratio
IT_ty = IT_t/(IT_pybar*IT_ybar);
// Aggregate labour cost share
IT_lcy = ((1+IT_tauwf)*IT_w*IT_nd)/(IT_py*IT_y);
// Aggregate nominal Wage share
IT_wy = (IT_w*IT_nd)/(IT_py*IT_y);
// NT sector nominal Wage share
IT_wnty = (IT_w*IT_ndn)/(IT_pnt*IT_ysn);
// T sector nominal Wage share
IT_whty = (IT_w*IT_ndt)/(IT_pht*IT_yst);
// T sector share
IT_yhty = IT_pht*IT_yst/(IT_py*IT_y);
// NT sector share
IT_ynty = IT_pnt*IT_ysn/(IT_py*IT_y);
// Output gap
IT_ygap = 0;
// Output growth (gross rate)
IT_ygrowth = IT_y/IT_y(-1);
// Output growth (gross rate yoy)
IT_ygrowth4 = IT_y/IT_y(-4);
// Domestic nominal output as a share of world nominal output
IT_yshare  = IT_size*IT_py*IT_y/IT_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
IT_epsilonm = -1/8*1/(IT_r*(IT_gammav2*IT_r+IT_r-1));
// Trade balance-to-GDP ratio
IT_tby = IT_tb/(IT_py*IT_y);
// Bilateral shares
ITRA_imcy = (RA_pex*ITRA_rer)*ITRA_imc/(IT_py*IT_y);
ITRA_imiy = (RA_pex*ITRA_rer)*ITRA_imi/(IT_py*IT_y);
ITRA_imcgy = (RA_pex*ITRA_rer)*ITRA_imcg/(IT_py*IT_y);
ITRA_imigy = (RA_pex*ITRA_rer)*ITRA_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITRA_excy  = RA_size/IT_size*IT_pex*RAIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITRA_exiy  = RA_size/IT_size*IT_pex*RAIT_imi/(IT_py*IT_y);
// Bilateral shares
ITAT_imcy = (AT_pex*ITAT_rer)*ITAT_imc/(IT_py*IT_y);
ITAT_imiy = (AT_pex*ITAT_rer)*ITAT_imi/(IT_py*IT_y);
ITAT_imcgy = (AT_pex*ITAT_rer)*ITAT_imcg/(IT_py*IT_y);
ITAT_imigy = (AT_pex*ITAT_rer)*ITAT_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITAT_excy  = AT_size/IT_size*IT_pex*ATIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITAT_exiy  = AT_size/IT_size*IT_pex*ATIT_imi/(IT_py*IT_y);
// Bilateral shares
ITBE_imcy = (BE_pex*ITBE_rer)*ITBE_imc/(IT_py*IT_y);
ITBE_imiy = (BE_pex*ITBE_rer)*ITBE_imi/(IT_py*IT_y);
ITBE_imcgy = (BE_pex*ITBE_rer)*ITBE_imcg/(IT_py*IT_y);
ITBE_imigy = (BE_pex*ITBE_rer)*ITBE_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITBE_excy  = BE_size/IT_size*IT_pex*BEIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITBE_exiy  = BE_size/IT_size*IT_pex*BEIT_imi/(IT_py*IT_y);
// Bilateral shares
ITES_imcy = (ES_pex*ITES_rer)*ITES_imc/(IT_py*IT_y);
ITES_imiy = (ES_pex*ITES_rer)*ITES_imi/(IT_py*IT_y);
ITES_imcgy = (ES_pex*ITES_rer)*ITES_imcg/(IT_py*IT_y);
ITES_imigy = (ES_pex*ITES_rer)*ITES_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITES_excy  = ES_size/IT_size*IT_pex*ESIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITES_exiy  = ES_size/IT_size*IT_pex*ESIT_imi/(IT_py*IT_y);
// Bilateral shares
ITFI_imcy = (FI_pex*ITFI_rer)*ITFI_imc/(IT_py*IT_y);
ITFI_imiy = (FI_pex*ITFI_rer)*ITFI_imi/(IT_py*IT_y);
ITFI_imcgy = (FI_pex*ITFI_rer)*ITFI_imcg/(IT_py*IT_y);
ITFI_imigy = (FI_pex*ITFI_rer)*ITFI_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITFI_excy  = FI_size/IT_size*IT_pex*FIIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITFI_exiy  = FI_size/IT_size*IT_pex*FIIT_imi/(IT_py*IT_y);
// Bilateral shares
ITFR_imcy = (FR_pex*ITFR_rer)*ITFR_imc/(IT_py*IT_y);
ITFR_imiy = (FR_pex*ITFR_rer)*ITFR_imi/(IT_py*IT_y);
ITFR_imcgy = (FR_pex*ITFR_rer)*ITFR_imcg/(IT_py*IT_y);
ITFR_imigy = (FR_pex*ITFR_rer)*ITFR_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITFR_excy  = FR_size/IT_size*IT_pex*FRIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITFR_exiy  = FR_size/IT_size*IT_pex*FRIT_imi/(IT_py*IT_y);
// Bilateral shares
ITGR_imcy = (GR_pex*ITGR_rer)*ITGR_imc/(IT_py*IT_y);
ITGR_imiy = (GR_pex*ITGR_rer)*ITGR_imi/(IT_py*IT_y);
ITGR_imcgy = (GR_pex*ITGR_rer)*ITGR_imcg/(IT_py*IT_y);
ITGR_imigy = (GR_pex*ITGR_rer)*ITGR_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITGR_excy  = GR_size/IT_size*IT_pex*GRIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITGR_exiy  = GR_size/IT_size*IT_pex*GRIT_imi/(IT_py*IT_y);
// Bilateral shares
ITNL_imcy = (NL_pex*ITNL_rer)*ITNL_imc/(IT_py*IT_y);
ITNL_imiy = (NL_pex*ITNL_rer)*ITNL_imi/(IT_py*IT_y);
ITNL_imcgy = (NL_pex*ITNL_rer)*ITNL_imcg/(IT_py*IT_y);
ITNL_imigy = (NL_pex*ITNL_rer)*ITNL_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITNL_excy  = NL_size/IT_size*IT_pex*NLIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITNL_exiy  = NL_size/IT_size*IT_pex*NLIT_imi/(IT_py*IT_y);
// Bilateral shares
ITPT_imcy = (PT_pex*ITPT_rer)*ITPT_imc/(IT_py*IT_y);
ITPT_imiy = (PT_pex*ITPT_rer)*ITPT_imi/(IT_py*IT_y);
ITPT_imcgy = (PT_pex*ITPT_rer)*ITPT_imcg/(IT_py*IT_y);
ITPT_imigy = (PT_pex*ITPT_rer)*ITPT_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITPT_excy  = PT_size/IT_size*IT_pex*PTIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITPT_exiy  = PT_size/IT_size*IT_pex*PTIT_imi/(IT_py*IT_y);
// Bilateral shares
ITDE_imcy = (DE_pex*ITDE_rer)*ITDE_imc/(IT_py*IT_y);
ITDE_imiy = (DE_pex*ITDE_rer)*ITDE_imi/(IT_py*IT_y);
ITDE_imcgy = (DE_pex*ITDE_rer)*ITDE_imcg/(IT_py*IT_y);
ITDE_imigy = (DE_pex*ITDE_rer)*ITDE_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITDE_excy  = DE_size/IT_size*IT_pex*DEIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITDE_exiy  = DE_size/IT_size*IT_pex*DEIT_imi/(IT_py*IT_y);
// Bilateral shares
ITRU_imcy = (RU_pex*ITRU_rer)*ITRU_imc/(IT_py*IT_y);
ITRU_imiy = (RU_pex*ITRU_rer)*ITRU_imi/(IT_py*IT_y);
ITRU_imcgy = (RU_pex*ITRU_rer)*ITRU_imcg/(IT_py*IT_y);
ITRU_imigy = (RU_pex*ITRU_rer)*ITRU_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITRU_excy  = RU_size/IT_size*IT_pex*RUIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITRU_exiy  = RU_size/IT_size*IT_pex*RUIT_imi/(IT_py*IT_y);
// Bilateral shares
ITRW_imcy = (RW_pex*ITRW_rer)*ITRW_imc/(IT_py*IT_y);
ITRW_imiy = (RW_pex*ITRW_rer)*ITRW_imi/(IT_py*IT_y);
ITRW_imcgy = (RW_pex*ITRW_rer)*ITRW_imcg/(IT_py*IT_y);
ITRW_imigy = (RW_pex*ITRW_rer)*ITRW_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITRW_excy  = RW_size/IT_size*IT_pex*RWIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITRW_exiy  = RW_size/IT_size*IT_pex*RWIT_imi/(IT_py*IT_y);
// Bilateral shares
ITUS_imcy = (US_pex*ITUS_rer)*ITUS_imc/(IT_py*IT_y);
ITUS_imiy = (US_pex*ITUS_rer)*ITUS_imi/(IT_py*IT_y);
ITUS_imcgy = (US_pex*ITUS_rer)*ITUS_imcg/(IT_py*IT_y);
ITUS_imigy = (US_pex*ITUS_rer)*ITUS_imig/(IT_py*IT_y);
// Exports of consumption goods to gdp
ITUS_excy  = US_size/IT_size*IT_pex*USIT_imc/(IT_py*IT_y);
// Exports of investment goods to gdp
ITUS_exiy  = US_size/IT_size*IT_pex*USIT_imi/(IT_py*IT_y);
// Internal real exchange rate
IT_internalrer = IT_pnt/IT_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
NL_ccesi^(1-1/NL_mucces) = (NL_nucces)^(1/NL_mucces)*NL_ci^(1-1/NL_mucces)+(1-NL_nucces)^(1/NL_mucces)*NL_cg^(1-1/NL_mucces);
// Utility
NL_utili = 
NL_zcon*log(NL_ccesi-NL_kappa*NL_ccesi(-1))-1/(1+NL_zeta)*(NL_ni)^(1+NL_zeta)+NL_beta*NL_utili(+1)
;
// Marginal utility of consumption
NL_dcci = ((NL_nucces)^(1/NL_mucces)*NL_ci^(1-1/NL_mucces)+(1-NL_nucces)^(1/NL_mucces)*NL_cg^(1-1/NL_mucces))^(1/(NL_mucces-1))*(NL_nucces^(1/NL_mucces))*(NL_ci^(-1/NL_mucces));
NL_lambdai*(1+NL_tauc+NL_gammavi+NL_vi*NL_gammavider) = NL_zcon*(NL_ccesi-NL_kappa*NL_ccesi(-1))^(-NL_sigma)*NL_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
NL_r                   = NL_beta^(-1)*NL_lambdai/NL_lambdai    *NL_pic;
// Germany
// US and the RoW
// Euler equation for money
NL_vi^(2)*NL_gammavider = 1-NL_beta*NL_lambdai(+1)/(NL_lambdai*NL_pic(+1));
// Consumption-based velocity
NL_vi = NL_ci/NL_mi;
// Transaction cost
NL_gammavi = NL_gammav1*NL_vi+NL_gammav2/NL_vi-2*(NL_gammav1*NL_gammav2)^(1/2);
// Derivative of transaction cost
NL_gammavider = NL_gammav1-NL_gammav2*NL_vi^(-2);
NL_delta = NL_ii/NL_ki;
NL_gammai = 0;
NL_gammaider = 0;
NL_gammau = 0;
NL_gammauder = ((NL_beta^(-1)-1+NL_delta)*NL_qbar-NL_delta*NL_taukbar*NL_pibar)/((1-NL_taukbar)*NL_pibar);
NL_u = 1;
NL_pi = NL_q;
// Auxiliary equation for Tobin's Q in steady state
NL_qbar = NL_q;
// Rate of return on capital
NL_q = NL_beta*((1-NL_tauk)*NL_rk+(NL_tauk*NL_delta)*NL_pi+(1-NL_delta)*NL_q);
// Optimal wage contract (FOC)
NL_witilde^(1+NL_etai*NL_zeta) = NL_etai/(NL_etai-1)*NL_fi/NL_gi+NL_wcst;
// Definition of fi
NL_fi = NL_wi^(NL_etai*(1+NL_zeta))*NL_ndi^(1+NL_zeta)+NL_xii*NL_beta*(NL_pic(+1)/(NL_pic^NL_chii*NL_pi4target^(1/4*(1-NL_chii))))^(NL_etai*(1+NL_zeta))*NL_fi(+1);
// Definition of gi
NL_gi = NL_lambdai*(1-NL_taun-NL_tauwh)*NL_wi^NL_etai*NL_ndi+NL_xii*NL_beta*(NL_pic(+1)/(NL_pic^NL_chii*NL_pi4target^(1/4*(1-NL_chii))))^(NL_etai-1)*NL_gi(+1);
// Aggregate wage rate
NL_wi^(1-NL_etai) = (1-NL_xii)*NL_witilde^(1-NL_etai)+NL_xii*NL_wi(-1)^(1-NL_etai)*(NL_pic(-1)^NL_chii*NL_pi4target^(1/4*(1-NL_chii))/NL_pic)^(1-NL_etai);
//-------------
// Household J
//-------------
NL_ccesj^(1-1/NL_mucces) = (NL_nucces)^(1/NL_mucces)*NL_cj^(1-1/NL_mucces)+(1-NL_nucces)^(1/NL_mucces)*NL_cg^(1-1/NL_mucces);
// Utility
NL_utilj = 
NL_zcon*log(NL_ccesj-NL_kappa*NL_ccesj(-1))-1/(1+NL_zeta)*(NL_nj)^(1+NL_zeta)+NL_beta*NL_utilj(+1)
;
// Marginal utility of consumption
NL_dccj = ((NL_nucces)^(1/NL_mucces)*NL_cj^(1-1/NL_mucces)+(1-NL_nucces)^(1/NL_mucces)*NL_cg^(1-1/NL_mucces))^(1/(NL_mucces-1))*(NL_nucces^(1/NL_mucces))*(NL_cj^(-1/NL_mucces));
NL_lambdaj*(1+NL_tauc+NL_gammavj+NL_vj*NL_gammavjder) = NL_zcon*(NL_ccesj-NL_kappa*NL_ccesj(-1))^(-NL_sigma)*NL_dccj;
// Budget constraint
(1+NL_tauc+NL_gammavj)*NL_cj+NL_mj = (1-NL_taun-NL_tauwh)*NL_wj*NL_nj+NL_trj-NL_tj+NL_mj(-1)*NL_pic^(-1);
// Euler equation for money
NL_vj^(2)*NL_gammavjder = 1-NL_beta*NL_lambdaj(+1)/(NL_lambdaj*NL_pic(+1));
// Consumption-based velocity
NL_vj = NL_cj/NL_mj;
// Transaction technology
NL_gammavj = NL_gammav1*NL_vj+NL_gammav2/NL_vj-2*(NL_gammav1*NL_gammav2)^(1/2);
// Derivative of transaction technology
NL_gammavjder = NL_gammav1-NL_gammav2*NL_vj^(-2);
// Optimal wage contract (FOC)
NL_wjtilde^(1+NL_etaj*NL_zeta) = NL_etaj/(NL_etaj-1)*NL_fj/NL_gj+NL_wcst;
// Definition of fj
NL_fj = NL_wj^(NL_etaj*(1+NL_zeta))*NL_ndj^(1+NL_zeta)+NL_xij*NL_beta*(NL_pic(+1)/(NL_pic^NL_chij*NL_pi4target^(1/4*(1-NL_chij))))^(NL_etaj*(1+NL_zeta))*NL_fj(+1);
// Definition of gj
NL_gj = NL_lambdaj*(1-NL_taun-NL_tauwh)*NL_wj^NL_etaj*NL_ndj+NL_xij*NL_beta*(NL_pic(+1)/(NL_pic^NL_chij*NL_pi4target^(1/4*(1-NL_chij))))^(NL_etaj-1)*NL_gj(+1);
// Aggregate wage rate
NL_wj^(1-NL_etaj) = (1-NL_xij)*NL_wjtilde^(1-NL_etaj)+NL_xij*NL_wj(-1)^(1-NL_etaj)*(NL_pic(-1)^NL_chij*NL_pi4target^(1/4*(1-NL_chij))/NL_pic)^(1-NL_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
NL_kg = (1-NL_deltag)*NL_kg(-1)+NL_ig(-1);
// Production function tradable
NL_yst = NL_zt*NL_kg^NL_alphag*NL_kdt^NL_alphat*NL_ndt^(1-NL_alphat)-NL_psitbar;
// Production function nontradable
NL_ysn = NL_zn*NL_kg^NL_alphag*NL_kdn^NL_alphan*NL_ndn^(1-NL_alphan)-NL_psinbar;
// Real marginal cost tradable
NL_mct = 1/(NL_zt*NL_kg^NL_alphag*(NL_alphat)^(NL_alphat)*(1-NL_alphat)^(1-NL_alphat))*NL_rk^(NL_alphat)*((1+NL_tauwf)*NL_w)^(1-NL_alphat);
// Real marginal cost nontradable
NL_mcn = 1/(NL_zn*NL_kg^NL_alphag*(NL_alphan)^(NL_alphan)*(1-NL_alphan)^(1-NL_alphan))*NL_rk^(NL_alphan)*((1+NL_tauwf)*NL_w)^(1-NL_alphan);
// Wage Inflation (qoq)
NL_piw = NL_w/NL_w(-1)*NL_pic;
// Wage Inflation (yoy)
NL_piw4 = NL_pic4;
// Auxiliary equation for steady-state fixed cost
NL_psitbar = NL_psit*NL_ytbar;
// Auxiliary equation for steady-state fixed cost
NL_psinbar = NL_psin*NL_ynbar;
// Capital input (FOC)
NL_rk = NL_alphat*(NL_yst+NL_psitbar)/NL_kdt*NL_mct;
// Capital input (FOC)
NL_rk = NL_alphan*(NL_ysn+NL_psinbar)/NL_kdn*NL_mcn;
// Total capital demand
NL_kd = NL_kdt+NL_kdn;
// Demand for labour services by household I
NL_ndi = 
(1-NL_omega)*(NL_wi/NL_w)^(-NL_eta)*NL_nd
;
// Demand for labour services by household J
NL_ndj = 
NL_omega*(NL_wj/NL_w)^(-NL_eta)*NL_nd
;
// Aggregate labour demand
NL_nd^(1-1/NL_eta) = 
(1-NL_omega)^(1/NL_eta)*NL_ndi^(1-1/NL_eta)+NL_omega^(1/NL_eta)*NL_ndj^(1-1/NL_eta)
;
// Total demand 
NL_nd = NL_ndt+NL_ndn;
// Aggregate dividends
NL_d = NL_py*NL_y-NL_rk*NL_kd-(1+NL_tauwf)*NL_w*NL_nd;
// Non-tradable sector dividends
NL_dn = NL_pnt*NL_ysn-NL_rk*NL_kdn-(1+NL_tauwf)*NL_w*NL_ndn;
// Tradable sector dividends
NL_dt = NL_pht*NL_ht
+NL_pex*NL_ex
-NL_rk*NL_kdt-(1+NL_tauwf)*NL_w*NL_ndt;
// Optimal price contract set in domestic markets (FOC)
NL_phttilde/NL_pht = NL_thetat/(NL_thetat-1)*NL_fh/NL_gh;
// Definition of fh
NL_fh = NL_mct*NL_ht+NL_xih*NL_beta*NL_lambdai(+1)/NL_lambdai*(NL_piht(+1)/(NL_piht^NL_chih*NL_pi4target^(1/4*(1-NL_chih))))^NL_thetat*NL_fh(+1);
// Definition of gh
NL_gh = NL_pht*NL_ht+NL_xih*NL_beta*NL_lambdai(+1)/NL_lambdai*(NL_piht(+1)/(NL_piht^NL_chih*NL_pi4target^(1/4*(1-NL_chih))))^(NL_thetat-1)*NL_gh(+1);
// Aggregate intermediate-good price dynamics
NL_pht^(1-NL_thetat) = (1-NL_xih)*NL_phttilde^(1-NL_thetat)+NL_xih*(NL_pht(-1)/NL_pic)^(1-NL_thetat)*(NL_piht(-1)^NL_chih*NL_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation
NL_piht = NL_pht/NL_pht(-1)*NL_pic;
// Optimal price contract set in domestic markets (FOC)
NL_pnttilde/NL_pnt = NL_thetan/(NL_thetan-1)*NL_fn/NL_gn;
// Definition of fn
NL_fn = NL_mcn*NL_nt+NL_xin*NL_beta*NL_lambdai(+1)/NL_lambdai*(NL_pint(+1)/(NL_pint^NL_chin*NL_pi4target^(1/4*(1-NL_chin))))^NL_thetan*NL_fn(+1);
// Definition of gn
NL_gn = NL_pnt*NL_nt+NL_xin*NL_beta*NL_lambdai(+1)/NL_lambdai*(NL_pint(+1)/(NL_pint^NL_chin*NL_pi4target^(1/4*(1-NL_chin))))^(NL_thetan-1)*NL_gn(+1);
// Aggregate intermediate-good price dynamics
NL_pnt^(1-NL_thetan) = (1-NL_xin)*NL_pnttilde^(1-NL_thetan)+NL_xin*(NL_pnt(-1)/NL_pic)^(1-NL_thetan)*(NL_pint(-1)^NL_chin*NL_pi4target^(1/4*(1-NL_chin)))^(1-NL_thetan);
// Intermediate-good price inflation
NL_pint = NL_pnt/NL_pnt(-1)*NL_pic;
// Optimal price contract set in domestic markets (FOC)
NL_pextilde/NL_pex = NL_thetat/(NL_thetat-1)*NL_fx/NL_gx;
// Definition of fh
NL_fx = NL_mct*NL_ex+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(NL_piex(+1)/(NL_piex^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NL_fx(+1);
// Definition of gh
NL_gx = NL_pex*NL_ex+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(NL_piex(+1)/(NL_piex^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NL_gx(+1);
// Aggregate intermediate-good price dynamics
NL_pex^(1-NL_thetat) = (1-NL_xix)*NL_pextilde^(1-NL_thetat)+NL_xix*(NL_pex(-1)/NL_pic)^(1-NL_thetat)*(NL_piex(-1)^NL_chix*NL_pi4target^(1/4*(1-NL_chix)))^(1-NL_thetat);
// Intermediate-good price inflation
NL_piex = NL_pex/NL_pex(-1)*NL_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = RA_pimtilde
// RANL_pimtilde/RANL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLRA_fx/NLRA_gx;
// Definition of fx
// NLRA_fx = RA_size/NL_size*RANL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(RANL_piim(+1)/(RANL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLRA_fx(+1);
// Definition of gx   
// NLRA_gx = NLRA_rer*RANL_pim*RA_size/NL_size*RANL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(RANL_piim(+1)/(RANL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLRA_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = RA_pim
// RANL_pim^(1-NL_thetat) = (1-NL_xix)*RANL_pimtilde^(1-NL_thetat)+NL_xix*(RANL_pim(-1)/RA_pic)^(1-NL_thetat)*(RANL_piim(-1)^NL_chix*RA_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = RA_piim
// RANL_piim = RANL_pim/RANL_pim(-1)*RA_pic;
// Bilateral real exchange rate
NLRA_rer = NL_rer/RA_rer;
// Auxiliary equation for steady-state output
NLRA_rerbar = NLRA_rer;
//Terms of Trade
NLRA_tot = RA_pex*NLRA_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = AT_pimtilde
// ATNL_pimtilde/ATNL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLAT_fx/NLAT_gx;
// Definition of fx
// NLAT_fx = AT_size/NL_size*ATNL_im*NL_mct+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(ATNL_piim(+1)/(ATNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^NL_thetat*NLAT_fx(+1);
// Definition of gx   
// NLAT_gx = NLAT_rer*ATNL_pim*AT_size/NL_size*ATNL_im+NL_xix*NL_beta*NL_lambdai(+1)/NL_lambdai*(ATNL_piim(+1)/(ATNL_piim^NL_chix*NL_pi4target^(1/4*(1-NL_chix))))^(NL_thetat-1)*NLAT_gx(+1);
// Aggregate intermediate-good price dynamics, using NL_px = AT_pim
// ATNL_pim^(1-NL_thetat) = (1-NL_xix)*ATNL_pimtilde^(1-NL_thetat)+NL_xix*(ATNL_pim(-1)/AT_pic)^(1-NL_thetat)*(ATNL_piim(-1)^NL_chix*AT_pi4target^(1/4*(1-NL_chih)))^(1-NL_thetat);
// Intermediate-good price inflation, using NL_pix = AT_piim
// ATNL_piim = ATNL_pim/ATNL_pim(-1)*AT_pic;
// Bilateral real exchange rate
NLAT_rer = NL_rer/AT_rer;
// Auxiliary equation for steady-state output
NLAT_rerbar = NLAT_rer;
//Terms of Trade
NLAT_tot = AT_pex*NLAT_rer/NL_pex;
// Optimal price contract set in foreign markets (FOC), using NL_pxtilde = BE_pimtilde
// BENL_pimtilde/BENL_pim = NL_cpim*NL_thetat/(NL_thetat-1)*NLBE_fx/NLBE_gx;
