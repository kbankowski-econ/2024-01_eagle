// GRFI_fx = FI_size/GR_size*FIGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(FIGR_piim(+1)/(FIGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRFI_fx(+1);
