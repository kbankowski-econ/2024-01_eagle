ES_pttcg^(1-ES_mutcg) = (ES_nutcg)*ES_pht^(1-ES_mutcg)+(1-ES_nutcg)*ES_pimcg^(1-ES_mutcg);
// Price of the consumption good 
ES_pcg^(1-ES_mucg) = (ES_nucg)*ES_pttcg^(1-ES_mucg)+(1-ES_nucg)*ES_pnt^(1-ES_mucg);
// Demand for domestic intermediate goods
ES_htcg = ES_nutcg*(ES_pht/ES_pttcg)^(-ES_mutcg)*ES_ttcg;
ESRA_gammaimcg = 0;
ESRA_gammaimcgdag = 1;
ESAT_gammaimcg = 0;
ESAT_gammaimcgdag = 1;
ESBE_gammaimcg = 0;
ESBE_gammaimcgdag = 1;
ESFI_gammaimcg = 0;
ESFI_gammaimcgdag = 1;
ESFR_gammaimcg = 0;
ESFR_gammaimcgdag = 1;
ESGR_gammaimcg = 0;
ESGR_gammaimcgdag = 1;
ESIT_gammaimcg = 0;
ESIT_gammaimcgdag = 1;
ESNL_gammaimcg = 0;
ESNL_gammaimcgdag = 1;
ESPT_gammaimcg = 0;
ESPT_gammaimcgdag = 1;
ESDE_gammaimcg = 0;
ESDE_gammaimcgdag = 1;
ESRU_gammaimcg = 0;
ESRU_gammaimcgdag = 1;
ESRW_gammaimcg = 0;
ESRW_gammaimcgdag = 1;
ESUS_gammaimcg = 0;
ESUS_gammaimcgdag = 1;
// Private consumption good (tradable)
ES_ttig^((ES_mutig-1)/ES_mutig) = (ES_nutig)^(1/ES_mutig)*ES_htig^(1-1/ES_mutig)+(1-ES_nutig)^(1/ES_mutig)*ES_imig^(1-1/ES_mutig);
// Private consumption good  (total)
ES_qig^((ES_muig-1)/ES_muig) = (ES_nuig)^(1/ES_muig)*ES_ttig^(1-1/ES_muig)+(1-ES_nuig)^(1/ES_muig)*ES_ntig^(1-1/ES_muig);
// Demand for domestic intermediate goods - NONTRADABLE
ES_ntig = (1-ES_nuig)*(ES_pnt/ES_pig)^(-ES_muig)*ES_qig;
// Price of the consumption good (tradable)  
ES_pttig^(1-ES_mutig) = (ES_nutig)*ES_pht^(1-ES_mutig)+(1-ES_nutig)*ES_pimig^(1-ES_mutig);
// Price of the consumption good 
ES_pig^(1-ES_muig) = (ES_nuig)*ES_pttig^(1-ES_muig)+(1-ES_nuig)*ES_pnt^(1-ES_muig);
// Demand for domestic intermediate goods
ES_htig = ES_nutig*(ES_pht/ES_pttig)^(-ES_mutig)*ES_ttig;
ESRA_gammaimig = 0;
ESRA_gammaimigdag = 1;
ESAT_gammaimig = 0;
ESAT_gammaimigdag = 1;
ESBE_gammaimig = 0;
ESBE_gammaimigdag = 1;
ESFI_gammaimig = 0;
ESFI_gammaimigdag = 1;
ESFR_gammaimig = 0;
ESFR_gammaimigdag = 1;
ESGR_gammaimig = 0;
ESGR_gammaimigdag = 1;
ESIT_gammaimig = 0;
ESIT_gammaimigdag = 1;
ESNL_gammaimig = 0;
ESNL_gammaimigdag = 1;
ESPT_gammaimig = 0;
ESPT_gammaimigdag = 1;
ESDE_gammaimig = 0;
ESDE_gammaimigdag = 1;
ESRU_gammaimig = 0;
ESRU_gammaimigdag = 1;
ESRW_gammaimig = 0;
ESRW_gammaimigdag = 1;
ESUS_gammaimig = 0;
ESUS_gammaimigdag = 1;
// Trade balance
ES_tb =
+ES_pex*RA_size/ES_size*RAES_im
-RA_pex*ESRA_rer*ESRA_im
+ES_pex*AT_size/ES_size*ATES_im
-AT_pex*ESAT_rer*ESAT_im
+ES_pex*BE_size/ES_size*BEES_im
-BE_pex*ESBE_rer*ESBE_im
+ES_pex*FI_size/ES_size*FIES_im
-FI_pex*ESFI_rer*ESFI_im
+ES_pex*FR_size/ES_size*FRES_im
-FR_pex*ESFR_rer*ESFR_im
+ES_pex*GR_size/ES_size*GRES_im
-GR_pex*ESGR_rer*ESGR_im
+ES_pex*IT_size/ES_size*ITES_im
-IT_pex*ESIT_rer*ESIT_im
+ES_pex*NL_size/ES_size*NLES_im
-NL_pex*ESNL_rer*ESNL_im
+ES_pex*PT_size/ES_size*PTES_im
-PT_pex*ESPT_rer*ESPT_im
+ES_pex*DE_size/ES_size*DEES_im
-DE_pex*ESDE_rer*ESDE_im
+ES_pex*RU_size/ES_size*RUES_im
-RU_pex*ESRU_rer*ESRU_im
+ES_pex*RW_size/ES_size*RWES_im
-RW_pex*ESRW_rer*ESRW_im
+ES_pex*US_size/ES_size*USES_im
-US_pex*ESUS_rer*ESUS_im
;
// Aggregate exports (volume)
ES_ex =
+RA_size/ES_size*RAES_im
+AT_size/ES_size*ATES_im
+BE_size/ES_size*BEES_im
+FI_size/ES_size*FIES_im
+FR_size/ES_size*FRES_im
+GR_size/ES_size*GRES_im
+IT_size/ES_size*ITES_im
+NL_size/ES_size*NLES_im
+PT_size/ES_size*PTES_im
+DE_size/ES_size*DEES_im
+RU_size/ES_size*RUES_im
+RW_size/ES_size*RWES_im
+US_size/ES_size*USES_im
;
//-------------
//-------------
// Fiscal and monetary authorities
//-------------
//-------------
//-------------
// Fiscal authority
//-------------
// Government budget constraint, using ES_pg = ES_pht
// TODO: check the (1-ES_gammab(-1)) adjustment here, which is not in the fiscal extention
	ES_pcg(-1)*ES_cg(-1)+ES_pig(-1)*ES_ig(-1)+ES_tr(-1)
	+ES_b(-1)*ES_pic(-1)^(-1)+ES_m(-2)*ES_pic(-1)^(-1) = ES_tauc(-1)*ES_c(-1)+(ES_taun(-1)+ES_tauwh(-1))*(ES_wi(-1)*ES_ndi(-1)+ES_wj(-1)*ES_ndj(-1))+ES_tauwf(-1)*ES_w(-1)*ES_nd(-1)+ES_tauk(-1)*(ES_rk(-1)*ES_u(-1)-(ES_gammau(-1)+ES_delta)*ES_pi(-1))*ES_k(-1)+ES_taud(-1)*ES_d(-1)+ES_t(-1)+(ES_r(-1)*(1-ES_gammab(-1)))^(-1)*ES_b+ES_m(-1);
// Government spending, using ES_pg = ES_pht
ES_pcg*ES_cg = ES_cgy*ES_pybar*ES_ybar;
ES_pig*ES_ig = ES_igy*ES_pybar*ES_ybar;
ES_t = 0;
ES_b = ES_bytarget*ES_pybar*ES_ybar;
// Auxiliary equation for steady-state output
ES_ybar = ES_y;
// Auxiliary equation for steady-state output
ES_ytbar = ES_yst;
// Auxiliary equation for steady-state output
ES_ynbar = ES_ysn;
// Auxiliary equation for steady-state output deflator
ES_pybar = ES_py;
// Auxiliary equation for the steady-state lump-sum transfers-to-output ratio
ES_trybar = ES_tr/(ES_pybar*ES_ybar);
// Auxiliary equation for determining the distribution of lump-sum taxes
ES_ti = ES_upsilont*ES_t;
/* Note: Valid parameter space: 0 <= upsilont <= 1/(1-omega) with
upsilont = 0:            ti = 0, tj = 1/omega t
upsilont = 1:            ti = tj = t
upsilont = 1/(1-omega):  ti = 1/(1-omega) t, tj = 0. */
// Auxiliary equation for determining the distribution of lump-sum transfers
ES_tri = ES_upsilontr*ES_tr;
/* Note: Valid parameter space: 0 <= upsilontr <= 1/(1-omega) with
upsilontr = 0:            tri = 0, trj = 1/omega tr
upsilontr = 1:            tri = trj = tr
upsilontr = 1/(1-omega):  tri = 1/(1-omega) tr, trj = 0. */
//-------------
// Monetary authority
//-------------
	ES_r = DE_r;
ES_pic4 = ES_pi4target;
ES_rr-1 = ES_r/ES_pi4target^(1/4)-1;
// Equilibrium real interest rate
ES_rrstar-1 = 1/ES_beta-1;
//-------------
//-------------
// Aggregation, market clearing and resource constraint
//-------------
//-------------
//-------------
// Aggregation
//-------------
// Aggregate consumption
ES_c = (1-ES_omega)*ES_ci+ES_omega*ES_cj;
// Aggregate money holdings
ES_m = (1-ES_omega)*ES_mi+ES_omega*ES_mj;
// Aggregate capital stock
ES_k = (1-ES_omega)*ES_ki;
// Aggregate investment
ES_i = (1-ES_omega)*ES_ii;
// Aggregate lump-sum transfers
ES_trj = 
1/ES_omega*ES_tr-(1-ES_omega)/ES_omega*ES_tri
;
// Aggregate lump-sum taxes
ES_tj = 
1/ES_omega*ES_t-(1-ES_omega)/ES_omega*ES_ti
;
// Aggregate transaction costs
ES_gammav = (1-ES_omega)*ES_ci*ES_gammavi+ES_omega*ES_cj*ES_gammavj;
//-------------
// Market clearing
//-------------
// Labour markets for household I
// Wedge between labour demand/hours worked and labour supply
ES_ni = ES_si*ES_ndi;
// Wage dispersion
ES_si = (1-ES_xii)*(ES_witilde/ES_wi)^(-ES_etai)+ES_xii*(ES_wi(-1)/ES_wi)^(-ES_etai)*(ES_pic/(ES_pic(-1)^ES_chii*ES_pi4target^(1/4*(1-ES_chii))))^(ES_etai)*ES_si(-1);
// Labour markets for household J
// Wedge between labour demand/hours worked and labour supply
ES_nj = ES_sj*ES_ndj;
// Wage dispersion
ES_sj = (1-ES_xij)*(ES_wjtilde/ES_wj)^(-ES_etaj)+ES_xij*(ES_wj(-1)/ES_wj)^(-ES_etaj)*(ES_pic/(ES_pic(-1)^ES_chij*ES_pi4target^(1/4*(1-ES_chij))))^(ES_etaj)*ES_sj(-1);
// Rental market for capital
// Equality of capital input and effective capital services
ES_u*ES_k = ES_kd;
// Intermediate-good markets
// Wedge between aggregate demand and production, using ES_x = FI_size/ES_size*FI_im
ES_ysn = ES_snt*ES_nt;
//  nontradables aggregate demand
ES_nt = 
+ES_ntc
+ES_nti
+ES_ntcg
+ES_ntig
;
// Aggregate demand for domestic intermediate goods, using ES_hg = ES_cg
ES_ht =
+ES_htc
+ES_hti
+ES_htcg
+ES_htig
;
// Price dispersion in the domestic markets
ES_sh = (1-ES_xih)*(ES_phttilde/ES_pht)^(-ES_thetat)+ES_xih*(ES_piht/(ES_piht(-1)^ES_chih*ES_pi4target^(1/4*(1-ES_chih))))^ES_thetat*ES_sh(-1);
// Price dispersion in the foreign markets
ES_sx = (1-ES_xix)*(ES_pextilde/ES_pex)^(-ES_thetat)+ES_xix*(ES_piex/(ES_piex(-1)^ES_chix*ES_pi4target^(1/4*(1-ES_chix))))^ES_thetat*ES_sx(-1);
// Price dispersion in the domestic markets
ES_snt = (1-ES_xin)*(ES_pnttilde/ES_pnt)^(-ES_thetan)+ES_xin*(ES_pint/(ES_pint(-1)^ES_chin*ES_pi4target^(1/4*(1-ES_chin))))^ES_thetan*ES_snt(-1);
// Final-good markets
// Aggregate consumption and transaction cost
ES_qc = ES_c+ES_gammav;
// Aggregate investment and capital utilisation cost
ES_qi = ES_i+ES_k*ES_gammau;
// Aggregate gov demand components added to use the same structure like in private components
ES_qcg = ES_cg;
ES_qig = ES_ig;
//-------------
// Resource constraint
//-------------
// TODO: why there is no adjustment cost for gov components
// Aggregate nominal demand
ES_py*ES_y = 
+ES_qc
+ES_pi*ES_qi
+ES_pcg*ES_qcg
+ES_pig*ES_qig
+ES_pex*RA_size/ES_size*RAES_im
-(RA_pex*ESRA_rer)*ESRA_imc
-(RA_pex*ESRA_rer)*ESRA_imi
-(RA_pex*ESRA_rer)*ESRA_imcg
-(RA_pex*ESRA_rer)*ESRA_imig
+ES_pex*AT_size/ES_size*ATES_im
-(AT_pex*ESAT_rer)*ESAT_imc
-(AT_pex*ESAT_rer)*ESAT_imi
-(AT_pex*ESAT_rer)*ESAT_imcg
-(AT_pex*ESAT_rer)*ESAT_imig
+ES_pex*BE_size/ES_size*BEES_im
-(BE_pex*ESBE_rer)*ESBE_imc
-(BE_pex*ESBE_rer)*ESBE_imi
-(BE_pex*ESBE_rer)*ESBE_imcg
-(BE_pex*ESBE_rer)*ESBE_imig
+ES_pex*FI_size/ES_size*FIES_im
-(FI_pex*ESFI_rer)*ESFI_imc
-(FI_pex*ESFI_rer)*ESFI_imi
-(FI_pex*ESFI_rer)*ESFI_imcg
-(FI_pex*ESFI_rer)*ESFI_imig
+ES_pex*FR_size/ES_size*FRES_im
-(FR_pex*ESFR_rer)*ESFR_imc
-(FR_pex*ESFR_rer)*ESFR_imi
-(FR_pex*ESFR_rer)*ESFR_imcg
-(FR_pex*ESFR_rer)*ESFR_imig
+ES_pex*GR_size/ES_size*GRES_im
-(GR_pex*ESGR_rer)*ESGR_imc
-(GR_pex*ESGR_rer)*ESGR_imi
-(GR_pex*ESGR_rer)*ESGR_imcg
-(GR_pex*ESGR_rer)*ESGR_imig
+ES_pex*IT_size/ES_size*ITES_im
-(IT_pex*ESIT_rer)*ESIT_imc
-(IT_pex*ESIT_rer)*ESIT_imi
-(IT_pex*ESIT_rer)*ESIT_imcg
-(IT_pex*ESIT_rer)*ESIT_imig
+ES_pex*NL_size/ES_size*NLES_im
-(NL_pex*ESNL_rer)*ESNL_imc
-(NL_pex*ESNL_rer)*ESNL_imi
-(NL_pex*ESNL_rer)*ESNL_imcg
-(NL_pex*ESNL_rer)*ESNL_imig
+ES_pex*PT_size/ES_size*PTES_im
-(PT_pex*ESPT_rer)*ESPT_imc
-(PT_pex*ESPT_rer)*ESPT_imi
-(PT_pex*ESPT_rer)*ESPT_imcg
-(PT_pex*ESPT_rer)*ESPT_imig
+ES_pex*DE_size/ES_size*DEES_im
-(DE_pex*ESDE_rer)*ESDE_imc
-(DE_pex*ESDE_rer)*ESDE_imi
-(DE_pex*ESDE_rer)*ESDE_imcg
-(DE_pex*ESDE_rer)*ESDE_imig
+ES_pex*RU_size/ES_size*RUES_im
-(RU_pex*ESRU_rer)*ESRU_imc
-(RU_pex*ESRU_rer)*ESRU_imi
-(RU_pex*ESRU_rer)*ESRU_imcg
-(RU_pex*ESRU_rer)*ESRU_imig
+ES_pex*RW_size/ES_size*RWES_im
-(RW_pex*ESRW_rer)*ESRW_imc
-(RW_pex*ESRW_rer)*ESRW_imi
-(RW_pex*ESRW_rer)*ESRW_imcg
-(RW_pex*ESRW_rer)*ESRW_imig
+ES_pex*US_size/ES_size*USES_im
-(US_pex*ESUS_rer)*ESUS_imc
-(US_pex*ESUS_rer)*ESUS_imi
-(US_pex*ESUS_rer)*ESUS_imcg
-(US_pex*ESUS_rer)*ESUS_imig
;
// Aggregate real demand
ES_y = ES_yst+ES_ysn;
//-------------
//-------------
// Autoregressive shocks
//-------------
//-------------
// Productivity shocks
log(ES_zt) = (1-ES_rhozt)*log(ES_ztbar)+ES_rhozt*log(ES_zt(-1))+ES_epszt;
log(ES_zn) = (1-ES_rhozn)*log(ES_znbar)+ES_rhozn*log(ES_zn(-1))+ES_epszn;
// Government spending shock
ES_cgy = (1-ES_rhocg)*ES_cgybar+ES_rhocg*ES_cgy(-1)+ES_epsgc;
ES_igy = (1-ES_rhoig)*ES_igybar+ES_rhoig*ES_igy(-1)+ES_epsgi;
// Transfer shock
ES_try = (1-ES_rhotr)*ES_trybar+ES_rhotr*ES_try(-1)+ES_epstr;
// Consumption tax shock
ES_tauc = (1-ES_rhotauc)*ES_taucbar+ES_rhotauc*ES_tauc(-1)+ES_epstauc;
// Dividend income tax shock
ES_taud = (1-ES_rhotaud)*ES_taudbar+ES_rhotaud*ES_taud(-1)+ES_epstaud;
// Capital income tax shock
ES_tauk = (1-ES_rhotauk)*ES_taukbar+ES_rhotauk*ES_tauk(-1)+ES_epstauk;
// Labour income tax shock
ES_taun = (1-ES_rhotaun)*ES_taunbar+ES_rhotaun*ES_taun(-1)+ES_epstaun;
// Payroll tax shock: households
ES_tauwh = (1-ES_rhotauwh)*ES_tauwhbar+ES_rhotauwh*ES_tauwh(-1)+ES_epstauwh;
// Payroll tax shock: firms
ES_tauwf = (1-ES_rhotauwf)*ES_tauwfbar+ES_rhotauwf*ES_tauwf(-1)+ES_epstauwf;
// Wage cost push shock
ES_wcst = (1-ES_rhowcst)*ES_wcstbar+ES_rhowcst*ES_wcst(-1)+ES_epswcst;
// Preference shock
log(ES_zcon) = (1-ES_rhozcon)*log(ES_zconbar)+ES_rhozcon*log(ES_zcon(-1))+ES_epszcon;
// Investment specific shock
log(ES_zinv) = (1-ES_rhozinv)*log(ES_zinvbar)+ES_rhozinv*log(ES_zinv(-1))+ES_epszinv;
//-------------
//-------------
// Conditions for calibration and reporting
//-------------
//-------------
// Aggregate nominal consumption share
ES_cy = ES_c/(ES_py*ES_y);
// Aggregate nominal investment share
ES_iy = ES_pi*ES_i/(ES_py*ES_y);
// Aggregate nominal import share  
ES_imy = (
+ES_pimc*ES_imc
+ES_pimi*ES_imi
+ES_pimcg*ES_imcg
+ES_pimig*ES_imig
)/(ES_py*ES_y);
// Aggregate nominal import share
ES_imcy = ES_pimc*ES_imc/(ES_py*ES_y);
ES_imiy = ES_pimi*ES_imi/(ES_py*ES_y);
ES_imcgy = ES_pimcg*ES_imcg/(ES_py*ES_y);
ES_imigy = ES_pimig*ES_imig/(ES_py*ES_y);
// Aggregate debt-to-output ratio
ES_by = ES_b/(ES_pybar*ES_ybar);
// Aggregate lump-sum tax-to-output ratio
ES_ty = ES_t/(ES_pybar*ES_ybar);
// Aggregate labour cost share
ES_lcy = ((1+ES_tauwf)*ES_w*ES_nd)/(ES_py*ES_y);
// Aggregate nominal Wage share
ES_wy = (ES_w*ES_nd)/(ES_py*ES_y);
// NT sector nominal Wage share
ES_wnty = (ES_w*ES_ndn)/(ES_pnt*ES_ysn);
// T sector nominal Wage share
ES_whty = (ES_w*ES_ndt)/(ES_pht*ES_yst);
// T sector share
ES_yhty = ES_pht*ES_yst/(ES_py*ES_y);
// NT sector share
ES_ynty = ES_pnt*ES_ysn/(ES_py*ES_y);
// Output gap
ES_ygap = 0;
// Output growth (gross rate)
ES_ygrowth = ES_y/ES_y(-1);
// Output growth (gross rate yoy)
ES_ygrowth4 = ES_y/ES_y(-4);
// Domestic nominal output as a share of world nominal output
ES_yshare  = ES_size*ES_py*ES_y/ES_rer/(
+RA_size*RA_py*RA_y/RA_rer
+AT_size*AT_py*AT_y/AT_rer
+BE_size*BE_py*BE_y/BE_rer
+ES_size*ES_py*ES_y/ES_rer
+FI_size*FI_py*FI_y/FI_rer
+FR_size*FR_py*FR_y/FR_rer
+GR_size*GR_py*GR_y/GR_rer
+IT_size*IT_py*IT_y/IT_rer
+NL_size*NL_py*NL_y/NL_rer
+PT_size*PT_py*PT_y/PT_rer
+DE_size*DE_py*DE_y/DE_rer
+RU_size*RU_py*RU_y/RU_rer
+RW_size*RW_py*RW_y/RW_rer
+US_size*US_py*US_y/US_rer
);
// Interest (semi-)elasticity of money demand
ES_epsilonm = -1/8*1/(ES_r*(ES_gammav2*ES_r+ES_r-1));
// Trade balance-to-GDP ratio
ES_tby = ES_tb/(ES_py*ES_y);
// Bilateral shares
ESRA_imcy = (RA_pex*ESRA_rer)*ESRA_imc/(ES_py*ES_y);
ESRA_imiy = (RA_pex*ESRA_rer)*ESRA_imi/(ES_py*ES_y);
ESRA_imcgy = (RA_pex*ESRA_rer)*ESRA_imcg/(ES_py*ES_y);
ESRA_imigy = (RA_pex*ESRA_rer)*ESRA_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESRA_excy  = RA_size/ES_size*ES_pex*RAES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESRA_exiy  = RA_size/ES_size*ES_pex*RAES_imi/(ES_py*ES_y);
// Bilateral shares
ESAT_imcy = (AT_pex*ESAT_rer)*ESAT_imc/(ES_py*ES_y);
ESAT_imiy = (AT_pex*ESAT_rer)*ESAT_imi/(ES_py*ES_y);
ESAT_imcgy = (AT_pex*ESAT_rer)*ESAT_imcg/(ES_py*ES_y);
ESAT_imigy = (AT_pex*ESAT_rer)*ESAT_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESAT_excy  = AT_size/ES_size*ES_pex*ATES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESAT_exiy  = AT_size/ES_size*ES_pex*ATES_imi/(ES_py*ES_y);
// Bilateral shares
ESBE_imcy = (BE_pex*ESBE_rer)*ESBE_imc/(ES_py*ES_y);
ESBE_imiy = (BE_pex*ESBE_rer)*ESBE_imi/(ES_py*ES_y);
ESBE_imcgy = (BE_pex*ESBE_rer)*ESBE_imcg/(ES_py*ES_y);
ESBE_imigy = (BE_pex*ESBE_rer)*ESBE_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESBE_excy  = BE_size/ES_size*ES_pex*BEES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESBE_exiy  = BE_size/ES_size*ES_pex*BEES_imi/(ES_py*ES_y);
// Bilateral shares
ESFI_imcy = (FI_pex*ESFI_rer)*ESFI_imc/(ES_py*ES_y);
ESFI_imiy = (FI_pex*ESFI_rer)*ESFI_imi/(ES_py*ES_y);
ESFI_imcgy = (FI_pex*ESFI_rer)*ESFI_imcg/(ES_py*ES_y);
ESFI_imigy = (FI_pex*ESFI_rer)*ESFI_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESFI_excy  = FI_size/ES_size*ES_pex*FIES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESFI_exiy  = FI_size/ES_size*ES_pex*FIES_imi/(ES_py*ES_y);
// Bilateral shares
ESFR_imcy = (FR_pex*ESFR_rer)*ESFR_imc/(ES_py*ES_y);
ESFR_imiy = (FR_pex*ESFR_rer)*ESFR_imi/(ES_py*ES_y);
ESFR_imcgy = (FR_pex*ESFR_rer)*ESFR_imcg/(ES_py*ES_y);
ESFR_imigy = (FR_pex*ESFR_rer)*ESFR_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESFR_excy  = FR_size/ES_size*ES_pex*FRES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESFR_exiy  = FR_size/ES_size*ES_pex*FRES_imi/(ES_py*ES_y);
// Bilateral shares
ESGR_imcy = (GR_pex*ESGR_rer)*ESGR_imc/(ES_py*ES_y);
ESGR_imiy = (GR_pex*ESGR_rer)*ESGR_imi/(ES_py*ES_y);
ESGR_imcgy = (GR_pex*ESGR_rer)*ESGR_imcg/(ES_py*ES_y);
ESGR_imigy = (GR_pex*ESGR_rer)*ESGR_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESGR_excy  = GR_size/ES_size*ES_pex*GRES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESGR_exiy  = GR_size/ES_size*ES_pex*GRES_imi/(ES_py*ES_y);
// Bilateral shares
ESIT_imcy = (IT_pex*ESIT_rer)*ESIT_imc/(ES_py*ES_y);
ESIT_imiy = (IT_pex*ESIT_rer)*ESIT_imi/(ES_py*ES_y);
ESIT_imcgy = (IT_pex*ESIT_rer)*ESIT_imcg/(ES_py*ES_y);
ESIT_imigy = (IT_pex*ESIT_rer)*ESIT_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESIT_excy  = IT_size/ES_size*ES_pex*ITES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESIT_exiy  = IT_size/ES_size*ES_pex*ITES_imi/(ES_py*ES_y);
// Bilateral shares
ESNL_imcy = (NL_pex*ESNL_rer)*ESNL_imc/(ES_py*ES_y);
ESNL_imiy = (NL_pex*ESNL_rer)*ESNL_imi/(ES_py*ES_y);
ESNL_imcgy = (NL_pex*ESNL_rer)*ESNL_imcg/(ES_py*ES_y);
ESNL_imigy = (NL_pex*ESNL_rer)*ESNL_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESNL_excy  = NL_size/ES_size*ES_pex*NLES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESNL_exiy  = NL_size/ES_size*ES_pex*NLES_imi/(ES_py*ES_y);
// Bilateral shares
ESPT_imcy = (PT_pex*ESPT_rer)*ESPT_imc/(ES_py*ES_y);
ESPT_imiy = (PT_pex*ESPT_rer)*ESPT_imi/(ES_py*ES_y);
ESPT_imcgy = (PT_pex*ESPT_rer)*ESPT_imcg/(ES_py*ES_y);
ESPT_imigy = (PT_pex*ESPT_rer)*ESPT_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESPT_excy  = PT_size/ES_size*ES_pex*PTES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESPT_exiy  = PT_size/ES_size*ES_pex*PTES_imi/(ES_py*ES_y);
// Bilateral shares
ESDE_imcy = (DE_pex*ESDE_rer)*ESDE_imc/(ES_py*ES_y);
ESDE_imiy = (DE_pex*ESDE_rer)*ESDE_imi/(ES_py*ES_y);
ESDE_imcgy = (DE_pex*ESDE_rer)*ESDE_imcg/(ES_py*ES_y);
ESDE_imigy = (DE_pex*ESDE_rer)*ESDE_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESDE_excy  = DE_size/ES_size*ES_pex*DEES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESDE_exiy  = DE_size/ES_size*ES_pex*DEES_imi/(ES_py*ES_y);
// Bilateral shares
ESRU_imcy = (RU_pex*ESRU_rer)*ESRU_imc/(ES_py*ES_y);
ESRU_imiy = (RU_pex*ESRU_rer)*ESRU_imi/(ES_py*ES_y);
ESRU_imcgy = (RU_pex*ESRU_rer)*ESRU_imcg/(ES_py*ES_y);
ESRU_imigy = (RU_pex*ESRU_rer)*ESRU_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESRU_excy  = RU_size/ES_size*ES_pex*RUES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESRU_exiy  = RU_size/ES_size*ES_pex*RUES_imi/(ES_py*ES_y);
// Bilateral shares
ESRW_imcy = (RW_pex*ESRW_rer)*ESRW_imc/(ES_py*ES_y);
ESRW_imiy = (RW_pex*ESRW_rer)*ESRW_imi/(ES_py*ES_y);
ESRW_imcgy = (RW_pex*ESRW_rer)*ESRW_imcg/(ES_py*ES_y);
ESRW_imigy = (RW_pex*ESRW_rer)*ESRW_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESRW_excy  = RW_size/ES_size*ES_pex*RWES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESRW_exiy  = RW_size/ES_size*ES_pex*RWES_imi/(ES_py*ES_y);
// Bilateral shares
ESUS_imcy = (US_pex*ESUS_rer)*ESUS_imc/(ES_py*ES_y);
ESUS_imiy = (US_pex*ESUS_rer)*ESUS_imi/(ES_py*ES_y);
ESUS_imcgy = (US_pex*ESUS_rer)*ESUS_imcg/(ES_py*ES_y);
ESUS_imigy = (US_pex*ESUS_rer)*ESUS_imig/(ES_py*ES_y);
// Exports of consumption goods to gdp
ESUS_excy  = US_size/ES_size*ES_pex*USES_imc/(ES_py*ES_y);
// Exports of investment goods to gdp
ESUS_exiy  = US_size/ES_size*ES_pex*USES_imi/(ES_py*ES_y);
// Internal real exchange rate
ES_internalrer = ES_pnt/ES_pttc;
// Core model begins
//-------------
//-------------
// Households
//-------------
//-------------
//-------------
// Household I
//-------------
FI_ccesi^(1-1/FI_mucces) = (FI_nucces)^(1/FI_mucces)*FI_ci^(1-1/FI_mucces)+(1-FI_nucces)^(1/FI_mucces)*FI_cg^(1-1/FI_mucces);
// Utility
FI_utili = 
FI_zcon*log(FI_ccesi-FI_kappa*FI_ccesi(-1))-1/(1+FI_zeta)*(FI_ni)^(1+FI_zeta)+FI_beta*FI_utili(+1)
;
// Marginal utility of consumption
FI_dcci = ((FI_nucces)^(1/FI_mucces)*FI_ci^(1-1/FI_mucces)+(1-FI_nucces)^(1/FI_mucces)*FI_cg^(1-1/FI_mucces))^(1/(FI_mucces-1))*(FI_nucces^(1/FI_mucces))*(FI_ci^(-1/FI_mucces));
FI_lambdai*(1+FI_tauc+FI_gammavi+FI_vi*FI_gammavider) = FI_zcon*(FI_ccesi-FI_kappa*FI_ccesi(-1))^(-FI_sigma)*FI_dcci;
// Euler equation for government bonds
// all other that are not Germany, not US and not the RoW
FI_r                   = FI_beta^(-1)*FI_lambdai/FI_lambdai    *FI_pic;
// Germany
// US and the RoW
// Euler equation for money
FI_vi^(2)*FI_gammavider = 1-FI_beta*FI_lambdai(+1)/(FI_lambdai*FI_pic(+1));
// Consumption-based velocity
FI_vi = FI_ci/FI_mi;
// Transaction cost
FI_gammavi = FI_gammav1*FI_vi+FI_gammav2/FI_vi-2*(FI_gammav1*FI_gammav2)^(1/2);
// Derivative of transaction cost
FI_gammavider = FI_gammav1-FI_gammav2*FI_vi^(-2);
FI_delta = FI_ii/FI_ki;
FI_gammai = 0;
FI_gammaider = 0;
FI_gammau = 0;
FI_gammauder = ((FI_beta^(-1)-1+FI_delta)*FI_qbar-FI_delta*FI_taukbar*FI_pibar)/((1-FI_taukbar)*FI_pibar);
FI_u = 1;
FI_pi = FI_q;
// Auxiliary equation for Tobin's Q in steady state
FI_qbar = FI_q;
// Rate of return on capital
FI_q = FI_beta*((1-FI_tauk)*FI_rk+(FI_tauk*FI_delta)*FI_pi+(1-FI_delta)*FI_q);
// Optimal wage contract (FOC)
FI_witilde^(1+FI_etai*FI_zeta) = FI_etai/(FI_etai-1)*FI_fi/FI_gi+FI_wcst;
// Definition of fi
FI_fi = FI_wi^(FI_etai*(1+FI_zeta))*FI_ndi^(1+FI_zeta)+FI_xii*FI_beta*(FI_pic(+1)/(FI_pic^FI_chii*FI_pi4target^(1/4*(1-FI_chii))))^(FI_etai*(1+FI_zeta))*FI_fi(+1);
// Definition of gi
FI_gi = FI_lambdai*(1-FI_taun-FI_tauwh)*FI_wi^FI_etai*FI_ndi+FI_xii*FI_beta*(FI_pic(+1)/(FI_pic^FI_chii*FI_pi4target^(1/4*(1-FI_chii))))^(FI_etai-1)*FI_gi(+1);
// Aggregate wage rate
FI_wi^(1-FI_etai) = (1-FI_xii)*FI_witilde^(1-FI_etai)+FI_xii*FI_wi(-1)^(1-FI_etai)*(FI_pic(-1)^FI_chii*FI_pi4target^(1/4*(1-FI_chii))/FI_pic)^(1-FI_etai);
//-------------
// Household J
//-------------
FI_ccesj^(1-1/FI_mucces) = (FI_nucces)^(1/FI_mucces)*FI_cj^(1-1/FI_mucces)+(1-FI_nucces)^(1/FI_mucces)*FI_cg^(1-1/FI_mucces);
// Utility
FI_utilj = 
FI_zcon*log(FI_ccesj-FI_kappa*FI_ccesj(-1))-1/(1+FI_zeta)*(FI_nj)^(1+FI_zeta)+FI_beta*FI_utilj(+1)
;
// Marginal utility of consumption
FI_dccj = ((FI_nucces)^(1/FI_mucces)*FI_cj^(1-1/FI_mucces)+(1-FI_nucces)^(1/FI_mucces)*FI_cg^(1-1/FI_mucces))^(1/(FI_mucces-1))*(FI_nucces^(1/FI_mucces))*(FI_cj^(-1/FI_mucces));
FI_lambdaj*(1+FI_tauc+FI_gammavj+FI_vj*FI_gammavjder) = FI_zcon*(FI_ccesj-FI_kappa*FI_ccesj(-1))^(-FI_sigma)*FI_dccj;
// Budget constraint
(1+FI_tauc+FI_gammavj)*FI_cj+FI_mj = (1-FI_taun-FI_tauwh)*FI_wj*FI_nj+FI_trj-FI_tj+FI_mj(-1)*FI_pic^(-1);
// Euler equation for money
FI_vj^(2)*FI_gammavjder = 1-FI_beta*FI_lambdaj(+1)/(FI_lambdaj*FI_pic(+1));
// Consumption-based velocity
FI_vj = FI_cj/FI_mj;
// Transaction technology
FI_gammavj = FI_gammav1*FI_vj+FI_gammav2/FI_vj-2*(FI_gammav1*FI_gammav2)^(1/2);
// Derivative of transaction technology
FI_gammavjder = FI_gammav1-FI_gammav2*FI_vj^(-2);
// Optimal wage contract (FOC)
FI_wjtilde^(1+FI_etaj*FI_zeta) = FI_etaj/(FI_etaj-1)*FI_fj/FI_gj+FI_wcst;
// Definition of fj
FI_fj = FI_wj^(FI_etaj*(1+FI_zeta))*FI_ndj^(1+FI_zeta)+FI_xij*FI_beta*(FI_pic(+1)/(FI_pic^FI_chij*FI_pi4target^(1/4*(1-FI_chij))))^(FI_etaj*(1+FI_zeta))*FI_fj(+1);
// Definition of gj
FI_gj = FI_lambdaj*(1-FI_taun-FI_tauwh)*FI_wj^FI_etaj*FI_ndj+FI_xij*FI_beta*(FI_pic(+1)/(FI_pic^FI_chij*FI_pi4target^(1/4*(1-FI_chij))))^(FI_etaj-1)*FI_gj(+1);
// Aggregate wage rate
FI_wj^(1-FI_etaj) = (1-FI_xij)*FI_wjtilde^(1-FI_etaj)+FI_xij*FI_wj(-1)^(1-FI_etaj)*(FI_pic(-1)^FI_chij*FI_pi4target^(1/4*(1-FI_chij))/FI_pic)^(1-FI_etaj);
//-------------
//-------------
// Firms
//-------------
//-------------
//-------------
// Intermediate-good firms
//-------------
// Government capital accumulation:
FI_kg = (1-FI_deltag)*FI_kg(-1)+FI_ig(-1);
// Production function tradable
FI_yst = EA_z*FI_zt*FI_kg^FI_alphag*FI_kdt^FI_alphat*FI_ndt^(1-FI_alphat)-FI_psitbar;
// Production function nontradable
FI_ysn = EA_z*FI_zn*FI_kg^FI_alphag*FI_kdn^FI_alphan*FI_ndn^(1-FI_alphan)-FI_psinbar;
// Real marginal cost tradable
FI_mct = 1/(EA_z*FI_zt*FI_kg^FI_alphag*(FI_alphat)^(FI_alphat)*(1-FI_alphat)^(1-FI_alphat))*FI_rk^(FI_alphat)*((1+FI_tauwf)*FI_w)^(1-FI_alphat);
// Real marginal cost nontradable
FI_mcn = 1/(EA_z*FI_zn*FI_kg^FI_alphag*(FI_alphan)^(FI_alphan)*(1-FI_alphan)^(1-FI_alphan))*FI_rk^(FI_alphan)*((1+FI_tauwf)*FI_w)^(1-FI_alphan);
// Wage Inflation (qoq)
FI_piw = FI_w/FI_w(-1)*FI_pic;
// Wage Inflation (yoy)
FI_piw4 = FI_pic4;
// Auxiliary equation for steady-state fixed cost
FI_psitbar = FI_psit*FI_ytbar;
// Auxiliary equation for steady-state fixed cost
FI_psinbar = FI_psin*FI_ynbar;
// Capital input (FOC)
FI_rk = FI_alphat*(FI_yst+FI_psitbar)/FI_kdt*FI_mct;
// Capital input (FOC)
FI_rk = FI_alphan*(FI_ysn+FI_psinbar)/FI_kdn*FI_mcn;
// Total capital demand
FI_kd = FI_kdt+FI_kdn;
// Demand for labour services by household I
FI_ndi = 
(1-FI_omega)*(FI_wi/FI_w)^(-FI_eta)*FI_nd
;
// Demand for labour services by household J
FI_ndj = 
FI_omega*(FI_wj/FI_w)^(-FI_eta)*FI_nd
;
// Aggregate labour demand
FI_nd^(1-1/FI_eta) = 
(1-FI_omega)^(1/FI_eta)*FI_ndi^(1-1/FI_eta)+FI_omega^(1/FI_eta)*FI_ndj^(1-1/FI_eta)
;
// Total demand 
FI_nd = FI_ndt+FI_ndn;
// Aggregate dividends
FI_d = FI_py*FI_y-FI_rk*FI_kd-(1+FI_tauwf)*FI_w*FI_nd;
// Non-tradable sector dividends
FI_dn = FI_pnt*FI_ysn-FI_rk*FI_kdn-(1+FI_tauwf)*FI_w*FI_ndn;
// Tradable sector dividends
FI_dt = FI_pht*FI_ht
+FI_pex*FI_ex
-FI_rk*FI_kdt-(1+FI_tauwf)*FI_w*FI_ndt;
// Optimal price contract set in domestic markets (FOC)
FI_phttilde/FI_pht = FI_thetat/(FI_thetat-1)*FI_fh/FI_gh;
// Definition of fh
FI_fh = FI_mct*FI_ht+FI_xih*FI_beta*FI_lambdai(+1)/FI_lambdai*(FI_piht(+1)/(FI_piht^FI_chih*FI_pi4target^(1/4*(1-FI_chih))))^FI_thetat*FI_fh(+1);
// Definition of gh
FI_gh = FI_pht*FI_ht+FI_xih*FI_beta*FI_lambdai(+1)/FI_lambdai*(FI_piht(+1)/(FI_piht^FI_chih*FI_pi4target^(1/4*(1-FI_chih))))^(FI_thetat-1)*FI_gh(+1);
// Aggregate intermediate-good price dynamics
FI_pht^(1-FI_thetat) = (1-FI_xih)*FI_phttilde^(1-FI_thetat)+FI_xih*(FI_pht(-1)/FI_pic)^(1-FI_thetat)*(FI_piht(-1)^FI_chih*FI_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation
FI_piht = FI_pht/FI_pht(-1)*FI_pic;
// Optimal price contract set in domestic markets (FOC)
FI_pnttilde/FI_pnt = FI_thetan/(FI_thetan-1)*FI_fn/FI_gn;
// Definition of fn
FI_fn = FI_mcn*FI_nt+FI_xin*FI_beta*FI_lambdai(+1)/FI_lambdai*(FI_pint(+1)/(FI_pint^FI_chin*FI_pi4target^(1/4*(1-FI_chin))))^FI_thetan*FI_fn(+1);
// Definition of gn
FI_gn = FI_pnt*FI_nt+FI_xin*FI_beta*FI_lambdai(+1)/FI_lambdai*(FI_pint(+1)/(FI_pint^FI_chin*FI_pi4target^(1/4*(1-FI_chin))))^(FI_thetan-1)*FI_gn(+1);
// Aggregate intermediate-good price dynamics
FI_pnt^(1-FI_thetan) = (1-FI_xin)*FI_pnttilde^(1-FI_thetan)+FI_xin*(FI_pnt(-1)/FI_pic)^(1-FI_thetan)*(FI_pint(-1)^FI_chin*FI_pi4target^(1/4*(1-FI_chin)))^(1-FI_thetan);
// Intermediate-good price inflation
FI_pint = FI_pnt/FI_pnt(-1)*FI_pic;
// Optimal price contract set in domestic markets (FOC)
FI_pextilde/FI_pex = FI_thetat/(FI_thetat-1)*FI_fx/FI_gx;
// Definition of fh
FI_fx = FI_mct*FI_ex+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(FI_piex(+1)/(FI_piex^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FI_fx(+1);
// Definition of gh
FI_gx = FI_pex*FI_ex+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(FI_piex(+1)/(FI_piex^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FI_gx(+1);
// Aggregate intermediate-good price dynamics
FI_pex^(1-FI_thetat) = (1-FI_xix)*FI_pextilde^(1-FI_thetat)+FI_xix*(FI_pex(-1)/FI_pic)^(1-FI_thetat)*(FI_piex(-1)^FI_chix*FI_pi4target^(1/4*(1-FI_chix)))^(1-FI_thetat);
// Intermediate-good price inflation
FI_piex = FI_pex/FI_pex(-1)*FI_pic;
//---------------
// import pricing
//---------------
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = RA_pimtilde
// RAFI_pimtilde/RAFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIRA_fx/FIRA_gx;
// Definition of fx
// FIRA_fx = RA_size/FI_size*RAFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(RAFI_piim(+1)/(RAFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIRA_fx(+1);
// Definition of gx   
// FIRA_gx = FIRA_rer*RAFI_pim*RA_size/FI_size*RAFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(RAFI_piim(+1)/(RAFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIRA_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = RA_pim
// RAFI_pim^(1-FI_thetat) = (1-FI_xix)*RAFI_pimtilde^(1-FI_thetat)+FI_xix*(RAFI_pim(-1)/RA_pic)^(1-FI_thetat)*(RAFI_piim(-1)^FI_chix*RA_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = RA_piim
// RAFI_piim = RAFI_pim/RAFI_pim(-1)*RA_pic;
// Bilateral real exchange rate
FIRA_rer = FI_rer/RA_rer;
// Auxiliary equation for steady-state output
FIRA_rerbar = FIRA_rer;
//Terms of Trade
FIRA_tot = RA_pex*FIRA_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = AT_pimtilde
// ATFI_pimtilde/ATFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIAT_fx/FIAT_gx;
// Definition of fx
// FIAT_fx = AT_size/FI_size*ATFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(ATFI_piim(+1)/(ATFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIAT_fx(+1);
// Definition of gx   
// FIAT_gx = FIAT_rer*ATFI_pim*AT_size/FI_size*ATFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(ATFI_piim(+1)/(ATFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIAT_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = AT_pim
// ATFI_pim^(1-FI_thetat) = (1-FI_xix)*ATFI_pimtilde^(1-FI_thetat)+FI_xix*(ATFI_pim(-1)/AT_pic)^(1-FI_thetat)*(ATFI_piim(-1)^FI_chix*AT_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = AT_piim
// ATFI_piim = ATFI_pim/ATFI_pim(-1)*AT_pic;
// Bilateral real exchange rate
FIAT_rer = FI_rer/AT_rer;
// Auxiliary equation for steady-state output
FIAT_rerbar = FIAT_rer;
//Terms of Trade
FIAT_tot = AT_pex*FIAT_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = BE_pimtilde
// BEFI_pimtilde/BEFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIBE_fx/FIBE_gx;
// Definition of fx
// FIBE_fx = BE_size/FI_size*BEFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(BEFI_piim(+1)/(BEFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIBE_fx(+1);
// Definition of gx   
// FIBE_gx = FIBE_rer*BEFI_pim*BE_size/FI_size*BEFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(BEFI_piim(+1)/(BEFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIBE_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = BE_pim
// BEFI_pim^(1-FI_thetat) = (1-FI_xix)*BEFI_pimtilde^(1-FI_thetat)+FI_xix*(BEFI_pim(-1)/BE_pic)^(1-FI_thetat)*(BEFI_piim(-1)^FI_chix*BE_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = BE_piim
// BEFI_piim = BEFI_pim/BEFI_pim(-1)*BE_pic;
// Bilateral real exchange rate
FIBE_rer = FI_rer/BE_rer;
// Auxiliary equation for steady-state output
FIBE_rerbar = FIBE_rer;
//Terms of Trade
FIBE_tot = BE_pex*FIBE_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = ES_pimtilde
// ESFI_pimtilde/ESFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIES_fx/FIES_gx;
// Definition of fx
// FIES_fx = ES_size/FI_size*ESFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(ESFI_piim(+1)/(ESFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIES_fx(+1);
// Definition of gx   
// FIES_gx = FIES_rer*ESFI_pim*ES_size/FI_size*ESFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(ESFI_piim(+1)/(ESFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIES_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = ES_pim
// ESFI_pim^(1-FI_thetat) = (1-FI_xix)*ESFI_pimtilde^(1-FI_thetat)+FI_xix*(ESFI_pim(-1)/ES_pic)^(1-FI_thetat)*(ESFI_piim(-1)^FI_chix*ES_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = ES_piim
// ESFI_piim = ESFI_pim/ESFI_pim(-1)*ES_pic;
// Bilateral real exchange rate
FIES_rer = FI_rer/ES_rer;
// Auxiliary equation for steady-state output
FIES_rerbar = FIES_rer;
//Terms of Trade
FIES_tot = ES_pex*FIES_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = FR_pimtilde
// FRFI_pimtilde/FRFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIFR_fx/FIFR_gx;
// Definition of fx
// FIFR_fx = FR_size/FI_size*FRFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(FRFI_piim(+1)/(FRFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIFR_fx(+1);
// Definition of gx   
// FIFR_gx = FIFR_rer*FRFI_pim*FR_size/FI_size*FRFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(FRFI_piim(+1)/(FRFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIFR_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = FR_pim
// FRFI_pim^(1-FI_thetat) = (1-FI_xix)*FRFI_pimtilde^(1-FI_thetat)+FI_xix*(FRFI_pim(-1)/FR_pic)^(1-FI_thetat)*(FRFI_piim(-1)^FI_chix*FR_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = FR_piim
// FRFI_piim = FRFI_pim/FRFI_pim(-1)*FR_pic;
// Bilateral real exchange rate
FIFR_rer = FI_rer/FR_rer;
// Auxiliary equation for steady-state output
FIFR_rerbar = FIFR_rer;
//Terms of Trade
FIFR_tot = FR_pex*FIFR_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = GR_pimtilde
// GRFI_pimtilde/GRFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIGR_fx/FIGR_gx;
// Definition of fx
// FIGR_fx = GR_size/FI_size*GRFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(GRFI_piim(+1)/(GRFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIGR_fx(+1);
// Definition of gx   
// FIGR_gx = FIGR_rer*GRFI_pim*GR_size/FI_size*GRFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(GRFI_piim(+1)/(GRFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIGR_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = GR_pim
// GRFI_pim^(1-FI_thetat) = (1-FI_xix)*GRFI_pimtilde^(1-FI_thetat)+FI_xix*(GRFI_pim(-1)/GR_pic)^(1-FI_thetat)*(GRFI_piim(-1)^FI_chix*GR_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = GR_piim
// GRFI_piim = GRFI_pim/GRFI_pim(-1)*GR_pic;
// Bilateral real exchange rate
FIGR_rer = FI_rer/GR_rer;
// Auxiliary equation for steady-state output
FIGR_rerbar = FIGR_rer;
//Terms of Trade
FIGR_tot = GR_pex*FIGR_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = IT_pimtilde
// ITFI_pimtilde/ITFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIIT_fx/FIIT_gx;
// Definition of fx
// FIIT_fx = IT_size/FI_size*ITFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(ITFI_piim(+1)/(ITFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIIT_fx(+1);
// Definition of gx   
// FIIT_gx = FIIT_rer*ITFI_pim*IT_size/FI_size*ITFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(ITFI_piim(+1)/(ITFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIIT_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = IT_pim
// ITFI_pim^(1-FI_thetat) = (1-FI_xix)*ITFI_pimtilde^(1-FI_thetat)+FI_xix*(ITFI_pim(-1)/IT_pic)^(1-FI_thetat)*(ITFI_piim(-1)^FI_chix*IT_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = IT_piim
// ITFI_piim = ITFI_pim/ITFI_pim(-1)*IT_pic;
// Bilateral real exchange rate
FIIT_rer = FI_rer/IT_rer;
// Auxiliary equation for steady-state output
FIIT_rerbar = FIIT_rer;
//Terms of Trade
FIIT_tot = IT_pex*FIIT_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = NL_pimtilde
// NLFI_pimtilde/NLFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FINL_fx/FINL_gx;
// Definition of fx
// FINL_fx = NL_size/FI_size*NLFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(NLFI_piim(+1)/(NLFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FINL_fx(+1);
// Definition of gx   
// FINL_gx = FINL_rer*NLFI_pim*NL_size/FI_size*NLFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(NLFI_piim(+1)/(NLFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FINL_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = NL_pim
// NLFI_pim^(1-FI_thetat) = (1-FI_xix)*NLFI_pimtilde^(1-FI_thetat)+FI_xix*(NLFI_pim(-1)/NL_pic)^(1-FI_thetat)*(NLFI_piim(-1)^FI_chix*NL_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = NL_piim
// NLFI_piim = NLFI_pim/NLFI_pim(-1)*NL_pic;
// Bilateral real exchange rate
FINL_rer = FI_rer/NL_rer;
// Auxiliary equation for steady-state output
FINL_rerbar = FINL_rer;
//Terms of Trade
FINL_tot = NL_pex*FINL_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = PT_pimtilde
// PTFI_pimtilde/PTFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIPT_fx/FIPT_gx;
// Definition of fx
// FIPT_fx = PT_size/FI_size*PTFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(PTFI_piim(+1)/(PTFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIPT_fx(+1);
// Definition of gx   
// FIPT_gx = FIPT_rer*PTFI_pim*PT_size/FI_size*PTFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(PTFI_piim(+1)/(PTFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIPT_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = PT_pim
// PTFI_pim^(1-FI_thetat) = (1-FI_xix)*PTFI_pimtilde^(1-FI_thetat)+FI_xix*(PTFI_pim(-1)/PT_pic)^(1-FI_thetat)*(PTFI_piim(-1)^FI_chix*PT_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = PT_piim
// PTFI_piim = PTFI_pim/PTFI_pim(-1)*PT_pic;
// Bilateral real exchange rate
FIPT_rer = FI_rer/PT_rer;
// Auxiliary equation for steady-state output
FIPT_rerbar = FIPT_rer;
//Terms of Trade
FIPT_tot = PT_pex*FIPT_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = DE_pimtilde
// DEFI_pimtilde/DEFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIDE_fx/FIDE_gx;
// Definition of fx
// FIDE_fx = DE_size/FI_size*DEFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(DEFI_piim(+1)/(DEFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIDE_fx(+1);
// Definition of gx   
// FIDE_gx = FIDE_rer*DEFI_pim*DE_size/FI_size*DEFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(DEFI_piim(+1)/(DEFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIDE_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = DE_pim
// DEFI_pim^(1-FI_thetat) = (1-FI_xix)*DEFI_pimtilde^(1-FI_thetat)+FI_xix*(DEFI_pim(-1)/DE_pic)^(1-FI_thetat)*(DEFI_piim(-1)^FI_chix*DE_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = DE_piim
// DEFI_piim = DEFI_pim/DEFI_pim(-1)*DE_pic;
// Bilateral real exchange rate
FIDE_rer = FI_rer/DE_rer;
// Auxiliary equation for steady-state output
FIDE_rerbar = FIDE_rer;
//Terms of Trade
FIDE_tot = DE_pex*FIDE_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = RU_pimtilde
// RUFI_pimtilde/RUFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIRU_fx/FIRU_gx;
// Definition of fx
// FIRU_fx = RU_size/FI_size*RUFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(RUFI_piim(+1)/(RUFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIRU_fx(+1);
// Definition of gx   
// FIRU_gx = FIRU_rer*RUFI_pim*RU_size/FI_size*RUFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(RUFI_piim(+1)/(RUFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIRU_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = RU_pim
// RUFI_pim^(1-FI_thetat) = (1-FI_xix)*RUFI_pimtilde^(1-FI_thetat)+FI_xix*(RUFI_pim(-1)/RU_pic)^(1-FI_thetat)*(RUFI_piim(-1)^FI_chix*RU_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = RU_piim
// RUFI_piim = RUFI_pim/RUFI_pim(-1)*RU_pic;
// Bilateral real exchange rate
FIRU_rer = FI_rer/RU_rer;
// Auxiliary equation for steady-state output
FIRU_rerbar = FIRU_rer;
//Terms of Trade
FIRU_tot = RU_pex*FIRU_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = RW_pimtilde
// RWFI_pimtilde/RWFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIRW_fx/FIRW_gx;
// Definition of fx
// FIRW_fx = RW_size/FI_size*RWFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(RWFI_piim(+1)/(RWFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIRW_fx(+1);
// Definition of gx   
// FIRW_gx = FIRW_rer*RWFI_pim*RW_size/FI_size*RWFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(RWFI_piim(+1)/(RWFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIRW_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = RW_pim
// RWFI_pim^(1-FI_thetat) = (1-FI_xix)*RWFI_pimtilde^(1-FI_thetat)+FI_xix*(RWFI_pim(-1)/RW_pic)^(1-FI_thetat)*(RWFI_piim(-1)^FI_chix*RW_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = RW_piim
// RWFI_piim = RWFI_pim/RWFI_pim(-1)*RW_pic;
// Bilateral real exchange rate
FIRW_rer = FI_rer/RW_rer;
// Auxiliary equation for steady-state output
FIRW_rerbar = FIRW_rer;
//Terms of Trade
FIRW_tot = RW_pex*FIRW_rer/FI_pex;
// Optimal price contract set in foreign markets (FOC), using FI_pxtilde = US_pimtilde
// USFI_pimtilde/USFI_pim = FI_cpim*FI_thetat/(FI_thetat-1)*FIUS_fx/FIUS_gx;
// Definition of fx
// FIUS_fx = US_size/FI_size*USFI_im*FI_mct+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(USFI_piim(+1)/(USFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^FI_thetat*FIUS_fx(+1);
// Definition of gx   
// FIUS_gx = FIUS_rer*USFI_pim*US_size/FI_size*USFI_im+FI_xix*FI_beta*FI_lambdai(+1)/FI_lambdai*(USFI_piim(+1)/(USFI_piim^FI_chix*FI_pi4target^(1/4*(1-FI_chix))))^(FI_thetat-1)*FIUS_gx(+1);
// Aggregate intermediate-good price dynamics, using FI_px = US_pim
// USFI_pim^(1-FI_thetat) = (1-FI_xix)*USFI_pimtilde^(1-FI_thetat)+FI_xix*(USFI_pim(-1)/US_pic)^(1-FI_thetat)*(USFI_piim(-1)^FI_chix*US_pi4target^(1/4*(1-FI_chih)))^(1-FI_thetat);
// Intermediate-good price inflation, using FI_pix = US_piim
// USFI_piim = USFI_pim/USFI_pim(-1)*US_pic;
// Bilateral real exchange rate
FIUS_rer = FI_rer/US_rer;
// Auxiliary equation for steady-state output
FIUS_rerbar = FIUS_rer;
//Terms of Trade
FIUS_tot = US_pex*FIUS_rer/FI_pex;
// Total imports 
FI_im = 
+FI_imc
+FI_imi
+FI_imcg
+FI_imig
;
// Total import deflator
FI_im*FI_pim  = 
+FI_pimc*FI_imc
+FI_pimi*FI_imi
+FI_pimcg*FI_imcg
+FI_pimig*FI_imig
;
// Effective real exchange rate: double weighting (imports)
FIRA_weightim = FIRA_rer*RA_pex*FIRA_im/(FI_pim*FI_im);
// Effective real exchange rate: double weighting (exports)
FIRA_weightex = RA_size/FI_size*RAFI_im/FI_ex*FIRA_rer*RA_py*RA_y/(FIRA_rer*RA_py*RA_y
+FIAT_rer*AT_pex*RAAT_im
+FIBE_rer*BE_pex*RABE_im
+FIES_rer*ES_pex*RAES_im
+FIFR_rer*FR_pex*RAFR_im
+FIGR_rer*GR_pex*RAGR_im
+FIIT_rer*IT_pex*RAIT_im
+FINL_rer*NL_pex*RANL_im
+FIPT_rer*PT_pex*RAPT_im
+FIDE_rer*DE_pex*RADE_im
+FIRU_rer*RU_pex*RARU_im
+FIRW_rer*RW_pex*RARW_im
+FIUS_rer*US_pex*RAUS_im
)+
+AT_size/FI_size*ATFI_im/FI_ex*FIRA_rer*RA_pex*ATRA_im/(FIAT_rer*AT_py*AT_y
+FIRA_rer*RA_pex*ATRA_im
+FIBE_rer*BE_pex*ATBE_im
+FIES_rer*ES_pex*ATES_im
+FIFR_rer*FR_pex*ATFR_im
+FIGR_rer*GR_pex*ATGR_im
+FIIT_rer*IT_pex*ATIT_im
+FINL_rer*NL_pex*ATNL_im
+FIPT_rer*PT_pex*ATPT_im
+FIDE_rer*DE_pex*ATDE_im
+FIRU_rer*RU_pex*ATRU_im
+FIRW_rer*RW_pex*ATRW_im
+FIUS_rer*US_pex*ATUS_im
)
+BE_size/FI_size*BEFI_im/FI_ex*FIRA_rer*RA_pex*BERA_im/(FIBE_rer*BE_py*BE_y
+FIRA_rer*RA_pex*BERA_im
+FIAT_rer*AT_pex*BEAT_im
+FIES_rer*ES_pex*BEES_im
+FIFR_rer*FR_pex*BEFR_im
+FIGR_rer*GR_pex*BEGR_im
+FIIT_rer*IT_pex*BEIT_im
+FINL_rer*NL_pex*BENL_im
+FIPT_rer*PT_pex*BEPT_im
+FIDE_rer*DE_pex*BEDE_im
+FIRU_rer*RU_pex*BERU_im
+FIRW_rer*RW_pex*BERW_im
+FIUS_rer*US_pex*BEUS_im
)
+ES_size/FI_size*ESFI_im/FI_ex*FIRA_rer*RA_pex*ESRA_im/(FIES_rer*ES_py*ES_y
+FIRA_rer*RA_pex*ESRA_im
+FIAT_rer*AT_pex*ESAT_im
+FIBE_rer*BE_pex*ESBE_im
+FIFR_rer*FR_pex*ESFR_im
+FIGR_rer*GR_pex*ESGR_im
+FIIT_rer*IT_pex*ESIT_im
+FINL_rer*NL_pex*ESNL_im
+FIPT_rer*PT_pex*ESPT_im
+FIDE_rer*DE_pex*ESDE_im
+FIRU_rer*RU_pex*ESRU_im
+FIRW_rer*RW_pex*ESRW_im
+FIUS_rer*US_pex*ESUS_im
)
+FR_size/FI_size*FRFI_im/FI_ex*FIRA_rer*RA_pex*FRRA_im/(FIFR_rer*FR_py*FR_y
+FIRA_rer*RA_pex*FRRA_im
+FIAT_rer*AT_pex*FRAT_im
+FIBE_rer*BE_pex*FRBE_im
+FIES_rer*ES_pex*FRES_im
+FIGR_rer*GR_pex*FRGR_im
+FIIT_rer*IT_pex*FRIT_im
+FINL_rer*NL_pex*FRNL_im
+FIPT_rer*PT_pex*FRPT_im
+FIDE_rer*DE_pex*FRDE_im
+FIRU_rer*RU_pex*FRRU_im
+FIRW_rer*RW_pex*FRRW_im
+FIUS_rer*US_pex*FRUS_im
)
+GR_size/FI_size*GRFI_im/FI_ex*FIRA_rer*RA_pex*GRRA_im/(FIGR_rer*GR_py*GR_y
+FIRA_rer*RA_pex*GRRA_im
+FIAT_rer*AT_pex*GRAT_im
+FIBE_rer*BE_pex*GRBE_im
+FIES_rer*ES_pex*GRES_im
+FIFR_rer*FR_pex*GRFR_im
+FIIT_rer*IT_pex*GRIT_im
+FINL_rer*NL_pex*GRNL_im
+FIPT_rer*PT_pex*GRPT_im
+FIDE_rer*DE_pex*GRDE_im
+FIRU_rer*RU_pex*GRRU_im
+FIRW_rer*RW_pex*GRRW_im
+FIUS_rer*US_pex*GRUS_im
)
+IT_size/FI_size*ITFI_im/FI_ex*FIRA_rer*RA_pex*ITRA_im/(FIIT_rer*IT_py*IT_y
+FIRA_rer*RA_pex*ITRA_im
+FIAT_rer*AT_pex*ITAT_im
+FIBE_rer*BE_pex*ITBE_im
+FIES_rer*ES_pex*ITES_im
+FIFR_rer*FR_pex*ITFR_im
+FIGR_rer*GR_pex*ITGR_im
+FINL_rer*NL_pex*ITNL_im
+FIPT_rer*PT_pex*ITPT_im
+FIDE_rer*DE_pex*ITDE_im
+FIRU_rer*RU_pex*ITRU_im
+FIRW_rer*RW_pex*ITRW_im
+FIUS_rer*US_pex*ITUS_im
)
+NL_size/FI_size*NLFI_im/FI_ex*FIRA_rer*RA_pex*NLRA_im/(FINL_rer*NL_py*NL_y
+FIRA_rer*RA_pex*NLRA_im
+FIAT_rer*AT_pex*NLAT_im
+FIBE_rer*BE_pex*NLBE_im
+FIES_rer*ES_pex*NLES_im
+FIFR_rer*FR_pex*NLFR_im
+FIGR_rer*GR_pex*NLGR_im
+FIIT_rer*IT_pex*NLIT_im
+FIPT_rer*PT_pex*NLPT_im
+FIDE_rer*DE_pex*NLDE_im
+FIRU_rer*RU_pex*NLRU_im
+FIRW_rer*RW_pex*NLRW_im
+FIUS_rer*US_pex*NLUS_im
)
+PT_size/FI_size*PTFI_im/FI_ex*FIRA_rer*RA_pex*PTRA_im/(FIPT_rer*PT_py*PT_y
+FIRA_rer*RA_pex*PTRA_im
+FIAT_rer*AT_pex*PTAT_im
+FIBE_rer*BE_pex*PTBE_im
+FIES_rer*ES_pex*PTES_im
+FIFR_rer*FR_pex*PTFR_im
+FIGR_rer*GR_pex*PTGR_im
+FIIT_rer*IT_pex*PTIT_im
+FINL_rer*NL_pex*PTNL_im
+FIDE_rer*DE_pex*PTDE_im
+FIRU_rer*RU_pex*PTRU_im
+FIRW_rer*RW_pex*PTRW_im
+FIUS_rer*US_pex*PTUS_im
)
+DE_size/FI_size*DEFI_im/FI_ex*FIRA_rer*RA_pex*DERA_im/(FIDE_rer*DE_py*DE_y
+FIRA_rer*RA_pex*DERA_im
+FIAT_rer*AT_pex*DEAT_im
+FIBE_rer*BE_pex*DEBE_im
+FIES_rer*ES_pex*DEES_im
+FIFR_rer*FR_pex*DEFR_im
+FIGR_rer*GR_pex*DEGR_im
+FIIT_rer*IT_pex*DEIT_im
+FINL_rer*NL_pex*DENL_im
+FIPT_rer*PT_pex*DEPT_im
+FIRU_rer*RU_pex*DERU_im
+FIRW_rer*RW_pex*DERW_im
+FIUS_rer*US_pex*DEUS_im
)
+RU_size/FI_size*RUFI_im/FI_ex*FIRA_rer*RA_pex*RURA_im/(FIRU_rer*RU_py*RU_y
+FIRA_rer*RA_pex*RURA_im
+FIAT_rer*AT_pex*RUAT_im
+FIBE_rer*BE_pex*RUBE_im
+FIES_rer*ES_pex*RUES_im
+FIFR_rer*FR_pex*RUFR_im
+FIGR_rer*GR_pex*RUGR_im
+FIIT_rer*IT_pex*RUIT_im
+FINL_rer*NL_pex*RUNL_im
+FIPT_rer*PT_pex*RUPT_im
+FIDE_rer*DE_pex*RUDE_im
+FIRW_rer*RW_pex*RURW_im
+FIUS_rer*US_pex*RUUS_im
)
+RW_size/FI_size*RWFI_im/FI_ex*FIRA_rer*RA_pex*RWRA_im/(FIRW_rer*RW_py*RW_y
+FIRA_rer*RA_pex*RWRA_im
+FIAT_rer*AT_pex*RWAT_im
+FIBE_rer*BE_pex*RWBE_im
+FIES_rer*ES_pex*RWES_im
+FIFR_rer*FR_pex*RWFR_im
+FIGR_rer*GR_pex*RWGR_im
+FIIT_rer*IT_pex*RWIT_im
+FINL_rer*NL_pex*RWNL_im
+FIPT_rer*PT_pex*RWPT_im
+FIDE_rer*DE_pex*RWDE_im
+FIRU_rer*RU_pex*RWRU_im
+FIUS_rer*US_pex*RWUS_im
)
+US_size/FI_size*USFI_im/FI_ex*FIRA_rer*RA_pex*USRA_im/(FIUS_rer*US_py*US_y
+FIRA_rer*RA_pex*USRA_im
+FIAT_rer*AT_pex*USAT_im
+FIBE_rer*BE_pex*USBE_im
+FIES_rer*ES_pex*USES_im
+FIFR_rer*FR_pex*USFR_im
+FIGR_rer*GR_pex*USGR_im
+FIIT_rer*IT_pex*USIT_im
+FINL_rer*NL_pex*USNL_im
+FIPT_rer*PT_pex*USPT_im
+FIDE_rer*DE_pex*USDE_im
+FIRU_rer*RU_pex*USRU_im
+FIRW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
FIRA_weight = FI_pim*FI_im/(FI_pim*FI_im+FI_pex*FI_ex)*FIRA_weightim+FI_pex*FI_ex/(FI_pim*FI_im+FI_pex*FI_ex)*FIRA_weightex;
// Effective real exchange rate: double weighting (imports)
FIAT_weightim = FIAT_rer*AT_pex*FIAT_im/(FI_pim*FI_im);
// Effective real exchange rate: double weighting (exports)
