// Aggregate intermediate-good price dynamics, using GR_px = FI_pim
// FIGR_pim^(1-GR_thetat) = (1-GR_xix)*FIGR_pimtilde^(1-GR_thetat)+GR_xix*(FIGR_pim(-1)/FI_pic)^(1-GR_thetat)*(FIGR_piim(-1)^GR_chix*FI_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = FI_piim
// FIGR_piim = FIGR_pim/FIGR_pim(-1)*FI_pic;
// Bilateral real exchange rate
GRFI_rer = GR_rer/FI_rer;
// Auxiliary equation for steady-state output
GRFI_rerbar = GRFI_rer;
//Terms of Trade
GRFI_tot = FI_pex*GRFI_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = FR_pimtilde
// FRGR_pimtilde/FRGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRFR_fx/GRFR_gx;
// Definition of fx
// GRFR_fx = FR_size/GR_size*FRGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(FRGR_piim(+1)/(FRGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRFR_fx(+1);
// Definition of gx   
// GRFR_gx = GRFR_rer*FRGR_pim*FR_size/GR_size*FRGR_im+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(FRGR_piim(+1)/(FRGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^(GR_thetat-1)*GRFR_gx(+1);
// Aggregate intermediate-good price dynamics, using GR_px = FR_pim
// FRGR_pim^(1-GR_thetat) = (1-GR_xix)*FRGR_pimtilde^(1-GR_thetat)+GR_xix*(FRGR_pim(-1)/FR_pic)^(1-GR_thetat)*(FRGR_piim(-1)^GR_chix*FR_pi4target^(1/4*(1-GR_chih)))^(1-GR_thetat);
// Intermediate-good price inflation, using GR_pix = FR_piim
// FRGR_piim = FRGR_pim/FRGR_pim(-1)*FR_pic;
// Bilateral real exchange rate
GRFR_rer = GR_rer/FR_rer;
// Auxiliary equation for steady-state output
GRFR_rerbar = GRFR_rer;
//Terms of Trade
GRFR_tot = FR_pex*GRFR_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = IT_pimtilde
// ITGR_pimtilde/ITGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRIT_fx/GRIT_gx;
// Definition of fx
// GRIT_fx = IT_size/GR_size*ITGR_im*GR_mct+GR_xix*GR_beta*GR_lambdai(+1)/GR_lambdai*(ITGR_piim(+1)/(ITGR_piim^GR_chix*GR_pi4target^(1/4*(1-GR_chix))))^GR_thetat*GRIT_fx(+1);
// Definition of gx   
