+BEDE_rer*DE_pex*USDE_im
+BERU_rer*RU_pex*USRU_im
+BERW_rer*RW_pex*USRW_im
)
;
// Effective real exchange rate: double weighting (overall)
BERW_weight = BE_pim*BE_im/(BE_pim*BE_im+BE_pex*BE_ex)*BERW_weightim+BE_pex*BE_ex/(BE_pim*BE_im+BE_pex*BE_ex)*BERW_weightex;
// Effective real exchange rate: double weighting (imports)
BEUS_weightim = BEUS_rer*US_pex*BEUS_im/(BE_pim*BE_im);
// Effective real exchange rate: double weighting (exports)
BEUS_weightex = US_size/BE_size*USBE_im/BE_ex*BEUS_rer*US_py*US_y/(BEUS_rer*US_py*US_y
+BERA_rer*RA_pex*USRA_im
+BEAT_rer*AT_pex*USAT_im
