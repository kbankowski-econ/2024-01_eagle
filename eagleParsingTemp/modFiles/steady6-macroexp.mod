// Effective real exchange rate: double weighting (overall)
ESRW_weight = ES_pim*ES_im/(ES_pim*ES_im+ES_pex*ES_ex)*ESRW_weightim+ES_pex*ES_ex/(ES_pim*ES_im+ES_pex*ES_ex)*ESRW_weightex;
// Effective real exchange rate: double weighting (imports)
ESUS_weightim = ESUS_rer*US_pex*ESUS_im/(ES_pim*ES_im);
// Effective real exchange rate: double weighting (exports)
ESUS_weightex = US_size/ES_size*USES_im/ES_ex*ESUS_rer*US_py*US_y/(ESUS_rer*US_py*US_y
+ESRA_rer*RA_pex*USRA_im
