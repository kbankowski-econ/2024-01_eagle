//Terms of Trade
GRES_tot = ES_pex*GRES_rer/GR_pex;
// Optimal price contract set in foreign markets (FOC), using GR_pxtilde = FI_pimtilde
// FIGR_pimtilde/FIGR_pim = GR_cpim*GR_thetat/(GR_thetat-1)*GRFI_fx/GRFI_gx;
