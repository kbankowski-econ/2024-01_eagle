r*EAA_pex*EAKEAA_im+EACEAB_rer*EAB_pex*EAKEAB_im+EACEAD_rer*EAD_pex*EAKEAD_im+EACEAE_rer*EAE_pex*EAKEAE_im+EACEAF_rer*EAF_pex*EAKEAF_im+EACEAG_rer*EAG_pex*EAKEAG_im+EACEAH_rer*EAH_pex*EAKEAH_im+EACEAI_rer*EAI_pex*EAKEAI_im+EACEAJ_rer*EAJ_pex*EAKEAJ_im+EACEAL_rer*EAL_pex*EAKEAL_im+EACRW_rer*RW_pex*EAKRW_im+EACUS_rer*US_pex*EAKUS_im)+EAL_size/EAC_size*EALEAC_im/EAC_ex*EACEAA_rer*EAA_pex*EALEAA_im/(EACEAL_rer*EAL_py*EAL_y+EACEAA_rer*EAA_pex*EALEAA_im+EACEAB_rer*EAB_pex*EALEAB_im+EACEAD_rer*EAD_pex*EALEAD_im+EACEAE_rer*EAE_pex*EALEAE_im+EACEAF_rer*EAF_pex*EALEAF_im+EACEAG_rer*EAG_pex*EALEAG_im+EACEAH_rer*EAH_pex*EALEAH_im+EACEAI_rer*EAI_pex*EALEAI_im+EACEAJ_rer*EAJ_pex*EALEAJ_im+EACEAK_rer*EAK_pex*EALEAK_im+EACRW_rer*RW_pex*EALRW_im+EACUS_rer*US_pex*EALUS_im)+RW_size/EAC_size*RWEAC_im/EAC_ex*EACEAA_rer*EAA_pex*RWEAA_im/(EACRW_rer*RW_py*RW_y+EACEAA_rer*EAA_pex*RWEAA_im+EACEAB_rer*EAB_pex*RWEAB_im+EACEAD_rer*EAD_pex*RWEAD_im+EACEAE_rer*EAE_pex*RWEAE_im+EACEAF_rer*EAF_pex*RWEAF_im+EACEAG_rer*EAG_pex*RWEAG_im+EACEAH_rer*EAH_pex*RWEAH_im+EACEAI_rer*EAI_pex*RWEAI_im+EACEAJ_rer*EAJ_pex*RWEAJ_im+EACEAK_rer*EAK_pex*RWEAK_im+EACEAL_rer*EAL_pex*RWEAL_im+EACUS_rer*US_pex*RWUS_im)+US_size/EAC_size*USEAC_im/EAC_ex*EACEAA_rer*EAA_pex*USEAA_im/(EACUS_rer*US_py*US_y+EACEAA_rer*EAA_pex*USEAA_im+EACEAB_rer*EAB_pex*USEAB_im+EACEAD_rer*EAD_pex*USEAD_im+EACEAE_rer*EAE_pex*USEAE_im+EACEAF_rer*EAF_pex*USEAF_im+EACEAG_rer*EAG_pex*USEAG_im+EACEAH_rer*EAH_pex*USEAH_im+EACEAI_rer*EAI_pex*USEAI_im+EACEAJ_rer*EAJ_pex*USEAJ_im+EACEAK_rer*EAK_pex*USEAK_im+EACEAL_rer*EAL_pex*USEAL_im+EACRW_rer*RW_pex*USRW_im);
