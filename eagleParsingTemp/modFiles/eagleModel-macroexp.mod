+EAFEAA_rer*EAA_pex*EAJEAA_im
+EAFEAB_rer*EAB_pex*EAJEAB_im
+EAFEAC_rer*EAC_pex*EAJEAC_im
+EAFEAD_rer*EAD_pex*EAJEAD_im
+EAFEAE_rer*EAE_pex*EAJEAE_im
+EAFEAG_rer*EAG_pex*EAJEAG_im
+EAFEAH_rer*EAH_pex*EAJEAH_im
+EAFEAI_rer*EAI_pex*EAJEAI_im
+EAFEAK_rer*EAK_pex*EAJEAK_im
+EAFRW_rer*RW_pex*EAJRW_im
+EAFUS_rer*US_pex*EAJUS_im
)
+EAK_size/EAF_size*EAKEAF_im/EAF_ex*EAFUS_rer*US_pex*EAKUS_im/(EAFEAK_rer*EAK_py*EAK_y
+EAFEAA_rer*EAA_pex*EAKEAA_im
+EAFEAB_rer*EAB_pex*EAKEAB_im
+EAFEAC_rer*EAC_pex*EAKEAC_im
+EAFEAD_rer*EAD_pex*EAKEAD_im
+EAFEAE_rer*EAE_pex*EAKEAE_im
+EAFEAG_rer*EAG_pex*EAKEAG_im
+EAFEAH_rer*EAH_pex*EAKEAH_im
+EAFEAI_rer*EAI_pex*EAKEAI_im
+EAFEAJ_rer*EAJ_pex*EAKEAJ_im
+EAFRW_rer*RW_pex*EAKRW_im
+EAFUS_rer*US_pex*EAKUS_im
)
+RW_size/EAF_size*RWEAF_im/EAF_ex*EAFUS_rer*US_pex*RWUS_im/(EAFRW_rer*RW_py*RW_y
+EAFEAA_rer*EAA_pex*RWEAA_im
+EAFEAB_rer*EAB_pex*RWEAB_im
+EAFEAC_rer*EAC_pex*RWEAC_im
+EAFEAD_rer*EAD_pex*RWEAD_im
+EAFEAE_rer*EAE_pex*RWEAE_im
+EAFEAG_rer*EAG_pex*RWEAG_im
+EAFEAH_rer*EAH_pex*RWEAH_im
+EAFEAI_rer*EAI_pex*RWEAI_im
+EAFEAJ_rer*EAJ_pex*RWEAJ_im
+EAFEAK_rer*EAK_pex*RWEAK_im
+EAFUS_rer*US_pex*RWUS_im
)
;
// Effective real exchange rate: double weighting (overall)
EAFUS_weight = EAF_pim*EAF_im/(EAF_pim*EAF_im+EAF_pex*EAF_ex)*EAFUS_weightim+EAF_pex*EAF_ex/(EAF_pim*EAF_im+EAF_pex*EAF_ex)*EAFUS_weightex;
// Effective real exchange rate
EAF_reer = 1
*EAFEAA_rer^EAFEAA_weight
*EAFEAB_rer^EAFEAB_weight
*EAFEAC_rer^EAFEAC_weight
*EAFEAD_rer^EAFEAD_weight
*EAFEAE_rer^EAFEAE_weight
*EAFEAG_rer^EAFEAG_weight
*EAFEAH_rer^EAFEAH_weight
*EAFEAI_rer^EAFEAI_weight
*EAFEAJ_rer^EAFEAJ_weight
*EAFEAK_rer^EAFEAK_weight
*EAFRW_rer^EAFRW_weight
*EAFUS_rer^EAFUS_weight
;
// Effective terms of trade
EAF_etot = 1
*EAFEAA_tot^EAFEAA_weight
*EAFEAB_tot^EAFEAB_weight
*EAFEAC_tot^EAFEAC_weight
*EAFEAD_tot^EAFEAD_weight
*EAFEAE_tot^EAFEAE_weight
*EAFEAG_tot^EAFEAG_weight
*EAFEAH_tot^EAFEAH_weight
*EAFEAI_tot^EAFEAI_weight
*EAFEAJ_tot^EAFEAJ_weight
*EAFEAK_tot^EAFEAK_weight
*EAFRW_tot^EAFRW_weight
*EAFUS_tot^EAFUS_weight
;
//-----------------
// Final-good firms
//-----------------
// Private consumption good (import)
EAF_imc^((EAF_mumc-1)/EAF_mumc) =
+EAFEAA_numc ^(1/EAF_mumc)*((1-EAFEAA_gammaimc)*EAFEAA_imc)^(1-1/EAF_mumc)
+EAFEAB_numc ^(1/EAF_mumc)*((1-EAFEAB_gammaimc)*EAFEAB_imc)^(1-1/EAF_mumc)
+EAFEAC_numc ^(1/EAF_mumc)*((1-EAFEAC_gammaimc)*EAFEAC_imc)^(1-1/EAF_mumc)
+EAFEAE_numc ^(1/EAF_mumc)*((1-EAFEAE_gammaimc)*EAFEAE_imc)^(1-1/EAF_mumc)
+EAFEAG_numc ^(1/EAF_mumc)*((1-EAFEAG_gammaimc)*EAFEAG_imc)^(1-1/EAF_mumc)
+EAFEAH_numc ^(1/EAF_mumc)*((1-EAFEAH_gammaimc)*EAFEAH_imc)^(1-1/EAF_mumc)
+EAFEAI_numc ^(1/EAF_mumc)*((1-EAFEAI_gammaimc)*EAFEAI_imc)^(1-1/EAF_mumc)
+EAFEAJ_numc ^(1/EAF_mumc)*((1-EAFEAJ_gammaimc)*EAFEAJ_imc)^(1-1/EAF_mumc)
+EAFEAK_numc ^(1/EAF_mumc)*((1-EAFEAK_gammaimc)*EAFEAK_imc)^(1-1/EAF_mumc)
+EAFRW_numc ^(1/EAF_mumc)*((1-EAFRW_gammaimc)*EAFRW_imc)^(1-1/EAF_mumc)
+EAFUS_numc ^(1/EAF_mumc)*((1-EAFUS_gammaimc)*EAFUS_imc)^(1-1/EAF_mumc)
+(1
-EAFEAA_numc
-EAFEAB_numc
-EAFEAC_numc
-EAFEAE_numc
-EAFEAG_numc
-EAFEAH_numc
-EAFEAI_numc
-EAFEAJ_numc
-EAFEAK_numc
-EAFRW_numc
-EAFUS_numc
)^(1/EAF_mumc)*((1-EAFEAD_gammaimc)*EAFEAD_imc)^(1-1/EAF_mumc);
// Demand for bilateral consumption import goods
EAFEAA_imc = EAFEAA_numc*((EAA_pex*EAFEAA_rer)/(EAFEAA_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAA_gammaimc);
// Demand for bilateral consumption import goods
EAFEAB_imc = EAFEAB_numc*((EAB_pex*EAFEAB_rer)/(EAFEAB_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAB_gammaimc);
// Demand for bilateral consumption import goods
EAFEAC_imc = EAFEAC_numc*((EAC_pex*EAFEAC_rer)/(EAFEAC_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAC_gammaimc);
// Demand for bilateral consumption import goods
EAFEAE_imc = EAFEAE_numc*((EAE_pex*EAFEAE_rer)/(EAFEAE_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAE_gammaimc);
// Demand for bilateral consumption import goods
EAFEAH_imc = EAFEAH_numc*((EAH_pex*EAFEAH_rer)/(EAFEAH_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAH_gammaimc);
// Demand for bilateral consumption import goods
EAFEAI_imc = EAFEAI_numc*((EAI_pex*EAFEAI_rer)/(EAFEAI_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAI_gammaimc);
// Demand for bilateral consumption import goods
EAFEAJ_imc = EAFEAJ_numc*((EAJ_pex*EAFEAJ_rer)/(EAFEAJ_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAJ_gammaimc);
// Demand for bilateral consumption import goods
EAFEAK_imc = EAFEAK_numc*((EAK_pex*EAFEAK_rer)/(EAFEAK_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAK_gammaimc);
// Demand for bilateral consumption import goods
EAFRW_imc = EAFRW_numc*((RW_pex*EAFRW_rer)/(EAFRW_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFRW_gammaimc);
// Demand for bilateral consumption import goods
EAFUS_imc = EAFUS_numc*((US_pex*EAFUS_rer)/(EAFUS_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFUS_gammaimc);
EAFEAD_imc = (1
-EAFEAA_numc
-EAFEAB_numc
-EAFEAC_numc
-EAFEAE_numc
-EAFEAG_numc
-EAFEAH_numc
-EAFEAI_numc
-EAFEAJ_numc
-EAFEAK_numc
-EAFRW_numc
-EAFUS_numc
)*((EAD_pex*EAFEAD_rer)/(EAFEAD_gammaimcdag*EAF_pimc))^(-EAF_mumc)*EAF_imc/(1-EAFEAD_gammaimc);
// Price of the consumption good (import)
EAF_pimc^(1-EAF_mumc) =
+EAFEAA_numc *((EAA_pex*EAFEAA_rer)/EAFEAA_gammaimcdag)^(1-EAF_mumc)
+EAFEAB_numc *((EAB_pex*EAFEAB_rer)/EAFEAB_gammaimcdag)^(1-EAF_mumc)
+EAFEAC_numc *((EAC_pex*EAFEAC_rer)/EAFEAC_gammaimcdag)^(1-EAF_mumc)
+EAFEAE_numc *((EAE_pex*EAFEAE_rer)/EAFEAE_gammaimcdag)^(1-EAF_mumc)
+EAFEAG_numc *((EAG_pex*EAFEAG_rer)/EAFEAG_gammaimcdag)^(1-EAF_mumc)
+EAFEAH_numc *((EAH_pex*EAFEAH_rer)/EAFEAH_gammaimcdag)^(1-EAF_mumc)
