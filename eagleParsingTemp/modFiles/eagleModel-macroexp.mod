EAHEAA_rer = EAH_rer/EAA_rer;
// Auxiliary equation for steady-state output
//Terms of Trade
EAHEAA_tot = EAA_pex*EAHEAA_rer/EAH_pex;
// Optimal price contract set in foreign markets (FOC), using EAH_pxtilde = EAB_pimtilde
