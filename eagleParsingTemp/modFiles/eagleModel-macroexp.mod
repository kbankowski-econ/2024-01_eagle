EADEAF_gammaimcdag = 1-EADEAF_gammaimc-EAD_gammaimc1*((EADEAF_imc/EAD_qc)/(EADEAF_imc(-1)/EAD_qc(-1))-1)*(EADEAF_imc/EAD_qc)/(EADEAF_imc(-1)/EAD_qc(-1));
// Import adjustment cost
