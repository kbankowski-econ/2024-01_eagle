// Effective real exchange rate
EAA_reer = 1
*EAAEAB_rer^EAAEAB_weight
*EAAEAC_rer^EAAEAC_weight
*EAAEAD_rer^EAAEAD_weight
*EAAEAE_rer^EAAEAE_weight
*EAAEAF_rer^EAAEAF_weight
