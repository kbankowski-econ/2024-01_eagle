+EAEUS_rer*US_pex*EABUS_im
)
+EAC_size/EAE_size*EACEAE_im/EAE_ex*EAEEAA_rer*EAA_pex*EACEAA_im/(EAEEAC_rer*EAC_py*EAC_y
+EAEEAA_rer*EAA_pex*EACEAA_im
+EAEEAB_rer*EAB_pex*EACEAB_im
+EAEEAD_rer*EAD_pex*EACEAD_im
