+EAJ_size/EAF_size*EAJEAF_im/EAF_ex*EAFRW_rer*RW_pex*EAJRW_im/(EAFEAJ_rer*EAJ_py*EAJ_y
+EAFEAA_rer*EAA_pex*EAJEAA_im
