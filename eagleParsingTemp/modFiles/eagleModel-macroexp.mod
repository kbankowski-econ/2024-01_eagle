// Auxiliary equation for transformation of import adjustment cost
EAGEAK_gammaimidag = 1-EAGEAK_gammaimi-EAG_gammaimi1*((EAGEAK_imi/EAG_qi)/(EAGEAK_imi(-1)/EAG_qi)-1)*((EAGEAK_imi/EAG_qi)/(EAGEAK_imi(-1)/EAG_qi(-1)));
