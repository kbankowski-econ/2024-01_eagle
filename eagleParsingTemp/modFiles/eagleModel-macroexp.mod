EAI_pex^(1-EAI_thetat) = (1-EAI_xix)*EAI_pextilde^(1-EAI_thetat)+EAI_xix*(EAI_pex(-1)/EAI_pic)^(1-EAI_thetat)*(EAI_piex(-1)^EAI_chix*EAI_pi4target^(1/4*(1-EAI_chix)))^(1-EAI_thetat);
