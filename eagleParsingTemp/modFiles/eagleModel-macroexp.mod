// EABEAJ_pim^(1-EAJ_thetat) = (1-EAJ_xix)*EABEAJ_pimtilde^(1-EAJ_thetat)+EAJ_xix*(EABEAJ_pim(-1)/EAB_pic)^(1-EAJ_thetat)*(EABEAJ_piim(-1)^EAJ_chix*EAB_pi4target^(1/4*(1-EAJ_chih)))^(1-EAJ_thetat);
