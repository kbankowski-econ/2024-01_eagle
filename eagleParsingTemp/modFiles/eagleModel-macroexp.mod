+EAEEAA_rer*EAA_pex*EADEAA_im
+EAEEAB_rer*EAB_pex*EADEAB_im
+EAEEAC_rer*EAC_pex*EADEAC_im
+EAEEAF_rer*EAF_pex*EADEAF_im
+EAEEAG_rer*EAG_pex*EADEAG_im
+EAEEAH_rer*EAH_pex*EADEAH_im
