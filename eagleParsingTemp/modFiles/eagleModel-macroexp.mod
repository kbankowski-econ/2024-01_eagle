// Auxiliary equation for transformation of import adjustment cost
EAGEAD_gammaimidag = 1-EAGEAD_gammaimi-EAG_gammaimi1*((EAGEAD_imi/EAG_qi)/(EAGEAD_imi(-1)/EAG_qi)-1)*((EAGEAD_imi/EAG_qi)/(EAGEAD_imi(-1)/EAG_qi(-1)));
