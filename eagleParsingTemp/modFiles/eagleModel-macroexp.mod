// Auxiliary equation for transformation of import adjustment cost
EAGEAC_gammaimidag = 1-EAGEAC_gammaimi-EAG_gammaimi1*((EAGEAC_imi/EAG_qi)/(EAGEAC_imi(-1)/EAG_qi)-1)*((EAGEAC_imi/EAG_qi)/(EAGEAC_imi(-1)/EAG_qi(-1)));
