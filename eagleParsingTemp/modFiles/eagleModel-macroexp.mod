;
// Effective terms of trade
EAA_etot = 1
*EAAEAB_tot^EAAEAB_weight
*EAAEAC_tot^EAAEAC_weight
*EAAEAD_tot^EAAEAD_weight
*EAAEAE_tot^EAAEAE_weight
*EAAEAF_tot^EAAEAF_weight
