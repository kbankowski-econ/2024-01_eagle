        var EAAEAK_nerdep;
        var EAA_gammabh;
        var EABEAK_nerdep;
        var EAB_gammabh;
        var EACEAK_nerdep;
        var EAC_gammabh;
        var EADEAK_nerdep;
        var EAD_gammabh;
        var EAEEAK_nerdep;
        var EAE_gammabh;
        var EAFEAK_nerdep;
        var EAF_gammabh;
        var EAGEAK_nerdep;
        var EAG_gammabh;
        var EAHEAK_nerdep;
        var EAH_gammabh;
        var EAIEAK_nerdep;
        var EAI_gammabh;
        var EAJEAK_nerdep;
