EAHEAJ_imig = EAHEAJ_numig*((EAJ_pex*EAHEAJ_rer)/(EAHEAJ_gammaimigdag*EAH_pimig))^(-EAH_mumig)*EAH_imig/(1-EAHEAJ_gammaimig);
// Demand for bilateral consumption import goods
EAHEAK_imig = EAHEAK_numig*((EAK_pex*EAHEAK_rer)/(EAHEAK_gammaimigdag*EAH_pimig))^(-EAH_mumig)*EAH_imig/(1-EAHEAK_gammaimig);
// Demand for bilateral consumption import goods
EAHRW_imig = EAHRW_numig*((RW_pex*EAHRW_rer)/(EAHRW_gammaimigdag*EAH_pimig))^(-EAH_mumig)*EAH_imig/(1-EAHRW_gammaimig);
// Demand for bilateral consumption import goods
EAHUS_imig = EAHUS_numig*((US_pex*EAHUS_rer)/(EAHUS_gammaimigdag*EAH_pimig))^(-EAH_mumig)*EAH_imig/(1-EAHUS_gammaimig);
EAHEAF_imig = (1
-EAHEAA_numig
-EAHEAB_numig
-EAHEAC_numig
-EAHEAD_numig
-EAHEAE_numig
-EAHEAG_numig
-EAHEAI_numig
-EAHEAJ_numig
-EAHEAK_numig
-EAHRW_numig
-EAHUS_numig
)*((EAF_pex*EAHEAF_rer)/(EAHEAF_gammaimigdag*EAH_pimig))^(-EAH_mumig)*EAH_imig/(1-EAHEAF_gammaimig);
// Price of the consumption good (import)
EAH_pimig^(1-EAH_mumig) =
+EAHEAA_numig *((EAA_pex*EAHEAA_rer)/EAHEAA_gammaimigdag)^(1-EAH_mumig)
+EAHEAB_numig *((EAB_pex*EAHEAB_rer)/EAHEAB_gammaimigdag)^(1-EAH_mumig)
+EAHEAC_numig *((EAC_pex*EAHEAC_rer)/EAHEAC_gammaimigdag)^(1-EAH_mumig)
+EAHEAD_numig *((EAD_pex*EAHEAD_rer)/EAHEAD_gammaimigdag)^(1-EAH_mumig)
+EAHEAE_numig *((EAE_pex*EAHEAE_rer)/EAHEAE_gammaimigdag)^(1-EAH_mumig)
+EAHEAG_numig *((EAG_pex*EAHEAG_rer)/EAHEAG_gammaimigdag)^(1-EAH_mumig)
+EAHEAI_numig *((EAI_pex*EAHEAI_rer)/EAHEAI_gammaimigdag)^(1-EAH_mumig)
+EAHEAJ_numig *((EAJ_pex*EAHEAJ_rer)/EAHEAJ_gammaimigdag)^(1-EAH_mumig)
+EAHEAK_numig *((EAK_pex*EAHEAK_rer)/EAHEAK_gammaimigdag)^(1-EAH_mumig)
+EAHRW_numig *((RW_pex*EAHRW_rer)/EAHRW_gammaimigdag)^(1-EAH_mumig)
+EAHUS_numig *((US_pex*EAHUS_rer)/EAHUS_gammaimigdag)^(1-EAH_mumig)
+(1
-EAHEAA_numig
-EAHEAB_numig
-EAHEAC_numig
-EAHEAD_numig
-EAHEAE_numig
-EAHEAG_numig
-EAHEAI_numig
-EAHEAJ_numig
-EAHEAK_numig
-EAHRW_numig
-EAHUS_numig
)*((EAF_pex*EAHEAF_rer)/EAHEAF_gammaimigdag)^(1-EAH_mumig);
// Private consumption good (import) inflation
EAH_piimig = EAH_pimig/EAH_pimig(-1)*EAH_pic;
// Private consumption good (import) inflation
EAH_piimc4 = EAH_pimc/EAH_pimc(-4)*EAH_pic4;
// Private consumption good (import) inflation
EAH_piex4 = EAH_pex/EAH_pex(-4)*EAH_pic4;
// Wedge between aggregate demand and production, using EAH_x = EAI_size/EAH_size*EAI_im
EAH_yst = EAH_sh*EAH_ht+EAH_sx*EAH_ex;
// Aggregate demand for bilateral imported intermediate goods
EAHEAA_im = 
+EAHEAA_imc
+EAHEAA_imi
+EAHEAA_imcg
+EAHEAA_imig
;
EAHEAB_im = 
+EAHEAB_imc
+EAHEAB_imi
+EAHEAB_imcg
+EAHEAB_imig
;
EAHEAC_im = 
+EAHEAC_imc
+EAHEAC_imi
+EAHEAC_imcg
+EAHEAC_imig
;
EAHEAD_im = 
+EAHEAD_imc
+EAHEAD_imi
+EAHEAD_imcg
+EAHEAD_imig
;
EAHEAE_im = 
+EAHEAE_imc
+EAHEAE_imi
+EAHEAE_imcg
+EAHEAE_imig
;
EAHEAF_im = 
+EAHEAF_imc
+EAHEAF_imi
+EAHEAF_imcg
+EAHEAF_imig
