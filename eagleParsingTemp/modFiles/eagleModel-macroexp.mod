EABEAE_tot = EAE_pex*EABEAE_rer/EAB_pex;
// Optimal price contract set in foreign markets (FOC), using EAB_pxtilde = EAF_pimtilde
// EAFEAB_pimtilde/EAFEAB_pim = EAB_cpim*EAB_thetat/(EAB_thetat-1)*EABEAF_fx/EABEAF_gx;
