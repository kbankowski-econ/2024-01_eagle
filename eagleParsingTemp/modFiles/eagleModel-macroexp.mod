EADEAA_gammaimcdag = 1-EADEAA_gammaimc-EAD_gammaimc1*((EADEAA_imc/EAD_qc)/(EADEAA_imc(-1)/EAD_qc(-1))-1)*(EADEAA_imc/EAD_qc)/(EADEAA_imc(-1)/EAD_qc(-1));
