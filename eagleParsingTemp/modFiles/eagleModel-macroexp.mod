+EAFUS_rer*US_pex*EADUS_im
)
+EAE_size/EAF_size*EAEEAF_im/EAF_ex*EAFUS_rer*US_pex*EAEUS_im/(EAFEAE_rer*EAE_py*EAE_y
+EAFEAA_rer*EAA_pex*EAEEAA_im
+EAFEAB_rer*EAB_pex*EAEEAB_im
+EAFEAC_rer*EAC_pex*EAEEAC_im
