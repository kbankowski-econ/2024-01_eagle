+EAKRW_rer*RW_pex*EAARW_im
+EAKUS_rer*US_pex*EAAUS_im
)+
+EAB_size/EAK_size*EABEAK_im/EAK_ex*EAKEAA_rer*EAA_pex*EABEAA_im/(EAKEAB_rer*EAB_py*EAB_y
+EAKEAA_rer*EAA_pex*EABEAA_im
