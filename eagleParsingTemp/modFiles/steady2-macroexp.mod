+EADUS_rer*US_pex*EAFUS_im
)
+EAG_size/EAD_size*EAGEAD_im/EAD_ex*EADEAA_rer*EAA_pex*EAGEAA_im/(EADEAG_rer*EAG_py*EAG_y
+EADEAA_rer*EAA_pex*EAGEAA_im
