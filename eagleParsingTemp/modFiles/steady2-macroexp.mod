+EALEAK_rer*EAK_pex*EACEAK_im
+EALRW_rer*RW_pex*EACRW_im
+EALUS_rer*US_pex*EACUS_im
)
+EAD_size/EAL_size*EADEAL_im/EAL_ex*EALEAA_rer*EAA_pex*EADEAA_im/(EALEAD_rer*EAD_py*EAD_y
+EALEAA_rer*EAA_pex*EADEAA_im
