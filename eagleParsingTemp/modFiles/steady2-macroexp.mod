+RWEAB_rer*EAB_pex*EALEAB_im
+RWEAC_rer*EAC_pex*EALEAC_im
+RWEAD_rer*EAD_pex*EALEAD_im
+RWEAE_rer*EAE_pex*EALEAE_im
+RWEAF_rer*EAF_pex*EALEAF_im
