+EAHRW_rer*RW_pex*EAARW_im
+EAHUS_rer*US_pex*EAAUS_im
)+
+EAB_size/EAH_size*EABEAH_im/EAH_ex*EAHEAA_rer*EAA_pex*EABEAA_im/(EAHEAB_rer*EAB_py*EAB_y
+EAHEAA_rer*EAA_pex*EABEAA_im
+EAHEAC_rer*EAC_pex*EABEAC_im
