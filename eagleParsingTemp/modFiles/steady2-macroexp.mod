+EAFUS_rer*US_pex*EAEUS_im
)
+EAG_size/EAF_size*EAGEAF_im/EAF_ex*EAFUS_rer*US_pex*EAGUS_im/(EAFEAG_rer*EAG_py*EAG_y
+EAFEAA_rer*EAA_pex*EAGEAA_im
+EAFEAB_rer*EAB_pex*EAGEAB_im
+EAFEAC_rer*EAC_pex*EAGEAC_im
