// EAKRW_fx = RW_size/EAK_size*RWEAK_im*EAK_mct+EAK_xix*EAK_beta*EAK_lambdai(+1)/EAK_lambdai*(RWEAK_piim(+1)/(RWEAK_piim^EAK_chix*EAK_pi4target^(1/4*(1-EAK_chix))))^EAK_thetat*EAKRW_fx(+1);
