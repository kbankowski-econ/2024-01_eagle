// Optimal price contract set in foreign markets (FOC), using EAE_pxtilde = EAG_pimtilde
// EAGEAE_pimtilde/EAGEAE_pim = EAE_cpim*EAE_thetat/(EAE_thetat-1)*EAEEAG_fx/EAEEAG_gx;
