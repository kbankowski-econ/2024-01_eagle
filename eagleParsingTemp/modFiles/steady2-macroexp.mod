)
+EAK_size/EAD_size*EAKEAD_im/EAD_ex*EADRW_rer*RW_pex*EAKRW_im/(EADEAK_rer*EAK_py*EAK_y
+EADEAA_rer*EAA_pex*EAKEAA_im
