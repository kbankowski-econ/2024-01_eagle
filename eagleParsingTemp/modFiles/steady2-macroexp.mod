EALEAA_imc = EALEAA_numc*((EAA_pex*EALEAA_rer)/EAL_pimc)^(-EAL_mumc)*EAL_imc;
// Demand for bilateral consumption import goods
EALEAB_imc = EALEAB_numc*((EAB_pex*EALEAB_rer)/EAL_pimc)^(-EAL_mumc)*EAL_imc;
// Demand for bilateral consumption import goods
