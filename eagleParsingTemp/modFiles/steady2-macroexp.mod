)
+EAH_size/EAD_size*EAHEAD_im/EAD_ex*EADEAA_rer*EAA_pex*EAHEAA_im/(EADEAH_rer*EAH_py*EAH_y
+EADEAA_rer*EAA_pex*EAHEAA_im
+EADEAB_rer*EAB_pex*EAHEAB_im
