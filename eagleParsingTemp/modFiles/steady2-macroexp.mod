EALUS_weightim = EALUS_rer*US_pex*EALUS_im/(EAL_pim*EAL_im);
// Effective real exchange rate: double weighting (exports)
EALUS_weightex = US_size/EAL_size*USEAL_im/EAL_ex*EALUS_rer*US_py*US_y/(EALUS_rer*US_py*US_y
+EALEAA_rer*EAA_pex*USEAA_im
+EALEAB_rer*EAB_pex*USEAB_im
+EALEAC_rer*EAC_pex*USEAC_im
+EALEAD_rer*EAD_pex*USEAD_im
+EALEAE_rer*EAE_pex*USEAE_im
+EALEAF_rer*EAF_pex*USEAF_im
+EALEAG_rer*EAG_pex*USEAG_im
+EALEAH_rer*EAH_pex*USEAH_im
+EALEAI_rer*EAI_pex*USEAI_im
+EALEAJ_rer*EAJ_pex*USEAJ_im
+EALEAK_rer*EAK_pex*USEAK_im
+EALRW_rer*RW_pex*USRW_im
)+
+EAA_size/EAL_size*EAAEAL_im/EAL_ex*EALUS_rer*US_pex*EAAUS_im/(EALEAA_rer*EAA_py*EAA_y
+EALEAB_rer*EAB_pex*EAAEAB_im
+EALEAC_rer*EAC_pex*EAAEAC_im
+EALEAD_rer*EAD_pex*EAAEAD_im
+EALEAE_rer*EAE_pex*EAAEAE_im
