)
+EAE_size/EAK_size*EAEEAK_im/EAK_ex*EAKEAA_rer*EAA_pex*EAEEAA_im/(EAKEAE_rer*EAE_py*EAE_y
+EAKEAA_rer*EAA_pex*EAEEAA_im
+EAKEAB_rer*EAB_pex*EAEEAB_im
+EAKEAC_rer*EAC_pex*EAEEAC_im
+EAKEAD_rer*EAD_pex*EAEEAD_im
