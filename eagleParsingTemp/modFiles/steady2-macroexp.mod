+EAFUS_rer*US_pex*EAAUS_im
)
+EAB_size/EAF_size*EABEAF_im/EAF_ex*EAFUS_rer*US_pex*EABUS_im/(EAFEAB_rer*EAB_py*EAB_y
+EAFEAA_rer*EAA_pex*EABEAA_im
