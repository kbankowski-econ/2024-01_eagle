+EALEAJ_rer*EAJ_pex*EAAEAJ_im
+EALEAK_rer*EAK_pex*EAAEAK_im
+EALRW_rer*RW_pex*EAARW_im
+EALUS_rer*US_pex*EAAUS_im
)+
+EAB_size/EAL_size*EABEAL_im/EAL_ex*EALEAA_rer*EAA_pex*EABEAA_im/(EALEAB_rer*EAB_py*EAB_y
+EALEAA_rer*EAA_pex*EABEAA_im
+EALEAC_rer*EAC_pex*EABEAC_im
