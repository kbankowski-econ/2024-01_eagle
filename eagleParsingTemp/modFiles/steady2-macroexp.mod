)
+EAL_size/EAD_size*EALEAD_im/EAD_ex*EADEAA_rer*EAA_pex*EALEAA_im/(EADEAL_rer*EAL_py*EAL_y
+EADEAA_rer*EAA_pex*EALEAA_im
+EADEAB_rer*EAB_pex*EALEAB_im
+EADEAC_rer*EAC_pex*EALEAC_im
