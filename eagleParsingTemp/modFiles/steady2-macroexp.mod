+EABEAE_rer*EAE_pex*RWEAE_im
+EABEAF_rer*EAF_pex*RWEAF_im
+EABEAG_rer*EAG_pex*RWEAG_im
+EABEAH_rer*EAH_pex*RWEAH_im
+EABEAI_rer*EAI_pex*RWEAI_im
+EABEAJ_rer*EAJ_pex*RWEAJ_im
+EABEAK_rer*EAK_pex*RWEAK_im
+EABEAL_rer*EAL_pex*RWEAL_im
+EABUS_rer*US_pex*RWUS_im
)
;
// Effective real exchange rate: double weighting (overall)
EABUS_weight = EAB_pim*EAB_im/(EAB_pim*EAB_im+EAB_pex*EAB_ex)*EABUS_weightim+EAB_pex*EAB_ex/(EAB_pim*EAB_im+EAB_pex*EAB_ex)*EABUS_weightex;
// Effective real exchange rate
EAB_reer = 1
*EABEAA_rer^EABEAA_weight
*EABEAC_rer^EABEAC_weight
*EABEAD_rer^EABEAD_weight
*EABEAE_rer^EABEAE_weight
*EABEAF_rer^EABEAF_weight
*EABEAG_rer^EABEAG_weight
*EABEAH_rer^EABEAH_weight
*EABEAI_rer^EABEAI_weight
*EABEAJ_rer^EABEAJ_weight
*EABEAK_rer^EABEAK_weight
*EABEAL_rer^EABEAL_weight
*EABRW_rer^EABRW_weight
*EABUS_rer^EABUS_weight
;
// Effective terms of trade
EAB_etot = 1
*EABEAA_tot^EABEAA_weight
*EABEAC_tot^EABEAC_weight
*EABEAD_tot^EABEAD_weight
*EABEAE_tot^EABEAE_weight
*EABEAF_tot^EABEAF_weight
*EABEAG_tot^EABEAG_weight
*EABEAH_tot^EABEAH_weight
*EABEAI_tot^EABEAI_weight
*EABEAJ_tot^EABEAJ_weight
*EABEAK_tot^EABEAK_weight
*EABEAL_tot^EABEAL_weight
*EABRW_tot^EABRW_weight
*EABUS_tot^EABUS_weight
;
//-----------------
// Final-good firms
//-----------------
// Private consumption good (import)
EAB_imc^((EAB_mumc-1)/EAB_mumc) =
+EABEAA_numc ^(1/EAB_mumc)*EABEAA_imc^(1-1/EAB_mumc)
+EABEAC_numc ^(1/EAB_mumc)*EABEAC_imc^(1-1/EAB_mumc)
+EABEAD_numc ^(1/EAB_mumc)*EABEAD_imc^(1-1/EAB_mumc)
+EABEAE_numc ^(1/EAB_mumc)*EABEAE_imc^(1-1/EAB_mumc)
+EABEAF_numc ^(1/EAB_mumc)*EABEAF_imc^(1-1/EAB_mumc)
+EABEAG_numc ^(1/EAB_mumc)*EABEAG_imc^(1-1/EAB_mumc)
+EABEAH_numc ^(1/EAB_mumc)*EABEAH_imc^(1-1/EAB_mumc)
+EABEAI_numc ^(1/EAB_mumc)*EABEAI_imc^(1-1/EAB_mumc)
+EABEAJ_numc ^(1/EAB_mumc)*EABEAJ_imc^(1-1/EAB_mumc)
+EABEAK_numc ^(1/EAB_mumc)*EABEAK_imc^(1-1/EAB_mumc)
+EABEAL_numc ^(1/EAB_mumc)*EABEAL_imc^(1-1/EAB_mumc)
+EABRW_numc ^(1/EAB_mumc)*EABRW_imc^(1-1/EAB_mumc)
+(1
-EABEAA_numc
-EABEAC_numc
-EABEAD_numc
-EABEAE_numc
-EABEAF_numc
-EABEAG_numc
-EABEAH_numc
-EABEAI_numc
-EABEAJ_numc
-EABEAK_numc
-EABEAL_numc
-EABRW_numc
)^(1/EAB_mumc)*EABUS_imc^(1-1/EAB_mumc);
// Demand for bilateral consumption import goods
EABEAA_imc = EABEAA_numc*((EAA_pex*EABEAA_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAD_imc = EABEAD_numc*((EAD_pex*EABEAD_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAE_imc = EABEAE_numc*((EAE_pex*EABEAE_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAF_imc = EABEAF_numc*((EAF_pex*EABEAF_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAG_imc = EABEAG_numc*((EAG_pex*EABEAG_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAH_imc = EABEAH_numc*((EAH_pex*EABEAH_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAI_imc = EABEAI_numc*((EAI_pex*EABEAI_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAJ_imc = EABEAJ_numc*((EAJ_pex*EABEAJ_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAK_imc = EABEAK_numc*((EAK_pex*EABEAK_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABEAL_imc = EABEAL_numc*((EAL_pex*EABEAL_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Demand for bilateral consumption import goods
EABRW_imc = EABRW_numc*((RW_pex*EABRW_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
EABUS_imc = (1
-EABEAA_numc
-EABEAC_numc
-EABEAD_numc
-EABEAE_numc
-EABEAF_numc
-EABEAG_numc
-EABEAH_numc
-EABEAI_numc
-EABEAJ_numc
-EABEAK_numc
-EABEAL_numc
-EABRW_numc
)*((US_pex*EABUS_rer)/EAB_pimc)^(-EAB_mumc)*EAB_imc;
// Price of the consumption good (import)
EAB_pimc^(1-EAB_mumc) =
+EABEAA_numc * (EAA_pex*EABEAA_rer)^(1-EAB_mumc)
+EABEAC_numc * (EAC_pex*EABEAC_rer)^(1-EAB_mumc)
+EABEAD_numc * (EAD_pex*EABEAD_rer)^(1-EAB_mumc)
+EABEAE_numc * (EAE_pex*EABEAE_rer)^(1-EAB_mumc)
+EABEAF_numc * (EAF_pex*EABEAF_rer)^(1-EAB_mumc)
+EABEAG_numc * (EAG_pex*EABEAG_rer)^(1-EAB_mumc)
+EABEAH_numc * (EAH_pex*EABEAH_rer)^(1-EAB_mumc)
+EABEAI_numc * (EAI_pex*EABEAI_rer)^(1-EAB_mumc)
+EABEAJ_numc * (EAJ_pex*EABEAJ_rer)^(1-EAB_mumc)
+EABEAK_numc * (EAK_pex*EABEAK_rer)^(1-EAB_mumc)
+EABEAL_numc * (EAL_pex*EABEAL_rer)^(1-EAB_mumc)
+EABRW_numc * (RW_pex*EABRW_rer)^(1-EAB_mumc)
+(1
-EABEAA_numc
-EABEAC_numc
-EABEAD_numc
-EABEAE_numc
-EABEAF_numc
-EABEAG_numc
-EABEAH_numc
-EABEAI_numc
-EABEAJ_numc
-EABEAK_numc
-EABEAL_numc
-EABRW_numc
)*(US_pex*EABUS_rer)^(1-EAB_mumc);
// Private consumption good (import) inflation
EAB_piimc = EAB_pimc/EAB_pimc(-1)*EAB_pic;
// Private consumption good (import)
EAB_imi^((EAB_mumi-1)/EAB_mumi) =
+EABEAA_numi ^(1/EAB_mumi)*EABEAA_imi^(1-1/EAB_mumi)
+EABEAC_numi ^(1/EAB_mumi)*EABEAC_imi^(1-1/EAB_mumi)
+EABEAD_numi ^(1/EAB_mumi)*EABEAD_imi^(1-1/EAB_mumi)
+EABEAE_numi ^(1/EAB_mumi)*EABEAE_imi^(1-1/EAB_mumi)
+EABEAF_numi ^(1/EAB_mumi)*EABEAF_imi^(1-1/EAB_mumi)
+EABEAG_numi ^(1/EAB_mumi)*EABEAG_imi^(1-1/EAB_mumi)
+EABEAH_numi ^(1/EAB_mumi)*EABEAH_imi^(1-1/EAB_mumi)
+EABEAI_numi ^(1/EAB_mumi)*EABEAI_imi^(1-1/EAB_mumi)
+EABEAJ_numi ^(1/EAB_mumi)*EABEAJ_imi^(1-1/EAB_mumi)
+EABEAK_numi ^(1/EAB_mumi)*EABEAK_imi^(1-1/EAB_mumi)
+EABEAL_numi ^(1/EAB_mumi)*EABEAL_imi^(1-1/EAB_mumi)
+EABRW_numi ^(1/EAB_mumi)*EABRW_imi^(1-1/EAB_mumi)
+(1
-EABEAA_numi
-EABEAC_numi
-EABEAD_numi
