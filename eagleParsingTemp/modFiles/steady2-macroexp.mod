)
+EAK_size/EAB_size*EAKEAB_im/EAB_ex*EABRW_rer*RW_pex*EAKRW_im/(EABEAK_rer*EAK_py*EAK_y
+EABEAA_rer*EAA_pex*EAKEAA_im
