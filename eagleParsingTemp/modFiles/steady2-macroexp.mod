*EALEAJ_rer^EALEAJ_weight
*EALEAK_rer^EALEAK_weight
*EALRW_rer^EALRW_weight
*EALUS_rer^EALUS_weight
;
// Effective terms of trade
EAL_etot = 1
*EALEAA_tot^EALEAA_weight
*EALEAB_tot^EALEAB_weight
*EALEAC_tot^EALEAC_weight
*EALEAD_tot^EALEAD_weight
*EALEAE_tot^EALEAE_weight
*EALEAF_tot^EALEAF_weight
*EALEAG_tot^EALEAG_weight
*EALEAH_tot^EALEAH_weight
*EALEAI_tot^EALEAI_weight
*EALEAJ_tot^EALEAJ_weight
*EALEAK_tot^EALEAK_weight
*EALRW_tot^EALRW_weight
*EALUS_tot^EALUS_weight
;
