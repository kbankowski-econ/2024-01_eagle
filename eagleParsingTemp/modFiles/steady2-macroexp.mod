// Exports of investment goods to gdp
USRW_exiy  = RW_size/US_size*US_pex*RWUS_imi/(US_py*US_y);
// Internal real exchange rate
US_internalrer = US_pnt/US_pttc;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAA_gammab = 0;
// International transaction cost ('risk premium')
EAA_bf = (EAA_bfytarget*EAA_py*EAA_y)/EAA_rer*US_pic;
// Risk premium shock
EAA_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAA_rerdep = EAA_rer/EAA_rer(-1);
// Definition of the terms of trade
EAA_tot = US_pex*EAA_rer/EAA_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAB_gammab = 0;
// International transaction cost ('risk premium')
EAB_bf = (EAB_bfytarget*EAB_py*EAB_y)/EAB_rer*US_pic;
// Risk premium shock
EAB_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAB_rerdep = EAB_rer/EAB_rer(-1);
// Definition of the terms of trade
EAB_tot = US_pex*EAB_rer/EAB_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAC_gammab = 0;
// International transaction cost ('risk premium')
EAC_bf = (EAC_bfytarget*EAC_py*EAC_y)/EAC_rer*US_pic;
// Risk premium shock
EAC_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAC_rerdep = EAC_rer/EAC_rer(-1);
// Definition of the terms of trade
EAC_tot = US_pex*EAC_rer/EAC_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAD_gammab = 0;
// International transaction cost ('risk premium')
EAD_bf = (EAD_bfytarget*EAD_py*EAD_y)/EAD_rer*US_pic;
// Risk premium shock
EAD_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAD_rerdep = EAD_rer/EAD_rer(-1);
// Definition of the terms of trade
EAD_tot = US_pex*EAD_rer/EAD_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAE_gammab = 0;
// International transaction cost ('risk premium')
EAE_bf = (EAE_bfytarget*EAE_py*EAE_y)/EAE_rer*US_pic;
// Risk premium shock
EAE_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAE_rerdep = EAE_rer/EAE_rer(-1);
// Definition of the terms of trade
EAE_tot = US_pex*EAE_rer/EAE_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAF_gammab = 0;
// International transaction cost ('risk premium')
EAF_bf = (EAF_bfytarget*EAF_py*EAF_y)/EAF_rer*US_pic;
// Risk premium shock
EAF_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAF_rerdep = EAF_rer/EAF_rer(-1);
// Definition of the terms of trade
EAF_tot = US_pex*EAF_rer/EAF_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAG_gammab = 0;
// International transaction cost ('risk premium')
EAG_bf = (EAG_bfytarget*EAG_py*EAG_y)/EAG_rer*US_pic;
// Risk premium shock
EAG_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAG_rerdep = EAG_rer/EAG_rer(-1);
// Definition of the terms of trade
EAG_tot = US_pex*EAG_rer/EAG_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAH_gammab = 0;
// International transaction cost ('risk premium')
EAH_bf = (EAH_bfytarget*EAH_py*EAH_y)/EAH_rer*US_pic;
// Risk premium shock
EAH_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAH_rerdep = EAH_rer/EAH_rer(-1);
// Definition of the terms of trade
EAH_tot = US_pex*EAH_rer/EAH_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAI_gammab = 0;
// International transaction cost ('risk premium')
EAI_bf = (EAI_bfytarget*EAI_py*EAI_y)/EAI_rer*US_pic;
// Risk premium shock
EAI_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAI_rerdep = EAI_rer/EAI_rer(-1);
// Definition of the terms of trade
EAI_tot = US_pex*EAI_rer/EAI_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAJ_gammab = 0;
// International transaction cost ('risk premium')
EAJ_bf = (EAJ_bfytarget*EAJ_py*EAJ_y)/EAJ_rer*US_pic;
// Risk premium shock
EAJ_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAJ_rerdep = EAJ_rer/EAJ_rer(-1);
// Definition of the terms of trade
EAJ_tot = US_pex*EAJ_rer/EAJ_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAK_gammab = 0;
// International transaction cost ('risk premium')
EAK_bf = (EAK_bfytarget*EAK_py*EAK_y)/EAK_rer*US_pic;
// Risk premium shock
EAK_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAK_rerdep = EAK_rer/EAK_rer(-1);
// Definition of the terms of trade
EAK_tot = US_pex*EAK_rer/EAK_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
EAL_gammab = 0;
// International transaction cost ('risk premium')
EAL_bf = (EAL_bfytarget*EAL_py*EAL_y)/EAL_rer*US_pic;
// Risk premium shock
EAL_rp = 0;
// Definition of the rate of real exchange-rate depreciation
EAL_rerdep = EAL_rer/EAL_rer(-1);
// Definition of the terms of trade
EAL_tot = US_pex*EAL_rer/EAL_pex;
//-------------
// Bilateral equations versus country N
//-------------
// Euler equation for internationally traded bonds
RW_gammab = 0;
// International transaction cost ('risk premium')
RW_bf = (RW_bfytarget*RW_py*RW_y)/RW_rer*US_pic;
// Risk premium shock
RW_rp = 0;
// Definition of the rate of real exchange-rate depreciation
RW_rerdep = RW_rer/RW_rer(-1);
// Definition of the terms of trade
RW_tot = US_pex*RW_rer/RW_pex;
//-------------
// Closure conditions
//-------------
US_size*US_bf =
-EAA_size*EAA_bf
-EAB_size*EAB_bf
-EAC_size*EAC_bf
-EAD_size*EAD_bf
-EAE_size*EAE_bf
-EAF_size*EAF_bf
-EAG_size*EAG_bf
-EAH_size*EAH_bf
-EAI_size*EAI_bf
-EAJ_size*EAJ_bf
-EAK_size*EAK_bf
-EAL_size*EAL_bf
-RW_size*RW_bf
;
// Net foreign asset position
	
		
			EAA_bf/US_r(-1) = -EAA_bh/EAL_r(-1)*EAAEAL_rer(-1)/EAA_rer(-1) + EAA_bh(-1)*EAAEAL_rer(-2) / EAA_rer(-2) + EAA_bf(-1) + EAA_tb(-1)/EAA_rer(-1);
		
	
	
		
			EAB_bf/US_r(-1) = -EAB_bh/EAL_r(-1)*EABEAL_rer(-1)/EAB_rer(-1) + EAB_bh(-1)*EABEAL_rer(-2) / EAB_rer(-2) + EAB_bf(-1) + EAB_tb(-1)/EAB_rer(-1);
		
	
	
		
			EAC_bf/US_r(-1) = -EAC_bh/EAL_r(-1)*EACEAL_rer(-1)/EAC_rer(-1) + EAC_bh(-1)*EACEAL_rer(-2) / EAC_rer(-2) + EAC_bf(-1) + EAC_tb(-1)/EAC_rer(-1);
		
	
	
		
			EAD_bf/US_r(-1) = -EAD_bh/EAL_r(-1)*EADEAL_rer(-1)/EAD_rer(-1) + EAD_bh(-1)*EADEAL_rer(-2) / EAD_rer(-2) + EAD_bf(-1) + EAD_tb(-1)/EAD_rer(-1);
		
	
	
		
			EAE_bf/US_r(-1) = -EAE_bh/EAL_r(-1)*EAEEAL_rer(-1)/EAE_rer(-1) + EAE_bh(-1)*EAEEAL_rer(-2) / EAE_rer(-2) + EAE_bf(-1) + EAE_tb(-1)/EAE_rer(-1);
		
	
	
		
			EAF_bf/US_r(-1) = -EAF_bh/EAL_r(-1)*EAFEAL_rer(-1)/EAF_rer(-1) + EAF_bh(-1)*EAFEAL_rer(-2) / EAF_rer(-2) + EAF_bf(-1) + EAF_tb(-1)/EAF_rer(-1);
		
	
	
		
			EAG_bf/US_r(-1) = -EAG_bh/EAL_r(-1)*EAGEAL_rer(-1)/EAG_rer(-1) + EAG_bh(-1)*EAGEAL_rer(-2) / EAG_rer(-2) + EAG_bf(-1) + EAG_tb(-1)/EAG_rer(-1);
		
	
	
		
			EAH_bf/US_r(-1) = -EAH_bh/EAL_r(-1)*EAHEAL_rer(-1)/EAH_rer(-1) + EAH_bh(-1)*EAHEAL_rer(-2) / EAH_rer(-2) + EAH_bf(-1) + EAH_tb(-1)/EAH_rer(-1);
		
	
	
		
			EAI_bf/US_r(-1) = -EAI_bh/EAL_r(-1)*EAIEAL_rer(-1)/EAI_rer(-1) + EAI_bh(-1)*EAIEAL_rer(-2) / EAI_rer(-2) + EAI_bf(-1) + EAI_tb(-1)/EAI_rer(-1);
		
	
	
		
			EAJ_bf/US_r(-1) = -EAJ_bh/EAL_r(-1)*EAJEAL_rer(-1)/EAJ_rer(-1) + EAJ_bh(-1)*EAJEAL_rer(-2) / EAJ_rer(-2) + EAJ_bf(-1) + EAJ_tb(-1)/EAJ_rer(-1);
		
	
	
		
			EAK_bf/US_r(-1) = -EAK_bh/EAL_r(-1)*EAKEAL_rer(-1)/EAK_rer(-1) + EAK_bh(-1)*EAKEAL_rer(-2) / EAK_rer(-2) + EAK_bf(-1) + EAK_tb(-1)/EAK_rer(-1);
		
	
	
			EAL_bf/US_r(-1) = -EAL_bh/EAA_r(-1) / EAL_rer(-1) + EAL_bh(-1) / EAL_rer(-2) + EAL_bf(-1) + EAL_tb(-1)/EAL_rer(-1);
		
	
		RW_bf/US_r(-1) = RW_bf(-1)+RW_tb(-1)/RW_rer(-1);
	
US_rer = 1;
		EAAEAL_nerdep = EAA_rerdep/EAL_rerdep*EAA_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAA_gammabh = 0;
			EAA_bh = (EAA_bhytarget*EAA_py*EAA_y)/EAAEAL_rer*EAL_pic;
		EABEAL_nerdep = EAB_rerdep/EAL_rerdep*EAB_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAB_gammabh = 0;
			EAB_bh = (EAB_bhytarget*EAB_py*EAB_y)/EABEAL_rer*EAL_pic;
		EACEAL_nerdep = EAC_rerdep/EAL_rerdep*EAC_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAC_gammabh = 0;
			EAC_bh = (EAC_bhytarget*EAC_py*EAC_y)/EACEAL_rer*EAL_pic;
		EADEAL_nerdep = EAD_rerdep/EAL_rerdep*EAD_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAD_gammabh = 0;
			EAD_bh = (EAD_bhytarget*EAD_py*EAD_y)/EADEAL_rer*EAL_pic;
		EAEEAL_nerdep = EAE_rerdep/EAL_rerdep*EAE_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAE_gammabh = 0;
			EAE_bh = (EAE_bhytarget*EAE_py*EAE_y)/EAEEAL_rer*EAL_pic;
		EAFEAL_nerdep = EAF_rerdep/EAL_rerdep*EAF_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAF_gammabh = 0;
			EAF_bh = (EAF_bhytarget*EAF_py*EAF_y)/EAFEAL_rer*EAL_pic;
		EAGEAL_nerdep = EAG_rerdep/EAL_rerdep*EAG_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAG_gammabh = 0;
			EAG_bh = (EAG_bhytarget*EAG_py*EAG_y)/EAGEAL_rer*EAL_pic;
		EAHEAL_nerdep = EAH_rerdep/EAL_rerdep*EAH_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAH_gammabh = 0;
			EAH_bh = (EAH_bhytarget*EAH_py*EAH_y)/EAHEAL_rer*EAL_pic;
		EAIEAL_nerdep = EAI_rerdep/EAL_rerdep*EAI_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAI_gammabh = 0;
			EAI_bh = (EAI_bhytarget*EAI_py*EAI_y)/EAIEAL_rer*EAL_pic;
		EAJEAL_nerdep = EAJ_rerdep/EAL_rerdep*EAJ_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAJ_gammabh = 0;
			EAJ_bh = (EAJ_bhytarget*EAJ_py*EAJ_y)/EAJEAL_rer*EAL_pic;
		EAKEAL_nerdep = EAK_rerdep/EAL_rerdep*EAK_pic/EAL_pic;
		// Euler equation for euroarea traded bonds and International transaction cost ('risk premium')
			EAK_gammabh = 0;
			EAK_bh = (EAK_bhytarget*EAK_py*EAK_y)/EAKEAL_rer*EAL_pic;
0 =
	+ EAA_size*EAA_bh
	+ EAB_size*EAB_bh
	+ EAC_size*EAC_bh
	+ EAD_size*EAD_bh
	+ EAE_size*EAE_bh
	+ EAF_size*EAF_bh
	+ EAG_size*EAG_bh
	+ EAH_size*EAH_bh
	+ EAI_size*EAI_bh
	+ EAJ_size*EAJ_bh
	+ EAK_size*EAK_bh
	+ EAL_size*EAL_bh
;
//-------------
// Euroarea-wide variables
//-------------
// GDP
EA_y = 
	(
	EAA_size*EAA_pybar*EAA_y
			+ EAB_size*EAAEAB_rerbar*EAB_pybar *EAB_y	
			+ EAC_size*EAAEAC_rerbar*EAC_pybar *EAC_y	
			+ EAD_size*EAAEAD_rerbar*EAD_pybar *EAD_y	
			+ EAE_size*EAAEAE_rerbar*EAE_pybar *EAE_y	
			+ EAF_size*EAAEAF_rerbar*EAF_pybar *EAF_y	
			+ EAG_size*EAAEAG_rerbar*EAG_pybar *EAG_y	
			+ EAH_size*EAAEAH_rerbar*EAH_pybar *EAH_y	
			+ EAI_size*EAAEAI_rerbar*EAI_pybar *EAI_y	
			+ EAJ_size*EAAEAJ_rerbar*EAJ_pybar *EAJ_y	
			+ EAK_size*EAAEAK_rerbar*EAK_pybar *EAK_y	
			+ EAL_size*EAAEAL_rerbar*EAL_pybar *EAL_y	
	)
	/
	(
	+ EAA_size
	+ EAB_size
	+ EAC_size
	+ EAD_size
	+ EAE_size
	+ EAF_size
	+ EAG_size
	+ EAH_size
	+ EAI_size
	+ EAJ_size
	+ EAK_size
	+ EAL_size
);
// GDP growth
EA_ygrowth= EA_y/EA_y(-1);
// GDP growth (yoy)
EA_ygrowth4= EA_y/EA_y(-4);
// Money
EA_m = 
	(
	EAA_size*EAA_m
			+ EAB_size*EAAEAB_rerbar*EAB_m	
			+ EAC_size*EAAEAC_rerbar*EAC_m	
			+ EAD_size*EAAEAD_rerbar*EAD_m	
			+ EAE_size*EAAEAE_rerbar*EAE_m	
			+ EAF_size*EAAEAF_rerbar*EAF_m	
			+ EAG_size*EAAEAG_rerbar*EAG_m	
			+ EAH_size*EAAEAH_rerbar*EAH_m	
			+ EAI_size*EAAEAI_rerbar*EAI_m	
			+ EAJ_size*EAAEAJ_rerbar*EAJ_m	
			+ EAK_size*EAAEAK_rerbar*EAK_m	
			+ EAL_size*EAAEAL_rerbar*EAL_m	
	)
	/
	(
	+ EAA_size
	+ EAB_size
	+ EAC_size
	+ EAD_size
	+ EAE_size
	+ EAF_size
	+ EAG_size
	+ EAH_size
	+ EAI_size
	+ EAJ_size
	+ EAK_size
	+ EAL_size
);
	
EA_bf = 
	(
		+ EAA_size*EAA_bf	
		+ EAB_size*EAB_bf	
		+ EAC_size*EAC_bf	
		+ EAD_size*EAD_bf	
		+ EAE_size*EAE_bf	
		+ EAF_size*EAF_bf	
		+ EAG_size*EAG_bf	
		+ EAH_size*EAH_bf	
		+ EAI_size*EAI_bf	
		+ EAJ_size*EAJ_bf	
		+ EAK_size*EAK_bf	
		+ EAL_size*EAL_bf	
	)
	/
	(
	+ EAA_size
	+ EAB_size
	+ EAC_size
	+ EAD_size
	+ EAE_size
	+ EAF_size
	+ EAG_size
	+ EAH_size
	+ EAI_size
	+ EAJ_size
	+ EAK_size
	+ EAL_size
);
// Annual inflation
EA_pic4 = 1 
		* EAA_pic4^(EAA_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAB_pic4^(EAB_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAC_pic4^(EAC_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAD_pic4^(EAD_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAE_pic4^(EAE_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAF_pic4^(EAF_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAG_pic4^(EAG_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAH_pic4^(EAH_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAI_pic4^(EAI_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAJ_pic4^(EAJ_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAK_pic4^(EAK_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
		* EAL_pic4^(EAL_size/(
				+ EAA_size
				+ EAB_size
				+ EAC_size
				+ EAD_size
				+ EAE_size
				+ EAF_size
				+ EAG_size
				+ EAH_size
				+ EAI_size
				+ EAJ_size
				+ EAK_size
				+ EAL_size
			)) 
;
// Productivity
log(EA_z) = (1-EA_rhoz)*log(EA_zbar)+EA_rhoz*log(EA_z(-1))+EA_epsz;
// Auxiliary equation for steady-state output
EA_ybar = EA_y;
end;
load_params_and_steady_state('eagle_steady_stage1.txt');
// Calibration of interest (semi-)elasticity of money demand
disp('epsilonm')
homotopy_setup;
EAA_epsilonm, -0.75;
EAB_epsilonm, -0.75;
EAC_epsilonm, -0.75;
EAD_epsilonm, -0.75;
EAE_epsilonm, -0.75;
EAF_epsilonm, -0.75;
EAG_epsilonm, -0.75;
EAH_epsilonm, -0.75;
EAI_epsilonm, -0.75;
EAJ_epsilonm, -0.75;
EAK_epsilonm, -0.75;
EAL_epsilonm, -0.75;
RW_epsilonm, -0.75;
US_epsilonm, -0.75;
end;
steady(homotopy_steps = 5);
// Calibration of consumption-based velocity (based on MSN data and SGU, respectively)
disp('vi')
homotopy_setup;
EAA_vi, 2.38;
EAB_vi, 2.38;
EAC_vi, 2.38;
EAD_vi, 2.38;
EAE_vi, 2.38;
EAF_vi, 2.38;
EAG_vi, 2.38;
EAH_vi, 2.38;
EAI_vi, 2.38;
EAJ_vi, 2.38;
EAK_vi, 2.38;
EAL_vi, 2.38;
RW_vi, 2.38;
US_vi, 2.38;
end;
steady(homotopy_steps = 5);
// Calibration of nominal investment-to-output ratio
disp('iy')
homotopy_setup;
EAA_iy, 0.2;
EAB_iy, 0.2;
EAC_iy, 0.2;
EAD_iy, 0.2;
EAE_iy, 0.2;
EAF_iy, 0.2;
