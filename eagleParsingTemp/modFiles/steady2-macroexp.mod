+EAL_size/EAB_size*EALEAB_im/EAB_ex*EABUS_rer*US_pex*EALUS_im/(EABEAL_rer*EAL_py*EAL_y
+EABEAA_rer*EAA_pex*EALEAA_im
+EABEAC_rer*EAC_pex*EALEAC_im
+EABEAD_rer*EAD_pex*EALEAD_im
+EABEAE_rer*EAE_pex*EALEAE_im
+EABEAF_rer*EAF_pex*EALEAF_im
+EABEAG_rer*EAG_pex*EALEAG_im
+EABEAH_rer*EAH_pex*EALEAH_im
+EABEAI_rer*EAI_pex*EALEAI_im
+EABEAJ_rer*EAJ_pex*EALEAJ_im
+EABEAK_rer*EAK_pex*EALEAK_im
