//Terms of Trade
EAKEAI_tot = EAI_pex*EAKEAI_rer/EAK_pex;
// Optimal price contract set in foreign markets (FOC), using EAK_pxtilde = EAJ_pimtilde
// EAJEAK_pimtilde/EAJEAK_pim = EAK_cpim*EAK_thetat/(EAK_thetat-1)*EAKEAJ_fx/EAKEAJ_gx;
