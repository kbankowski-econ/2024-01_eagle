// EAEEAG_fx = EAG_size/EAE_size*EAGEAE_im*EAE_mct+EAE_xix*EAE_beta*EAE_lambdai(+1)/EAE_lambdai*(EAGEAE_piim(+1)/(EAGEAE_piim^EAE_chix*EAE_pi4target^(1/4*(1-EAE_chix))))^EAE_thetat*EAEEAG_fx(+1);
