+EAHEAL_numc * (EAL_pex*EAHEAL_rer)^(1-EAH_mumc)
+EAHRW_numc * (RW_pex*EAHRW_rer)^(1-EAH_mumc)
+EAHUS_numc * (US_pex*EAHUS_rer)^(1-EAH_mumc)
+(1
-EAHEAA_numc
-EAHEAB_numc
-EAHEAC_numc
-EAHEAD_numc
-EAHEAE_numc
-EAHEAG_numc
-EAHEAI_numc
-EAHEAJ_numc
-EAHEAK_numc
