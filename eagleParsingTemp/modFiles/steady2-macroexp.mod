)
+EAE_size/EAB_size*EAEEAB_im/EAB_ex*EABUS_rer*US_pex*EAEUS_im/(EABEAE_rer*EAE_py*EAE_y
+EABEAA_rer*EAA_pex*EAEEAA_im
+EABEAC_rer*EAC_pex*EAEEAC_im
