+EAHUS_rer*US_pex*EABUS_im
)
+EAC_size/EAH_size*EACEAH_im/EAH_ex*EAHEAA_rer*EAA_pex*EACEAA_im/(EAHEAC_rer*EAC_py*EAC_y
+EAHEAA_rer*EAA_pex*EACEAA_im
+EAHEAB_rer*EAB_pex*EACEAB_im
