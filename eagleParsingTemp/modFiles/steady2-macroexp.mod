//Terms of Trade
EAEEAI_tot = EAI_pex*EAEEAI_rer/EAE_pex;
// Optimal price contract set in foreign markets (FOC), using EAE_pxtilde = EAJ_pimtilde
// EAJEAE_pimtilde/EAJEAE_pim = EAE_cpim*EAE_thetat/(EAE_thetat-1)*EAEEAJ_fx/EAEEAJ_gx;
