IM_{t}^{C}(x^{CO})=\left[\left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}\Bigg[\underbrace{\frac{1}{s^{H}}\left(\frac{P_{X,t}^{CO}(h)}{P_{X,t}^{H,CO}}\right)^{-\theta_{T}}IM_{t}^{C}(x^{CO})}_{IM_{t}^{C}(x^{CO},h)}\Bigg]^{(\theta_{T}-1)/\theta_{T}}dh\right]^{\theta_{T}/(\theta_{T}-1)},
\end{gather*}

\end_inset


\lang british
which can be simplified further as follows through the series of steps:
\begin_inset Formula 
\begin{gather*}
1=\left\{ \left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}\left[\frac{1}{s^{H}}\left(\frac{P_{X,t}^{CO}(h)}{P_{X,t}^{H,CO}}\right)^{-\theta_{T}}\right]^{\nicefrac{\left(\theta_{T}-1\right)}{\theta_{T}}}dn\right\} ^{\nicefrac{\theta_{T}}{\left(\theta_{T}-1\right)}}\\
1=\left\{ \left(\frac{1}{s^{H}}\right)\int_{_{0}}^{^{s^{H}}}\left[\left(P_{X,t}^{CO}(h)\right)^{-\theta_{T}}\right]^{\nicefrac{\left(\theta_{T}-1\right)}{\theta_{T}}}dh\left(P_{X,t}^{H,CO}\right)^{\theta_{T}\nicefrac{\left(\theta_{T}-1\right)}{\theta_{T}}}\right\} ^{\nicefrac{\theta_{T}}{\left(\theta_{T}-1\right)}}\\
1=\left\{ \left(\frac{1}{s^{H}}\right)\int_{_{0}}^{^{s^{H}}}\left[\left(P_{X,t}^{CO}(h)\right)^{-\theta_{T}}\right]^{(\theta_{T}-1)/\theta_{T}}dh\right\} ^{\nicefrac{\theta_{T}}{\left(\theta_{T}-1\right)}}\left(P_{X,t}^{H,CO}\right)^{\theta_{T}}\\
\left(P_{X,t}^{H,CO}\right)^{-\theta_{T}}=\left\{ \left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}\left[P_{X,t}^{CO}(h)\right]^{(1-\theta_{T})}dh\right\} ^{\nicefrac{\theta_{T}}{\left(\theta_{T}-1\right)}}\\
P_{X,t}^{H,CO}=\left\{ \left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}\left[P_{X,t}^{CO}(h)\right]^{(1-\theta_{T})}dh\right\} ^{\nicefrac{\theta_{T}}{\left(\theta_{T}-1\right)}\left(\nicefrac{-1}{\theta_{T}}\right)}\\
P_{X,t}^{H,CO}=\left\{ \left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{N}}}\int_{_{0}}^{^{s^{H}}}\left[P_{X,t}^{CO}(h)\right]^{(1-\theta_{T})}dh\right\} ^{\nicefrac{1}{(1-\theta_{T})}}
\end{gather*}

