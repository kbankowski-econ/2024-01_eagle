\begin_layout Plain Layout

\lang english
The generic firm 
\begin_inset Formula $x^{CO}$
\end_inset

 in the consumption sector of the importing country 
\begin_inset Formula $CO$
\end_inset

 exploits the following CES technology: 
\end_layout

\begin_layout Plain Layout

\lang english
\begin_inset Formula 
\[
IM_{t}^{C}(x^{CO})=\left[\left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}IM_{t}^{C}(x^{CO},h){}^{(\theta_{T}-1)/\theta_{T}}dh\right]^{\theta_{T}/(\theta_{T}-1)},\theta_{T}>1
\]

\end_inset


\end_layout

\begin_layout Plain Layout

\lang english
Cost minimization implies:
\end_layout

\begin_layout Plain Layout

\lang english
\begin_inset Formula 
\begin{align*}
\underset{\{IM_{t}^{C}(x^{CO},h):x^{CO},h\in[0,s^{H}]\}}{max} & P_{X,t}^{H,CO}\underbrace{\left[\left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}IM_{t}^{C}(x^{CO},h){}^{(\theta_{T}-1)/\theta_{T}}dh\right]^{\theta_{T}/(\theta_{T}-1)}}_{IM_{t}^{C}(x^{CO})}\\
 & -\int_{_{0}}^{^{s^{H}}}P_{X,t}^{CO}(h)IM_{t}^{C}(x^{CO},h)dh
\end{align*}

\end_inset


\begin_inset VSpace 0.5em
\end_inset


\end_layout

\begin_layout Plain Layout

\lang english
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
fcolorbox{blue}{lightgray}{FOC with respect to $IM_{t}^{C}(x^{CO},h)$:}
\end_layout

\end_inset


\begin_inset Formula 
\begin{gather*}
P_{X,t}^{H,CO}\left(\frac{\theta_{T}}{\theta_{T}-1}\right)\underbrace{\left(\left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}\int_{_{0}}^{^{s^{H}}}IM_{t}^{C}(x^{CO},h){}^{(\theta_{T}-1)/\theta_{T}}dh\right)^{1/(\theta_{T}-1)}}_{\left(IM_{t}^{C}(x^{CO})\right)^{\nicefrac{1}{\theta_{T}}}}\left(\frac{\theta_{T}-1}{\theta_{T}}\right)\left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}IM_{t}^{C}(x^{CO},h)^{-1/\theta_{T}}-P_{X,t}^{CO}(h)\overset{!}{=}0\\
P_{X,t}^{H,CO}\left(IM_{t}^{C}(x^{CO})\right)^{1/\theta_{T}}\left(\frac{1}{s^{H}}\right)^{\frac{1}{\theta_{T}}}IM_{t}^{C}(x^{CO},h)^{-1/\theta_{T}}-P_{X,t}^{CO}(h)=0\\
IM_{t}^{C}(x^{CO},h)^{-1/\theta_{T}}=\left(\frac{1}{s^{H}}\right)^{-\frac{1}{\theta_{T}}}\frac{P_{X,t}^{CO}(h)\left(IM_{t}^{C}(x^{CO})\right)^{1/\theta_{T}}}{P_{X,t}^{H,CO}}\\
IM_{t}^{C}(x^{CO},h)=\frac{1}{s^{H}}\left(\frac{P_{X,t}^{CO}(h)}{P_{X,t}^{H,CO}}\right)^{-\theta_{T}}IM_{t}^{C}(x^{CO})
\end{gather*}

\end_inset

By substituting the optimal amount of import good 
