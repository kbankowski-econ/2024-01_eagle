\begin_layout Plain Layout

\lang english
\begin_inset Formula 
\begin{gather*}
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(\left(1-\theta_{T}\right)S_{t+k}^{H,CO}\left(P_{X,t+k}^{CO}(h)\right)^{-\theta_{T}}\left(P_{X,t+k}^{H,CO}\right)^{\theta_{T}}IM_{t+k}^{CO,H}-MC_{T,t+k}\left(-\theta_{T}\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}-1}\frac{1}{P_{X,t+k}^{H,CO}}IM_{t+k}^{CO,H}\right)\right)\right]=0\\
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(\left(1-\theta_{N}\right)S_{t+k}^{H,CO}\left(P_{X,t+k}^{CO}(h)\right)^{-\theta_{T}}\left(P_{X,t+k}^{H,CO}\right)^{\theta_{T}}IM_{t+k}^{CO,H}-MC_{T,t+k}\left(-\theta_{T}\left(P_{X,t+k}^{CO}(h)\right)^{-\theta_{T}-1}\left(P_{X,t+k}^{H,CO}\right)^{\theta_{T}}IM_{t+k}^{CO,H}\right)\right)\right]=0\\
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(S_{t+k}^{H,CO}\left(\frac{P_{X,t+k}^{H,CO}}{P_{X,t+k}^{CO}(h)}\right)^{\theta_{T}}IM_{t+k}^{CO,H}-MC_{T,t+k}\left(-\frac{\theta_{T}}{\left(1-\theta_{T}\right)}\left(P_{X,t+k}^{CO}(h)\right)^{-1}\left(\frac{P_{X,t+k}^{H,CO}}{P_{X,t+k}^{CO}(h)}\right)^{\theta_{T}}IM_{t+k}^{CO,H}\right)\right)\right]=0\\
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(S_{t+k}^{H,CO}\underset{IM_{t+k}^{CO}(h)}{\underbrace{\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}}IM_{t+k}^{CO,H}}}-MC_{T,t+k}\left(-\frac{\theta_{T}}{\left(1-\theta_{T}\right)}\left(P_{X,t+k}^{CO}(h)\right)^{-1}\underset{IM_{t+k}^{CO}(h)}{\underbrace{\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}}IM_{t+k}^{CO,H}}}\right)\right)\right]=0\\
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(S_{t+k}^{H,CO}IM_{t+k}^{CO}(h)-MC_{T,t+k}\left(\frac{\theta_{T}}{\theta_{T}-1}\left(P_{X,t+k}^{CO}(h)\right)^{-1}IM_{t+k}^{CO}(h)\right)\right)\right]=0\\
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(P_{X,t+k}^{CO}(h)-\frac{\theta_{T}}{\theta_{T}-1}\left(S_{t+k}^{H,CO}\right)^{-1}MC_{T,t+k}\right)IM_{t+k}^{CO}(h)\right]=0\\
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left(\stackrel[s=1]{k}{\prod}\left(\Pi_{X,t+s-1}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t}^{H,CO}(h)-\frac{\theta_{T}}{\theta_{T}-1}\left(S_{t+k}^{H,CO}\right)^{-1}MC_{T,t+k}\right)IM_{t+k}^{CO}(h)\right]=0
\end{gather*}

