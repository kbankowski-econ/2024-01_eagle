\underset{\{P_{X,t+k}^{CO}(h):h\in[0,s^{H}]\}}{max} & E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left[\stackrel[CO\neq H]{}{\sum}\left(S_{t+k}^{H,CO}P_{X,t+k}^{CO}(h)\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}}IM_{t+k}^{CO,H}-MC_{T,t+k}\left(\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}}IM_{t+k}^{CO,H}+\psi_{T}\right)\right)\right]\right]\\
\underset{\{P_{X,t+k}^{CO}(h):h\in[0,s^{H}]\}}{max} & E_{t}\left[\stackrel[k=0]{\infty}{\sum}\left(\xi_{X}\right)^{k}\varLambda_{I,t,t+k}\left[\stackrel[CO\neq H]{}{\sum}\left(S_{t+k}^{H,CO}\left(P_{X,t+k}^{CO}(h)\right)^{1-\theta_{T}}\left(P_{X,t+k}^{H,CO}\right)^{\theta_{T}}IM_{t+k}^{CO,H}-MC_{T,t+k}\left(\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}}IM_{t+k}^{CO,H}+\psi_{T}\right)\right)\right]\right]
\end{align*}

