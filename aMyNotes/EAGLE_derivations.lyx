\begin_layout Plain Layout
\noindent

\lang english
The price setting scheme provided is
\end_layout

\begin_layout Plain Layout
\noindent

\lang english
\begin_inset Formula 
\begin{gather*}
P_{X,t}^{CO}(h)=\left(\Pi_{X,t-1}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t-1}^{CO}(h)
\end{gather*}

\end_inset


\end_layout

\begin_layout Plain Layout

\lang english
which can be written for periods 
\begin_inset Formula $t+1$
\end_inset

, 
\begin_inset Formula $t+2$
\end_inset

and 
\begin_inset Formula $t+3$
\end_inset

 as:
\end_layout

\begin_layout Plain Layout
\noindent

\lang english
\begin_inset Formula 
\begin{gather*}
P_{X,t+1}^{CO}(h)=\left(\Pi_{X,t}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t}^{CO}(h)\\
P_{X,t+2}^{CO}(h)=\left(\Pi_{X,t+1}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t+1}^{CO}(h)\\
P_{X,t+3}^{CO}(h)=\left(\Pi_{X,t+2}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t+2}^{CO}(h)
\end{gather*}

\end_inset


\end_layout

\begin_layout Plain Layout
\noindent

\lang english
By substituting all the conditions above one into the other in otrder to
 express 
\begin_inset Formula $P_{t+k}(n)$
\end_inset

 (where 
\begin_inset Formula $k=3$
\end_inset

) with 
\begin_inset Formula $P_{t}(n)$
\end_inset

 we obtain the following:
\end_layout

\begin_layout Plain Layout

\lang english
\begin_inset Formula 
\[
P_{X,t+3}^{CO}(h)=\underset{P_{X,t+3}^{CO}(h)}{\underbrace{\left(\Pi_{X,t+2}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}\underset{P_{X,t+2}^{CO}(h)}{\underbrace{\left(\Pi_{X,t+1}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}\underset{P_{X,t+1}^{CO}(h)}{\underbrace{\left(\Pi_{X,t}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t}^{CO}(h)}}}}}}
\]

\end_inset


\end_layout

\begin_layout Plain Layout

\lang english
which can be simplified using the 
\begin_inset Formula $\prod$
\end_inset

 operator:
\end_layout

\begin_layout Plain Layout

\lang english
\begin_inset Formula 
\begin{gather*}
P_{X,t+k}^{CO}(h)=\stackrel[s=0]{k-1}{\prod}\left(\Pi_{X,t+s}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t}^{CO}(h),
\end{gather*}

\end_inset


\end_layout

\begin_layout Plain Layout

\lang english
and which can also be written as:
\end_layout

\begin_layout Plain Layout

\lang english
\begin_inset Formula 
\begin{gather*}
P_{X,t+k}^{CO}(h)=\stackrel[s=1]{k}{\prod}\left(\Pi_{X,t+s-1}^{H,CO}\right)^{\chi_{X}}\overline{\Pi}^{1-\chi_{X}}P_{X,t}^{CO}(h)
\end{gather*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard

\lang english
Each exporting firm 
\begin_inset Formula $h$
\end_inset

 that re-optimizes at time 
\begin_inset Formula $t$
\end_inset

 maximizes the discounted sum of its expected nominal profits, expressed
 in domestic currency:
\end_layout

\begin_layout Standard

\lang english
\begin_inset Formula 
\begin{gather*}
E_{t}\left[\stackrel[k=0]{\infty}{\sum}\varLambda_{I,t,t+k}\left[\stackrel[CO\neq H]{}{\sum}\left(\xi_{X}\right)^{k}\left(S_{t+k}^{H,CO}P_{X,t+k}^{CO}(h)IM_{t+k}^{CO}(h)-MC_{T,t+k}(IM_{t+k}^{CO}(h)+\psi_{T})\right)\right]\right]
\end{gather*}

\end_inset


\end_layout

\begin_layout Standard

\lang english
subject to price-indexation scheme and taking as given the demand function
 of importing country 
\begin_inset Formula $CO$
\end_inset

:
\end_layout

\begin_layout Standard

\lang english
\begin_inset Formula 
\begin{gather*}
IM_{t+k}^{CO}(h)=\left(\frac{P_{X,t+k}^{CO}(h)}{P_{X,t+k}^{H,CO}}\right)^{-\theta_{T}}IM_{t+k}^{CO,H}
\end{gather*}

\end_inset


\end_layout

